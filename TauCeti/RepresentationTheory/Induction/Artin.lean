module

public import TauCeti.GroupTheory.Elementary
public import TauCeti.RepresentationTheory.Induction.Spanning
import Mathlib.Combinatorics.Enumerative.IncidenceAlgebra

/-!
# Artin's induction theorem

For a finite group `G`, the sharp Artin identity and the projection formula show that
`|G| • χ` is induced from virtual characters of cyclic subgroups for every virtual character `χ`.
The target is the canonical subgroup
`TauCeti.ClassFunction.indVirtualCharacters k G (fun C ↦ IsCyclic C)`, rather than a parallel
cyclic-specific construction.  When `Nat.card G` vanishes in `k`, this displayed multiple is zero;
the intended nonvacuous content is the characteristic-zero specialization.

The direct sum of induction maps `⨁_{C cyclic} R(C) → R(G)` is also bundled explicitly, and its
scalar extension after tensoring source and target over `ℤ` with `ℚ` is surjective.  In positive
characteristic the target tensor product is zero; the usual nonvacuous rational formulation is the
specialization to a characteristic-zero algebraically closed splitting field.

The earlier spanning development also identifies the canonical target with
`TauCeti.ClassFunction.indCharacterSpanInt`, the finer subgroup generated by induced irreducible
characters, over an algebraically closed field in which the selected subgroup orders are
invertible.  Combining that comparison with the sharp canonical theorem gives the conventional
characteristic-zero induced-character-span endpoint.

The sharp identity is proved by Möbius inversion on the finite poset of cyclic subgroups, and the
projection formula propagates it from the trivial character to every virtual character.

## Main statements

* `TauCeti.ClassFunction.natCard_nsmul_mem_indVirtualCharacters_isCyclic`: **Artin's induction
  theorem, sharp form**, through the canonical induced-virtual-character API.
* `TauCeti.ClassFunction.natCard_nsmul_mem_indCharacterSpanInt_isCyclic`: the characteristic-zero
  splitting-field form with the roadmap's literal induced-character-span target.
* `TauCeti.ClassFunction.natCard_nsmul_one_mem_indVirtualCharacters_isCyclic`: the sharp
  membership statement for the trivial character.
* `TauCeti.ClassFunction.indVirtualCharacterDirectSumBaseChangeRat_isCyclic_surjective`: rational
  surjectivity after extension of scalars from `ℤ` to `ℚ`, with the intended nonvacuous
  specialization at a characteristic-zero splitting field.
* `TauCeti.ClassFunction.indVirtualCharacterDirectSumBaseChangeRat_isElementary_surjective`: the
  corresponding rational-surjectivity theorem for elementary subgroups.
* `TauCeti.ClassFunction.natCard_nsmul_mem_indVirtualCharacters_isElementary`: the sharp theorem,
  read for the elementary subgroups.

## References

This proves both parts of the "Artin's induction theorem" item of Layer 6 in
`TauCetiRoadmap/RepresentationTheory/InductionRestriction/README.md`: rational surjectivity of the
direct-sum induction map and `ℤ`-membership of `|G| • χ` in the cyclic-induced subgroup.

* J.-P. Serre, *Linear Representations of Finite Groups*, Springer GTM 42 (1977), Section 9.2,
  Theorem 17 and its corollary.
* C. W. Curtis, I. Reiner, *Methods of Representation Theory, Vol. I*, Wiley (1981), Section 15.
-/

public section

namespace TauCeti

namespace ClassFunction

universe u v

private abbrev CyclicSubgroup (G : Type*) [Group G] := {C : Subgroup G // IsCyclic C}

@[instance_reducible]
private noncomputable def cyclicSubgroupFintype {G : Type*} [Group G] [Finite G] :
    Fintype (CyclicSubgroup G) := by
  classical
  exact Fintype.ofFinite _

attribute [local instance] cyclicSubgroupFintype

@[instance_reducible]
private noncomputable def cyclicSubgroupLocallyFiniteOrder {G : Type*} [Group G] [Finite G] :
    LocallyFiniteOrder (CyclicSubgroup G) := by
  classical
  exact Fintype.toLocallyFiniteOrder

attribute [local instance] cyclicSubgroupLocallyFiniteOrder

@[instance_reducible]
private noncomputable def cyclicSubgroupLocallyFiniteOrderTop {G : Type*} [Group G]
    [Finite G] : LocallyFiniteOrderTop (CyclicSubgroup G) := by
  classical
  exact LocallyFiniteOrderTop.ofIci _ (fun C ↦ Finset.univ.filter (C ≤ ·)) (by simp)

attribute [local instance] cyclicSubgroupLocallyFiniteOrderTop

/-- The sum of `μ(C, D)` over cyclic subgroups `D` containing `C`; this is the coefficient of `C`
in the Artin identity. -/
private noncomputable def artinCoeff {G : Type*} [Group G] [Finite G]
    (C : CyclicSubgroup G) : ℤ := by
  classical
  exact ∑ D ∈ Finset.Ici C, IncidenceAlgebra.mu ℤ C D

/-- The sum of the Artin coefficients over cyclic subgroups `C` containing `H`; this is the
quantity shown to equal one by `artinUpperSum_eq_one`. -/
private noncomputable def artinUpperSum {G : Type*} [Group G] [Finite G]
    (H : CyclicSubgroup G) : ℤ := by
  classical
  exact ∑ C ∈ Finset.Ici H, artinCoeff C

/-- The upper sums of the Artin coefficients are one. -/
private theorem artinUpperSum_eq_one {G : Type*} [Group G] [Finite G]
    (H : CyclicSubgroup G) : artinUpperSum H = 1 := by
  classical
  simp_rw [artinUpperSum, artinCoeff]
  calc
    ∑ C ∈ Finset.Ici H, ∑ D ∈ Finset.Ici C, IncidenceAlgebra.mu ℤ C D =
        ∑ D ∈ Finset.Ici H, ∑ C ∈ Finset.Icc H D, IncidenceAlgebra.mu ℤ C D :=
      Finset.sum_comm' fun C D ↦ by
        simp only [Finset.mem_Ici, Finset.mem_Icc]
        aesop (add unsafe le_trans)
    _ = 1 := by
      simp only [IncidenceAlgebra.sum_Icc_mu_left, Finset.sum_ite_eq, Finset.mem_Ici,
        le_refl, ite_true]

variable {k : Type u} {G : Type v} [Field k] [Group G]
variable [Finite G]

/-! ### The sharp Artin identity -/

/-- **Artin induction for the trivial character.** The order of `G` times the trivial character
belongs to the subgroup generated by virtual characters induced from cyclic subgroups.  When
`Nat.card G` vanishes in `k`, the multiple is zero; the intended nonvacuous content is the
characteristic-zero specialization. -/
theorem natCard_nsmul_one_mem_indVirtualCharacters_isCyclic :
    Nat.card G • (1 : G → k) ∈ indVirtualCharacters k G (fun C ↦ IsCyclic C) := by
  -- Möbius inversion supplies the coefficients. Pointwise, subgroup order times an induced
  -- trivial character counts conjugates lying in that subgroup; the upper Möbius sum is one.
  classical
  let _ := Fintype.ofFinite G
  let α : CyclicSubgroup G → (G → k) := fun C ↦
    artinCoeff C • (Nat.card (C : Subgroup G) •
      indClassFun (C : Subgroup G) (fun _ : (C : Subgroup G) ↦ (1 : k)))
  have hα (C : CyclicSubgroup G) : α C ∈ indVirtualCharacters k G (fun C ↦ IsCyclic C) := by
    exact AddSubgroup.zsmul_mem _ (AddSubgroup.nsmul_mem _
      (indClassFun_mem_indVirtualCharacters C.2 one_mem_virtualCharacters) _) _
  suffices hsum : ∑ C, α C = Nat.card G • (1 : G → k) by
    rw [← hsum]
    exact AddSubgroup.sum_mem _ fun C _ ↦ hα C
  funext g
  simp only [α, Finset.sum_apply, Pi.smul_apply]
  have hnat (C : CyclicSubgroup G) :
      (Nat.card (C : Subgroup G) : k) *
          indClassFun (C : Subgroup G) (fun _ : (C : Subgroup G) ↦ (1 : k)) g =
        ∑ x : G, if h : x⁻¹ * g * x ∈ (C : Subgroup G) then
          (1 : k) else 0 :=
    natCard_mul_indClassFun
      (ClassFunction.mem_iff.mpr fun _ _ ↦ rfl) g
  simp_rw [← Int.cast_smul_eq_zsmul k, ← Nat.cast_smul_eq_nsmul k,
    smul_eq_mul, hnat]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  simp only [mul_dite, mul_one, mul_zero]
  have hz (x : G) :
      (∑ C : CyclicSubgroup G,
        (if _h : x⁻¹ * g * x ∈ (C : Subgroup G) then (artinCoeff C : k) else (0 : k))) =
          (1 : k) := by
    let H : CyclicSubgroup G :=
      ⟨Subgroup.zpowers (x⁻¹ * g * x), Subgroup.isCyclic_zpowers (x⁻¹ * g * x)⟩
    have hu : ((artinUpperSum H : ℤ) : k) = 1 := by rw [artinUpperSum_eq_one]; simp
    rw [← hu]
    simp only [artinUpperSum, Int.cast_sum]
    calc
      (∑ C : CyclicSubgroup G,
        if _h : x⁻¹ * g * x ∈ (C : Subgroup G) then (artinCoeff C : k) else 0) =
          ∑ C ∈ Finset.Ici H,
            if _h : x⁻¹ * g * x ∈ (C : Subgroup G) then (artinCoeff C : k) else 0 := by
        symm
        apply Finset.sum_subset (Finset.Ici H).subset_univ
        intro C _ hC
        rw [dite_eq_right]
        intro hmem
        apply hC
        exact Finset.mem_Ici.mpr (Subgroup.zpowers_le_of_mem hmem)
      _ = ∑ C ∈ Finset.Ici H, (artinCoeff C : k) := by
        apply Finset.sum_congr rfl
        intro C hHC
        rw [dite_eq_left]
        exact (Finset.mem_Ici.mp hHC) (Subgroup.mem_zpowers _)
  simp_rw [hz]
  simp

/-- **Artin's induction theorem, sharp form, through the canonical API.** For every virtual
character `f` of a finite group `G`, the explicit multiple `|G| • f` belongs to the subgroup
generated by virtual characters induced from cyclic subgroups.  When `Nat.card G` vanishes in `k`,
the multiple is zero; the intended nonvacuous content is the characteristic-zero specialization. -/
theorem natCard_nsmul_mem_indVirtualCharacters_isCyclic {f : G → k}
    (hf : f ∈ virtualCharacters k G) :
    Nat.card G • f ∈ indVirtualCharacters k G (fun C ↦ IsCyclic C) := by
  simpa [nsmul_eq_mul, mul_comm] using mul_mem_indVirtualCharacters hf
    (natCard_nsmul_one_mem_indVirtualCharacters_isCyclic (k := k) (G := G))

/-- **Artin's induction theorem with its induced-character-span target.** Over a
characteristic-zero algebraically closed splitting field, `|G| • f` belongs to the additive
subgroup generated by characters induced from irreducible characters of cyclic subgroups. -/
theorem natCard_nsmul_mem_indCharacterSpanInt_isCyclic [CharZero k] [IsAlgClosed k]
    {f : G → k} (hf : f ∈ virtualCharacters k G) :
    Nat.card G • f ∈ indCharacterSpanInt k G (fun C ↦ IsCyclic C) := by
  rw [← indVirtualCharacters_eq_indCharacterSpanInt fun C _ ↦
    isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr Nat.card_pos.ne')]
  exact natCard_nsmul_mem_indVirtualCharacters_isCyclic hf

/-! ### Rational surjectivity -/

/-- **Rational Artin induction in map form.** The scalar extension to `ℚ` of induction from cyclic
subgroups is surjective.  In positive characteristic the target is zero; specialization to a
characteristic-zero algebraically closed field gives the usual nonvacuous representation-ring
statement. -/
theorem indVirtualCharacterDirectSumBaseChangeRat_isCyclic_surjective :
    Function.Surjective
      (indVirtualCharacterDirectSumBaseChangeRat k G (fun C ↦ IsCyclic C)) :=
  indVirtualCharacterDirectSumBaseChangeRat_surjective_of_nsmul_one_mem
    (fun C ↦ IsCyclic C) (Nat.card G) Nat.card_pos.ne'
      natCard_nsmul_one_mem_indVirtualCharacters_isCyclic

/-! ### The cyclic and the elementary families -/

/-- Every cyclic subgroup is elementary, so a virtual character induced from a cyclic subgroup is
induced from an elementary one. -/
theorem indVirtualCharacters_isCyclic_le_indVirtualCharacters_isElementary :
    indVirtualCharacters k G (fun C => IsCyclic C) ≤
      indVirtualCharacters k G (fun E => IsElementary E) :=
  indVirtualCharacters_mono fun C hC => by
    have : IsCyclic C := hC
    exact isElementary_of_isCyclic

/-- **Artin's sharp induction theorem, read for the elementary subgroups.** Every cyclic subgroup
is elementary, so the sharp cyclic theorem gives the explicit multiplier `|G|` here too.

When `Nat.card G` vanishes in `k`, the multiple is zero; the intended nonvacuous content is the
characteristic-zero specialization.

This is *weaker* than Brauer's induction theorem, which asserts the same with multiplier `1`. By
`TauCeti.ClassFunction.indVirtualCharacters_eq_virtualCharacters_iff`, Brauer's theorem is
equivalent to `1` being induced from the elementary subgroups, which is not proved here. -/
theorem natCard_nsmul_mem_indVirtualCharacters_isElementary {f : G → k}
    (hf : f ∈ virtualCharacters k G) :
    Nat.card G • f ∈ indVirtualCharacters k G (fun E ↦ IsElementary E) :=
  indVirtualCharacters_isCyclic_le_indVirtualCharacters_isElementary
    (natCard_nsmul_mem_indVirtualCharacters_isCyclic hf)

/-- Rationalized induction from elementary subgroups is surjective. -/
theorem indVirtualCharacterDirectSumBaseChangeRat_isElementary_surjective :
    Function.Surjective
      (indVirtualCharacterDirectSumBaseChangeRat k G (fun E ↦ IsElementary E)) :=
  indVirtualCharacterDirectSumBaseChangeRat_surjective_of_nsmul_one_mem
    (fun E ↦ IsElementary E) (Nat.card G) Nat.card_pos.ne'
      (indVirtualCharacters_isCyclic_le_indVirtualCharacters_isElementary
        natCard_nsmul_one_mem_indVirtualCharacters_isCyclic)

end ClassFunction

end TauCeti
