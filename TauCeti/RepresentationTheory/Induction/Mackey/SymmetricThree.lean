module

public import TauCeti.RepresentationTheory.Induction.Mackey.Reducible

/-!
# Mackey on `S₃`: nothing induced from a point stabilizer is irreducible

The roadmap's smallest Mackey example takes `G = S₃` and `H = ⟨(1 2)⟩`, the two-element subgroup
generated by a transposition, which is the stabilizer of the remaining point. Inducing a linear
character of `H` gives a three-dimensional representation of `S₃`, which the roadmap records as
`sgn ⊕ standard` for the sign character, and which the Mackey criterion reports **reducible**.
The reducibility is what this file proves, and it proves it for *every* representation of `H`,
not only for a linear character: `H` is a non-normal subgroup of prime order, so
`TauCeti.not_simple_indFDRep_of_prime_card_of_not_normal` applies with no information about the
representation at all. The decomposition `sgn ⊕ standard` itself is not proved here.

`S₃` is realized as `Equiv.Perm (Fin 3)` and the two-element subgroup as the point stabilizer
`MulAction.stabilizer (Equiv.Perm (Fin 3)) a`, which is generated by the transposition of the two
points other than `a`. The facts about `Fin 3` that the argument needs -- which permutations fix a
point, that the transposition of the other two points is not the identity, and that conjugating it
by a transposition moving `a` leaves the stabilizer -- are settled by `decide` on the six
permutations, which is what makes this a *worked* example rather than a further piece of theory.

The contrast the roadmap draws is with the *normal* subgroup `A₃`, from which a nontrivial linear
character does induce irreducibly; that half is not proved here, and needs the normal-subgroup form
`TauCeti.simple_indFDRep_iff_of_normal` of the criterion instead.

## Main statements

* `TauCeti.mem_stabilizer_permFinThree_iff`: a permutation of three points fixes `a` exactly when
  it is the identity or the transposition of the other two points.
* `TauCeti.card_stabilizer_permFinThree`: the point stabilizer in `S₃` has order two.
* `TauCeti.not_normal_stabilizer_permFinThree`: it is not normal.
* `TauCeti.not_simple_indFDRep_stabilizer_permFinThree`: **nothing induced from it is
  irreducible**, in particular not the roadmap's linear characters.

## References

The "Mackey on a small group" worked example of
[the induction and restriction roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/InductionRestriction/README.md),
in its reducibility half.

* J.-P. Serre, *Linear Representations of Finite Groups*, Chapter 7.4.
-/

public section

open CategoryTheory

namespace TauCeti

/-! ### The point stabilizers of `S₃` -/

/-- **A permutation of three points fixing `a` is the identity or the transposition of the other
two points.** Written with `a + 1` and `a + 2` so that the statement is uniform in `a`: those are
the two points other than `a`, whichever `a` is. -/
theorem mem_stabilizer_permFinThree_iff (a : Fin 3) (σ : Equiv.Perm (Fin 3)) :
    σ ∈ MulAction.stabilizer (Equiv.Perm (Fin 3)) a ↔
      σ = 1 ∨ σ = Equiv.swap (a + 1) (a + 2) := by
  simp only [MulAction.mem_stabilizer_iff, Equiv.Perm.smul_def]
  revert σ
  revert a
  decide

/-- The point stabilizer of `S₃`, as a set: the identity and one transposition. -/
theorem coe_stabilizer_permFinThree (a : Fin 3) :
    (MulAction.stabilizer (Equiv.Perm (Fin 3)) a : Set (Equiv.Perm (Fin 3)))
      = {1, Equiv.swap (a + 1) (a + 2)} :=
  Set.ext fun σ => mem_stabilizer_permFinThree_iff a σ

/-- The transposition of the two points other than `a` is not the identity. -/
private theorem one_ne_swap_permFinThree (a : Fin 3) :
    (1 : Equiv.Perm (Fin 3)) ≠ Equiv.swap (a + 1) (a + 2) := by
  revert a
  decide

/-- **The point stabilizer of `S₃` has order two**: it is the two-element subgroup generated by a
transposition, the roadmap's `⟨(1 2)⟩`. -/
theorem card_stabilizer_permFinThree (a : Fin 3) :
    Nat.card (MulAction.stabilizer (Equiv.Perm (Fin 3)) a) = 2 := by
  rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq, coe_stabilizer_permFinThree,
    Set.ncard_pair (one_ne_swap_permFinThree a)]

/-- Conjugating the transposition fixing `a` by a transposition that moves `a` leaves the
stabilizer: the conjugate carries `a` elsewhere. -/
private theorem conj_swap_notMem_stabilizer_permFinThree (a : Fin 3) :
    Equiv.swap a (a + 1) * Equiv.swap (a + 1) (a + 2) * (Equiv.swap a (a + 1))⁻¹ ∉
      MulAction.stabilizer (Equiv.Perm (Fin 3)) a := by
  rw [mem_stabilizer_permFinThree_iff]
  revert a
  decide

/-- **The point stabilizer of `S₃` is not normal**: conjugating its transposition by a
transposition moving `a` produces a permutation that no longer fixes `a`. -/
theorem not_normal_stabilizer_permFinThree (a : Fin 3) :
    ¬ (MulAction.stabilizer (Equiv.Perm (Fin 3)) a).Normal := by
  intro hnormal
  have hmem : Equiv.swap (a + 1) (a + 2) ∈ MulAction.stabilizer (Equiv.Perm (Fin 3)) a :=
    (mem_stabilizer_permFinThree_iff a _).mpr (Or.inr rfl)
  exact conj_swap_notMem_stabilizer_permFinThree a
    (hnormal.conj_mem _ hmem (Equiv.swap a (a + 1)))

/-! ### The induced representations, and their reducibility -/

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k]

/-- **Nothing induced from a point stabilizer of `S₃` is irreducible.** This is the roadmap's
`Ind_{C₂}^{S₃}` example: the subgroup has prime order two and is not normal, so
`TauCeti.not_simple_indFDRep_of_prime_card_of_not_normal` refutes irreducibility for every
representation `A` whatsoever -- in particular for the linear characters the roadmap induces. -/
theorem not_simple_indFDRep_stabilizer_permFinThree (a : Fin 3)
    {A : FDRep k (MulAction.stabilizer (Equiv.Perm (Fin 3)) a)} : ¬ Simple (indFDRep A) :=
  not_simple_indFDRep_of_prime_card_of_not_normal
    ((card_stabilizer_permFinThree a).symm ▸ Nat.prime_two)
    (not_normal_stabilizer_permFinThree a)

end TauCeti
