module

public import TauCeti.RepresentationTheory.Induction.Mackey.Irreducible

/-!
# Reducibility of an induced representation from a trivially meeting conjugate

The Mackey irreducibility criterion `TauCeti.simple_indFDRep_iff` asks the restrictions of `A` and
of its conjugate `{}^s A` to the Mackey subgroup `H ⊓ sHs⁻¹` to be disjoint for every `s ∉ H`.
This file records the extreme case in which that condition **fails as badly as possible**: if the
Mackey subgroup is trivial, then the two restrictions are representations of the trivial group on
the same space, so the identity is an intertwiner between them, and it is nonzero unless `A` is a
zero object; disjointness then fails outright. Consequently an induced representation is reducible
as soon as some conjugate of the subgroup meets it trivially, whatever the representation being
induced -- no nonzeroness need be assumed there, because an irreducible induced representation
already forces the inducing representation to be irreducible, hence nonzero.

The condition is not exotic. A subgroup of prime order either equals a conjugate of itself or
meets it trivially, there being nothing in between, so
`TauCeti.exists_notMem_mackeySubgroup_eq_bot_of_prime_card` turns non-normality of such a subgroup
into the hypothesis above: **nothing induced from a non-normal subgroup of prime order is
irreducible**. That is the mechanism behind the roadmap's `S₃` example, where the two-element
subgroup generated by a transposition is not normal and every representation induced from it is
reducible; see
`TauCeti.RepresentationTheory.Induction.Mackey.SymmetricThree`.

The hypothesis constrains only the subgroup, so the conclusion is uniform in the representation
induced. That is what distinguishes the two halves of the roadmap's small-group example: inducing
from the non-normal `C₂` of `S₃` can never give an irreducible, whatever is induced, while
inducing from the normal `A₃` can.

## Main statements

* `TauCeti.not_mackeyDisjoint_of_mackeySubgroup_eq_bot`: a trivial Mackey subgroup destroys
  disjointness for every representation that is not a zero object.
* `TauCeti.not_simple_indFDRep_of_mackeySubgroup_eq_bot`: consequently the induced representation
  is not irreducible.
* `TauCeti.mackeySubgroup_self_eq_bot_or_conj_smul_eq_self`: for a subgroup of prime order the
  Mackey subgroup is `⊥` unless the conjugate is the subgroup itself.
* `TauCeti.exists_notMem_mackeySubgroup_eq_bot_of_prime_card`: a non-normal subgroup of prime
  order has a conjugate meeting it trivially.
* `TauCeti.not_simple_indFDRep_of_prime_card_of_not_normal`: **nothing induced from a non-normal
  subgroup of prime order is irreducible.**

## References

Layer 4 of
[the induction and restriction roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/InductionRestriction/README.md),
"the Mackey irreducibility criterion", read in the direction that refutes irreducibility, and its
"Mackey on a small group" worked example.

* J.-P. Serre, *Linear Representations of Finite Groups*, Chapter 7.4, Proposition 23.
* I. M. Isaacs, *Character Theory of Finite Groups*, Chapter 5, Corollary 5.7.
-/

public section

open scoped Pointwise

open CategoryTheory Limits

namespace TauCeti

universe u

section Disjoint

variable {k G : Type u} [Field k] [Group G] {H : Subgroup G}

/-- A trivial Mackey subgroup makes the group indexing the two restrictions trivial. -/
private theorem subsingleton_subgroupOf_of_eq_bot {s : G} (hbot : mackeySubgroup s H H = ⊥) :
    Subsingleton ((mackeySubgroup s H H).subgroupOf H) := by
  have hbot' : (mackeySubgroup s H H).subgroupOf H = ⊥ := by
    rw [hbot, Subgroup.bot_subgroupOf]
  have key : ∀ x : ((mackeySubgroup s H H).subgroupOf H), (x : H) = 1 := fun x =>
    Subgroup.mem_bot.mp (by rw [← hbot']; exact x.2)
  exact ⟨fun x y => Subtype.ext ((key x).trans (key y).symm)⟩

/-- **A trivial Mackey subgroup destroys Mackey disjointness.** Both restrictions appearing in
`TauCeti.MackeyDisjoint` are then representations of the trivial group on the module underlying
`A`, so the identity is an intertwiner between them; it is nonzero unless `A` is a zero object.

The hypothesis mentions only the subgroup, so this refutes disjointness uniformly in `A`. -/
theorem not_mackeyDisjoint_of_mackeySubgroup_eq_bot {A : FDRep k H} {s : G}
    (hbot : mackeySubgroup s H H = ⊥) (hA : ¬ IsZero A) : ¬ MackeyDisjoint A s := by
  have hsub : Subsingleton ((mackeySubgroup s H H).subgroupOf H) :=
    subsingleton_subgroupOf_of_eq_bot hbot
  -- The identity of the underlying module, as an intertwiner: over the trivial group the
  -- equivariance condition is the one instance at `1`.
  let φ : resFDRep ((mackeySubgroup s H H).subgroupOf H) A ⟶
      (Action.res (FGModuleCat k) (mackeyToH s H H)).obj A :=
    { hom := 𝟙 A.V
      comm := fun g => by
        obtain rfl : g = 1 := Subsingleton.elim g 1
        simp only [map_one, End.one_def]
        exact (Category.id_comp _).trans (Category.comp_id _).symm }
  intro hdisj
  have hzero : (𝟙 A.V : A.V ⟶ A.V) = 0 := congrArg Action.Hom.hom (hdisj.eq_zero φ)
  exact hA ((IsZero.iff_id_eq_zero A).mpr (Action.Hom.ext hzero))

/-- **An induced representation is reducible as soon as some conjugate of the subgroup meets it
trivially.** Read off `TauCeti.simple_indFDRep_iff` at the element `s`, whose Mackey term
`TauCeti.not_mackeyDisjoint_of_mackeySubgroup_eq_bot` shows cannot vanish. The criterion also
returns simplicity of `A`, which supplies the nonzeroness that lemma needs, so this holds for
every `A` whatsoever. -/
theorem not_simple_indFDRep_of_mackeySubgroup_eq_bot [Finite G] [IsAlgClosed k] [CharZero k]
    {A : FDRep k H} {s : G} (hs : s ∉ H) (hbot : mackeySubgroup s H H = ⊥) :
    ¬ Simple (indFDRep A) := by
  intro hsimple
  -- No nonzeroness need be assumed: the criterion returns simplicity of `A` itself, and a simple
  -- object is not a zero object.
  obtain ⟨hsimpleA, hdisj⟩ := (simple_indFDRep_iff A).mp hsimple
  exact not_mackeyDisjoint_of_mackeySubgroup_eq_bot hbot (Simple.not_isZero A) (hdisj s hs)

end Disjoint

section PrimeCard

variable {G : Type*} [Group G] {H : Subgroup G}

/-- **A subgroup of prime order meets each of its conjugates in `⊥` or in itself.** The Mackey
subgroup `H ⊓ sHs⁻¹` sits inside `H`, so its order divides the prime `Nat.card H`; being `H`
itself forces `H ≤ sHs⁻¹`, and the two conjugate subgroups have the same finite order, so they
are equal. -/
theorem mackeySubgroup_self_eq_bot_or_conj_smul_eq_self (hp : (Nat.card H).Prime) (s : G) :
    mackeySubgroup s H H = ⊥ ∨ (MulAut.conj s • H : Subgroup G) = H := by
  have _ : Fact (Nat.card H).Prime := ⟨hp⟩
  have _ : Finite H := Nat.finite_of_card_ne_zero hp.ne_zero
  -- Inside `H` the Mackey subgroup is a subgroup of a group of prime order, so it is `⊥` or `⊤`.
  rcases Subgroup.eq_bot_or_eq_top_of_prime_card ((mackeySubgroup s H H).subgroupOf H) with h | h
  · refine Or.inl (Subgroup.eq_bot_iff_forall _ |>.mpr fun x hx => ?_)
    have hmem : (⟨x, mackeySubgroup_le_right hx⟩ : H) ∈ (mackeySubgroup s H H).subgroupOf H :=
      Subgroup.mem_subgroupOf.mpr hx
    rw [h] at hmem
    exact congrArg Subtype.val (Subgroup.mem_bot.mp hmem)
  · -- The Mackey subgroup is all of `H`, so `H ≤ sHs⁻¹`; the two have the same finite order.
    have hle : H ≤ (MulAut.conj s • H : Subgroup G) := fun y hyH =>
      mackeySubgroup_le_conj
        (Subgroup.mem_subgroupOf.mp (h ▸ Subgroup.mem_top (⟨y, hyH⟩ : H)))
    have hcard : Nat.card (MulAut.conj s • H : Subgroup G) = Nat.card H :=
      Nat.card_congr (Subgroup.equivSMul (MulAut.conj s) H).toEquiv.symm
    have _ : Finite (MulAut.conj s • H : Subgroup G) :=
      Nat.finite_of_card_ne_zero (hcard ▸ hp.ne_zero)
    exact Or.inr (Subgroup.eq_of_le_of_card_ge hle hcard.le).symm

/-- **A non-normal subgroup of prime order has a conjugate meeting it trivially.** If every
conjugate of `H` were `H` itself, `H` would be normal; so some conjugate is different, and by
`TauCeti.mackeySubgroup_self_eq_bot_or_conj_smul_eq_self` it then meets `H` trivially. The
conjugating element lies outside `H`, since conjugating by an element of `H` preserves `H`. -/
theorem exists_notMem_mackeySubgroup_eq_bot_of_prime_card (hp : (Nat.card H).Prime)
    (hH : ¬ H.Normal) : ∃ s ∉ H, mackeySubgroup s H H = ⊥ := by
  by_contra hcon
  push Not at hcon
  refine hH (Subgroup.Normal.of_conjugate_fixed fun g => ?_)
  by_cases hg : g ∈ H
  · exact Subgroup.conj_smul_eq_self_of_mem hg
  · -- At an element outside `H` the Mackey subgroup is not `⊥`, so the conjugate is `H` itself.
    exact (mackeySubgroup_self_eq_bot_or_conj_smul_eq_self hp g).resolve_left (hcon g hg)

end PrimeCard

section PrimeReducible

variable {k G : Type u} [Field k] [Group G] [Finite G] [IsAlgClosed k] [CharZero k]
  {H : Subgroup G}

/-- **Nothing induced from a non-normal subgroup of prime order is irreducible.** Such a subgroup
meets one of its conjugates trivially
(`TauCeti.exists_notMem_mackeySubgroup_eq_bot_of_prime_card`), and that alone refutes the Mackey
criterion.

Both hypotheses are needed: over a normal subgroup the Mackey subgroup is always `H`, and without
prime order the intersection with a conjugate can be a proper nontrivial subgroup, in which case
irreducibility depends on the representation. -/
theorem not_simple_indFDRep_of_prime_card_of_not_normal (hp : (Nat.card H).Prime)
    (hH : ¬ H.Normal) {A : FDRep k H} : ¬ Simple (indFDRep A) := by
  obtain ⟨s, hs, hbot⟩ := exists_notMem_mackeySubgroup_eq_bot_of_prime_card hp hH
  exact not_simple_indFDRep_of_mackeySubgroup_eq_bot hs hbot

end PrimeReducible

end TauCeti
