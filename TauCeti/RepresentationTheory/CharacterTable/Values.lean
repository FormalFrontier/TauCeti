/-!
# The arithmetic of character values

If `g` is an element of finite order `n` in a group and `ρ` is a finite-dimensional
representation, then `ρ g` satisfies `X ^ n - 1`, so every root of its characteristic polynomial
is an `n`-th root of unity. Over an algebraically closed field the characteristic polynomial
splits, so the character value `ρ.character g` is the sum of `finrank` of these roots of unity.

This file proves that dichotomy and reads off its arithmetic consequences: the character value is
integral over `ℤ`, it lies in the ring `ℤ[ζ]` generated by a primitive `n`-th root of unity, and
over `ℂ` it is bounded in absolute value by the degree `χ(1)`. The endomorphism `ρ g` is moreover
semisimple as soon as `n` is invertible in the coefficient field, since `X ^ n - 1` is then
squarefree.

## Main results

* `TauCeti.pow_eq_one_of_isRoot_charpoly`: the roots of the characteristic polynomial of an
  endomorphism of finite order `n` are `n`-th roots of unity.
* `TauCeti.Representation.exists_multiset_character_eq_sum`: over an algebraically closed field a
  character value is a sum of `finrank` many `n`-th roots of unity.
* `TauCeti.FDRep.isIntegral_character`: **character values are algebraic integers**.
* `TauCeti.FDRep.character_mem_adjoin_of_isPrimitiveRoot`: they lie in `ℤ[ζ_e]`, for `ζ_e` a
  primitive root of unity of order the exponent of the group.
* `TauCeti.FDRep.norm_character_le_finrank`: over `ℂ`, `‖χ(g)‖ ≤ χ(1)`.

The eigenvalues are taken with algebraic multiplicity, as the root multiset of the characteristic
polynomial: the roots of the *minimal* polynomial would be the distinct eigenvalues only, and their
sum is not the trace.

## References

* [Character Theory roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/CharacterTheory/README.md),
  Layer 4, "The arithmetic of character values".
* I. M. Isaacs, *Character Theory of Finite Groups* (1976), Chapter 3.
* J.-P. Serre, *Linear Representations of Finite Groups* (1977), Section 12.1.
-/

public section

namespace TauCeti

open Module Polynomial

universe u v w

/-- A root of unity in a commutative ring is integral over `ℤ`: it is a root of the monic
integer polynomial `X ^ n - 1`. This drops the primitivity hypothesis of
`IsPrimitiveRoot.isIntegral`, which the same proof never uses. -/
theorem isIntegral_of_pow_eq_one {A : Type*} [CommRing A] {μ : A} {n : ℕ} (hn : n ≠ 0)
    (hμ : μ ^ n = 1) : IsIntegral ℤ μ :=
  ⟨X ^ n - 1, by simpa using monic_X_pow_sub_C (1 : ℤ) hn, by simp [hμ]⟩

section End

variable {k : Type u} {V : Type w} [Field k] [AddCommGroup V] [Module k V] [FiniteDimensional k V]

/-- Every root of the characteristic polynomial of an endomorphism `f` with `f ^ n = 1` is an
`n`-th root of unity. -/
theorem pow_eq_one_of_isRoot_charpoly {f : End k V} {n : ℕ} (hf : f ^ n = 1) {μ : k}
    (hμ : f.charpoly.IsRoot μ) : μ ^ n = 1 := by
  have hspec : μ ∈ spectrum k f := (End.mem_spectrum_iff_isRoot_charpoly f μ).2 hμ
  rcases subsingleton_or_nontrivial (End k V) with _ | _
  · exact absurd (isUnit_of_subsingleton _) (spectrum.mem_iff.mp hspec)
  · have hpow := spectrum.pow_mem_pow f n hspec
    rw [hf, spectrum.one_eq] at hpow
    simpa using hpow

omit [FiniteDimensional k V] in
/-- An endomorphism `f` with `f ^ n = 1` for some `n` invertible in `k` is semisimple, because it
is annihilated by the squarefree polynomial `X ^ n - 1`. -/
theorem isSemisimple_of_pow_eq_one {f : End k V} {n : ℕ} (hn : (n : k) ≠ 0) (hf : f ^ n = 1) :
    f.IsSemisimple := by
  refine End.isSemisimple_of_squarefree_aeval_eq_zero (p := X ^ n - 1) ?_ ?_
  · simpa using (Polynomial.separable_X_pow_sub_C (1 : k) hn one_ne_zero).squarefree
  · simp [hf]

/-- Over an algebraically closed field the characteristic polynomial of an endomorphism has
exactly `finrank k V` roots, counted with multiplicity. -/
theorem card_roots_charpoly [IsAlgClosed k] (f : End k V) :
    Multiset.card f.charpoly.roots = finrank k V := by
  rw [← LinearMap.charpoly_natDegree f]
  exact splits_iff_card_roots.mp (IsAlgClosed.splits _)

end End

namespace Representation

section Field

variable {k : Type u} {G : Type v} {V : Type w} [Field k] [Monoid G] [AddCommGroup V] [Module k V]
  [FiniteDimensional k V]

/-- Over an algebraically closed field the character value at `g` is the sum of the eigenvalues of
`ρ g`, counted with algebraic multiplicity. -/
theorem character_eq_sum_roots_charpoly [IsAlgClosed k] (ρ : Representation k G V) (g : G) :
    ρ.character g = (ρ g).charpoly.roots.sum :=
  End.trace_eq_sum_roots_charpoly_of_splits (IsAlgClosed.splits _)

/-- If `g ^ n = 1` then every eigenvalue of `ρ g` is an `n`-th root of unity. -/
theorem pow_eq_one_of_mem_roots_charpoly (ρ : Representation k G V) {g : G} {n : ℕ}
    (hg : g ^ n = 1) {μ : k} (hμ : μ ∈ (ρ g).charpoly.roots) : μ ^ n = 1 :=
  pow_eq_one_of_isRoot_charpoly (by rw [← map_pow, hg, map_one]) (isRoot_of_mem_roots hμ)

/-- **A character value is a sum of roots of unity.** Over an algebraically closed field, if
`g ^ n = 1` then `ρ.character g` is the sum of a multiset of `finrank k V` many `n`-th roots of
unity, namely the eigenvalues of `ρ g` with algebraic multiplicity. -/
theorem exists_multiset_character_eq_sum [IsAlgClosed k] (ρ : Representation k G V) {g : G} {n : ℕ}
    (hg : g ^ n = 1) :
    ∃ s : Multiset k, Multiset.card s = finrank k V ∧ (∀ μ ∈ s, μ ^ n = 1) ∧
      ρ.character g = s.sum :=
  ⟨(ρ g).charpoly.roots, card_roots_charpoly _,
    fun _ hμ => pow_eq_one_of_mem_roots_charpoly ρ hg hμ, character_eq_sum_roots_charpoly ρ g⟩

omit [FiniteDimensional k V] in
/-- If `g ^ n = 1` with `n` invertible in `k`, then `ρ g` is a semisimple endomorphism. This is the
diagonalizability behind the eigenvalue description of character values, and it needs no
hypothesis on the field beyond invertibility of `n`. -/
theorem isSemisimple_apply (ρ : Representation k G V) {g : G} {n : ℕ} (hn : (n : k) ≠ 0)
    (hg : g ^ n = 1) : End.IsSemisimple (ρ g) :=
  isSemisimple_of_pow_eq_one hn (by rw [← map_pow, hg, map_one])

/-- **Character values are algebraic integers**: over an algebraically closed field, the value of a
character at an element of finite order is integral over `ℤ`, being a sum of roots of unity. -/
theorem isIntegral_character [IsAlgClosed k] (ρ : Representation k G V) {g : G} {n : ℕ}
    (hn : n ≠ 0) (hg : g ^ n = 1) : IsIntegral ℤ (ρ.character g) := by
  obtain ⟨s, -, hroot, hsum⟩ := exists_multiset_character_eq_sum ρ hg
  rw [hsum]
  exact IsIntegral.multiset_sum fun μ hμ => isIntegral_of_pow_eq_one hn (hroot μ hμ)

/-- **Character values are cyclotomic integers**: if `ζ` is a primitive `n`-th root of unity and
`g ^ n = 1`, then `ρ.character g` lies in the subring `ℤ[ζ]` of the coefficient field. -/
theorem character_mem_adjoin_of_isPrimitiveRoot [IsAlgClosed k] (ρ : Representation k G V) {g : G}
    {ζ : k} {n : ℕ} [NeZero n] (hζ : IsPrimitiveRoot ζ n) (hg : g ^ n = 1) :
    ρ.character g ∈ Algebra.adjoin ℤ ({ζ} : Set k) := by
  obtain ⟨s, -, hroot, hsum⟩ := exists_multiset_character_eq_sum ρ hg
  have hmem : ζ ∈ Algebra.adjoin ℤ ({ζ} : Set k) := Algebra.subset_adjoin rfl
  rw [hsum]
  refine Subalgebra.multiset_sum_mem (Algebra.adjoin ℤ ({ζ} : Set k)) fun μ hμ => ?_
  obtain ⟨i, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one (hroot μ hμ)
  exact Subalgebra.pow_mem _ hmem i

end Field

section Complex

variable {G : Type v} {V : Type w} [Monoid G] [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]

/-- Over `ℂ` a character value at an element of finite order is bounded in absolute value by the
degree of the representation, since it is a sum of `finrank ℂ V` many roots of unity. -/
theorem norm_character_le_finrank (ρ : Representation ℂ G V) {g : G} {n : ℕ} (hn : n ≠ 0)
    (hg : g ^ n = 1) : ‖ρ.character g‖ ≤ finrank ℂ V := by
  obtain ⟨s, hcard, hroot, hsum⟩ := exists_multiset_character_eq_sum ρ hg
  have hmap : s.map (fun μ => ‖μ‖) = s.map (fun _ => (1 : ℝ)) :=
    Multiset.map_congr rfl fun μ hμ => Complex.norm_eq_one_of_pow_eq_one (hroot μ hμ) hn
  calc ‖ρ.character g‖ = ‖s.sum‖ := by rw [hsum]
    _ ≤ (s.map (fun μ => ‖μ‖)).sum := norm_multiset_sum_le s
    _ = finrank ℂ V := by rw [hmap]; simp [hcard]

end Complex

end Representation

namespace FDRep

variable {G : Type v} [Group G] [Finite G]

/-- **Character values are algebraic integers.** For a finite group, every value of the character
of a finite-dimensional complex representation is integral over `ℤ`. -/
theorem isIntegral_character (V : FDRep ℂ G) (g : G) : IsIntegral ℤ (V.character g) :=
  Representation.isIntegral_character V.ρ (isOfFinOrder_of_finite g).orderOf_pos.ne'
    (pow_orderOf_eq_one g)

/-- **Character values are cyclotomic integers.** For a finite group of exponent `e` and a
primitive `e`-th root of unity `ζ`, every value of a complex character lies in `ℤ[ζ]`. -/
theorem character_mem_adjoin_of_isPrimitiveRoot (V : FDRep ℂ G) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ (Monoid.exponent G)) (g : G) :
    V.character g ∈ Algebra.adjoin ℤ ({ζ} : Set ℂ) :=
  haveI : NeZero (Monoid.exponent G) := ⟨Monoid.exponent_ne_zero_of_finite⟩
  Representation.character_mem_adjoin_of_isPrimitiveRoot V.ρ hζ (Monoid.pow_exponent_eq_one g)

/-- Over `ℂ`, a character of a finite group is bounded in absolute value by its degree,
`‖χ(g)‖ ≤ χ(1)`. -/
theorem norm_character_le_finrank (V : FDRep ℂ G) (g : G) : ‖V.character g‖ ≤ finrank ℂ V :=
  Representation.norm_character_le_finrank V.ρ (isOfFinOrder_of_finite g).orderOf_pos.ne'
    (pow_orderOf_eq_one g)

end FDRep

end TauCeti
