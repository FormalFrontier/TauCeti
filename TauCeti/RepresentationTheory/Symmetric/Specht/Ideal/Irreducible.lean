public import Mathlib.RepresentationTheory.Maschke
public import TauCeti.RepresentationTheory.Symmetric.Factorization
public import TauCeti.RepresentationTheory.Symmetric.Specht.Ideal.Basic
public import TauCeti.RingTheory.Semisimple.NilpotentIdeal

/-!
# The Specht ideal is irreducible

For a Young tableau `t` of shape `μ`, the left ideal `ℚ[Sₙ] c_t` generated by the Young
symmetrizer `c_t = a_t b_t` carries an **irreducible** representation of `Sₙ`
(`TauCeti.YoungTableau.isIrreducible_spechtIdealRep`).  This is the Specht module in its ideal
presentation, and the theorem is the one all of its representation theory rests on.

Everything the proof needs is already in place.  The sandwich calculation of
`TauCeti.RepresentationTheory.Symmetric.Factorization` says that `c_t x c_t` is always a rational
multiple of `c_t`, and Maschke's theorem says that `ℚ[Sₙ]` is semisimple.  Take a left ideal
`W ≤ ℚ[Sₙ] c_t` and split into the two cases the sandwich calculation allows.

* If `c_t w = 0` for every `w ∈ W`, then `W` is square-zero: an element of `W` is `a c_t` by
  hypothesis, so a product of two elements of `W` is `a (c_t w) = 0`.  A square-zero left ideal
  of a semisimple ring vanishes (`TauCeti.Submodule.eq_bot_of_forall_mul_eq_zero`), so `W = ⊥`.
* Otherwise `c_t w ≠ 0` for some `w = a c_t ∈ W`, and `c_t w = c_t a c_t` is `κ • c_t` with
  `κ ≠ 0`.  It lies in `W`, hence so does `c_t`, hence so does the whole ideal it generates, and
  `W` is everything.

So `ℚ[Sₙ] c_t` is an atom of the lattice of left ideals, which is exactly simplicity of the
module it carries; the transfer to the language of representations is
`TauCeti.Representation.isIrreducible_ofModule'_iff`.

Running the first case on `W = ℚ[Sₙ] c_t` itself, which is nonzero, shows that the sandwich is
not identically zero: some `c_t a c_t` is a **nonzero** multiple of `c_t`
(`TauCeti.YoungTableau.exists_ne_zero_eq_smul_youngSymmetrizer_mul_mul`).  Whether the scalar
attached to `a = 1` is itself nonzero -- that is, whether `c_t * c_t = (n! / f^μ) • c_t` with the
stated nonzero scalar -- does not follow from the sandwich calculation alone (over `M₂(ℚ)` the
element `e₁₂` sandwiches to a line and squares to zero), and is not proved here.

The statement is made at the `Representation` level, as elsewhere in this repository; the `FDRep`
mirror is available through `FDRep.simple_iff_isIrreducible`, but the ideal `ℚ[Sₙ] c_t` is
not packaged as an object of `FDRep ℚ Sₙ` here, so there is nothing to mirror it onto.

On the one-row and the one-column shape the Specht ideal is a line, by the dimension count of
`TauCeti.RepresentationTheory.Symmetric.Specht.Ideal.Extremes`, so on those shapes this theorem is
visible without any of the above; there is nothing extra to say about them here.  The
identification of this representation with the span of the polytabloids inside the Young
permutation module, and the classification saying that these exhaust the irreducibles of `Sₙ` and
are pairwise non-isomorphic across shapes, are separate targets and are not claimed here.

## Main results

* `TauCeti.YoungTableau.exists_ne_zero_eq_smul_youngSymmetrizer_mul_mul`: the sandwich
  `c_t x c_t` is a nonzero multiple of `c_t` for some `x`.
* `TauCeti.YoungTableau.isAtom_spechtIdeal`: `ℚ[Sₙ] c_t` is an atom of the lattice of left ideals.
* `TauCeti.YoungTableau.isSimpleModule_spechtIdeal`: it is a simple `ℚ[Sₙ]`-module.
* `TauCeti.YoungTableau.isIrreducible_spechtIdealRep`: it is an irreducible representation
  of `Sₙ`.

## References

* [W. Fulton, *Young Tableaux*][fulton1997], Section 7.2, Theorem 5.
* W. Fulton and J. Harris, *Representation Theory: A First Course* (1991), Theorem 4.3.
* [Schur--Weyl roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/SchurWeyl/README.md),
  Layer 4, "irreducibility".
-/

public section

namespace TauCeti

namespace YoungTableau

variable {μ : YoungDiagram}

/-- A left ideal inside the Specht ideal that the Young symmetrizer annihilates is zero: it is
square-zero, because its elements are left multiples of the symmetrizer, and `ℚ[Sₙ]` is
semisimple. -/
private theorem eq_bot_of_forall_youngSymmetrizer_mul_eq_zero (t : YoungTableau μ)
    {W : Submodule (MonoidAlgebra ℚ (Equiv.Perm (Fin μ.card)))
      (MonoidAlgebra ℚ (Equiv.Perm (Fin μ.card)))}
    (hle : W ≤ spechtIdeal t) (h : ∀ w ∈ W, youngSymmetrizer t * w = 0) : W = ⊥ :=
  Submodule.eq_bot_of_forall_mul_eq_zero fun x hx y hy => by
    obtain ⟨a, rfl⟩ := (mem_spechtIdeal_iff t x).mp (hle hx)
    rw [mul_assoc, h y hy, mul_zero]

/-- **The Young symmetrizer does not sandwich to zero**: some `c_t a c_t` is nonzero.  If they all
vanished, the Specht ideal would be square-zero, hence zero, and it is not.  This is the raw form
of `TauCeti.YoungTableau.exists_ne_zero_eq_smul_youngSymmetrizer_mul_mul`, which is the statement
to use. -/
private theorem exists_youngSymmetrizer_mul_mul_ne_zero (t : YoungTableau μ) :
    ∃ a : MonoidAlgebra ℚ (Equiv.Perm (Fin μ.card)),
      youngSymmetrizer t * a * youngSymmetrizer t ≠ 0 := by
  by_contra hall
  push Not at hall
  refine spechtIdeal_ne_bot t
    (eq_bot_of_forall_youngSymmetrizer_mul_eq_zero t le_rfl fun w hw => ?_)
  obtain ⟨a, rfl⟩ := (mem_spechtIdeal_iff t w).mp hw
  rw [← mul_assoc]
  exact hall a

/-- The sharpened form of `TauCeti.YoungTableau.exists_eq_smul_youngSymmetrizer_mul_mul`: for some
element of the group algebra the scalar it sandwiches the Young symmetrizer by is nonzero. -/
theorem exists_ne_zero_eq_smul_youngSymmetrizer_mul_mul (t : YoungTableau μ) :
    ∃ (a : MonoidAlgebra ℚ (Equiv.Perm (Fin μ.card))) (κ : ℚ), κ ≠ 0 ∧
      youngSymmetrizer t * a * youngSymmetrizer t = κ • youngSymmetrizer t := by
  obtain ⟨a, ha⟩ := exists_youngSymmetrizer_mul_mul_ne_zero t
  obtain ⟨κ, hκ⟩ := exists_eq_smul_youngSymmetrizer_mul_mul t a
  exact ⟨a, κ, fun h => ha (by rw [hκ, h, zero_smul]), hκ⟩

/-- **The Specht ideal is an atom of the lattice of left ideals of `ℚ[Sₙ]`**: it is nonzero, and a
left ideal strictly inside it is zero. -/
theorem isAtom_spechtIdeal (t : YoungTableau μ) : IsAtom (spechtIdeal t) := by
  refine ⟨spechtIdeal_ne_bot t, fun W hW => ?_⟩
  by_contra hWne
  -- some element of `W` survives multiplication by the symmetrizer, else `W` is square-zero
  obtain ⟨w, hwW, hcw⟩ : ∃ w ∈ W, youngSymmetrizer t * w ≠ 0 := by
    by_contra hall
    push Not at hall
    exact hWne (eq_bot_of_forall_youngSymmetrizer_mul_eq_zero t hW.le hall)
  -- that element sandwiches the symmetrizer to a nonzero multiple of itself, which lies in `W`
  obtain ⟨a, ha⟩ := (mem_spechtIdeal_iff t w).mp (hW.le hwW)
  obtain ⟨κ, hκ⟩ := exists_eq_smul_youngSymmetrizer_mul_mul t a
  have hcw' : youngSymmetrizer t * w = κ • youngSymmetrizer t := by
    rw [← ha, ← mul_assoc]
    exact hκ
  have hκne : κ ≠ 0 := fun h => hcw (by rw [hcw', h, zero_smul])
  have hmem : κ • youngSymmetrizer t ∈ W := by
    rw [← hcw', ← smul_eq_mul]
    exact W.smul_mem _ hwW
  -- so the symmetrizer itself lies in `W`, and with it the whole ideal it generates
  have hc : youngSymmetrizer t ∈ W := by
    have hinv : κ⁻¹ • (κ • youngSymmetrizer t) ∈ W := by
      rw [← algebraMap_smul (MonoidAlgebra ℚ (Equiv.Perm (Fin μ.card))) κ⁻¹]
      exact W.smul_mem _ hmem
    rwa [smul_smul, inv_mul_cancel₀ hκne, one_smul] at hinv
  exact absurd ((spechtIdeal_le_iff t W).mpr hc) hW.not_ge

/-- **The Specht ideal is a simple `ℚ[Sₙ]`-module.** -/
theorem isSimpleModule_spechtIdeal (t : YoungTableau μ) :
    IsSimpleModule (MonoidAlgebra ℚ (Equiv.Perm (Fin μ.card))) (spechtIdeal t) :=
  isSimpleModule_iff_isAtom.mpr (isAtom_spechtIdeal t)

/-- **The Specht module is irreducible**, in its presentation as the left ideal `ℚ[Sₙ] c_t`. -/
instance isIrreducible_spechtIdealRep (t : YoungTableau μ) :
    (spechtIdealRep t).ρ.IsIrreducible :=
  (Representation.isIrreducible_ofModule'_iff _).mpr (isSimpleModule_spechtIdeal t)

end YoungTableau

end TauCeti
