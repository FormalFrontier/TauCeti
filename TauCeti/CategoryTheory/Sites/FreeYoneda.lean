module

public import Mathlib.CategoryTheory.Sites.SheafCohomology.Basic

/-!
# The free abelian sheaf generated by an object of a site

Mathlib's `CategoryTheory.Sheaf.H' F n U`, the degree-`n` cohomology of an object `U` of a site
`(C, J)` with coefficients in an abelian sheaf `F`, is an `Ext`-group whose source is the
sheafification of the free abelian presheaf on `yoneda.obj U`. This file names that source and
records the universal property that makes it useful: morphisms out of it into an abelian sheaf
`F` are exactly the sections of `F` over `U`.

## Main declarations

* `TauCeti.CategoryTheory.freeYonedaSheafFunctor J`, the functor `C ⥤ Sheaf J AddCommGrpCat`
  sending `U` to the free abelian sheaf `ℤ_U` generated by `yoneda.obj U`;
* `TauCeti.CategoryTheory.freeYonedaSheafHomEquiv`, the bijection between morphisms
  `ℤ_U ⟶ F` and sections of `F` over `U`, together with its naturality in each variable
  (`freeYonedaSheafHomEquiv_naturality_left` and `freeYonedaSheafHomEquiv_naturality_right`);
* `TauCeti.CategoryTheory.H'_eq_ext`, the identification of `Sheaf.H' F n U` with the
  `Ext`-group out of `ℤ_U`, and `TauCeti.CategoryTheory.H'Equiv₀`, the resulting description
  of degree-zero cohomology as sections.

The bijection is the composite of three of Mathlib's adjunctions: sheafification, the free
abelian group functor whiskered into presheaves, and the Yoneda lemma. Degree zero of the
cohomology of an object is therefore its group of sections, and — the reason for this file — a
morphism `U ⟶ V` induces `ℤ_U ⟶ ℤ_V`, which on `Hom(-, F)` is the restriction map of `F`.

This advances `TauCetiRoadmap/JacobianChallenge/README.md`, Layer B, "coherent sheaves and
cohomology `Hⁱ(X, ℱ)`": it is the input to the acyclicity of flasque sheaves in
`TauCeti/Topology/Sheaves/Flasque.lean`. No formalization is vendored.
-/

public section

open CategoryTheory Limits Opposite

universe w v u

namespace TauCeti

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

noncomputable section

section WeakSheafify

variable [HasWeakSheafify J AddCommGrpCat.{v}]

/-- The free abelian sheaf `ℤ_U` generated by an object `U` of a site, as a functor of `U`.

This is the sheafification of the free abelian presheaf on the presheaf of sets `yoneda.obj U`,
the object whose `Ext`-groups into `F` are the cohomology groups `Sheaf.H' F n U`. -/
abbrev freeYonedaSheafFunctor : C ⥤ Sheaf J AddCommGrpCat.{v} :=
  yoneda ⋙ (Functor.whiskeringRight Cᵒᵖ (Type v) AddCommGrpCat.{v}).obj AddCommGrpCat.free ⋙
    presheafToSheaf J AddCommGrpCat.{v}

/-- Morphisms from the free abelian sheaf on `U` to an abelian sheaf `F` are the sections of `F`
over `U`. -/
def freeYonedaSheafHomEquiv (U : C) (F : Sheaf J AddCommGrpCat.{v}) :
    ((freeYonedaSheafFunctor J).obj U ⟶ F) ≃ F.obj.obj (op U) :=
  ((sheafificationAdjunction J AddCommGrpCat.{v}).homEquiv _ _).trans
    (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj.{v}).homEquiv _ _).trans yonedaEquiv)

/-- The bijection `freeYonedaSheafHomEquiv` is natural in the coefficient sheaf. -/
lemma freeYonedaSheafHomEquiv_naturality_right {U : C} {F G : Sheaf J AddCommGrpCat.{v}}
    (f : (freeYonedaSheafFunctor J).obj U ⟶ F) (g : F ⟶ G) :
    freeYonedaSheafHomEquiv J U G (f ≫ g) =
      g.hom.app (op U) (freeYonedaSheafHomEquiv J U F f) := by
  dsimp only [freeYonedaSheafHomEquiv, Equiv.trans_apply]
  rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_right,
    yonedaEquiv_comp]
  rfl

/-- The bijection `freeYonedaSheafHomEquiv` is natural in the object of the site: precomposing
with the map induced by `i : U ⟶ V` is restricting sections along `i`. -/
lemma freeYonedaSheafHomEquiv_naturality_left {U V : C} (i : U ⟶ V)
    (F : Sheaf J AddCommGrpCat.{v}) (f : (freeYonedaSheafFunctor J).obj V ⟶ F) :
    freeYonedaSheafHomEquiv J U F ((freeYonedaSheafFunctor J).map i ≫ f) =
      F.obj.map i.op (freeYonedaSheafHomEquiv J V F f) := by
  dsimp only [freeYonedaSheafHomEquiv, Equiv.trans_apply, Functor.comp_map]
  rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_left,
    ← yonedaEquiv_naturality]
  rfl

end WeakSheafify

section Cohomology

variable [HasSheafify J AddCommGrpCat.{v}] [HasExt.{w} (Sheaf J AddCommGrpCat.{v})]

/-- The cohomology of an object of a site is the `Ext`-group out of the free abelian sheaf that
the object generates. -/
lemma H'_eq_ext (F : Sheaf J AddCommGrpCat.{v}) (n : ℕ) (U : C) :
    _root_.CategoryTheory.Sheaf.H' F n U =
      AddCommGrpCat.of (Abelian.Ext ((freeYonedaSheafFunctor J).obj U) F n) :=
  rfl

/-- In degree zero, the cohomology of an object of a site with coefficients in an abelian sheaf
`F` is the group of sections of `F` over that object. -/
def H'Equiv₀ (F : Sheaf J AddCommGrpCat.{v}) (U : C) :
    _root_.CategoryTheory.Sheaf.H' F 0 U ≃ F.obj.obj (op U) :=
  Abelian.Ext.homEquiv₀.trans (freeYonedaSheafHomEquiv J U F)

end Cohomology

end

end CategoryTheory

end TauCeti
