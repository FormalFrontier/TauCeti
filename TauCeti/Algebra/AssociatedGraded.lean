module

public import Mathlib.LinearAlgebra.Quotient.Bilinear
public import Mathlib.LinearAlgebra.TensorProduct.Submodule
public import Mathlib.Algebra.DirectSum.Algebra
public import TauCeti.Algebra.WordFiltration

/-!
# Associated-graded algebra of a word filtration

This file packages the homogeneous pieces of the word filtration generated by a linear map
`f : M →ₗ[R] A` into a direct-sum associated-graded algebra. Both the Clifford degree filtration
and the PBW filtration of a universal enveloping algebra are instances of this construction.

The construction is independent of the relations in `A`: multiplication on a homogeneous piece
is induced by multiplication in `A`, and changing either representative by an element of strictly
lower degree changes the product by an element of strictly lower total degree.

Its graded-algebra packaging adapts the pattern in Mathlib's
[`TensorPower` construction](https://github.com/leanprover-community/mathlib4/blob/master/Mathlib/LinearAlgebra/TensorPower/Basic.lean).

## Main definitions

* `TauCeti.Algebra.wordFiltration.associatedGraded f`: the direct sum
  `⨁ k, GradedPiece f k` of the homogeneous pieces.
* `TauCeti.Algebra.wordFiltration.gradedMul`: the product of two homogeneous pieces, induced by
  filtered multiplication through `wordFiltration_mul`.
* `TauCeti.Algebra.wordFiltration.gradedOne` and
  `TauCeti.Algebra.wordFiltration.gradedAlgebraMap₀`: the degree-zero unit and the degree-zero
  image of a scalar.

## Main results

* The graded structure instances assembling those pieces:
  `TauCeti.Algebra.wordFiltration.gradedGOne`, `gradedGMul`,
  `gradedGMonoid`, `gradedGRing`, `gradedGSemiring` and
  `gradedGAlgebra`, culminating in
  `TauCeti.Algebra.wordFiltration.associatedGradedRing`, the ring structure on the direct sum.

## Roadmap

This is the associated-graded-algebra prerequisite for the pinned associated-graded map from
`SymmetricAlgebra R L` in Layer 3 of
`TauCetiRoadmap/RepresentationTheory/LieHighestWeight/README.md`. It is stated for an arbitrary
word filtration so the existing Clifford associated-graded construction and the PBW construction
share one implementation.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, Chapter V, §17.
* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapter I, §2.7.

## Implementation notes

`gradedGSemiring` and `associatedGradedRing` are stated explicitly rather than
left to instance search. `DirectSum.GRing` is declared over `[∀ i, AddCommGroup (A i)]`, so
`DirectSum.GRing.toGSemiring` supplies the pointwise `AddCommMonoid` through
`AddCommGroup.toAddCommMonoid`, which does not match the one instance search finds directly for
`GradedPiece`; without these two declarations neither
`DirectSum.GSemiring (GradedPiece f)` nor `Ring (associatedGraded f)` is
synthesizable.
-/

public section

open scoped DirectSum

universe u v w

namespace TauCeti.Algebra.wordFiltration

variable {R : Type u} {M : Type v} {A : Type w}
variable [CommRing R] [AddCommGroup M] [Module R M] [Ring A] [Algebra R A]

/-- The preceding word-filtration step, viewed as a submodule of the current step. -/
abbrev previousRestricted (f : M →ₗ[R] A) (k : ℕ) :
    Submodule R (wordFiltration f k) :=
  (wordFiltrationPrevious f k).submoduleOf (wordFiltration f k)

/-- Membership in the restricted preceding step is ambient membership in the preceding step. -/
@[simp]
theorem mem_previousRestricted_iff (f : M →ₗ[R] A) (k : ℕ)
    (x : wordFiltration f k) :
    x ∈ previousRestricted f k ↔ (x : A) ∈ wordFiltrationPrevious f k :=
  Iff.rfl

/-- The restricted preceding word filtration is trivial in degree zero. -/
@[simp]
theorem previousRestricted_zero (f : M →ₗ[R] A) : previousRestricted f 0 = ⊥ := by
  ext x
  simp

/-- In successor degree, the restricted preceding word filtration is the previous step viewed
inside the current step. -/
@[simp]
theorem previousRestricted_succ (f : M →ₗ[R] A) (k : ℕ) :
    previousRestricted f (k + 1) =
      Submodule.comap (wordFiltration f (k + 1)).subtype (wordFiltration f k) := by
  simp only [previousRestricted, wordFiltrationPrevious_succ, Submodule.submoduleOf]

/-- The degree-`k` quotient of a word filtration by its preceding step. -/
abbrev GradedPiece (f : M →ₗ[R] A) (k : ℕ) : Type w :=
  wordFiltration f k ⧸ previousRestricted f k

/-- The direct sum of the homogeneous pieces of the filtered degree filtration. -/
abbrev associatedGraded (f : M →ₗ[R] A) : Type w :=
  ⨁ k : ℕ, GradedPiece f k

private theorem mul_mem_previous_left (f : M →ₗ[R] A) (i j : ℕ)
    {x y : A} (hx : x ∈ wordFiltrationPrevious f i) (hy : y ∈ wordFiltration f j) :
    x * y ∈ wordFiltrationPrevious f (i + j) := by
  cases i with
  | zero =>
      rw [wordFiltrationPrevious_zero] at hx
      rw [Submodule.mem_bot] at hx
      subst x
      simp
  | succ i =>
      rw [wordFiltrationPrevious_succ] at hx
      rw [Nat.succ_add, wordFiltrationPrevious_succ]
      exact mul_mem_wordFiltration f hx hy

private theorem mul_mem_previous_right (f : M →ₗ[R] A) (i j : ℕ)
    {x y : A} (hx : x ∈ wordFiltration f i) (hy : y ∈ wordFiltrationPrevious f j) :
    x * y ∈ wordFiltrationPrevious f (i + j) := by
  cases j with
  | zero =>
      rw [wordFiltrationPrevious_zero] at hy
      rw [Submodule.mem_bot] at hy
      subst y
      simp
  | succ j =>
      rw [wordFiltrationPrevious_succ] at hy
      rw [Nat.add_succ, wordFiltrationPrevious_succ]
      exact mul_mem_wordFiltration f hx hy

private noncomputable def filteredMul (f : M →ₗ[R] A) (i j : ℕ) :
    wordFiltration f i →ₗ[R] wordFiltration f j →ₗ[R] wordFiltration f (i + j) :=
  TensorProduct.curry
    ((LinearEquiv.ofEq _ _ (wordFiltration_mul f i j)).toLinearMap ∘ₗ
      Submodule.mulMap' (wordFiltration f i) (wordFiltration f j))

private noncomputable def gradedPreMul (f : M →ₗ[R] A) (i j : ℕ) :
    wordFiltration f i →ₗ[R] wordFiltration f j →ₗ[R] GradedPiece f (i + j) :=
  (filteredMul f i j).compr₂ (Submodule.mkQ _)

private theorem gradedPreMul_apply (f : M →ₗ[R] A) (i j : ℕ)
    (x : wordFiltration f i) (y : wordFiltration f j) :
    gradedPreMul f i j x y =
      Submodule.Quotient.mk
        (⟨(x : A) * y, mul_mem_wordFiltration f x.property y.property⟩ :
          wordFiltration f (i + j)) :=
  rfl

private theorem gradedPreMul_mem_ker_left (f : M →ₗ[R] A) (i j : ℕ) :
    previousRestricted f i ≤
      (gradedPreMul f i j).ker := by
  rintro ⟨x, hx⟩ hprevious
  rw [mem_previousRestricted_iff] at hprevious
  rw [LinearMap.mem_ker]
  ext y
  simp only [gradedPreMul_apply, LinearMap.zero_apply]
  rw [Submodule.Quotient.mk_eq_zero]
  rw [mem_previousRestricted_iff]
  -- The filtration product lemma is stated for ambient filtered-algebra elements.
  change (x : A) * (y : A) ∈ wordFiltrationPrevious f (i + j)
  exact mul_mem_previous_left f i j hprevious y.property

private theorem gradedPreMul_mem_ker_right (f : M →ₗ[R] A) (i j : ℕ) :
    previousRestricted f j ≤
      (gradedPreMul f i j).flip.ker := by
  rintro ⟨y, hy⟩ hprevious
  rw [mem_previousRestricted_iff] at hprevious
  rw [LinearMap.mem_ker]
  ext x
  simp only [LinearMap.flip_apply, LinearMap.zero_apply]
  rw [gradedPreMul_apply, Submodule.Quotient.mk_eq_zero]
  rw [mem_previousRestricted_iff]
  -- The filtration product lemma is stated for ambient filtered-algebra elements.
  change (x : A) * (y : A) ∈ wordFiltrationPrevious f (i + j)
  exact mul_mem_previous_right f i j x.property hprevious

/-- Multiplication of two homogeneous pieces of the filtered associated graded algebra. -/
noncomputable def gradedMul (f : M →ₗ[R] A) (i j : ℕ) :
    GradedPiece f i →ₗ[R] GradedPiece f j →ₗ[R]
      GradedPiece f (i + j) :=
  (gradedPreMul f i j).liftQ₂ _ _
    (gradedPreMul_mem_ker_left f i j)
    (gradedPreMul_mem_ker_right f i j)

/-- On quotient representatives, the homogeneous product is induced by filtered multiplication. -/
@[simp]
theorem gradedMul_apply_mk (f : M →ₗ[R] A) (i j : ℕ) (x : wordFiltration f i)
    (y : wordFiltration f j) :
    gradedMul f i j (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk
        (⟨(x : A) * y, mul_mem_wordFiltration f x.property y.property⟩ :
          wordFiltration f (i + j)) :=
  by
  rw [gradedMul, LinearMap.liftQ₂_mk]
  exact gradedPreMul_apply f i j x y

private theorem gradedPiece_cast_mk' (f : M →ₗ[R] A) {i j : ℕ}
    (h : i = j) (x : wordFiltration f i) :
    cast (congrArg (GradedPiece f) h) (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (cast (congrArg (fun k => ↥(wordFiltration f k)) h) x) := by
  subst j
  rfl

private theorem wordFiltration_coe_cast (f : M →ₗ[R] A) {i j : ℕ}
    (h : i = j) (x : wordFiltration f i) :
    ((cast (congrArg (fun k => ↥(wordFiltration f k)) h) x : wordFiltration f j) :
      A) = x := by
  subst j
  rfl

/-- Homogeneous word-filtration multiplication is associative after reindexing degrees. -/
theorem gradedMul_assoc (f : M →ₗ[R] A) (i j k : ℕ)
    (x : GradedPiece f i) (y : GradedPiece f j)
    (z : GradedPiece f k) :
    cast (congrArg (GradedPiece f) (Nat.add_assoc i j k))
      (gradedMul f (i + j) k (gradedMul f i j x y) z) =
      gradedMul f i (j + k) x (gradedMul f j k y z) := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      induction y using Submodule.Quotient.induction_on with
      | _ y =>
          induction z using Submodule.Quotient.induction_on with
          | _ z =>
              simp only [gradedMul_apply_mk]
              rw [gradedPiece_cast_mk' f (Nat.add_assoc i j k)]
              apply (Submodule.Quotient.eq _).mpr
              rw [mem_previousRestricted_iff, Submodule.coe_sub,
                wordFiltration_coe_cast f (Nat.add_assoc i j k)]
              -- Compare the two representatives in the ambient filtered algebra.
              change ((x : A) * y) * z - x * (y * z) ∈
                wordFiltrationPrevious f (i + (j + k))
              rw [mul_assoc, sub_self]
              exact Submodule.zero_mem (wordFiltrationPrevious f (i + (j + k)))

/-- The degree-zero unit of the homogeneous word-filtration pieces. -/
noncomputable def gradedOne (f : M →ₗ[R] A) :
    GradedPiece f 0 :=
  Submodule.Quotient.mk ⟨1, one_mem_wordFiltration f 0⟩

/-- The degree-zero unit is the quotient class of the filtered unit. -/
theorem gradedOne_def (f : M →ₗ[R] A) :
    gradedOne f =
      Submodule.Quotient.mk (⟨1, one_mem_wordFiltration f 0⟩ : wordFiltration f 0) := by
  rfl

/-- The quotient class of the filtered unit is the degree-zero homogeneous unit. -/
@[simp] theorem gradedOne_mk (f : M →ₗ[R] A) :
    Submodule.Quotient.mk (⟨1, one_mem_wordFiltration f 0⟩ : wordFiltration f 0) =
      gradedOne f :=
  (gradedOne_def f).symm

/-- The degree-zero class of a scalar in the associated graded of the word filtration. -/
noncomputable def gradedAlgebraMap₀ (f : M →ₗ[R] A) :
    R →+ GradedPiece f 0 where
  toFun r := Submodule.Quotient.mk
    ⟨algebraMap R (A) r, algebraMap_mem_wordFiltration f r 0⟩
  map_zero' := by simp
  map_add' r s := by
    rw [← Submodule.Quotient.mk_add]
    apply congrArg Submodule.Quotient.mk
    exact Subtype.ext (map_add (algebraMap R (A)) r s)

/-- The degree-zero scalar map is the quotient class of its ambient scalar. -/
theorem gradedAlgebraMap₀_apply (f : M →ₗ[R] A) (r : R) :
    gradedAlgebraMap₀ f r =
      Submodule.Quotient.mk
        (⟨algebraMap R (A) r, algebraMap_mem_wordFiltration f r 0⟩ :
          wordFiltration f 0) := by
  rfl

/-- The quotient class of an ambient scalar is its degree-zero homogeneous class. -/
@[simp] theorem gradedAlgebraMap₀_mk (f : M →ₗ[R] A) (r : R) :
    Submodule.Quotient.mk
      (⟨algebraMap R (A) r, algebraMap_mem_wordFiltration f r 0⟩ :
        wordFiltration f 0) = gradedAlgebraMap₀ f r :=
  (gradedAlgebraMap₀_apply f r).symm

/-- The degree-zero scalar map sends `1` to the homogeneous unit. -/
@[simp] theorem gradedAlgebraMap₀_one (f : M →ₗ[R] A) :
    gradedAlgebraMap₀ f 1 = gradedOne f := by
  -- Expand the two degree-zero representatives to compare their quotient classes;
  -- `map_one` is stated only in the ambient filtered algebra.
  change Submodule.Quotient.mk
      (⟨algebraMap R (A) 1, algebraMap_mem_wordFiltration f 1 0⟩ : wordFiltration f 0) =
    Submodule.Quotient.mk (⟨1, one_mem_wordFiltration f 0⟩ : wordFiltration f 0)
  apply (Submodule.Quotient.eq _).mpr
  rw [mem_previousRestricted_iff]
  -- Quotient equality is ambient membership, the form in which `map_one` applies.
  change algebraMap R (A) 1 - 1 ∈ wordFiltrationPrevious f 0
  rw [map_one, sub_self]
  exact Submodule.zero_mem _

/-- The degree-zero homogeneous unit acts on the left. -/
@[simp] theorem gradedOne_mul (f : M →ₗ[R] A) (k : ℕ)
    (x : GradedPiece f k) :
    gradedMul f 0 k (gradedOne f) x =
      cast (congrArg (GradedPiece f) (Nat.zero_add k).symm) x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      -- Quotient induction supplies representatives, the only stable form to which the
      -- public representative multiplication lemma applies.
      change gradedMul f 0 k (Submodule.Quotient.mk _)
        (Submodule.Quotient.mk x) = _
      rw [gradedMul_apply_mk]
      rw [gradedPiece_cast_mk' f (Nat.zero_add k).symm]
      apply (Submodule.Quotient.eq _).mpr
      rw [mem_previousRestricted_iff, Submodule.coe_sub,
        wordFiltration_coe_cast f (Nat.zero_add k).symm]
      -- Quotient equality is now ambient membership, the form of the filtration product API.
      change (1 : A) * (x : A) - x ∈
        wordFiltrationPrevious f (0 + k)
      rw [one_mul, sub_self]
      exact Submodule.zero_mem (wordFiltrationPrevious f (0 + k))

/-- The degree-zero homogeneous unit acts on the right. -/
@[simp] theorem gradedMul_one (f : M →ₗ[R] A) (k : ℕ)
    (x : GradedPiece f k) :
    gradedMul f k 0 x (gradedOne f) =
      cast (congrArg (GradedPiece f) (Nat.add_zero k).symm) x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      -- Quotient induction supplies representatives, the only stable form to which the
      -- public representative multiplication lemma applies.
      change gradedMul f k 0 (Submodule.Quotient.mk x)
        (Submodule.Quotient.mk _) = _
      rw [gradedMul_apply_mk]
      rw [gradedPiece_cast_mk' f (Nat.add_zero k).symm]
      apply (Submodule.Quotient.eq _).mpr
      rw [mem_previousRestricted_iff, Submodule.coe_sub,
        wordFiltration_coe_cast f (Nat.add_zero k).symm]
      -- Quotient equality is now ambient membership, the form of the filtration product API.
      change (x : A) * 1 - x ∈ wordFiltrationPrevious f (k + 0)
      rw [mul_one, sub_self]
      exact Submodule.zero_mem (wordFiltrationPrevious f (k + 0))

/-- The homogeneous degree-zero class supplies the `GOne` structure on filtration pieces. -/
noncomputable instance gradedGOne {f : M →ₗ[R] A} :
    GradedMonoid.GOne (GradedPiece f) where
  one := gradedOne f

/-- Homogeneous filtration multiplication supplies the `GMul` structure on filtration pieces. -/
noncomputable instance gradedGMul {f : M →ₗ[R] A} :
    GradedMonoid.GMul (GradedPiece f) where
  mul {i j} := fun x y => gradedMul f i j x y

/-- The homogeneous unit and multiplication form a graded monoid of filtration pieces. -/
noncomputable instance gradedGMonoid {f : M →ₗ[R] A} :
    GradedMonoid.GMonoid (GradedPiece f) :=
  { gradedGMul (f := f), gradedGOne (f := f) with
    one_mul := fun x => by
      rcases x with ⟨k, x⟩
      apply Sigma.ext (Nat.zero_add k)
      apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.zero_add k))
      -- The sigma equality is now a homogeneous equality after exposing the GOne and GMul fields.
      change cast (congrArg (GradedPiece f) (Nat.zero_add k))
        (gradedMul f 0 k (gradedOne f) x) = x
      rw [gradedOne_mul]
      simp
    mul_one := fun x => by
      rcases x with ⟨k, x⟩
      apply Sigma.ext (Nat.add_zero k)
      apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.add_zero k))
      -- The sigma equality is now a homogeneous equality after exposing the GOne and GMul fields.
      change cast (congrArg (GradedPiece f) (Nat.add_zero k))
        (gradedMul f k 0 x (gradedOne f)) = x
      rw [gradedMul_one]
      simp
    mul_assoc := fun x y z => by
      rcases x with ⟨i, x⟩
      rcases y with ⟨j, y⟩
      rcases z with ⟨k, z⟩
      apply Sigma.ext (Nat.add_assoc i j k)
      apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.add_assoc i j k))
      exact gradedMul_assoc f i j k x y z }

/-- Bilinearity and scalar casts make the homogeneous pieces a direct-sum graded ring. -/
noncomputable instance gradedGRing {f : M →ₗ[R] A} :
    DirectSum.GRing (GradedPiece f) where
  mul_zero := fun x => (gradedMul f _ _ x).map_zero
  zero_mul := fun x => by
    -- `DirectSum.GRing` states this through `GMul`; expose its declared homogeneous product.
    change gradedMul f _ _ 0 x = 0
    rw [LinearMap.map_zero]
    rfl
  mul_add := fun x y z => (gradedMul f _ _ x).map_add y z
  add_mul := fun x y z => by
    -- `DirectSum.GRing` states this through `GMul`; expose its declared homogeneous product.
    change gradedMul f _ _ (x + y) z =
      gradedMul f _ _ x z + gradedMul f _ _ y z
    rw [LinearMap.map_add]
    rfl
  natCast := fun n => gradedAlgebraMap₀ f n
  natCast_zero := by
    rw [Nat.cast_zero]
    exact map_zero (gradedAlgebraMap₀ f)
  natCast_succ := fun n => by
    -- The cast field is represented by the degree-zero scalar class chosen above.
    change gradedAlgebraMap₀ f ((n + 1 : ℕ) : R) =
      gradedAlgebraMap₀ f (n : R) + gradedOne f
    rw [Nat.cast_succ, map_add]
    rw [gradedAlgebraMap₀_one]
  intCast := fun z => gradedAlgebraMap₀ f z
  intCast_ofNat := fun n => by
    -- Integer casts use the same chosen degree-zero scalar representative.
    change gradedAlgebraMap₀ f ((n : ℤ) : R) = gradedAlgebraMap₀ f (n : R)
    norm_cast
  intCast_negSucc_ofNat := fun n => by
    -- Integer casts use the same chosen degree-zero scalar representative.
    change gradedAlgebraMap₀ f ((Int.negSucc n : ℤ) : R) =
      -gradedAlgebraMap₀ f ((n + 1 : ℕ) : R)
    rw [Int.cast_negSucc, map_neg]

/-- Left multiplication by a degree-zero scalar class is scalar multiplication. -/
@[simp] theorem gradedAlgebraMap₀_mul (f : M →ₗ[R] A) (r : R) (k : ℕ)
    (x : GradedPiece f k) :
    cast (congrArg (GradedPiece f) (Nat.zero_add k))
      (gradedMul f 0 k (gradedAlgebraMap₀ f r) x) = r • x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      -- Quotient induction supplies representatives, the only stable form to which the
      -- public representative multiplication lemma applies.
      change cast (congrArg (GradedPiece f) (Nat.zero_add k))
        (gradedMul f 0 k (Submodule.Quotient.mk _)
          (Submodule.Quotient.mk x)) = r • Submodule.Quotient.mk x
      rw [gradedMul_apply_mk, ← Submodule.Quotient.mk_smul]
      -- The cast needs an ambient membership witness; `wordFiltration_mul` supplies that witness.
      rw [gradedPiece_cast_mk' f (Nat.zero_add k)]
      apply (Submodule.Quotient.eq _).mpr
      rw [mem_previousRestricted_iff, Submodule.coe_sub,
        wordFiltration_coe_cast f (Nat.zero_add k), Submodule.coe_smul]
      change algebraMap R (A) r * (x : A) - r • x ∈
        wordFiltrationPrevious f k
      rw [Algebra.smul_def, sub_self]
      exact Submodule.zero_mem (wordFiltrationPrevious f k)

/-- Degree-zero scalar classes multiply by multiplying their scalars. -/
@[simp 1100] theorem gradedAlgebraMap₀_mul_algebraMap₀ (f : M →ₗ[R] A) (r s : R) :
    gradedMul f 0 0 (gradedAlgebraMap₀ f r)
      (gradedAlgebraMap₀ f s) = gradedAlgebraMap₀ f (r * s) := by
  -- Both scalar classes are quotient representatives, so expose them for the
  -- representative product.
  change gradedMul f 0 0 (Submodule.Quotient.mk _)
    (Submodule.Quotient.mk _) = Submodule.Quotient.mk _
  rw [gradedMul_apply_mk]
  apply (Submodule.Quotient.eq _).mpr
  rw [mem_previousRestricted_iff]
  -- Quotient equality is ambient membership, the form in which `map_mul` applies.
  change algebraMap R (A) r * algebraMap R (A) s -
      algebraMap R (A) (r * s) ∈ wordFiltrationPrevious f 0
  rw [← map_mul, sub_self]
  exact Submodule.zero_mem (wordFiltrationPrevious f 0)

/-- Degree-zero scalar classes commute with homogeneous products after reindexing degrees. -/
theorem gradedAlgebraMap₀_commutes (f : M →ₗ[R] A) (r : R) (k : ℕ)
    (x : GradedPiece f k) :
    cast (congrArg (GradedPiece f)
      ((Nat.zero_add k).trans (Nat.add_zero k).symm))
      (gradedMul f 0 k (gradedAlgebraMap₀ f r) x) =
      gradedMul f k 0 x (gradedAlgebraMap₀ f r) := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      -- Quotient induction provides a representative. Expose the quotient classes so the
      -- representative-product API applies on both sides of the commutation equation.
      change cast (congrArg (GradedPiece f)
        ((Nat.zero_add k).trans (Nat.add_zero k).symm))
        (gradedMul f 0 k (Submodule.Quotient.mk _)
          (Submodule.Quotient.mk x)) =
        gradedMul f k 0 (Submodule.Quotient.mk x) (Submodule.Quotient.mk _)
      rw [gradedMul_apply_mk, gradedMul_apply_mk]
      rw [gradedPiece_cast_mk' f ((Nat.zero_add k).trans (Nat.add_zero k).symm)]
      apply (Submodule.Quotient.eq _).mpr
      rw [mem_previousRestricted_iff, Submodule.coe_sub,
        wordFiltration_coe_cast f ((Nat.zero_add k).trans (Nat.add_zero k).symm)]
      -- Quotient equality is ambient filtration membership; this exposes the coercions needed
      -- for the filtered algebra's scalar-commutation theorem.
      change algebraMap R (A) r * (x : A) -
          x * algebraMap R (A) r ∈ wordFiltrationPrevious f (k + 0)
      rw [Algebra.commutes, sub_self]
      exact Submodule.zero_mem (wordFiltrationPrevious f (k + 0))

/-- Right multiplication by a degree-zero scalar class is scalar multiplication. -/
@[simp] theorem gradedMul_algebraMap₀ (f : M →ₗ[R] A) (r : R) (k : ℕ)
    (x : GradedPiece f k) :
    gradedMul f k 0 x (gradedAlgebraMap₀ f r) = r • x := by
  rw [← gradedAlgebraMap₀_commutes f r k x]
  simpa only [cast_cast, cast_eq] using gradedAlgebraMap₀_mul f r k x

/-- The graded-ring structure supplies the semiring structure needed by the direct sum. -/
noncomputable instance gradedGSemiring {f : M →ₗ[R] A} :
    DirectSum.GSemiring (GradedPiece f) := by
  exact @DirectSum.GRing.toGSemiring ℕ (GradedPiece f) _ _
    (gradedGRing (f := f))

/-- Degree-zero scalar classes make the homogeneous pieces into a graded `R`-algebra. -/
noncomputable instance gradedGAlgebra {f : M →ₗ[R] A} :
    DirectSum.GAlgebra R (GradedPiece f) where
  toFun := gradedAlgebraMap₀ f
  map_one := by
    -- `DirectSum.GAlgebra.map_one` is phrased through the degree-zero `GOne` field.
    change gradedAlgebraMap₀ f 1 = gradedOne f
    exact gradedAlgebraMap₀_one f
  map_mul r s := by
    apply Sigma.ext (Nat.zero_add 0).symm
    apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.zero_add 0).symm)
    -- The scalar product is a degree-zero homogeneous product after this reindexing.
    change cast (congrArg (GradedPiece f) (Nat.zero_add 0).symm)
      (gradedAlgebraMap₀ f (r * s)) =
      gradedMul f 0 0 (gradedAlgebraMap₀ f r)
        (gradedAlgebraMap₀ f s)
    rw [gradedAlgebraMap₀_mul_algebraMap₀]
    simp
  commutes r x := by
    rcases x with ⟨k, x⟩
    apply Sigma.ext ((Nat.zero_add k).trans (Nat.add_zero k).symm)
    apply heq_of_cast_eq
      (congrArg (GradedPiece f) ((Nat.zero_add k).trans (Nat.add_zero k).symm))
    exact gradedAlgebraMap₀_commutes f r k x
  smul_def r x := by
    rcases x with ⟨k, x⟩
    apply Sigma.ext (Nat.zero_add k).symm
    apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.zero_add k).symm)
    -- The sigma-level scalar law reduces to the degree-`k` homogeneous scalar equation.
    change cast (congrArg (GradedPiece f) (Nat.zero_add k).symm) (r • x) =
      gradedMul f 0 k (gradedAlgebraMap₀ f r) x
    symm
    simpa only [cast_cast, cast_eq] using
      congrArg (cast (congrArg (GradedPiece f) (Nat.zero_add k).symm))
        (gradedAlgebraMap₀_mul f r k x)

/-- The direct sum of homogeneous filtration pieces inherits its associated-graded
ring structure. -/
noncomputable instance associatedGradedRing {f : M →ₗ[R] A} :
    Ring (associatedGraded f) := by
  letI : ∀ k, AddCommGroup (GradedPiece f k) := fun _ => inferInstance
  infer_instance

end TauCeti.Algebra.wordFiltration
