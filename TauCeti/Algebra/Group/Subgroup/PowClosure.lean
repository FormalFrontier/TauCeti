module

public import Mathlib.Algebra.Group.Conj
public import Mathlib.Algebra.Group.End
public import Mathlib.Algebra.Group.Subgroup.Map

/-!
# The subgroup generated by the `n`-th powers

For a group `G` and a natural number `n`, the set of `n`-th powers is stable under conjugation,
because `(g x g⁻¹) ^ n = g x ^ n g⁻¹`. The subgroup `Gⁿ` it generates is therefore normal, even
when `G` is not commutative. Together with the commutator subgroup it cuts out the maximal
elementary abelian `n`-quotient of `G`.
-/

public section

/-- The subgroup generated by the `n`-th powers of a group is normal: the set of `n`-th powers
is stable under conjugation. -/
theorem Subgroup.normal_closure_range_pow {G : Type*} [Group G] (n : ℕ) :
    (Subgroup.closure (Set.range fun g : G ↦ g ^ n)).Normal := by
  have hle : ∀ g : G, (Subgroup.closure (Set.range fun x : G ↦ x ^ n)).map
      (MulAut.conj g).toMonoidHom ≤ Subgroup.closure (Set.range fun x : G ↦ x ^ n) := by
    intro g
    rw [MonoidHom.map_closure, Subgroup.closure_le]
    rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    exact Subgroup.subset_closure ⟨g * x * g⁻¹, by simp [conj_pow]⟩
  exact ⟨fun x hx g ↦ hle g ⟨x, hx, rfl⟩⟩
