module

public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Augmentation
public import TauCeti.Algebra.HopfAlgebra.SymmetricAlgebra.Basic

/-!
# The augmentation ideal of a symmetric algebra

The augmentation ideal of `SymmetricAlgebra R M` is the ideal generated by the canonical
degree-one elements `SymmetricAlgebra.ι R M m`. This description is basis-free and applies to an
arbitrary module over an arbitrary commutative ring. In rank one it identifies the augmentation
ideal with the principal ideal generated by `SymmetricAlgebra.ι R R 1`.

The calculation links the generic augmentation Hopf ideal with the coordinate ideals used for
additive groups and vector groups. In rank one, it supplies the coordinate-ideal input for
identifying the explicit `αₚ` quotient with the scheme-theoretic kernel of Frobenius on `𝔾ₐ`.

## Main declarations

* `TauCeti.SymmetricAlgebra.augmentation_toIdeal_eq_span_range_ι`: the augmentation ideal is
  generated by the degree-one generators.
* `TauCeti.SymmetricAlgebra.augmentation_toIdeal_eq_span_singleton_ι_one`: in rank one, the
  augmentation ideal is principal, generated by `ι 1`.
-/

public section

namespace TauCeti

namespace SymmetricAlgebra

universe u v

variable (R : Type u) [CommRing R] (M : Type v) [AddCommMonoid M] [Module R M]

private theorem sub_algebraMap_counit_mem_span_range_ι
    (z : _root_.SymmetricAlgebra R M) :
    z - algebraMap R (_root_.SymmetricAlgebra R M) (Coalgebra.counit (R := R) z) ∈
      Ideal.span (Set.range (_root_.SymmetricAlgebra.ι R M)) := by
  induction z using _root_.SymmetricAlgebra.induction with
  | algebraMap r => simp
  | ι m =>
      simp only [_root_.SymmetricAlgebra.counit_ι, map_zero, sub_zero]
      exact Ideal.subset_span ⟨m, rfl⟩
  | add a b ha hb =>
      rw [map_add, map_add, add_sub_add_comm]
      exact Ideal.add_mem _ ha hb
  | mul a b ha hb =>
      rw [Bialgebra.counit_mul, map_mul]
      have hdecomp :
          a * b -
                algebraMap R (_root_.SymmetricAlgebra R M) (Coalgebra.counit (R := R) a) *
                  algebraMap R (_root_.SymmetricAlgebra R M) (Coalgebra.counit (R := R) b) =
              a * (b - algebraMap R (_root_.SymmetricAlgebra R M)
                (Coalgebra.counit (R := R) b)) +
                (a - algebraMap R (_root_.SymmetricAlgebra R M)
                  (Coalgebra.counit (R := R) a)) *
                  algebraMap R (_root_.SymmetricAlgebra R M)
                    (Coalgebra.counit (R := R) b) := by
        ring
      rw [hdecomp]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ a hb)
        (Ideal.mul_mem_right
          (algebraMap R (_root_.SymmetricAlgebra R M) (Coalgebra.counit (R := R) b)) _ ha)

/-- The underlying ideal of the augmentation Hopf ideal of a symmetric algebra is generated by
the canonical degree-one generators. This description is basis-free and applies to every module
over an arbitrary commutative ring. -/
@[simp 1100]
theorem augmentation_toIdeal_eq_span_range_ι :
    (HopfIdeal.augmentation R (_root_.SymmetricAlgebra R M)).toIdeal =
      Ideal.span (Set.range (_root_.SymmetricAlgebra.ι R M)) := by
  apply le_antisymm
  · intro z hz
    have h := sub_algebraMap_counit_mem_span_range_ι R M z
    have hz' := (HopfIdeal.mem_augmentation R (_root_.SymmetricAlgebra R M)).mp hz
    simpa [hz'] using h
  · rw [Ideal.span_le]
    rintro _ ⟨m, rfl⟩
    exact (HopfIdeal.mem_augmentation R (_root_.SymmetricAlgebra R M)).mpr
      (_root_.SymmetricAlgebra.counit_ι (R := R) (M := M) m)

/-- For the rank-one symmetric algebra `SymmetricAlgebra R R`, the augmentation ideal is the
principal ideal generated by the degree-one coordinate `ι R R 1`. -/
@[simp 1200]
theorem augmentation_toIdeal_eq_span_singleton_ι_one :
    (HopfIdeal.augmentation R (_root_.SymmetricAlgebra R R)).toIdeal =
      Ideal.span {(_root_.SymmetricAlgebra.ι R R 1 : _root_.SymmetricAlgebra R R)} := by
  rw [augmentation_toIdeal_eq_span_range_ι]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨r, rfl⟩
    have hι : (_root_.SymmetricAlgebra.ι R R r : _root_.SymmetricAlgebra R R) =
        algebraMap R (_root_.SymmetricAlgebra R R) r *
          _root_.SymmetricAlgebra.ι R R 1 := by
      calc
        _root_.SymmetricAlgebra.ι R R r =
            _root_.SymmetricAlgebra.ι R R (r • (1 : R)) := by simp
        _ = r • (_root_.SymmetricAlgebra.ι R R 1) := by rw [map_smul]
        _ = algebraMap R (_root_.SymmetricAlgebra R R) r *
              _root_.SymmetricAlgebra.ι R R 1 := Algebra.smul_def _ _
    rw [hι]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le]
    rintro _ (rfl : _ = _root_.SymmetricAlgebra.ι R R 1)
    exact Ideal.subset_span ⟨1, rfl⟩

end SymmetricAlgebra

end TauCeti
