module

public import TauCeti.Algebra.Lie.Sl2.Casimir
-- Non-public: `TauCeti.isIrreducible_iff_isAtom`, `TauCeti.lieSubmoduleOfEqTop` and
-- `TauCeti.lieModuleEquivOfEqTop` are used only inside proofs.
import TauCeti.Algebra.Lie.Submodule.Atom
import TauCeti.Algebra.Lie.Subalgebra.Top

/-!
# A primitive vector generates a copy of `V(n)`

`TauCeti/Algebra/Lie/Sl2/WeightString.lean` and `TauCeti/Algebra/Lie/Sl2/Classification.lean`
classify the modules that are *irreducible* over an `sl₂` triple and carry a primitive vector: they
are the standard modules `V(n)`. That classification says nothing about a primitive vector sitting
inside a larger module. This file supplies the missing statement: over a characteristic-zero field,
in any finite-dimensional module over a Lie algebra generated by an `sl₂` triple, the Lie submodule
generated by a primitive vector of weight `n : ℕ` is already irreducible, hence is a copy of `V(n)`.

This is the rank-one case of the general principle that a highest weight vector of a
finite-dimensional module generates an irreducible highest weight module, and it is what turns an
explicitly exhibited primitive vector into a named summand.

## The argument

The weight string `m, f • m, …, fⁿ • m` spans the submodule generated by `m`
(`TauCeti.lieSpan_singleton_toSubmodule_eq_span`, which reuses
`TauCeti.weightStringSubmodule`), so a vector of the submodule is a combination
`∑ᵢ aᵢ fⁱ • m`. Raising annihilates a string vector once it has climbed past the top,

`eʲ · (fⁱ • m) = 0` for `i < j`  (`TauCeti.pow_toEnd_e_pow_toEnd_f_eq_zero`),

and returns a nonzero multiple of `m` when it climbs exactly to the top,

`eʲ · (fʲ • m) = (∏_{i < j} (i + 1)(n - i)) • m`  (`TauCeti.pow_toEnd_e_pow_toEnd_f_self`).

So applying `eʲ` for the *largest* `j` with `aⱼ ≠ 0` kills every term but one and leaves a nonzero
multiple of `m`. A nonzero Lie submodule of the string therefore contains `m`, hence contains
everything `m` generates: the string is an atom in the lattice of Lie submodules, which is
irreducibility.

## Main results

* `TauCeti.lieSpan_singleton_toSubmodule_eq_span`: the Lie submodule generated by a primitive
  vector is spanned by its weight string.
* `TauCeti.isAtom_lieSpan_singleton` and `TauCeti.isIrreducible_lieSpan_singleton`: that submodule
  is irreducible.
* `TauCeti.finrank_lieSpan_singleton`: it has dimension `n + 1`.
* `TauCeti.weightStringSubmodule_le_eigenspace_sl2Casimir` and
  `TauCeti.iSupIndep_weightStringSubmodule_of_injective`, with their `lieSpan` readings
  `TauCeti.lieSpan_singleton_le_eigenspace_sl2Casimir` and
  `TauCeti.iSupIndep_lieSpan_singleton_of_injective`: the Casimir operator acts on that submodule
  by the scalar attached to the weight, so submodules generated by primitive vectors of distinct
  weights are independent.
* `TauCeti.Sl2Std.nonempty_lieModuleEquiv_lieSpan_singleton`: over `sl (Fin 2) K` it is a copy of
  `V(n)`.

## References

This supports the Clebsch-Gordan item of Layer 0 of
`TauCetiRoadmap/RepresentationTheory/LieHighestWeight/README.md`.

* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §7.2.
-/

public section

namespace TauCeti

open LieModule Module

/-! ### The submodule generated by a primitive vector -/

section Span

variable {K : Type*} [CommRing K]
variable {L : Type*} [LieRing L] [LieAlgebra K L]
variable {M : Type*} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
variable {h e f : L} {t : IsSl2Triple h e f} {m : M} {μ : K}

variable (K L) in
/-- The weight string of `m` lies in the Lie submodule generated by `m`: the span is stable under
the action of `f`, so `Module.End.pow_apply_mem_of_forall_mem` carries `m` along it. -/
private theorem pow_toEnd_f_mem_lieSpan_singleton (f : L) (m : M) (i : ℕ) :
    (toEnd K L M f ^ i) m ∈ (LieSubmodule.lieSpan K L {m}).toSubmodule :=
  Module.End.pow_apply_mem_of_forall_mem i
    (fun _ hx ↦ (LieSubmodule.lieSpan K L {m}).lie_mem hx) m
    (LieSubmodule.subset_lieSpan (R := K) (L := L) (s := {m}) rfl)

/-- **The Lie submodule generated by a primitive vector is spanned by its weight string.** One
inclusion is that each string vector is reached from `m` by lowering; the other is that the weight
string already spans a Lie submodule, namely `TauCeti.weightStringSubmodule`, read for the whole
algebra through `TauCeti.lieSubmoduleOfEqTop`. -/
theorem lieSpan_singleton_toSubmodule_eq_span (htop : t.toLieSubalgebra K = ⊤)
    (P : t.HasPrimitiveVectorWith m μ) :
    (LieSubmodule.lieSpan K L {m}).toSubmodule =
      Submodule.span K (Set.range fun i : ℕ ↦ (toEnd K L M f ^ i) m) := by
  refine le_antisymm ?_ (Submodule.span_le.2 ?_)
  · have hmem : m ∈ lieSubmoduleOfEqTop htop (weightStringSubmodule P) := by
      rw [← LieSubmodule.mem_toSubmodule, lieSubmoduleOfEqTop_toSubmodule,
        LieSubmodule.mem_toSubmodule]
      exact mem_weightStringSubmodule P
    have hle := (LieSubmodule.toSubmodule_le_toSubmodule _ _).2
      (LieSubmodule.lieSpan_le.2 (Set.singleton_subset_iff.2 hmem))
    rwa [lieSubmoduleOfEqTop_toSubmodule, weightStringSubmodule_toSubmodule] at hle
  · rintro _ ⟨i, rfl⟩
    exact pow_toEnd_f_mem_lieSpan_singleton K L f m i

omit [LieAlgebra K L] [LieModule K L M] in
/-- The primitive vector, read as a vector of the Lie submodule it generates. -/
theorem hasPrimitiveVectorWith_lieSpan_singleton (P : t.HasPrimitiveVectorWith m μ)
    (hm : m ∈ LieSubmodule.lieSpan K L {m}) :
    t.HasPrimitiveVectorWith (⟨m, hm⟩ : LieSubmodule.lieSpan K L {m}) μ where
  ne_zero := fun hc ↦ P.ne_zero (congrArg Subtype.val hc)
  lie_h := Subtype.ext (by simpa using P.lie_h)
  lie_e := Subtype.ext (by simpa using P.lie_e)

end Span

/-! ### Irreducibility of the generated submodule -/

section Atom

variable {K : Type*} [Field K] [CharZero K]
variable {L : Type*} [LieRing L] [LieAlgebra K L]
variable {M : Type*} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [IsNoetherian K M]
variable {h e f : L} {t : IsSl2Triple h e f} {m : M} {n : ℕ}

/-- The weight string of a primitive vector of weight `n : ℕ` spans the Lie submodule it generates
already as a family of `n + 1` vectors, the string being zero from step `n + 1` on. -/
theorem lieSpan_singleton_toSubmodule_eq_span_fin (htop : t.toLieSubalgebra K = ⊤)
    (P : t.HasPrimitiveVectorWith m (n : K)) :
    (LieSubmodule.lieSpan K L {m}).toSubmodule =
      Submodule.span K (Set.range fun i : Fin (n + 1) ↦ (toEnd K L M f ^ (i : ℕ)) m) := by
  rw [lieSpan_singleton_toSubmodule_eq_span htop P, span_range_pow_toEnd_f_eq_span_range_fin P]

/-- The ladder coefficients picked up on the way up a weight string of length `n + 1` are nonzero
in characteristic zero. -/
private theorem prod_ladder_ne_zero {j : ℕ} (hjn : j ≤ n) :
    (∏ i ∈ Finset.range j, (((i : K) + 1) * ((n : K) - i))) ≠ 0 := by
  refine Finset.prod_ne_zero_iff.2 fun i hi ↦ mul_ne_zero ?_ ?_
  · have hcast : ((i + 1 : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.2 (by omega)
    push_cast at hcast
    exact hcast
  · have hin : i < n := lt_of_lt_of_le (Finset.mem_range.1 hi) hjn
    exact sub_ne_zero.2 fun hc ↦ absurd (Nat.cast_injective hc.symm) (by omega)

omit [CharZero K] [IsNoetherian K M] in
/-- **Raising a combination of the weight string to the top.** Applying the raising operator `j`
times to `∑ᵢ aᵢ fⁱ • m`, where `j` is above every index with a nonzero coefficient, kills every
term but the `j`-th and leaves a multiple of the primitive vector. -/
private theorem pow_toEnd_e_sum_smul_pow_toEnd_f (P : t.HasPrimitiveVectorWith m (n : K))
    {a : Fin (n + 1) → K} {j : Fin (n + 1)} (hjmax : ∀ i, j < i → a i = 0) :
    (toEnd K L M e ^ (j : ℕ)) (∑ i, a i • (toEnd K L M f ^ (i : ℕ)) m)
      = (a j * ∏ i ∈ Finset.range (j : ℕ), (((i : K) + 1) * ((n : K) - i))) • m := by
  rw [map_sum, Finset.sum_eq_single j]
  · rw [map_smul, pow_toEnd_e_pow_toEnd_f_self P, smul_smul]
  · intro i _ hij
    rcases lt_or_gt_of_ne hij with hlt | hgt
    · rw [map_smul, pow_toEnd_e_pow_toEnd_f_eq_zero P hlt, smul_zero]
    · rw [hjmax i hgt, zero_smul, map_zero]
  · intro hc
    exact absurd (Finset.mem_univ j) hc

omit [CharZero K] [IsNoetherian K M] in
/-- A nonzero family of scalars indexed by `Fin (n + 1)` has a largest index carrying a nonzero
value. -/
private theorem exists_max_ne_zero {a : Fin (n + 1) → K} (ha : a ≠ 0) :
    ∃ j : Fin (n + 1), a j ≠ 0 ∧ ∀ i, j < i → a i = 0 := by
  classical
  obtain ⟨j₀, hj₀⟩ := Function.ne_iff.1 ha
  have hs : {i : Fin (n + 1) | a i ≠ 0}.toFinset.Nonempty := ⟨j₀, by simpa using hj₀⟩
  refine ⟨_, by simpa using Finset.max'_mem _ hs, fun i hi ↦ ?_⟩
  by_contra hc
  exact absurd (Finset.le_max' _ i (by simpa using hc)) (not_le.2 hi)

/-- **A primitive vector generates an irreducible submodule.** For a Lie algebra generated by an
`sl₂` triple, the Lie submodule generated by a primitive vector of weight `n : ℕ` is an atom in
the lattice of Lie submodules. -/
theorem isAtom_lieSpan_singleton (htop : t.toLieSubalgebra K = ⊤)
    (P : t.HasPrimitiveVectorWith m (n : K)) : IsAtom (LieSubmodule.lieSpan K L {m}) := by
  have hm : m ∈ LieSubmodule.lieSpan K L {m} :=
    LieSubmodule.subset_lieSpan (R := K) (L := L) (s := {m}) rfl
  refine ⟨fun hbot ↦ P.ne_zero ?_, fun N hN ↦ ?_⟩
  · rwa [hbot, LieSubmodule.mem_bot] at hm
  -- A nonzero submodule of the string contains a nonzero combination of the string vectors.
  by_contra hne
  obtain ⟨v, hvN, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (p := N.toSubmodule) fun hc ↦ hne ((LieSubmodule.toSubmodule_eq_bot N).1 hc)
  have hvspan : v ∈
      Submodule.span K (Set.range fun i : Fin (n + 1) ↦ (toEnd K L M f ^ (i : ℕ)) m) :=
    lieSpan_singleton_toSubmodule_eq_span_fin htop P ▸ hN.le hvN
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun K).1 hvspan
  -- Raise as many times as the top nonzero coefficient allows: every other term dies.
  obtain ⟨j, hajne, hjmax⟩ := exists_max_ne_zero (a := a) fun hc ↦ hv0 (by rw [← ha, hc]; simp)
  have hprod := prod_ladder_ne_zero (K := K) (n := n) (j := (j : ℕ)) (by omega)
  have hraise : (toEnd K L M e ^ (j : ℕ)) v =
      (a j * ∏ i ∈ Finset.range (j : ℕ), (((i : K) + 1) * ((n : K) - i))) • m :=
    ha ▸ pow_toEnd_e_sum_smul_pow_toEnd_f P hjmax
  -- The resulting multiple of `m` is nonzero, so `m` lies in `N` and `N` is everything.
  have hmN : m ∈ N := by
    have hmem : (toEnd K L M e ^ (j : ℕ)) v ∈ N.toSubmodule :=
      Module.End.pow_apply_mem_of_forall_mem _ (fun _ hx ↦ N.lie_mem hx) v hvN
    rw [hraise] at hmem
    have hsmul := N.toSubmodule.smul_mem (a j * ∏ i ∈ Finset.range (j : ℕ),
      (((i : K) + 1) * ((n : K) - i)))⁻¹ hmem
    rwa [smul_smul, inv_mul_cancel₀ (mul_ne_zero hajne hprod), one_smul] at hsmul
  exact hN.not_ge (LieSubmodule.lieSpan_le.2 (Set.singleton_subset_iff.2 hmN))

/-- **A primitive vector generates an irreducible submodule.** The module-level reading of
`TauCeti.isAtom_lieSpan_singleton`. -/
theorem isIrreducible_lieSpan_singleton (htop : t.toLieSubalgebra K = ⊤)
    (P : t.HasPrimitiveVectorWith m (n : K)) :
    LieModule.IsIrreducible K L (LieSubmodule.lieSpan K L {m}) :=
  (isIrreducible_iff_isAtom _).2 (isAtom_lieSpan_singleton htop P)

/-- **The dimension of the submodule generated by a primitive vector** of weight `n` is `n + 1`,
the length of its weight string. -/
theorem finrank_lieSpan_singleton (htop : t.toLieSubalgebra K = ⊤)
    (P : t.HasPrimitiveVectorWith m (n : K)) :
    finrank K (LieSubmodule.lieSpan K L {m}) = n + 1 :=
  have := isIrreducible_lieSpan_singleton htop P
  finrank_eq_of_hasPrimitiveVectorWith_of_eq_top htop
    (hasPrimitiveVectorWith_lieSpan_singleton P
      (LieSubmodule.subset_lieSpan (R := K) (L := L) (s := {m}) rfl))

end Atom

/-! ### The Casimir operator on the generated submodule -/

section Casimir

variable {K : Type*} [Field K]
variable {L : Type*} [LieRing L] [LieAlgebra K L]
variable {M : Type*} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
variable {h e f : L} {t : IsSl2Triple h e f} {m : M} {n : ℕ}

section

variable [NeZero (2 : K)]

/-- **The Casimir operator acts by a scalar on the weight string of a primitive vector.** It does
so on the primitive vector by `TauCeti.sl2Casimir_apply_of_hasPrimitiveVectorWith`, and it commutes
with the lowering operator that sweeps out the rest of the string. -/
theorem weightStringSubmodule_le_eigenspace_sl2Casimir (P : t.HasPrimitiveVectorWith m (n : K)) :
    (weightStringSubmodule P).toSubmodule
      ≤ Module.End.eigenspace (sl2Casimir K h e f M) ((n : K) * (n + 2) / 2) := by
  have key : ∀ i : ℕ, sl2Casimir K h e f M ((toEnd K L M f ^ i) m)
      = ((n : K) * (n + 2) / 2) • (toEnd K L M f ^ i) m := by
    intro i
    induction i with
    | zero => simpa using sl2Casimir_apply_of_hasPrimitiveVectorWith P
    | succ i ih =>
      rw [pow_succ' (toEnd K L M f), Module.End.mul_apply, toEnd_apply_apply,
        ← lie_f_sl2Casimir t, ih, lie_smul]
  rw [weightStringSubmodule_toSubmodule, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  exact Module.End.mem_eigenspace_iff.2 (key i)

/-- The reading of `TauCeti.weightStringSubmodule_le_eigenspace_sl2Casimir` for the submodule
generated over the whole algebra, which the weight string is when the triple generates it. -/
theorem lieSpan_singleton_le_eigenspace_sl2Casimir (htop : t.toLieSubalgebra K = ⊤)
    (P : t.HasPrimitiveVectorWith m (n : K)) :
    (LieSubmodule.lieSpan K L {m}).toSubmodule
      ≤ Module.End.eigenspace (sl2Casimir K h e f M) ((n : K) * (n + 2) / 2) := by
  rw [lieSpan_singleton_toSubmodule_eq_span htop P, ← weightStringSubmodule_toSubmodule P]
  exact weightStringSubmodule_le_eigenspace_sl2Casimir P

end

variable [CharZero K]

/-- **Primitive vectors of distinct weights have independent weight strings.** The Casimir operator
separates them: it acts on the weight string of a primitive vector of weight `n` by `n(n + 2)/2`,
and those scalars are distinct for distinct weights, so the strings lie in distinct eigenspaces of
a single endomorphism. -/
theorem iSupIndep_weightStringSubmodule_of_injective {ι : Type*} {v : ι → M} {p : ι → ℕ}
    (P : ∀ i, t.HasPrimitiveVectorWith (v i) ((p i : ℕ) : K)) (hp : Function.Injective p) :
    iSupIndep fun i ↦ (weightStringSubmodule (P i)).toSubmodule :=
  ((Module.End.eigenspaces_iSupIndep (sl2Casimir K h e f M)).comp
      (sl2CasimirScalar_injective.comp hp)).mono
    fun i ↦ weightStringSubmodule_le_eigenspace_sl2Casimir (P i)

/-- The reading of `TauCeti.iSupIndep_weightStringSubmodule_of_injective` for the submodules
generated over the whole algebra, which the weight strings are when the triple generates it. -/
theorem iSupIndep_lieSpan_singleton_of_injective {ι : Type*} (htop : t.toLieSubalgebra K = ⊤)
    {v : ι → M} {p : ι → ℕ} (P : ∀ i, t.HasPrimitiveVectorWith (v i) ((p i : ℕ) : K))
    (hp : Function.Injective p) :
    iSupIndep fun i ↦ (LieSubmodule.lieSpan K L {v i}).toSubmodule := by
  have heq : ∀ i, (LieSubmodule.lieSpan K L {v i}).toSubmodule
      = (weightStringSubmodule (P i)).toSubmodule := fun i ↦ by
    rw [lieSpan_singleton_toSubmodule_eq_span htop (P i), weightStringSubmodule_toSubmodule]
  simpa only [heq] using iSupIndep_weightStringSubmodule_of_injective P hp

end Casimir

/-! ### The generated submodule as a copy of `V(n)` -/

namespace Sl2Std

open LieAlgebra

variable {K : Type*} [Field K] [CharZero K]
variable {M : Type*} [AddCommGroup M] [Module K M]
  [LieRingModule (SpecialLinear.sl (Fin 2) K) M] [LieModule K (SpecialLinear.sl (Fin 2) K) M]
  [IsNoetherian K M] {m : M} {n : ℕ}

/-- **A primitive vector of `sl (Fin 2) K` generates a copy of `V(n)`.** The Lie submodule
generated by a primitive vector of weight `n` is irreducible by
`TauCeti.isIrreducible_lieSpan_singleton`, so the classification identifies it with the standard
module. -/
theorem nonempty_lieModuleEquiv_lieSpan_singleton
    (P : (isSl2Triple_single (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1)).HasPrimitiveVectorWith
      m (n : K)) :
    Nonempty ((LieSubmodule.lieSpan K (SpecialLinear.sl (Fin 2) K) {m} :
      Type _) ≃ₗ⁅K, SpecialLinear.sl (Fin 2) K⁆ Sl2Std K n) := by
  have htop := toLieSubalgebra_isSl2Triple_single_eq_top (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1)
  have := isIrreducible_lieSpan_singleton htop P
  have := isIrreducible_of_eq_top
    (M := (LieSubmodule.lieSpan K (SpecialLinear.sl (Fin 2) K) {m} : Type _)) htop
  exact ⟨lieModuleEquivOfEqTop htop (lieModuleEquiv
    (hasPrimitiveVectorWith_lieSpan_singleton P
      (LieSubmodule.subset_lieSpan (R := K) (L := SpecialLinear.sl (Fin 2) K) (s := {m}) rfl)))⟩

end Sl2Std

end TauCeti
