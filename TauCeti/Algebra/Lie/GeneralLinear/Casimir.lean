module

public import TauCeti.Algebra.Lie.GeneralLinear.TraceForm
public import TauCeti.Algebra.Lie.UniversalEnveloping.Basic
public import Mathlib.Algebra.Algebra.Subalgebra.Basic

/-!
# The trace-form Casimir element of `gl n`

For the general linear Lie algebra `gl n R = Matrix n n R`, the invariant nondegenerate form
used by highest-weight theory is the trace form

`B(X, Y) = trace (X * Y)`.

The matrix units `Eᵢⱼ` and `Eⱼᵢ` are dual for this form.  The corresponding Casimir element is

`Ω = ∑ i, ∑ j, ι(Eᵢⱼ) ι(Eⱼᵢ) ∈ U(gl n)`.

This file constructs `TauCeti.glCasimir` and proves that it is central.  Centrality is proved
directly on matrix units: the four terms in the commutator with `Eₐb` cancel in pairs.  Since the
matrix units span `gl n` and the canonical generators span its universal enveloping algebra as an
algebra, this proves commutation with every element of `U(gl n)`.

The next stage of the highest-weight roadmap computes the action of this element on a module
generated by a `gl n` highest-weight vector of weight `μ` as
`∑ i, μ i * (μ i + n - 1 - 2 * i)`.

## Main definitions and results

* `TauCeti.glCasimir`: the trace-form Casimir element of `gl n`.
* `TauCeti.glCasimir_def`: its defining matrix-unit sum.
* `TauCeti.ι_mul_glCasimir`: every canonical Lie generator commutes with `glCasimir`.
* `TauCeti.glCasimir_mem_center`: `glCasimir` is central in `U(gl n)`.
* `TauCeti.representation_glCasimir_apply`: its action on any Lie module is the double-action
  sum `∑ i, ∑ j, ⁅Eᵢⱼ, ⁅Eⱼᵢ, m⁆⁆`.

## References

* R. Goodman and N. R. Wallach, *Symmetry, Representations, and Invariants*, Springer GTM 255
  (2009), Chapter 4.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, Springer GTM 9
  (1972), Section 6.

This is the element-and-centrality part of the trace-form Casimir target in Layer 9 of the
highest-weight roadmap, `TauCetiRoadmap/RepresentationTheory/LieHighestWeight/README.md`.
-/

public section

open Finset UniversalEnvelopingAlgebra

namespace TauCeti

universe u v

attribute [local instance 100] LieRing.ofAssociativeRing

variable (K : Type u) [CommRing K] (n : Type v) [Fintype n] [DecidableEq n]

local notation "Ugl" => UniversalEnvelopingAlgebra K (Matrix n n K)

/-- The trace-form Casimir element of `gl n K`,
`∑ i, ∑ j, ι(Eᵢⱼ) * ι(Eⱼᵢ) ∈ U(gl n K)`.

The two matrix units in each summand are dual for `TauCeti.traceBilinForm K n`, since
`trace (Eᵢⱼ Eₖₗ)` is `1` exactly when `j = k` and `l = i`. -/
noncomputable def glCasimir : Ugl :=
  ∑ i, ∑ j, ι K (Matrix.single i j 1) * ι K (Matrix.single j i 1)

/-- The trace-form Casimir element is its defining sum over pairs of matrix units. -/
theorem glCasimir_def :
    glCasimir K n = ∑ i, ∑ j, ι K (Matrix.single i j 1) * ι K (Matrix.single j i 1) :=
  (rfl)

private theorem lie_single_single (a b i j : n) :
    ⁅Matrix.single a b (1 : K), Matrix.single i j (1 : K)⁆ =
      (if b = i then Matrix.single a j (1 : K) else 0) -
        if j = a then Matrix.single i b (1 : K) else 0 := by
  rw [LieRing.of_associative_ring_bracket]
  by_cases hbi : b = i
  · subst i
    by_cases hja : j = a
    · subst j
      rw [Matrix.single_mul_single_same, Matrix.single_mul_single_same]
      simp
    · rw [Matrix.single_mul_single_same, Matrix.single_mul_single_of_ne (h := hja)]
      simp [hja]
  · by_cases hja : j = a
    · subst j
      rw [Matrix.single_mul_single_of_ne (h := hbi), Matrix.single_mul_single_same]
      simp [hbi]
    · rw [Matrix.single_mul_single_of_ne (h := hbi),
        Matrix.single_mul_single_of_ne (h := hja)]
      simp [hbi, hja]

private theorem ι_lie_single_single (a b i j : n) :
    ι K ⁅Matrix.single a b (1 : K), Matrix.single i j (1 : K)⁆ =
      (if b = i then ι K (Matrix.single a j (1 : K)) else 0) -
        if j = a then ι K (Matrix.single i b (1 : K)) else 0 := by
  rw [lie_single_single]
  by_cases hbi : b = i <;> by_cases hja : j = a <;> simp [hbi, hja]

private theorem ι_single_mul_glCasimir (a b : n) :
    ι K (Matrix.single a b (1 : K)) * glCasimir K n =
      glCasimir K n * ι K (Matrix.single a b (1 : K)) := by
  rw [← sub_eq_zero, glCasimir_def, Finset.mul_sum, Finset.sum_mul,
    ← Finset.sum_sub_distrib]
  simp_rw [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
  have hcomm : ∀ x y : Matrix n n K,
      ι K x * ι K y - ι K y * ι K x = ι K (⁅x, y⁆ : Matrix n n K) :=
    fun x y => by
      simpa using UniversalEnvelopingAlgebra.mul_sub_mul_eq_map_ι_lie
        (AlgHom.id K Ugl) x y
  have hleibniz : ∀ x y : Matrix n n K,
      ι K (Matrix.single a b (1 : K)) * (ι K x * ι K y) -
          ι K x * ι K y * ι K (Matrix.single a b (1 : K)) =
        ι K ⁅Matrix.single a b (1 : K), x⁆ * ι K y +
          ι K x * ι K ⁅Matrix.single a b (1 : K), y⁆ := by
    intro x y
    rw [← hcomm (Matrix.single a b (1 : K)) x,
      ← hcomm (Matrix.single a b (1 : K)) y]
    noncomm_ring
  simp_rw [hleibniz, ι_lie_single_single]
  simp only [sub_mul, zero_mul, mul_sub, mul_zero, ite_mul, mul_ite, add_sub]
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib]
  simp [eq_comm]

/-- Every canonical Lie generator commutes with the trace-form Casimir element of `gl n`. -/
theorem ι_mul_glCasimir (X : Matrix n n K) :
    ι K X * glCasimir K n = glCasimir K n * ι K X := by
  rw [Matrix.matrix_eq_sum_single X, map_sum, Finset.sum_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_sum, Finset.sum_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  have hsingle : Matrix.single i j (X i j) = X i j • Matrix.single i j (1 : K) := by
    rw [Matrix.smul_single, smul_eq_mul, mul_one]
  rw [hsingle, map_smul, smul_mul_assoc, mul_smul_comm,
    ι_single_mul_glCasimir K n i j]

/-- The trace-form Casimir element of `gl n` is central in its universal enveloping algebra. -/
theorem glCasimir_mem_center : glCasimir K n ∈ Subalgebra.center K Ugl := by
  refine Subalgebra.mem_center_iff.mpr fun u => ?_
  induction u using TauCeti.UniversalEnvelopingAlgebra.induction_ι with
  | ι X => exact ι_mul_glCasimir K n X
  | algebraMap r => exact Algebra.commutes r _
  | add x y hx hy => rw [add_mul, mul_add, hx, hy]
  | mul x y hx hy => rw [mul_assoc, hy, ← mul_assoc, hx, mul_assoc]

section Action

variable {M : Type*} [AddCommGroup M] [Module K M]
  [LieRingModule (Matrix n n K) M] [LieModule K (Matrix n n K) M]

/-- The trace-form Casimir acts on a `gl n`-module by the double-action sum
`∑ i, ∑ j, ⁅Eᵢⱼ, ⁅Eⱼᵢ, m⁆⁆`.

This is the computational interface used by the highest-weight eigenvalue calculation: it exposes
the matrix-unit expression while keeping `TauCeti.glCasimir` itself opaque. -/
theorem representation_glCasimir_apply (m : M) :
    TauCeti.UniversalEnvelopingAlgebra.representation K (Matrix n n K) M (glCasimir K n) m =
      ∑ i : n, ∑ j : n,
        ⁅Matrix.single i j (1 : K), ⁅Matrix.single j i (1 : K), m⁆⁆ := by
  rw [glCasimir_def, map_sum, LinearMap.sum_apply]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_sum, LinearMap.sum_apply]
  apply Finset.sum_congr rfl
  intro j _
  rw [map_mul, Module.End.mul_apply,
    TauCeti.UniversalEnvelopingAlgebra.representation_ι_apply,
    TauCeti.UniversalEnvelopingAlgebra.representation_ι_apply]

end Action

end TauCeti
