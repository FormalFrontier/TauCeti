module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Form

/-!
# Admissible lattices over a Kostant integral form

Let `L` be a Lie algebra over `ℚ` and let `U_ℤ = kostantForm e h` be the Kostant integral form
generated by families `e` of root vectors and `h` of Cartan vectors. For a module `V` over
`U(L)` and a vector `v : V`, the **admissible lattice** generated by `v` is the additive subgroup

```text
V_ℤ = U_ℤ • v ⊆ V.
```

This file establishes the divided-power stability needed later in the Chevalley--Demazure
construction: every divided power `eᵢ⁽ⁿ⁾` generating `U_ℤ` carries `V_ℤ` into itself. Defining
root-vector exponentials additionally requires a local-nilpotence or finite-sum hypothesis.

Two things have to be true for `V_ℤ` to deserve the name, and both are proved here. It is stable
under `U_ℤ`, which is immediate from `U_ℤ` being a subring, and it is *full*: its `ℚ`-span is the
whole `U(L)`-submodule generated by `v`, so no direction of that cyclic submodule is lost. For a
cyclic module this is all of `V`. Fullness rests on `span_kostantForm_eq_top` from
`TauCeti/Algebra/Lie/UniversalEnveloping/Kostant/Form.lean`.

What is deliberately *not* claimed is that `V_ℤ` is a finitely generated `ℤ`-module, or that
`U_ℤ` is `ℤ`-free on the Kostant monomials. Both need the integral Poincaré--Birkhoff--Witt
theorem, which the filtration development in
`TauCeti/Algebra/Lie/UniversalEnveloping/Filtration.lean` has not yet reached; spanning is the
half of "integral form" that is available without it.

## Main definitions and results

* `TauCeti.UniversalEnvelopingAlgebra.admissibleLattice`: the lattice `U_ℤ • v`.
* `TauCeti.UniversalEnvelopingAlgebra.smul_mem_admissibleLattice` and
  `TauCeti.UniversalEnvelopingAlgebra.dividedPower_smul_mem_admissibleLattice`: stability under
  the integral form and, in particular, under the divided powers of the root vectors.
* `TauCeti.UniversalEnvelopingAlgebra.admissibleLattice_le_of_stable`: it is the smallest stable
  subgroup containing `v`.
* `TauCeti.UniversalEnvelopingAlgebra.span_admissibleLattice`: its `ℚ`-span is the
  `U(L)`-submodule generated by `v`.
* `TauCeti.UniversalEnvelopingAlgebra.span_admissibleLattice_eq_top`: for a cyclic module it is a
  full lattice.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26 and §27.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
* R. Steinberg, *Lectures on Chevalley Groups*, §2.
-/

public section

universe u v w

namespace TauCeti.UniversalEnvelopingAlgebra

open Set

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type w} {κ : Type*}

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

/-! ## Admissible lattices -/

section Lattice

variable {V : Type v} [AddCommGroup V]
variable [Module (_root_.UniversalEnvelopingAlgebra ℚ L) V]
variable {e : ι → L} {h : κ → L} {v : V}

/-- The **admissible lattice** generated by a vector `v` of a `U(L)`-module over the Kostant
integral form attached to root vectors `e` and Cartan vectors `h`: the additive subgroup of
elements `u • v` with `u` integral.

It is recorded as a `Submodule ℤ V` rather than as a `Submodule (kostantForm e h) V`, because the
statements that matter downstream — stability under the divided powers, and spanning `V` over
`ℚ` — compare it with the ambient rational structure. -/
def admissibleLattice (e : ι → L) (h : κ → L) (v : V) : Submodule ℤ V :=
  (kostantForm e h).toAddSubgroup.toIntSubmodule.map
    ((LinearMap.toSpanSingleton U V v).restrictScalars ℤ)

/-- The admissible lattice consists exactly of the vectors `u • v` for `u` in the integral form:
no `ℤ`-linear combinations beyond those are needed, since the form is closed under addition. -/
@[simp]
theorem mem_admissibleLattice_iff {x : V} :
    x ∈ admissibleLattice e h v ↔ ∃ u ∈ kostantForm e h, u • v = x := by
  simp only [admissibleLattice, Submodule.mem_map, LinearMap.coe_restrictScalars,
    LinearMap.toSpanSingleton_apply]
  constructor
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u, hu, rfl⟩
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u, hu, rfl⟩

/-- The generating vector belongs to its admissible lattice. -/
theorem self_mem_admissibleLattice (e : ι → L) (h : κ → L) (v : V) :
    v ∈ admissibleLattice e h v :=
  mem_admissibleLattice_iff.2 ⟨1, one_mem _, one_smul _ v⟩

/-- **The admissible lattice is stable under the integral form.** -/
theorem smul_mem_admissibleLattice {u : U} (hu : u ∈ kostantForm e h) {x : V}
    (hx : x ∈ admissibleLattice e h v) : u • x ∈ admissibleLattice e h v := by
  obtain ⟨w, hw, rfl⟩ := mem_admissibleLattice_iff.1 hx
  exact mem_admissibleLattice_iff.2 ⟨u * w, mul_mem hu hw, mul_smul u w v⟩

/-- Every Kostant generator — a divided power of a root vector, or a binomial coefficient of a
Cartan vector — carries the admissible lattice into itself. -/
theorem generator_smul_mem_admissibleLattice {u : U} (hu : u ∈ kostantGenerators e h) {x : V}
    (hx : x ∈ admissibleLattice e h v) : u • x ∈ admissibleLattice e h v := by
  rw [mem_kostantGenerators_iff] at hu
  obtain ⟨i, n, rfl⟩ | ⟨i, n, rfl⟩ := hu
  · exact smul_mem_admissibleLattice (dividedPower_mem_kostantForm e h i n) hx
  · exact smul_mem_admissibleLattice (ringChoose_mem_kostantForm e h i n) hx

/-- **The divided powers of the root vectors preserve the admissible lattice.** This is the
stability statement needed before locally finite root-vector exponentials can be defined. -/
theorem dividedPower_smul_mem_admissibleLattice (i : ι) (n : ℕ) {x : V}
    (hx : x ∈ admissibleLattice e h v) :
    Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) • x ∈
      admissibleLattice e h v :=
  smul_mem_admissibleLattice (dividedPower_mem_kostantForm e h i n) hx

/-- The universal property of the admissible lattice: it is contained in a subgroup exactly when
that subgroup contains the whole integral orbit of `v`. -/
theorem admissibleLattice_le_iff {N : Submodule ℤ V} :
    admissibleLattice e h v ≤ N ↔ ∀ u ∈ kostantForm e h, u • v ∈ N := by
  constructor
  · exact fun hN u hu => hN (mem_admissibleLattice_iff.2 ⟨u, hu, rfl⟩)
  · rintro hN x hx
    obtain ⟨u, hu, rfl⟩ := mem_admissibleLattice_iff.1 hx
    exact hN u hu

/-- The zero vector generates the zero lattice. -/
@[simp]
theorem admissibleLattice_zero (e : ι → L) (h : κ → L) :
    admissibleLattice e h (0 : V) = ⊥ := by
  refine le_antisymm (admissibleLattice_le_iff.2 fun u _ => ?_) bot_le
  simp

/-- The admissible lattice of a nonzero vector is nonzero: it contains that vector. So the
construction never degenerates. -/
@[simp]
theorem admissibleLattice_eq_bot_iff : admissibleLattice e h v = ⊥ ↔ v = 0 := by
  refine ⟨fun hv => ?_, fun hv => hv ▸ admissibleLattice_zero e h⟩
  simpa [hv] using self_mem_admissibleLattice e h v

/-- **The admissible lattice is the smallest stable subgroup containing `v`.** Together with
`self_mem_admissibleLattice` and `smul_mem_admissibleLattice` this characterizes it. -/
theorem admissibleLattice_le_of_stable {N : Submodule ℤ V} (hv : v ∈ N)
    (hN : ∀ u ∈ kostantForm e h, ∀ x ∈ N, u • x ∈ N) : admissibleLattice e h v ≤ N :=
  admissibleLattice_le_iff.2 fun u hu => hN u hu v hv

/-- The admissible lattice sits inside the `U(L)`-submodule generated by `v`, of which
`span_admissibleLattice` shows it is a full sublattice. -/
theorem admissibleLattice_le_restrictScalars (e : ι → L) (h : κ → L) (v : V) :
    admissibleLattice e h v ≤ (Submodule.span U {v}).restrictScalars ℤ :=
  admissibleLattice_le_iff.2 fun u _ =>
    Submodule.smul_mem _ u (Submodule.mem_span_singleton_self v)

/-- The admissible lattice of the identity in the regular module is the integral form itself. -/
theorem admissibleLattice_one (e : ι → L) (h : κ → L) :
    admissibleLattice e h (1 : U) = (kostantForm e h).toAddSubgroup.toIntSubmodule := by
  refine SetLike.ext' ?_
  rw [AddSubgroup.coe_toIntSubmodule]
  ext x
  simp [mem_admissibleLattice_iff, eq_comm]

/-- A `U(L)`-linear map carries admissible lattices to admissible lattices. -/
theorem map_admissibleLattice {W : Type*} [AddCommGroup W]
    [Module (_root_.UniversalEnvelopingAlgebra ℚ L) W] (f : V →ₗ[U] W) (v : V) :
    (admissibleLattice e h v).map (f.restrictScalars ℤ) = admissibleLattice e h (f v) := by
  rw [admissibleLattice, admissibleLattice, ← Submodule.map_comp]
  congr 1
  ext u
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_restrictScalars,
    LinearMap.toSpanSingleton_apply, f.map_smul]

section Rational

variable [Module ℚ V] [IsScalarTower ℚ (_root_.UniversalEnvelopingAlgebra ℚ L) V]

/-- **The admissible lattice is full.** Whenever the integral form spans the enveloping algebra
over `ℚ` — which `span_kostantForm_eq_top` supplies from a Lie generating set — the `ℚ`-span of
`U_ℤ • v` is the whole `U(L)`-submodule generated by `v`.

So passing from `U(L) • v` to `U_ℤ • v` loses no direction of the cyclic submodule generated by
`v`. -/
theorem span_admissibleLattice (hspan : Submodule.span ℚ (kostantForm e h : Set U) = ⊤)
    (v : V) :
    Submodule.span ℚ (admissibleLattice e h v : Set V) =
      (Submodule.span U {v}).restrictScalars ℚ := by
  have hlattice : (admissibleLattice e h v : Set V) =
      (LinearMap.toSpanSingleton U V v).restrictScalars ℚ '' (kostantForm e h : Set U) := by
    apply Set.ext
    intro x
    rw [Set.mem_image]
    exact mem_admissibleLattice_iff
  rw [hlattice, Submodule.span_image, hspan, Submodule.map_top,
    LinearMap.span_singleton_eq_range, LinearMap.range_restrictScalars]

/-- For a cyclic module — one generated by `v` over `U(L)`, as a highest weight module is
generated by a highest weight vector — the admissible lattice spans the whole module over `ℚ`. -/
theorem span_admissibleLattice_eq_top (e : ι → L) (h : κ → L)
    (hgen : LieSubalgebra.lieSpan ℚ L (range e ∪ range h) = ⊤) (v : V)
    (hv : Submodule.span U {v} = ⊤) :
    Submodule.span ℚ (admissibleLattice e h v : Set V) = ⊤ := by
  rw [span_admissibleLattice (span_kostantForm_eq_top e h hgen) v, hv]
  exact Submodule.restrictScalars_top ℚ U V

end Rational

end Lattice

end TauCeti.UniversalEnvelopingAlgebra
