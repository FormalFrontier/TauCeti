module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Functoriality
public import TauCeti.RingTheory.DividedPowers.Associative
public import Mathlib.RingTheory.Binomial

/-!
# The Kostant integral form generated by root and Cartan vectors

Let `L` be a Lie algebra over `ℚ`. Given families `e : ι → L` of root vectors and
`h : κ → L` of Cartan vectors, the associated **Kostant integral form** is the subring of
`UniversalEnvelopingAlgebra ℚ L` generated by

```text
eᵢ⁽ⁿ⁾ = eᵢⁿ / n!       and       (hⱼ choose n)
```

for all indices and all natural numbers `n`. For a Chevalley basis, this is the usual Kostant
`ℤ`-form. The definition in this file deliberately takes the two distinguished families as data:
the later Chevalley construction will supply them from a pinned root datum, while the integral-form
construction and its functoriality do not use the Chevalley relations.

The divided powers are `TauCeti.Associative.dividedPower`. The Cartan generators are Mathlib's
`Ring.choose`, which evaluates the descending Pochhammer polynomial and divides by `n!`; no second
binomial-coefficient API is introduced here. The form is a `Subring`, rather than a `ℚ`-subalgebra,
because multiplication by arbitrary rational scalars would destroy the integral lattice.

The main result is exact functoriality: a Lie homomorphism sends the form generated by `(e, h)`
onto the form generated by their images. Consequently a Lie equivalence restricts to a ring
equivalence of the corresponding integral forms. This is the transport needed when an isomorphism
of pinned root data acts on Chevalley generators.

## Main definitions and results

* `TauCeti.UniversalEnvelopingAlgebra.kostantForm`: the generated integral form.
* `TauCeti.UniversalEnvelopingAlgebra.kostantForm_le_iff`: its universal property.
* `TauCeti.UniversalEnvelopingAlgebra.map_kostantForm`: exact functoriality under Lie maps.
* `TauCeti.UniversalEnvelopingAlgebra.kostantFormMap`: the restricted map of integral forms.
* `TauCeti.UniversalEnvelopingAlgebra.kostantFormEquiv`: transport under a Lie equivalence.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

open Set

universe u v w

variable {L : Type u} {M : Type v}
variable [LieRing L] [LieAlgebra ℚ L]
variable [LieRing M] [LieAlgebra ℚ M]
variable {ι : Type w} {κ : Type*}

/-- The nonnegative-rational scalar action used to form divided powers over `ℚ`. -/
noncomputable local instance kostantFormModuleNNRat :
    Module ℚ≥0 (_root_.UniversalEnvelopingAlgebra ℚ L) :=
  Module.compHom _ (algebraMap ℚ≥0 ℚ)

/-! ## Generators and the integral form -/

/-- The divided powers of a specified family of root vectors in the universal enveloping algebra. -/
def kostantRootGenerators (e : ι → L) :
    Set (_root_.UniversalEnvelopingAlgebra ℚ L) :=
  range fun p : ι × ℕ =>
    Associative.dividedPower p.2 (_root_.UniversalEnvelopingAlgebra.ι ℚ (e p.1))

/-- The binomial coefficients of a specified family of Cartan vectors in the universal enveloping
algebra. Mathlib's `Ring.choose x n` is `x * (x - 1) * ... * (x - n + 1) / n!`. -/
def kostantCartanGenerators (h : κ → L) :
    Set (_root_.UniversalEnvelopingAlgebra ℚ L) :=
  range fun p : κ × ℕ => Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (h p.1)) p.2

/-- The generators of the Kostant integral form attached to root vectors `e` and Cartan vectors
`h`: all divided powers of the former and all binomial coefficients of the latter. -/
def kostantGenerators (e : ι → L) (h : κ → L) :
    Set (_root_.UniversalEnvelopingAlgebra ℚ L) :=
  kostantRootGenerators e ∪ kostantCartanGenerators h

/-- The **Kostant integral form** generated by specified root and Cartan vectors.

When these vectors come from a Chevalley basis, this is the usual `ℤ`-form inside the universal
enveloping algebra. It is represented as the smallest subring containing the divided powers of
the root vectors and the binomial coefficients of the Cartan vectors. -/
def kostantForm (e : ι → L) (h : κ → L) :
    Subring (_root_.UniversalEnvelopingAlgebra ℚ L) :=
  Subring.closure (kostantGenerators e h)

/-- A divided power of a designated root vector is one of the root-generator elements. -/
theorem dividedPower_mem_kostantRootGenerators (e : ι → L) (i : ι) (n : ℕ) :
    Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) ∈
      kostantRootGenerators e :=
  ⟨(i, n), rfl⟩

/-- A binomial coefficient of a designated Cartan vector is one of the Cartan-generator
elements. -/
theorem choose_mem_kostantCartanGenerators (h : κ → L) (i : κ) (n : ℕ) :
    Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (h i)) n ∈
      kostantCartanGenerators h :=
  ⟨(i, n), rfl⟩

/-- Every divided power of a designated root vector belongs to the Kostant form. -/
@[simp]
theorem dividedPower_mem_kostantForm (e : ι → L) (h : κ → L) (i : ι) (n : ℕ) :
    Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) ∈
      kostantForm e h :=
  Subring.subset_closure <| Or.inl (dividedPower_mem_kostantRootGenerators e i n)

/-- Every binomial coefficient of a designated Cartan vector belongs to the Kostant form. -/
@[simp]
theorem choose_mem_kostantForm (e : ι → L) (h : κ → L) (i : κ) (n : ℕ) :
    Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (h i)) n ∈ kostantForm e h :=
  Subring.subset_closure <| Or.inr (choose_mem_kostantCartanGenerators h i n)

/-- Each designated root vector itself belongs to the Kostant form. -/
theorem rootVector_mem_kostantForm (e : ι → L) (h : κ → L) (i : ι) :
    _root_.UniversalEnvelopingAlgebra.ι ℚ (e i) ∈ kostantForm e h := by
  simpa using dividedPower_mem_kostantForm e h i 1

/-- Each designated Cartan vector itself belongs to the Kostant form. -/
theorem cartanVector_mem_kostantForm (e : ι → L) (h : κ → L) (i : κ) :
    _root_.UniversalEnvelopingAlgebra.ι ℚ (h i) ∈ kostantForm e h := by
  simpa using choose_mem_kostantForm e h i 1

/-- The universal property of the Kostant form: it lies in a subring exactly when that subring
contains every root divided power and every Cartan binomial coefficient. -/
@[simp]
theorem kostantForm_le_iff (e : ι → L) (h : κ → L)
    (S : Subring (_root_.UniversalEnvelopingAlgebra ℚ L)) :
    kostantForm e h ≤ S ↔
      (∀ i n, Associative.dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) ∈ S) ∧
      (∀ i n, Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (h i)) n ∈ S) := by
  rw [kostantForm, Subring.closure_le]
  constructor
  · intro hS
    exact ⟨fun i n => hS (Or.inl ⟨(i, n), rfl⟩),
      fun i n => hS (Or.inr ⟨(i, n), rfl⟩)⟩
  · rintro ⟨he, hh⟩ x (hx | hx)
    · obtain ⟨⟨i, n⟩, rfl⟩ := hx
      exact he i n
    · obtain ⟨⟨i, n⟩, rfl⟩ := hx
      exact hh i n

/-! ## Functoriality -/

variable (f : LieHom ℚ L M)

/-- A Lie homomorphism maps the root generators to the root generators of the image family. -/
theorem image_kostantRootGenerators (e : ι → L) :
    (map ℚ f) '' kostantRootGenerators e =
      kostantRootGenerators (fun i => f (e i)) := by
  ext x
  constructor
  · rintro ⟨_, ⟨⟨i, n⟩, rfl⟩, rfl⟩
    exact ⟨(i, n), by simp⟩
  · rintro ⟨⟨i, n⟩, rfl⟩
    refine ⟨Associative.dividedPower n
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)), ⟨(i, n), rfl⟩, ?_⟩
    simp

/-- A Lie homomorphism maps the Cartan generators to the Cartan generators of the image family. -/
theorem image_kostantCartanGenerators (h : κ → L) :
    (map ℚ f) '' kostantCartanGenerators h =
      kostantCartanGenerators (fun i => f (h i)) := by
  ext x
  constructor
  · rintro ⟨_, ⟨⟨i, n⟩, rfl⟩, rfl⟩
    exact ⟨(i, n), by simp [Ring.map_choose]⟩
  · rintro ⟨⟨i, n⟩, rfl⟩
    refine ⟨Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (h i)) n,
      ⟨(i, n), rfl⟩, ?_⟩
    simp [Ring.map_choose]

/-- A Lie homomorphism maps the full Kostant generator set onto the generator set of the image
families. -/
theorem image_kostantGenerators (e : ι → L) (h : κ → L) :
    (map ℚ f) '' kostantGenerators e h =
      kostantGenerators (fun i => f (e i)) (fun i => f (h i)) := by
  rw [kostantGenerators, image_union, image_kostantRootGenerators,
    image_kostantCartanGenerators, kostantGenerators]

/-- **Exact functoriality of the Kostant form.** The enveloping-algebra map induced by a Lie
homomorphism sends the integral form generated by `(e, h)` onto the integral form generated by
their pointwise images. -/
theorem map_kostantForm (e : ι → L) (h : κ → L) :
    (kostantForm e h).map (map ℚ f).toRingHom =
      kostantForm (fun i => f (e i)) (fun i => f (h i)) := by
  rw [kostantForm, RingHom.map_closure, kostantForm]
  exact congrArg Subring.closure (image_kostantGenerators f e h)

/-- The restriction of an enveloping-algebra map to the corresponding Kostant integral forms. -/
noncomputable def kostantFormMap (e : ι → L) (h : κ → L) :
    kostantForm e h →+* kostantForm (fun i => f (e i)) (fun i => f (h i)) := by
  refine ((map ℚ f).toRingHom.comp (kostantForm e h).subtype).codRestrict _ ?_
  intro x
  rw [← map_kostantForm f e h]
  exact ⟨x, x.property, rfl⟩

/-- The restricted map agrees with the enveloping-algebra map on underlying elements. -/
@[simp]
theorem coe_kostantFormMap_apply (e : ι → L) (h : κ → L) (x : kostantForm e h) :
    (kostantFormMap f e h x : _root_.UniversalEnvelopingAlgebra ℚ M) = map ℚ f x :=
  by
    rw [kostantFormMap]
    rfl

/-- The restricted map is onto the form generated by the image families. No surjectivity
hypothesis on the ambient Lie homomorphism is needed, since the target families are its images. -/
theorem kostantFormMap_surjective (e : ι → L) (h : κ → L) :
    Function.Surjective (kostantFormMap f e h) := by
  intro y
  have hy : (y : _root_.UniversalEnvelopingAlgebra ℚ M) ∈
      (kostantForm e h).map (map ℚ f).toRingHom := by
    rw [map_kostantForm f e h]
    exact y.property
  obtain ⟨x, hx, hxy⟩ := hy
  exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩

/-- A Lie equivalence restricts to a ring equivalence between the Kostant forms generated by a
family and by its pointwise image. -/
noncomputable def kostantFormEquiv (g : LieEquiv ℚ L M) (e : ι → L) (h : κ → L) :
    kostantForm e h ≃+* kostantForm (fun i => g (e i)) (fun i => g (h i)) :=
  let F := (map ℚ g.toLieHom).toRingHom
  let hF : Function.Injective F :=
    map_injective_of_leftInverse ℚ g.toLieHom g.symm.toLieHom (by
      apply LieHom.ext
      exact g.symm_apply_apply)
  ((kostantForm e h).equivMapOfInjective F hF).trans
    (RingEquiv.subringCongr (map_kostantForm g.toLieHom e h))

/-- The restricted equivalence acts by the enveloping-algebra map induced by the original Lie
equivalence. -/
@[simp]
theorem coe_kostantFormEquiv_apply (g : LieEquiv ℚ L M) (e : ι → L) (h : κ → L)
    (x : kostantForm e h) :
    (kostantFormEquiv g e h x : _root_.UniversalEnvelopingAlgebra ℚ M) =
      map ℚ g.toLieHom x := by
  rw [kostantFormEquiv, RingEquiv.trans_apply, RingEquiv.coe_subringCongr_apply,
    Subring.coe_equivMapOfInjective_apply]
  exact congrFun (AlgHom.coe_toRingHom (map ℚ g.toLieHom)) x

end TauCeti.UniversalEnvelopingAlgebra
