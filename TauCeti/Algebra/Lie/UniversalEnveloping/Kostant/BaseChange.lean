module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Filtration
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Form
public import TauCeti.RingTheory.Subring.Basic
public import TauCeti.RingTheory.Subring.RationalBaseChange

/-!
# The Kostant form is an integral form of the enveloping algebra

Let `L` be a Lie algebra over `ℚ` and let `e : ι → L` and `h : κ → L` be the two distinguished
families out of which `TauCeti.UniversalEnvelopingAlgebra.kostantForm` is built. This file proves
that, as soon as those families generate `L` as a Lie algebra, the resulting subring is an integral
form of the whole enveloping algebra: its `ℚ`-span is everything, and extending its scalars to `ℚ`
recovers `U(L)`,

```text
ℚ ⊗[ℤ] kostantForm e h ≃ₐ[ℚ] UniversalEnvelopingAlgebra ℚ L.
```

The generation hypothesis is exactly what the Chevalley--Demazure construction supplies: there `e`
runs over the root vectors of a Chevalley basis and `h` over the Cartan generators, and those
together generate a split semisimple Lie algebra.

The argument is short because the Kostant form is a *subring*, not merely a subgroup: its `ℚ`-span
is therefore a subalgebra, and it is enough to see that the span contains the canonical image of
`L`. That image is a Lie subalgebra of `L` pulled back along `UniversalEnvelopingAlgebra.ι`, since
the bracket of the enveloping algebra is its ring commutator, so the generation hypothesis puts all
of `L` inside it; the canonical generators then generate `U(L)` as an algebra, which is
`TauCeti.UniversalEnvelopingAlgebra.adjoin_range_ι`.

Nothing here bounds the form from the other side. That the form is a *free* `ℤ`-module on the
ordered monomials in divided powers, the integral Poincaré--Birkhoff--Witt theorem, is a separate
statement and is not proved here; the results below say only that the form rationally spans the
enveloping algebra and allows denominators to be cleared.

## Main definitions

* `TauCeti.UniversalEnvelopingAlgebra.kostantFormBaseChange`: the isomorphism
  `ℚ ⊗[ℤ] kostantForm e h ≃ₐ[ℚ] UniversalEnvelopingAlgebra ℚ L`.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.adjoin_kostantForm_eq_top`: the Kostant form generates the
  enveloping algebra as a `ℚ`-algebra.
* `TauCeti.UniversalEnvelopingAlgebra.span_kostantForm_eq_top`: its `ℚ`-span is everything.
* `TauCeti.UniversalEnvelopingAlgebra.exists_natCast_smul_mem_kostantForm`: every element of the
  enveloping algebra is carried into the form by a nonzero natural number.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

open scoped TensorProduct

universe u w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type w} {κ : Type*}

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

local notation "ιU" => (_root_.UniversalEnvelopingAlgebra.ι ℚ : L →ₗ⁅ℚ⁆ U)

attribute [local instance 100] LieRing.ofAssociativeRing

variable (e : ι → L) (h : κ → L)

/-- The `ℚ`-subalgebra generated by the Kostant form is the whole enveloping algebra, as soon as
the distinguished families generate `L` as a Lie algebra. -/
theorem adjoin_kostantForm_eq_top
    (hgen : LieSubalgebra.lieSpan ℚ L (Set.range e ∪ Set.range h) = ⊤) :
    Algebra.adjoin ℚ (kostantForm e h : Set U) = ⊤ := by
  set S : Subalgebra ℚ U := Algebra.adjoin ℚ (kostantForm e h : Set U)
  -- The elements of `L` landing in `S` form a Lie subalgebra: the bracket of `U(L)` is its ring
  -- commutator, so a subalgebra of `U(L)` is closed under it.
  have hspan : LieSubalgebra.lieSpan ℚ L (Set.range e ∪ Set.range h) ≤
      (lieSubalgebraOfSubalgebra ℚ U S).comap ιU := by
    rw [LieSubalgebra.lieSpan_le]
    rintro x (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact Algebra.subset_adjoin (rootVector_mem_kostantForm e h i)
    · exact Algebra.subset_adjoin (cartanVector_mem_kostantForm e h i)
  rw [hgen] at hspan
  have hrange : Set.range ⇑ιU ⊆ (S : Set U) := by
    rintro _ ⟨x, rfl⟩
    exact hspan (LieSubalgebra.mem_top x)
  refine top_le_iff.mp ?_
  rw [← adjoin_range_ι ℚ L]
  exact Algebra.adjoin_le hrange

/-- The `ℚ`-span of the Kostant form is the whole enveloping algebra. Because the form is a
subring, its span is already a subalgebra, so this is the previous theorem restated. -/
theorem span_kostantForm_eq_top
    (hgen : LieSubalgebra.lieSpan ℚ L (Set.range e ∪ Set.range h) = ⊤) :
    Submodule.span ℚ (kostantForm e h : Set U) = ⊤ := by
  rw [← TauCeti.Subring.toSubmodule_adjoin_coe (S := ℚ), adjoin_kostantForm_eq_top e h hgen]
  simp

/-- **The Kostant form is an integral form of the enveloping algebra.** Extending its scalars from
`ℤ` to `ℚ` recovers `U(L)`. -/
noncomputable def kostantFormBaseChange
    (hgen : LieSubalgebra.lieSpan ℚ L (Set.range e ∪ Set.range h) = ⊤) :
    ℚ ⊗[ℤ] (kostantForm e h) ≃ₐ[ℚ] U :=
  TauCeti.Subring.ratBaseChangeEquiv _ (span_kostantForm_eq_top e h hgen)

@[simp]
theorem kostantFormBaseChange_tmul
    (hgen : LieSubalgebra.lieSpan ℚ L (Set.range e ∪ Set.range h) = ⊤)
    (q : ℚ) (x : kostantForm e h) :
    kostantFormBaseChange e h hgen (q ⊗ₜ[ℤ] x) = q • (x : U) := by
  exact TauCeti.Subring.ratBaseChangeEquiv_tmul _ _ q x

/-- The Kostant form allows denominators to be cleared: every element of the enveloping algebra is
carried into it by some nonzero natural number. -/
theorem exists_natCast_smul_mem_kostantForm
    (hgen : LieSubalgebra.lieSpan ℚ L (Set.range e ∪ Set.range h) = ⊤) (u : U) :
    ∃ n : ℕ, n ≠ 0 ∧ (n : ℚ) • u ∈ kostantForm e h :=
  TauCeti.Subring.exists_natCast_smul_mem _ (span_kostantForm_eq_top e h hgen) u

end TauCeti.UniversalEnvelopingAlgebra
