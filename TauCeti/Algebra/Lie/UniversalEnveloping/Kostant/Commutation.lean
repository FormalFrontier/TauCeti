module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Commutation
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Form

/-!
# Cartan/root commutation in the Kostant integral form

The Cartan/root normal-ordering formulas in
`TauCeti.Algebra.Lie.UniversalEnveloping.Commutation` replace a Cartan coefficient
`(h choose m)` by an integer translate `(h ± nz choose m)`. This file proves the integrality
step needed to use those formulas inside a Kostant form: every such translate belongs to the
subring generated by the original Cartan coefficients.

Thus the reordered factors in
`TauCeti.UniversalEnvelopingAlgebra.ringChoose_ι_mul_dividedPower_ι` and
`TauCeti.UniversalEnvelopingAlgebra.dividedPower_ι_mul_ringChoose_ι` remain in the same Kostant
form. Root/root normal ordering and the integral PBW basis remain separate steps.

## Main result

* `TauCeti.UniversalEnvelopingAlgebra.ringChoose_ι_add_intCast_mem_kostantForm`: every integer
  translate of a designated Cartan binomial coefficient belongs to the Kostant form.
* `TauCeti.UniversalEnvelopingAlgebra.ringChoose_ι_sub_intCast_mem_kostantForm`: the subtraction
  form used by the reverse normal-ordering formula.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

attribute [local instance] TauCeti.moduleNNRat

/-- Every integer translate of a designated Cartan binomial coefficient belongs to the Kostant
integral form. This is the integrality statement for the shifted coefficients produced by
Cartan/root normal ordering. -/
theorem ringChoose_ι_add_intCast_mem_kostantForm {I : Type v} {J : Type w}
    (e : I → L) (h : J → L) (i : J) (z : ℤ) (n : ℕ) :
    Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (h i) + (z : U)) n ∈
      kostantForm e h := by
  apply subringClosure_range_ringChoose_le_kostantForm e h i
  rw [mem_subringClosure_range_ringChoose_iff]
  exact choose_add_intCast_mem_ringChooseSpan _ z n

/-- Subtracting an integer from the argument of a designated Cartan binomial coefficient keeps it
in the Kostant integral form. -/
theorem ringChoose_ι_sub_intCast_mem_kostantForm {I : Type v} {J : Type w}
    (e : I → L) (h : J → L) (i : J) (z : ℤ) (n : ℕ) :
    Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (h i) - (z : U)) n ∈
      kostantForm e h := by
  simpa only [sub_eq_add_neg, Int.cast_neg] using
    ringChoose_ι_add_intCast_mem_kostantForm e h i (-z) n

end TauCeti.UniversalEnvelopingAlgebra
