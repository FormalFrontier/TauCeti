module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ClosedImmersion
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Generated.Basic

/-!
# Kostant root subgroups inside the generated group scheme

The group scheme generated by a family of represented Kostant root subgroups comes with a
factorization of each map `xᵢ : 𝔾ₐ ⟶ GLₙ` through the generated carrier. A pinning needs the
stronger statement that this factored map is still a closed immersion, so that it presents a
closed copy of `𝔾ₐ` inside the generated group rather than only a morphism into it.

Under the root-step hypotheses used to prove that `xᵢ : 𝔾ₐ ⟶ GLₙ` is a closed immersion, its
coordinate map is surjective. The coordinate map after factorization through the common-kernel
quotient is therefore also surjective: its composite with the quotient map is the original
coordinate map. The affine closed-immersion criterion then gives the desired result directly.

## Main declarations

* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupGeneratedCoordinateMap_surjective`:
  the factored coordinate map remains surjective.
* `TauCeti.UniversalEnvelopingAlgebra.isClosedImmersion_kostantRootSubgroupToGenerated`:
  the factored root-subgroup morphism is a closed immersion.
* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupInGenerated`: the resulting closed
  subgroup scheme of the generated Chevalley carrier.

## References

The construction is the root-subgroup part of a pinning in the Chevalley--Demazure construction;
see J. E. Humphreys, *Linear Algebraic Groups*, §26, and R. W. Carter, *Simple Groups of Lie
Type*, §4.4. It advances the "Pinnings" and "Root subgroup maps" milestones in Layer 9 of
`TauCetiRoadmap/ReductiveGroups/README.md`.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti.UniversalEnvelopingAlgebra

universe u w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type*}
variable {V : Type} [AddCommGroup V] [Module ℚ V]

variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ m ∈ M, ρ u m ∈ M)
variable (i : I)
variable (hnil : ∀ j, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M)
variable {r s : Fin n} {c : ℤ}
variable (hc : IsUnit c)
variable (hstep :
  ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) (b s : V) = c • (b r : V))
variable (hsq : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) (b s : V)) = 0)

include hc hstep hsq in
/-- The coordinate map of a Kostant root subgroup remains surjective after it is factored through
the coordinate ring of the generated group scheme. -/
theorem kostantRootSubgroupGeneratedCoordinateMap_surjective :
    Function.Surjective
      (kostantRootSubgroupGeneratedCoordinateMap e h ρ M hM hnil b i).hom :=
  kostantRootSubgroupGeneratedCoordinateMap_surjective_of_surjective
    e h ρ M hM hnil b i
    (kostantRootSubgroupCoordinateMap_surjective e h ρ M hM i (hnil i) b hc hstep hsq)

include hc hstep hsq in
/-- The `i`th Kostant root subgroup is a closed immersion into the group scheme generated by all
the represented root subgroups. Thus the factorization through the generated carrier presents a
closed copy of `𝔾ₐ`, as required by the root-subgroup data of a pinning. -/
theorem isClosedImmersion_kostantRootSubgroupToGenerated :
    IsClosedImmersion
      (kostantRootSubgroupToGenerated e h ρ M hM hnil b i).hom.hom.left := by
  rw [kostantRootSubgroupToGenerated_def]
  exact (CommHopfAlgCat.isClosedImmersion_eqToHom_comp_hopfSpec_map_iff
    (AdditiveGroup.groupScheme_def ℤ)
    (kostantRootSubgroupGeneratedCoordinateMap e h ρ M hM hnil b i)).2
    (kostantRootSubgroupGeneratedCoordinateMap_surjective
      e h ρ M hM i hnil b hc hstep hsq)

include hc hstep hsq in
/-- A factored Kostant root subgroup is a monomorphism into the generated group scheme. -/
theorem mono_kostantRootSubgroupToGenerated :
    Mono (kostantRootSubgroupToGenerated e h ρ M hM hnil b i) :=
  have := isClosedImmersion_kostantRootSubgroupToGenerated
    e h ρ M hM i hnil b hc hstep hsq
  mono_of_isClosedImmersion_underlying
    (kostantRootSubgroupToGenerated e h ρ M hM hnil b i)

/-- The `i`th Kostant root subgroup as a closed subgroup scheme of the generated Chevalley
carrier. Its representing arrow is the factorization of `xᵢ` through that carrier. -/
noncomputable def kostantRootSubgroupInGenerated :
    ClosedSubgroupScheme (kostantGeneratedGroupScheme e h ρ M hM hnil b) :=
  haveI := isClosedImmersion_kostantRootSubgroupToGenerated
    e h ρ M hM i hnil b hc hstep hsq
  ClosedSubgroupScheme.mk (kostantRootSubgroupToGenerated e h ρ M hM hnil b i)

include hc hstep hsq in
/-- The subobject underlying `kostantRootSubgroupInGenerated` is represented by the factored
root-subgroup morphism itself. -/
@[simp]
theorem coe_kostantRootSubgroupInGenerated :
    (kostantRootSubgroupInGenerated e h ρ M hM i hnil b hc hstep hsq).1 =
      letI := mono_kostantRootSubgroupToGenerated
        e h ρ M hM i hnil b hc hstep hsq
      Subobject.mk (kostantRootSubgroupToGenerated e h ρ M hM hnil b i) :=
  haveI := isClosedImmersion_kostantRootSubgroupToGenerated
    e h ρ M hM i hnil b hc hstep hsq
  ClosedSubgroupScheme.coe_mk _

end TauCeti.UniversalEnvelopingAlgebra
