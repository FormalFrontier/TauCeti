module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Commutator.G2
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.MultiplyLacedRelations
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Points

/-!
# Exceptional root-subgroup relations in the generated Kostant group

The Kostant root-subgroup morphisms are represented inside a general linear group, and their
common-kernel quotient defines the closed group scheme generated by them. This file places each
root-subgroup value in the algebra-valued points of that generated carrier and proves there the
two longer Chevalley relations:

```text
[x_α(t), x_β(u)] = x_{α+β}(c t u) x_{2α+β}(d t² u)
```

for a multiply-laced root string, and

```text
x_α(t) x_β(u) = x_β(u) x_{α+β}(c t u) x_{2α+β}(d t² u)
  x_{3α+β}(a t³ u) x_{3α+2β}(b t³ u²) x_α(t)
```

for the type-`G₂` root string. The equalities hold over every commutative value ring, including
characteristics two and three. They are intrinsic equalities in
`kostantGeneratedPointsSubgroup`, rather than equalities asserted only after mapping into the
ambient general linear group.

## Main declarations

* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupGeneratedPoints`: a root-subgroup map
  with codomain the points of the generated closed group scheme.
* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupGeneratedParam`: the same map with its
  parameter read in the value ring.
* `TauCeti.UniversalEnvelopingAlgebra.
  commutatorElement_kostantRootSubgroupGeneratedParam_of_lie_lie_eq`: the multiply-laced
  commutator relation in the generated carrier.
* `TauCeti.UniversalEnvelopingAlgebra.
  kostantRootSubgroupGeneratedParam_mul_of_lie_eq_three_nsmul`: the type-`G₂` product relation in
  the generated carrier.

## References

* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.2.2.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, Sections 26--27.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.

This advances the root-subgroup-maps milestone of Layer 9 of the ReductiveGroups roadmap. The
generated carrier and the represented exceptional relations already exist; these theorems provide
the relations at the carrier-valued interface consumed by the pinned Chevalley--Demazure group.
-/

public section

open WithConv
open scoped commutatorElement

namespace TauCeti.UniversalEnvelopingAlgebra

universe u w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type*}
variable {V : Type} [AddCommGroup V] [Module ℚ V]

variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ x ∈ kostantForm e h, ∀ v ∈ M, ρ x v ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {n : ℕ} (basis : Module.Basis (Fin n) ℤ M)

-- Match tensor products to the `ℤ`-algebra structure used by scalar extension.
attribute [local instance high] Algebra.toModule

variable (A : Type) [CommRing A]

/-- A represented Kostant root subgroup, with its values regarded as points of the closed group
scheme generated by all the root subgroups. -/
noncomputable def kostantRootSubgroupGeneratedPoints (i : I) :
    WithConv (SymmetricAlgebra ℤ ℤ →ₐ[ℤ] A) →*
      kostantGeneratedPointsSubgroup e h ρ M hM hnil basis A :=
  (kostantRootSubgroupMatrix e h ρ M hM i (hnil i) basis).codRestrict
    (kostantGeneratedPointsSubgroup e h ρ M hM hnil basis A)
    (kostantRootSubgroupMatrix_mem_generatedPoints e h ρ M hM hnil basis A i)

/-- Forgetting the generated-carrier membership proof recovers the represented root-subgroup
matrix. -/
@[simp]
theorem coe_kostantRootSubgroupGeneratedPoints (i : I)
    (q : WithConv (SymmetricAlgebra ℤ ℤ →ₐ[ℤ] A)) :
    (kostantRootSubgroupGeneratedPoints e h ρ M hM hnil basis A i q :
        Matrix.GeneralLinearGroup (Fin n) A) =
      kostantRootSubgroupMatrix e h ρ M hM i (hnil i) basis q :=
  by
    rw [kostantRootSubgroupGeneratedPoints]
    rfl

/-- A represented Kostant root subgroup in the generated carrier, with its parameter read in the
value ring through `𝔾ₐ(A) ≃ A⁺`. -/
noncomputable def kostantRootSubgroupGeneratedParam (i : I) :
    Multiplicative A →*
      kostantGeneratedPointsSubgroup e h ρ M hM hnil basis A :=
  (kostantRootSubgroupGeneratedPoints e h ρ M hM hnil basis A i).comp
    (AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm.toMonoidHom

/-- The parameterized map is the generated-carrier root-subgroup map evaluated at the
corresponding additive-group point. -/
theorem kostantRootSubgroupGeneratedParam_apply (i : I) (t : Multiplicative A) :
    kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A i t =
      kostantRootSubgroupGeneratedPoints e h ρ M hM hnil basis A i
        ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm t) := by
  rw [kostantRootSubgroupGeneratedParam, MonoidHom.comp_apply]
  rfl

/-- Forgetting the generated-carrier membership proof evaluates the matrix-valued root subgroup
at the corresponding additive-group point. -/
@[simp]
theorem coe_kostantRootSubgroupGeneratedParam (i : I) (t : Multiplicative A) :
    (kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A i t :
        Matrix.GeneralLinearGroup (Fin n) A) =
      kostantRootSubgroupMatrix e h ρ M hM i (hnil i) basis
        ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm t) :=
  by
    rw [kostantRootSubgroupGeneratedParam, MonoidHom.comp_apply,
      coe_kostantRootSubgroupGeneratedPoints]
    rfl

/-- Mapping the value ring carries a generated-carrier root-subgroup point to the corresponding
root-subgroup point over the target ring. -/
theorem mapKostantGeneratedPointsSubgroup_kostantRootSubgroupGeneratedPoints
    {B : Type} [CommRing B] (φ : A →+* B) (i : I)
    (q : WithConv (SymmetricAlgebra ℤ ℤ →ₐ[ℤ] A)) :
    mapKostantGeneratedPointsSubgroup e h ρ M hM hnil basis φ
        (kostantRootSubgroupGeneratedPoints e h ρ M hM hnil basis A i q) =
      kostantRootSubgroupGeneratedPoints e h ρ M hM hnil basis B i
        (AlgHom.mapValue (H := SymmetricAlgebra ℤ ℤ) φ.toIntAlgHom q) := by
  apply Subtype.ext
  simpa only [coe_mapKostantGeneratedPointsSubgroup,
    coe_kostantRootSubgroupGeneratedPoints] using
      map_kostantRootSubgroupMatrix e h ρ M hM i (hnil i) basis φ q

/-- Naturality of the parameterized root subgroup in the generated carrier. -/
theorem mapKostantGeneratedPointsSubgroup_kostantRootSubgroupGeneratedParam
    {B : Type} [CommRing B] (φ : A →+* B) (i : I) (t : Multiplicative A) :
    mapKostantGeneratedPointsSubgroup e h ρ M hM hnil basis φ
        (kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A i t) =
      kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis B i
        (Multiplicative.ofAdd (φ t.toAdd)) := by
  rw [kostantRootSubgroupGeneratedParam_apply, kostantRootSubgroupGeneratedParam_apply,
    ← RingHom.toIntAlgHom_apply,
    ← AdditiveGroup.mapValue_gaPointsMulEquiv_symm_apply φ.toIntAlgHom]
  exact mapKostantGeneratedPointsSubgroup_kostantRootSubgroupGeneratedPoints
    e h ρ M hM hnil basis A φ i _

/-- **The multiply-laced Chevalley commutator relation in the generated carrier.** Suppose the
distinguished root vectors form the chain `β`, `α + β`, `2α + β`. Then the commutator of the
`i`- and `j`-root values is the product of the `k`- and `l`-root values at parameters `c t u`
and `d t² u`. -/
theorem commutatorElement_kostantRootSubgroupGeneratedParam_of_lie_lie_eq
    {i j k l : I} {c d : ℤ}
    (hij : ⁅e i, e j⁆ = c • e k) (hiij : ⁅e i, ⁅e i, e j⁆⁆ = (2 * d) • e l)
    (hil : ⁅e i, e l⁆ = 0) (hjk : ⁅e j, e k⁆ = 0) (hjl : ⁅e j, e l⁆ = 0)
    (hkl : ⁅e k, e l⁆ = 0) (t u : Multiplicative A) :
    ⁅kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A i t,
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A j u⁆ =
      kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A k
          (Multiplicative.ofAdd ((c : A) * (t.toAdd * u.toAdd))) *
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A l
          (Multiplicative.ofAdd ((d : A) * (t.toAdd ^ 2 * u.toAdd))) := by
  apply Subtype.ext
  simpa only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv,
    coe_kostantRootSubgroupGeneratedParam, MulEquiv.apply_symm_apply] using
    commutatorElement_kostantRootSubgroupMatrix_of_lie_lie_eq'
      e h ρ M hM basis hij hiij hil hjk hjl hkl
        (hnil i) (hnil j) (hnil k) (hnil l)
        ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm t)
        ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm u)

/-- **The type-`G₂` Chevalley product relation in the generated carrier.** The indices
`i, j, k, l, m, o` correspond to `α, β, α + β, 2α + β, 3α + β, 3α + 2β`. The four output
parameters are `c t u`, `d t² u`, `a t³ u`, and `b t³ u²`. -/
theorem kostantRootSubgroupGeneratedParam_mul_of_lie_eq_three_nsmul
    {i j k l m o : I} {c d a b : ℤ}
    (hij : ⁅e i, e j⁆ = c • e k)
    (hik : c • ⁅e i, e k⁆ = (2 * d) • e l)
    (hil : d • ⁅e i, e l⁆ = (3 * a) • e m)
    (hlk : (d * c) • ⁅e l, e k⁆ = (3 * b) • e o)
    (him : ⁅e i, e m⁆ = 0) (hio : ⁅e i, e o⁆ = 0) (hjk : ⁅e j, e k⁆ = 0)
    (hlm : ⁅e l, e m⁆ = 0) (hko : ⁅e k, e o⁆ = 0) (hlo : ⁅e l, e o⁆ = 0)
    (hmo : ⁅e m, e o⁆ = 0) (t u : Multiplicative A) :
    kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A i t *
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A j u =
      kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A j u *
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A k
          (Multiplicative.ofAdd ((c : A) * (t.toAdd * u.toAdd))) *
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A l
          (Multiplicative.ofAdd ((d : A) * (t.toAdd ^ 2 * u.toAdd))) *
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A m
          (Multiplicative.ofAdd ((a : A) * (t.toAdd ^ 3 * u.toAdd))) *
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A o
          (Multiplicative.ofAdd ((b : A) * (t.toAdd ^ 3 * u.toAdd ^ 2))) *
        kostantRootSubgroupGeneratedParam e h ρ M hM hnil basis A i t := by
  let f := (AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm t
  let g := (AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm u
  have hpoints := kostantRootSubgroupPoints_mul_of_lie_eq_three_nsmul'
    e h ρ M hM hij hik hil hlk him hio hjk hlm hko hlo hmo
      (hnil i) (hnil j) (hnil k) (hnil l) (hnil m) (hnil o) f g
  have hmatrix :
      kostantRootSubgroupMatrix e h ρ M hM i (hnil i) basis f *
          kostantRootSubgroupMatrix e h ρ M hM j (hnil j) basis g =
        kostantRootSubgroupMatrix e h ρ M hM j (hnil j) basis g *
          kostantRootSubgroupMatrix e h ρ M hM k (hnil k) basis
            ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm
              (Multiplicative.ofAdd ((c : A) * (t.toAdd * u.toAdd)))) *
          kostantRootSubgroupMatrix e h ρ M hM l (hnil l) basis
            ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm
              (Multiplicative.ofAdd ((d : A) * (t.toAdd ^ 2 * u.toAdd)))) *
          kostantRootSubgroupMatrix e h ρ M hM m (hnil m) basis
            ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm
              (Multiplicative.ofAdd ((a : A) * (t.toAdd ^ 3 * u.toAdd)))) *
          kostantRootSubgroupMatrix e h ρ M hM o (hnil o) basis
            ((AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := A)).symm
              (Multiplicative.ofAdd ((b : A) * (t.toAdd ^ 3 * u.toAdd ^ 2)))) *
          kostantRootSubgroupMatrix e h ρ M hM i (hnil i) basis f := by
    simpa only [kostantRootSubgroupMatrix_def, MonoidHom.comp_apply, map_mul,
      f, g, MulEquiv.apply_symm_apply] using congrArg
        (Units.map (LinearMap.toMatrixAlgEquiv (basis.baseChange A)).toMonoidHom) hpoints
  apply Subtype.ext
  simpa only [Subgroup.coe_mul, coe_kostantRootSubgroupGeneratedParam, f, g] using hmatrix

end TauCeti.UniversalEnvelopingAlgebra
