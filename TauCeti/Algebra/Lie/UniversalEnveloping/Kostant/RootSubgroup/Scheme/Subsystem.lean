module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ClosedImmersion
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure

/-!
# Closed group schemes generated by root subsystems and the Kostant torus

Fix the represented Kostant root subgroups `xᵢ : 𝔾ₐ ⟶ GLₙ`, a represented split torus
`T ⟶ GLₙ`, and a set `S` of root indices. This file constructs the smallest closed subgroup scheme
of `GLₙ` containing `T` and the root subgroups indexed by `S`. On coordinate Hopf algebras its
defining ideal is the largest Hopf ideal killed by the torus coordinate map and by every root
coordinate map with index in `S`.

The construction is monotone: an inclusion `S ⊆ T` induces a closed immersion from the carrier
generated by `S` into the carrier generated by `T`. For `S = Set.univ` it recovers the toral
closure of
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure`. Each selected
root subgroup and the split torus factor through the new carrier, and the root-subgroup
factorization remains a closed immersion under the same root-step hypotheses used for the full
generated carrier.

When `S` is the set of positive roots, this is the scheme-level carrier corresponding to the
pointwise solvable group `kostantTorusSubsystemSubgroup` constructed in
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Borel`. No maximal-solvability or
Borel assertion is made here; those geometric statements remain necessary before this carrier can
be used as the Borel component of a pinning.

## Main declarations

* `TauCeti.UniversalEnvelopingAlgebra.kostantToralSubsystemDefiningIdeal`: the common-kernel Hopf
  ideal for the selected root subgroups and the torus.
* `TauCeti.UniversalEnvelopingAlgebra.kostantToralSubsystemGroupScheme`: the corresponding closed
  subgroup scheme of `GLₙ`.
* `TauCeti.UniversalEnvelopingAlgebra.kostantToralSubsystemMap`: the closed immersion induced by
  an inclusion of index sets.
* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupToToralSubsystem` and
  `TauCeti.UniversalEnvelopingAlgebra.kostantWeightTorusToToralSubsystem`: the selected root and
  torus factorizations.

## References

The construction is the scheme-theoretic positive-root-and-torus step in the construction of a
pinned Chevalley--Demazure group; see R. W. Carter, *Simple Groups of Lie Type*, §§8.2 and 8.5,
and J. E. Humphreys, *Linear Algebraic Groups*, §§26--28. It advances the pinning and explicit
Chevalley--Demazure group-scheme targets of Layer 9 of the reductive-groups roadmap. Milestone L0
of the CFSGStatement roadmap consumes that pinned carrier and its root-subgroup maps.
-/

public section

open AlgebraicGeometry CategoryTheory TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u w

attribute [local instance high] Algebra.toModule

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type} [Finite κ]
variable {V : Type} [AddCommGroup V] [Module ℚ V]

variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ m ∈ M, ρ u m ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M)
variable (wt : Fin n → κ → ℤ)

private noncomputable def kostantToralSubsystemGeneratorCodomain (S : Set I)
    (j : Sum S Unit) : _root_.CommHopfAlgCat ℤ :=
  match j with
  | .inl _ => AdditiveGroup.coordinateHopfAlgebra ℤ
  | .inr _ => (DiagonalizableGroup.coordinateRing ℤ (SplitTorus.characterGroup κ)).obj

private noncomputable def kostantToralSubsystemGeneratorMap (S : Set I) (j : Sum S Unit) :
    GeneralLinear.coordinateHopfAlgebra ℤ n ⟶
      kostantToralSubsystemGeneratorCodomain (I := I) (κ := κ) S j :=
  match j with
  | .inl i => kostantRootSubgroupCoordinateMap e h ρ M hM i.1 (hnil i.1) b
  | .inr _ => GeneralLinear.weightTorusCoordinateMap wt

/-- The defining Hopf ideal of the smallest closed subgroup scheme of `GLₙ` containing the
represented weight torus and the represented Kostant root subgroups indexed by `S`. -/
noncomputable def kostantToralSubsystemDefiningIdeal (S : Set I) :
    HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n) :=
  CommHopfAlgCat.commonKernelHopfIdeal
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S)

/-- A Hopf ideal lies in the toral-subsystem defining ideal exactly when the torus coordinate map
and every selected root-subgroup coordinate map kill it. This is the coordinate universal
property of the generated closed subgroup scheme. -/
theorem le_kostantToralSubsystemDefiningIdeal_iff (S : Set I)
    (J : HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n)) :
    J ≤ kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S ↔
      (∀ i ∈ S, J.toIdeal ≤ RingHom.ker
        (kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b).hom.toAlgHom.toRingHom) ∧
      J.toIdeal ≤ RingHom.ker
        (GeneralLinear.weightTorusCoordinateMap wt).hom.toAlgHom.toRingHom := by
  rw [kostantToralSubsystemDefiningIdeal, CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  constructor
  · intro hJ
    exact ⟨fun i hi ↦ hJ (.inl ⟨i, hi⟩), hJ (.inr ())⟩
  · rintro ⟨hroot, htorus⟩ (i | _)
    · exact hroot i.1 i.2
    · exact htorus

/-- Every selected root-subgroup coordinate map kills the toral-subsystem defining ideal. -/
theorem kostantToralSubsystemDefiningIdeal_toIdeal_le_root_ker (S : Set I) (i : S) :
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S).toIdeal ≤
      RingHom.ker
        (kostantRootSubgroupCoordinateMap e h ρ M hM i.1 (hnil i.1) b).hom.toAlgHom.toRingHom :=
  (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt S
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S)).mp le_rfl |>.1 i.1 i.2

/-- The represented weight-torus coordinate map kills every toral-subsystem defining ideal. -/
theorem kostantToralSubsystemDefiningIdeal_toIdeal_le_torus_ker (S : Set I) :
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S).toIdeal ≤
      RingHom.ker (GeneralLinear.weightTorusCoordinateMap wt).hom.toAlgHom.toRingHom :=
  (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt S
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S)).mp le_rfl |>.2

/-- Enlarging the root-index set shrinks the defining ideal, equivalently enlarging the generated
closed subgroup scheme. -/
theorem kostantToralSubsystemDefiningIdeal_antitone {S T : Set I} (hST : S ⊆ T) :
    kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt T ≤
      kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S := by
  rw [le_kostantToralSubsystemDefiningIdeal_iff]
  exact ⟨fun i hi ↦ kostantToralSubsystemDefiningIdeal_toIdeal_le_root_ker
      e h ρ M hM hnil b wt T ⟨i, hST hi⟩,
    kostantToralSubsystemDefiningIdeal_toIdeal_le_torus_ker e h ρ M hM hnil b wt T⟩

/-- Selecting every root recovers the defining ideal of the full toral closure. -/
@[simp]
theorem kostantToralSubsystemDefiningIdeal_univ :
    kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt Set.univ =
      kostantToralDefiningIdeal e h ρ M hM hnil b wt := by
  apply le_antisymm
  · rw [le_kostantToralDefiningIdeal_iff]
    exact ⟨fun i ↦ kostantToralSubsystemDefiningIdeal_toIdeal_le_root_ker
        e h ρ M hM hnil b wt Set.univ ⟨i, Set.mem_univ i⟩,
      kostantToralSubsystemDefiningIdeal_toIdeal_le_torus_ker
        e h ρ M hM hnil b wt Set.univ⟩
  · rw [le_kostantToralSubsystemDefiningIdeal_iff]
    exact ⟨fun i _ ↦ kostantToralDefiningIdeal_toIdeal_le_root_ker
        e h ρ M hM hnil b wt i,
      kostantToralDefiningIdeal_toIdeal_le_torus_ker e h ρ M hM hnil b wt⟩

/-- The affine group scheme generated jointly by the represented weight torus and the root
subgroups indexed by `S`. -/
noncomputable abbrev kostantToralSubsystemGroupScheme (S : Set I) :
    Grp (Over (Spec (CommRingCat.of ℤ))) :=
  CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra ℤ n)
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S)

/-- Selecting every root recovers the full toral-closure group scheme. This is deliberately not
tagged `@[simp]`: simplification already proves it from
`kostantToralSubsystemDefiningIdeal_univ`. -/
theorem kostantToralSubsystemGroupScheme_univ :
    kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt Set.univ =
      kostantToralGroupScheme e h ρ M hM hnil b wt :=
  congrArg (CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra ℤ n))
    (kostantToralSubsystemDefiningIdeal_univ e h ρ M hM hnil b wt)

/-- The toral-subsystem carrier as a closed subgroup scheme of `GLₙ`. -/
noncomputable def kostantToralSubsystemGroupSchemeι (S : Set I) :
    kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S ⟶
      GeneralLinear.groupScheme ℤ n :=
  CommHopfAlgCat.quotientSpecι (GeneralLinear.coordinateHopfAlgebra ℤ n)
      (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ≫
    eqToHom (GeneralLinear.groupScheme_def ℤ n).symm

/-- The inclusion of a toral-subsystem carrier is the quotient-spectrum inclusion transported
across the named presentation of `GLₙ`. -/
theorem kostantToralSubsystemGroupSchemeι_def (S : Set I) :
    kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S =
      CommHopfAlgCat.quotientSpecι (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ≫
        eqToHom (GeneralLinear.groupScheme_def ℤ n).symm := by
  rfl

/-- Every toral-subsystem carrier is a closed subgroup scheme of `GLₙ`. -/
instance isClosedImmersion_kostantToralSubsystemGroupSchemeι (S : Set I) :
    IsClosedImmersion
      (kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S).hom.hom.left := by
  rw [kostantToralSubsystemGroupSchemeι_def, CommHopfAlgCat.quotientSpecι_def]
  apply (CommHopfAlgCat.isClosedImmersion_hopfSpec_map_comp_eqToHom_iff
    (GeneralLinear.groupScheme_def ℤ n)
    (CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
      (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S))).mpr
  exact Ideal.Quotient.mkₐ_surjective ℤ
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S).toIdeal

/-- An inclusion `S ⊆ T` induces the corresponding closed immersion between the generated
toral-subsystem carriers. -/
noncomputable def kostantToralSubsystemMap {S T : Set I} (hST : S ⊆ T) :
    kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S ⟶
      kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt T :=
  CommHopfAlgCat.quotientSpecMapOfLe (GeneralLinear.coordinateHopfAlgebra ℤ n)
    (kostantToralSubsystemDefiningIdeal_antitone e h ρ M hM hnil b wt hST)

/-- Every map induced by inclusion of root-index sets is a closed immersion. -/
instance isClosedImmersion_kostantToralSubsystemMap {S T : Set I} (hST : S ⊆ T) :
    IsClosedImmersion (kostantToralSubsystemMap e h ρ M hM hnil b wt hST).hom.hom.left := by
  unfold kostantToralSubsystemMap
  infer_instance

/-- The subsystem inclusion followed by the inclusion of the larger carrier into `GLₙ` is the
inclusion of the smaller carrier. -/
@[simp]
theorem kostantToralSubsystemMap_comp_ι {S T : Set I} (hST : S ⊆ T) :
    kostantToralSubsystemMap e h ρ M hM hnil b wt hST ≫
        kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt T =
      kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S := by
  rw [kostantToralSubsystemMap, kostantToralSubsystemGroupSchemeι_def,
    kostantToralSubsystemGroupSchemeι_def, ← Category.assoc,
    CommHopfAlgCat.quotientSpecMapOfLe_comp_quotientSpecι]

/-- The map induced by a reflexive inclusion is the identity. -/
@[simp]
theorem kostantToralSubsystemMap_refl (S : Set I) :
    kostantToralSubsystemMap e h ρ M hM hnil b wt (Set.Subset.rfl : S ⊆ S) =
      𝟙 (kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S) := by
  rw [kostantToralSubsystemMap]
  exact CommHopfAlgCat.quotientSpecMapOfLe_refl _ _

/-- Subsystem inclusions compose according to composition of inclusions. -/
@[simp]
theorem kostantToralSubsystemMap_comp {S T U : Set I} (hST : S ⊆ T) (hTU : T ⊆ U) :
    kostantToralSubsystemMap e h ρ M hM hnil b wt hST ≫
        kostantToralSubsystemMap e h ρ M hM hnil b wt hTU =
      kostantToralSubsystemMap e h ρ M hM hnil b wt (hST.trans hTU) := by
  rw [kostantToralSubsystemMap, kostantToralSubsystemMap, kostantToralSubsystemMap]
  exact CommHopfAlgCat.quotientSpecMapOfLe_comp _ _ _

/-- The coordinate map through which a selected root subgroup factors into its toral-subsystem
carrier. -/
noncomputable def kostantRootSubgroupToralSubsystemCoordinateMap (S : Set I) (i : S) :
    CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
        (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ⟶
      AdditiveGroup.coordinateHopfAlgebra ℤ :=
  CommHopfAlgCat.commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inl i)

/-- Composing the quotient morphism with a selected factored root coordinate map recovers the
represented root-subgroup coordinate map. -/
@[simp]
theorem mkQuotient_comp_kostantRootSubgroupToralSubsystemCoordinateMap (S : Set I) (i : S) :
    CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ≫
        kostantRootSubgroupToralSubsystemCoordinateMap e h ρ M hM hnil b wt S i =
      kostantRootSubgroupCoordinateMap e h ρ M hM i.1 (hnil i.1) b :=
  CommHopfAlgCat.mkQuotient_comp_commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inl i)

/-- A selected represented root subgroup, factored through its toral-subsystem carrier. -/
noncomputable def kostantRootSubgroupToToralSubsystem (S : Set I) (i : S) :
    AdditiveGroup.groupScheme ℤ ⟶
      kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S :=
  eqToHom (AdditiveGroup.groupScheme_def ℤ) ≫
    (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map
      (kostantRootSubgroupToralSubsystemCoordinateMap e h ρ M hM hnil b wt S i).op

/-- Factoring a selected root subgroup through its toral-subsystem carrier and then including
into `GLₙ` recovers the represented root-subgroup morphism. -/
@[simp]
theorem kostantRootSubgroupToToralSubsystem_comp_ι (S : Set I) (i : S) :
    kostantRootSubgroupToToralSubsystem e h ρ M hM hnil b wt S i ≫
        kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S =
      kostantRootSubgroup e h ρ M hM i.1 (hnil i.1) b := by
  rw [kostantRootSubgroupToToralSubsystem, kostantToralSubsystemGroupSchemeι_def,
    CommHopfAlgCat.quotientSpecι_def, kostantRootSubgroup_def]
  slice_lhs 2 3 =>
    rw [← (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map_comp, ← op_comp,
      mkQuotient_comp_kostantRootSubgroupToralSubsystemCoordinateMap]

/-- Factoring a selected root subgroup is compatible with enlarging the selected index set. -/
@[simp]
theorem kostantRootSubgroupToToralSubsystem_comp_map {S T : Set I} (hST : S ⊆ T) (i : S) :
    kostantRootSubgroupToToralSubsystem e h ρ M hM hnil b wt S i ≫
        kostantToralSubsystemMap e h ρ M hM hnil b wt hST =
      kostantRootSubgroupToToralSubsystem e h ρ M hM hnil b wt T ⟨i.1, hST i.2⟩ := by
  apply (cancel_mono (kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt T)).1
  rw [Category.assoc, kostantToralSubsystemMap_comp_ι,
    kostantRootSubgroupToToralSubsystem_comp_ι,
    kostantRootSubgroupToToralSubsystem_comp_ι]

/-- The coordinate map through which the represented weight torus factors into a toral-subsystem
carrier. -/
noncomputable def kostantWeightTorusToralSubsystemCoordinateMap (S : Set I) :
    CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
        (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ⟶
      (DiagonalizableGroup.coordinateRing ℤ (SplitTorus.characterGroup κ)).obj :=
  CommHopfAlgCat.commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inr ())

/-- Composing the quotient morphism with the factored torus coordinate map recovers the represented
weight-torus coordinate map. -/
@[simp]
theorem mkQuotient_comp_kostantWeightTorusToralSubsystemCoordinateMap (S : Set I) :
    CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ≫
        kostantWeightTorusToralSubsystemCoordinateMap e h ρ M hM hnil b wt S =
      GeneralLinear.weightTorusCoordinateMap wt :=
  CommHopfAlgCat.mkQuotient_comp_commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inr ())

/-- The represented weight torus, factored through a toral-subsystem carrier. -/
noncomputable def kostantWeightTorusToToralSubsystem (S : Set I) :
    SplitTorus.groupScheme ℤ κ ⟶
      kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S :=
  eqToHom (DiagonalizableGroup.groupScheme_def ℤ (SplitTorus.characterGroup κ)) ≫
    (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map
      (kostantWeightTorusToralSubsystemCoordinateMap e h ρ M hM hnil b wt S).op

/-- Factoring the weight torus through a toral-subsystem carrier and then including into `GLₙ`
recovers the represented weight-torus morphism. -/
@[simp]
theorem kostantWeightTorusToToralSubsystem_comp_ι (S : Set I) :
    kostantWeightTorusToToralSubsystem e h ρ M hM hnil b wt S ≫
        kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S =
      GeneralLinear.weightTorus (R := ℤ) wt := by
  rw [kostantWeightTorusToToralSubsystem, kostantToralSubsystemGroupSchemeι_def,
    CommHopfAlgCat.quotientSpecι_def, GeneralLinear.weightTorus_def]
  slice_lhs 2 3 =>
    rw [← (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map_comp, ← op_comp,
      mkQuotient_comp_kostantWeightTorusToralSubsystemCoordinateMap]

/-- The torus factorization is compatible with enlarging the selected root-index set. -/
@[simp]
theorem kostantWeightTorusToToralSubsystem_comp_map {S T : Set I} (hST : S ⊆ T) :
    kostantWeightTorusToToralSubsystem e h ρ M hM hnil b wt S ≫
        kostantToralSubsystemMap e h ρ M hM hnil b wt hST =
      kostantWeightTorusToToralSubsystem e h ρ M hM hnil b wt T := by
  apply (cancel_mono (kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt T)).1
  rw [Category.assoc, kostantToralSubsystemMap_comp_ι,
    kostantWeightTorusToToralSubsystem_comp_ι,
    kostantWeightTorusToToralSubsystem_comp_ι]

section RootClosedImmersion

variable (S : Set I) (i : S) {r s : Fin n} {c : ℤ}
variable (hc : IsUnit c)
variable (hstep :
  ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i.1)) (b s : V) = c • (b r : V))
variable (hsq : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i.1))
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i.1)) (b s : V)) = 0)

include hc hstep hsq in
/-- The coordinate map of a selected root subgroup remains surjective after factorization through
the toral-subsystem carrier. -/
theorem kostantRootSubgroupToralSubsystemCoordinateMap_surjective :
    Function.Surjective
      (kostantRootSubgroupToralSubsystemCoordinateMap e h ρ M hM hnil b wt S i).hom :=
  CommHopfAlgCat.commonKernelLift_surjective_of_surjective
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inl i)
    (kostantRootSubgroupCoordinateMap_surjective e h ρ M hM i.1 (hnil i.1) b hc hstep hsq)

include hc hstep hsq in
/-- A selected root subgroup is a closed immersion into its toral-subsystem carrier. -/
theorem isClosedImmersion_kostantRootSubgroupToToralSubsystem :
    IsClosedImmersion
      (kostantRootSubgroupToToralSubsystem e h ρ M hM hnil b wt S i).hom.hom.left := by
  unfold kostantRootSubgroupToToralSubsystem
  exact (CommHopfAlgCat.isClosedImmersion_eqToHom_comp_hopfSpec_map_iff
    (AdditiveGroup.groupScheme_def ℤ)
    (kostantRootSubgroupToralSubsystemCoordinateMap e h ρ M hM hnil b wt S i)).2
    (kostantRootSubgroupToralSubsystemCoordinateMap_surjective
      e h ρ M hM hnil b wt S i hc hstep hsq)

end RootClosedImmersion

end TauCeti.UniversalEnvelopingAlgebra
