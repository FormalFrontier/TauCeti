module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ClosedImmersion
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Basic

/-!
# Kostant root subgroups inside the toral closure

The toral Kostant carrier is generated by represented root subgroups together with a represented
weight torus. Each root-subgroup map factors through this carrier, but a pinning needs the stronger
statement that the factored map is a closed immersion and hence presents a closed copy of `𝔾ₐ`.

The usual root-step hypotheses make the original root-subgroup coordinate map surjective. Its
factorization through the common-kernel quotient defining the toral carrier remains surjective,
so the affine closed-immersion criterion applies. The resulting closed subgroup scheme is the
root-subgroup datum used by a pinned Chevalley--Demazure carrier.

## Main declarations

* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupToralCoordinateMap_surjective`:
  the factored coordinate map is surjective under the root-step hypotheses.
* `TauCeti.UniversalEnvelopingAlgebra.isClosedImmersion_kostantRootSubgroupToToral`:
  the factored root-subgroup morphism is a closed immersion.
* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupInToral`:
  the corresponding closed subgroup scheme of the toral carrier.

## References

The declaration order, hypothesis layout, and proof organization adapt the existing formal
template in `TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.RootInGenerated`
to the toral carrier.

The construction is the root-subgroup part of a pinning in the Chevalley--Demazure construction;
see J. E. Humphreys, *Linear Algebraic Groups*, §26, and R. W. Carter,
*Simple Groups of Lie Type*, §4.4. It advances the "Pinnings" and "Root subgroup maps" targets
in Layer 9 of `TauCetiRoadmap/ReductiveGroups/README.md`, consumed by milestone L0 of the
CFSGStatement roadmap.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti.UniversalEnvelopingAlgebra

universe u w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type} [Finite κ]
variable {V : Type} [AddCommGroup V] [Module ℚ V]

variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ m ∈ M, ρ u m ∈ M)
variable (i : I)
variable (hnil : ∀ j, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e j))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M)
variable (wt : Fin n → κ → ℤ)
variable {r s : Fin n} {c : ℤ}
variable (hc : IsUnit c)
variable (hstep :
  ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) (b s : V) = c • (b r : V))
variable (hsq : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)) (b s : V)) = 0)

include hc hstep hsq in
/-- The coordinate map of a Kostant root subgroup remains surjective after factorization through
the coordinate ring of the toral closure. -/
theorem kostantRootSubgroupToralCoordinateMap_surjective :
    Function.Surjective
      (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).hom :=
  kostantRootSubgroupToralCoordinateMap_surjective_of_surjective
    e h ρ M hM hnil b wt i
    (kostantRootSubgroupCoordinateMap_surjective e h ρ M hM i (hnil i) b hc hstep hsq)

include hc hstep hsq in
/-- The `i`th Kostant root subgroup is a closed immersion into the toral closure. Thus the
factorization presents a closed copy of the additive group scheme in the carrier used by the
pinned Chevalley--Demazure construction. -/
theorem isClosedImmersion_kostantRootSubgroupToToral :
    IsClosedImmersion
      (kostantRootSubgroupToToral e h ρ M hM hnil b wt i).hom.hom.left :=
  isClosedImmersion_kostantRootSubgroupToToral_of_surjective
    e h ρ M hM hnil b wt i
    (kostantRootSubgroupToralCoordinateMap_surjective
      e h ρ M hM i hnil b wt hc hstep hsq)

include hc hstep hsq in
/-- A Kostant root subgroup factored through the toral closure is a monomorphism. -/
theorem mono_kostantRootSubgroupToToral :
    Mono (kostantRootSubgroupToToral e h ρ M hM hnil b wt i) :=
  have := isClosedImmersion_kostantRootSubgroupToToral
    e h ρ M hM i hnil b wt hc hstep hsq
  mono_of_isClosedImmersion_underlying
    (kostantRootSubgroupToToral e h ρ M hM hnil b wt i)

/-- The `i`th Kostant root subgroup as a closed subgroup scheme of the toral closure. Its
representing arrow is the factored root-subgroup morphism. -/
noncomputable def kostantRootSubgroupInToral :
    ClosedSubgroupScheme (kostantToralGroupScheme e h ρ M hM hnil b wt) :=
  haveI := isClosedImmersion_kostantRootSubgroupToToral
    e h ρ M hM i hnil b wt hc hstep hsq
  ClosedSubgroupScheme.mk (kostantRootSubgroupToToral e h ρ M hM hnil b wt i)

include hc hstep hsq in
/-- The subobject underlying `kostantRootSubgroupInToral` is represented by the factored
root-subgroup morphism itself. -/
@[simp]
theorem coe_kostantRootSubgroupInToral :
    (kostantRootSubgroupInToral e h ρ M hM i hnil b wt hc hstep hsq).1 =
      letI := mono_kostantRootSubgroupToToral
        e h ρ M hM i hnil b wt hc hstep hsq
      Subobject.mk (kostantRootSubgroupToToral e h ρ M hM hnil b wt i) :=
  haveI := isClosedImmersion_kostantRootSubgroupToToral
    e h ρ M hM i hnil b wt hc hstep hsq
  ClosedSubgroupScheme.coe_mk _

end TauCeti.UniversalEnvelopingAlgebra
