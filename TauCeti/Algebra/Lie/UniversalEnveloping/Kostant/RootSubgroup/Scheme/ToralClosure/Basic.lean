module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.WeightTorus
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Generated.Basic
public import TauCeti.AlgebraicGeometry.GroupScheme.ClosedSubgroup

/-!
# The closed group scheme generated by a Kostant torus and root subgroups

Fix a finite free Kostant-stable lattice with a basis, and prescribe an integer weight for each
basis vector. Distinguished nilpotent vectors give represented root-subgroup morphisms
`xᵢ : 𝔾ₐ → GLₙ`, while the chosen weights give a represented split-torus morphism
`T → GLₙ`. This file constructs the smallest closed subgroup scheme of `GLₙ` containing both
families.

On coordinate Hopf algebras, the defining ideal is the largest Hopf ideal killed by every root
subgroup coordinate map and by the weight-torus coordinate map. Quotienting by that ideal gives
an explicit affine group scheme, and both the root subgroups and the torus factor through it. The
previously constructed root-generated group scheme is a closed subgroup scheme of this toral
closure.

For arbitrary vectors and weights, no maximality of the torus and no reductivity or Borel
structure is asserted. When the inputs come from a Chevalley system and an admissible weight
lattice, this is the carrier assembled from the torus and root subgroups in the
Chevalley--Demazure construction. The remaining pinning work must identify the appropriate Borel
and prove the root-datum properties.

## Main declarations

* `TauCeti.UniversalEnvelopingAlgebra.kostantToralDefiningIdeal`: the common-kernel Hopf ideal of
  the root-subgroup and weight-torus coordinate maps.
* `TauCeti.UniversalEnvelopingAlgebra.kostantToralGroupScheme`: the resulting closed subgroup
  scheme of `GLₙ`.
* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupToToral`: the factored root-subgroup
  morphisms.
* `TauCeti.UniversalEnvelopingAlgebra.kostantWeightTorusToToral`: the factored weight-torus
  morphism.
* `TauCeti.UniversalEnvelopingAlgebra.kostantGeneratedToToral`: the closed immersion from the
  root-generated group scheme.

## References

The construction is the scheme-theoretic closure of the torus and root subgroups used in the
Chevalley--Demazure construction; see J. E. Humphreys, *Linear Algebraic Groups*, §26, and
R. W. Carter, *Simple Groups of Lie Type*, §§4.4 and 7.1. It advances Layer 9, "pinned
Chevalley--Demazure group schemes over `ℤ`", of `TauCetiRoadmap/ReductiveGroups/README.md` and
supplies the assembled ambient carrier required by milestone L0 of the CFSGStatement roadmap.
-/

public section

open AlgebraicGeometry CategoryTheory TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u w

-- Match tensor products to the `ℤ`-algebra structure used by scalar extension.
attribute [local instance high] Algebra.toModule

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type} [Finite κ]
variable {V : Type} [AddCommGroup V] [Module ℚ V]

variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ m ∈ M, ρ u m ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M)
variable (wt : Fin n → κ → ℤ)

/-- The coordinate Hopf algebra receiving a root-subgroup or weight-torus generator map. -/
private noncomputable def kostantToralGeneratorCodomain (j : Sum I Unit) :
    _root_.CommHopfAlgCat ℤ :=
  match j with
  | .inl _ => AdditiveGroup.coordinateHopfAlgebra ℤ
  | .inr _ => (DiagonalizableGroup.coordinateRing ℤ (SplitTorus.characterGroup κ)).obj

/-- The family consisting of every root-subgroup coordinate map and the weight-torus map. -/
private noncomputable def kostantToralGeneratorMap (j : Sum I Unit) :
    GeneralLinear.coordinateHopfAlgebra ℤ n ⟶
      kostantToralGeneratorCodomain (I := I) (κ := κ) j :=
  match j with
  | .inl i => kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b
  | .inr _ => GeneralLinear.weightTorusCoordinateMap wt

/-- The defining Hopf ideal of the closed subgroup scheme generated jointly by the represented
Kostant root subgroups and the represented weight torus. It is the largest Hopf ideal killed by
all of those coordinate maps. -/
noncomputable def kostantToralDefiningIdeal :
    HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n) :=
  CommHopfAlgCat.commonKernelHopfIdeal
    (kostantToralGeneratorMap e h ρ M hM hnil b wt)

/-- A Hopf ideal lies in the toral defining ideal exactly when every root-subgroup coordinate map
and the weight-torus coordinate map kill it. -/
theorem le_kostantToralDefiningIdeal_iff
    (J : HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n)) :
    J ≤ kostantToralDefiningIdeal e h ρ M hM hnil b wt ↔
      (∀ i, J.toIdeal ≤ RingHom.ker
        (kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b).hom.toAlgHom.toRingHom) ∧
      J.toIdeal ≤ RingHom.ker
        (GeneralLinear.weightTorusCoordinateMap wt).hom.toAlgHom.toRingHom := by
  rw [kostantToralDefiningIdeal, CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  constructor
  · intro hJ
    exact ⟨fun i ↦ hJ (.inl i), hJ (.inr ())⟩
  · rintro ⟨hroot, htorus⟩ (i | _)
    · exact hroot i
    · exact htorus

/-- Every represented root-subgroup coordinate map kills the toral defining ideal. -/
theorem kostantToralDefiningIdeal_toIdeal_le_root_ker (i : I) :
    (kostantToralDefiningIdeal e h ρ M hM hnil b wt).toIdeal ≤
      RingHom.ker
        (kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b).hom.toAlgHom.toRingHom :=
  (le_kostantToralDefiningIdeal_iff e h ρ M hM hnil b wt
    (kostantToralDefiningIdeal e h ρ M hM hnil b wt)).mp le_rfl |>.1 i

/-- The represented weight-torus coordinate map kills the toral defining ideal. -/
theorem kostantToralDefiningIdeal_toIdeal_le_torus_ker :
    (kostantToralDefiningIdeal e h ρ M hM hnil b wt).toIdeal ≤
      RingHom.ker
        (GeneralLinear.weightTorusCoordinateMap wt).hom.toAlgHom.toRingHom :=
  (le_kostantToralDefiningIdeal_iff e h ρ M hM hnil b wt
    (kostantToralDefiningIdeal e h ρ M hM hnil b wt)).mp le_rfl |>.2

/-- Adding the weight torus to the generators can only shrink the defining ideal. Equivalently,
the root-generated group scheme is a closed subgroup scheme of the toral closure. -/
theorem kostantToralDefiningIdeal_le_kostantGeneratedDefiningIdeal :
    kostantToralDefiningIdeal e h ρ M hM hnil b wt ≤
      kostantGeneratedDefiningIdeal e h ρ M hM hnil b := by
  rw [le_kostantGeneratedDefiningIdeal_iff]
  exact fun i ↦ kostantToralDefiningIdeal_toIdeal_le_root_ker
    e h ρ M hM hnil b wt i

/-- The affine group scheme generated jointly by the represented Kostant root subgroups and
weight torus, presented as a Hopf-ideal quotient of the coordinate algebra of `GLₙ`. -/
noncomputable abbrev kostantToralGroupScheme :
    Grp (Over (Spec (CommRingCat.of ℤ))) :=
  CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra ℤ n)
    (kostantToralDefiningIdeal e h ρ M hM hnil b wt)

/-- The toral closure is a closed subgroup scheme of `GLₙ`. -/
noncomputable def kostantToralGroupSchemeι :
    kostantToralGroupScheme e h ρ M hM hnil b wt ⟶ GeneralLinear.groupScheme ℤ n :=
  CommHopfAlgCat.quotientSpecι (GeneralLinear.coordinateHopfAlgebra ℤ n)
      (kostantToralDefiningIdeal e h ρ M hM hnil b wt) ≫
    eqToHom (GeneralLinear.groupScheme_def ℤ n).symm

/-- The inclusion of the toral closure is the quotient-spectrum inclusion transported across the
named presentation of `GLₙ`. -/
theorem kostantToralGroupSchemeι_def :
    kostantToralGroupSchemeι e h ρ M hM hnil b wt =
      CommHopfAlgCat.quotientSpecι (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralDefiningIdeal e h ρ M hM hnil b wt) ≫
        eqToHom (GeneralLinear.groupScheme_def ℤ n).symm := by
  rfl

/-- The inclusion of the toral closure into `GLₙ` is a closed immersion. -/
instance isClosedImmersion_kostantToralGroupSchemeι :
    IsClosedImmersion (kostantToralGroupSchemeι e h ρ M hM hnil b wt).hom.hom.left := by
  rw [kostantToralGroupSchemeι_def, CommHopfAlgCat.quotientSpecι_def]
  apply (CommHopfAlgCat.isClosedImmersion_hopfSpec_map_comp_eqToHom_iff
    (GeneralLinear.groupScheme_def ℤ n)
    (CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
      (kostantToralDefiningIdeal e h ρ M hM hnil b wt))).mpr
  exact Ideal.Quotient.mkₐ_surjective ℤ
    (kostantToralDefiningIdeal e h ρ M hM hnil b wt).toIdeal

/-- The coordinate map through which the `i`th root subgroup factors into the toral closure. -/
noncomputable def kostantRootSubgroupToralCoordinateMap (i : I) :
    CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
        (kostantToralDefiningIdeal e h ρ M hM hnil b wt) ⟶
      AdditiveGroup.coordinateHopfAlgebra ℤ :=
  CommHopfAlgCat.commonKernelLift
    (kostantToralGeneratorMap e h ρ M hM hnil b wt) (.inl i)

/-- Composing the quotient morphism with a factored root coordinate map recovers the represented
root-subgroup coordinate map. -/
@[simp]
theorem mkQuotient_comp_kostantRootSubgroupToralCoordinateMap (i : I) :
    CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralDefiningIdeal e h ρ M hM hnil b wt) ≫
        kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i =
      kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b :=
  CommHopfAlgCat.mkQuotient_comp_commonKernelLift
    (kostantToralGeneratorMap e h ρ M hM hnil b wt) (.inl i)

/-- The coordinate map through which the represented weight torus factors into the toral
closure. -/
noncomputable def kostantWeightTorusToralCoordinateMap :
    CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
        (kostantToralDefiningIdeal e h ρ M hM hnil b wt) ⟶
      (DiagonalizableGroup.coordinateRing ℤ (SplitTorus.characterGroup κ)).obj :=
  CommHopfAlgCat.commonKernelLift
    (kostantToralGeneratorMap e h ρ M hM hnil b wt) (.inr ())

/-- Composing the quotient morphism with the factored torus coordinate map recovers the weight
torus coordinate map. -/
@[simp]
theorem mkQuotient_comp_kostantWeightTorusToralCoordinateMap :
    CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralDefiningIdeal e h ρ M hM hnil b wt) ≫
        kostantWeightTorusToralCoordinateMap e h ρ M hM hnil b wt =
      GeneralLinear.weightTorusCoordinateMap wt :=
  CommHopfAlgCat.mkQuotient_comp_commonKernelLift
    (kostantToralGeneratorMap e h ρ M hM hnil b wt) (.inr ())

/-- The `i`th represented Kostant root subgroup, factored through the toral closure. -/
noncomputable def kostantRootSubgroupToToral (i : I) :
    AdditiveGroup.groupScheme ℤ ⟶ kostantToralGroupScheme e h ρ M hM hnil b wt :=
  eqToHom (AdditiveGroup.groupScheme_def ℤ) ≫
    (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map
      (kostantRootSubgroupToralCoordinateMap e h ρ M hM hnil b wt i).op

/-- Factoring a root subgroup through the toral closure and then including into `GLₙ` recovers
the original represented root-subgroup morphism. -/
@[simp]
theorem kostantRootSubgroupToToral_comp_ι (i : I) :
    kostantRootSubgroupToToral e h ρ M hM hnil b wt i ≫
        kostantToralGroupSchemeι e h ρ M hM hnil b wt =
      kostantRootSubgroup e h ρ M hM i (hnil i) b := by
  rw [kostantRootSubgroupToToral, kostantToralGroupSchemeι_def,
    CommHopfAlgCat.quotientSpecι_def, kostantRootSubgroup_def]
  slice_lhs 2 3 =>
    rw [← (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map_comp,
      ← op_comp, mkQuotient_comp_kostantRootSubgroupToralCoordinateMap]

/-- The represented Kostant weight torus, factored through the toral closure. -/
noncomputable def kostantWeightTorusToToral :
    SplitTorus.groupScheme ℤ κ ⟶ kostantToralGroupScheme e h ρ M hM hnil b wt :=
  eqToHom (DiagonalizableGroup.groupScheme_def ℤ (SplitTorus.characterGroup κ)) ≫
    (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map
      (kostantWeightTorusToralCoordinateMap e h ρ M hM hnil b wt).op

/-- Factoring the weight torus through the toral closure and then including into `GLₙ` recovers
the original represented weight-torus morphism. -/
@[simp]
theorem kostantWeightTorusToToral_comp_ι :
    kostantWeightTorusToToral e h ρ M hM hnil b wt ≫
        kostantToralGroupSchemeι e h ρ M hM hnil b wt =
      GeneralLinear.weightTorus (R := ℤ) wt := by
  rw [kostantWeightTorusToToral, kostantToralGroupSchemeι_def,
    CommHopfAlgCat.quotientSpecι_def, GeneralLinear.weightTorus_def]
  slice_lhs 2 3 =>
    rw [← (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map_comp,
      ← op_comp, mkQuotient_comp_kostantWeightTorusToralCoordinateMap]

/-- The root-generated Kostant group scheme as a closed subgroup scheme of the toral closure. -/
noncomputable def kostantGeneratedToToral :
    kostantGeneratedGroupScheme e h ρ M hM hnil b ⟶
      kostantToralGroupScheme e h ρ M hM hnil b wt :=
  CommHopfAlgCat.quotientSpecMapOfLe (GeneralLinear.coordinateHopfAlgebra ℤ n)
    (kostantToralDefiningIdeal_le_kostantGeneratedDefiningIdeal
      e h ρ M hM hnil b wt)

/-- The root-generated carrier includes into the toral closure as a closed immersion. -/
instance isClosedImmersion_kostantGeneratedToToral :
    IsClosedImmersion (kostantGeneratedToToral e h ρ M hM hnil b wt).hom.hom.left := by
  unfold kostantGeneratedToToral
  infer_instance

/-- The inclusion of the root-generated carrier into the toral closure, followed by the toral
inclusion into `GLₙ`, is the original root-generated inclusion. -/
@[simp]
theorem kostantGeneratedToToral_comp_ι :
    kostantGeneratedToToral e h ρ M hM hnil b wt ≫
        kostantToralGroupSchemeι e h ρ M hM hnil b wt =
      kostantGeneratedGroupSchemeι e h ρ M hM hnil b := by
  rw [kostantGeneratedToToral, kostantToralGroupSchemeι_def,
    kostantGeneratedGroupSchemeι_def, ← Category.assoc,
    CommHopfAlgCat.quotientSpecMapOfLe_comp_quotientSpecι]

/-- Factoring a root subgroup first through the root-generated carrier and then through its
closed immersion into the toral closure agrees with the direct toral factorization. -/
@[simp]
theorem kostantRootSubgroupToGenerated_comp_kostantGeneratedToToral (i : I) :
    kostantRootSubgroupToGenerated e h ρ M hM hnil b i ≫
        kostantGeneratedToToral e h ρ M hM hnil b wt =
      kostantRootSubgroupToToral e h ρ M hM hnil b wt i := by
  apply (cancel_mono (kostantToralGroupSchemeι e h ρ M hM hnil b wt)).1
  rw [Category.assoc, kostantGeneratedToToral_comp_ι,
    kostantRootSubgroupToGenerated_comp_ι, kostantRootSubgroupToToral_comp_ι]

end TauCeti.UniversalEnvelopingAlgebra
