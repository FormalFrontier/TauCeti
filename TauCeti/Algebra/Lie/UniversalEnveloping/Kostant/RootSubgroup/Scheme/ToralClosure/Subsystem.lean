module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Basic

/-!
# Closed subschemes generated by a torus and selected Kostant root subgroups

Fix the data defining a Kostant toral closure inside `GLₙ`, and let `S` be a set of its root
indices. This file constructs the smallest closed subgroup scheme of `GLₙ` containing the
represented weight torus and the root-subgroup morphisms indexed by `S`. Its defining Hopf ideal
is the largest one killed by precisely those morphisms.

The resulting carrier is a closed subgroup scheme of the full toral closure. The inclusion is
functorial in `S`, and both the selected root subgroups and the weight torus factor through it.
For a positive system, this is the scheme-level Borel-type carrier underlying the Borel component
of a pinning. No maximal-solvability or reductivity statement is made here: proving that this
closed carrier is a Borel subgroup for the Chevalley data is later geometric work.

This construction is the scheme counterpart of
`TauCeti.UniversalEnvelopingAlgebra.kostantTorusSubsystemSubgroup`, which generates a subgroup on
points. The pointwise subgroup maps into the points of this closed carrier, but equality can fail
over a general value ring and is not asserted here.

## Main declarations

* `TauCeti.UniversalEnvelopingAlgebra.kostantToralSubsystemDefiningIdeal`: the common-kernel Hopf
  ideal for the selected root subgroups and the weight torus.
* `TauCeti.UniversalEnvelopingAlgebra.kostantToralSubsystemGroupScheme`: the corresponding closed
  subgroup scheme of `GLₙ`.
* `TauCeti.UniversalEnvelopingAlgebra.kostantToralSubsystemToToral`: its closed immersion into the
  full toral closure.
* `TauCeti.UniversalEnvelopingAlgebra.kostantRootSubgroupToToralSubsystem` and
  `TauCeti.UniversalEnvelopingAlgebra.kostantWeightTorusToToralSubsystem`: the selected pinning
  maps factored through the subsystem carrier.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§26--28.
* R. W. Carter, *Simple Groups of Lie Type*, §§4.4, 8.2, and 8.5.

This advances the pinning and explicit Chevalley--Demazure construction targets in Layer 9 of
`TauCetiRoadmap/ReductiveGroups/README.md`. A positive-root specialization supplies the compatible
Borel carrier required by the pinning consumed in milestone L0 of the CFSGStatement roadmap.
-/

public section

open AlgebraicGeometry CategoryTheory TensorProduct

namespace TauCeti.UniversalEnvelopingAlgebra

universe u w

-- Match tensor products to the `ℤ`-algebra structure used by scalar extension.
attribute [local instance high] Algebra.toModule

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {I : Type w} {κ : Type} [Finite κ]
variable {V : Type} [AddCommGroup V] [Module ℚ V]

variable (e : I → L) (h : κ → L)
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm e h, ∀ m ∈ M, ρ u m ∈ M)
variable (hnil : ∀ i, IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
variable {n : ℕ} (b : Module.Basis (Fin n) ℤ M)
variable (wt : Fin n → κ → ℤ)

/-- The coordinate Hopf algebra receiving a generator map of a toral subsystem. -/
private noncomputable def kostantToralSubsystemGeneratorCodomain (S : Set I)
    (j : Sum S Unit) : _root_.CommHopfAlgCat ℤ :=
  match j with
  | .inl _ => AdditiveGroup.coordinateHopfAlgebra ℤ
  | .inr _ => (DiagonalizableGroup.coordinateRing ℤ (SplitTorus.characterGroup κ)).obj

/-- The family of selected root-subgroup coordinate maps together with the weight-torus map. -/
private noncomputable def kostantToralSubsystemGeneratorMap (S : Set I) (j : Sum S Unit) :
    GeneralLinear.coordinateHopfAlgebra ℤ n ⟶
      kostantToralSubsystemGeneratorCodomain (κ := κ) S j :=
  match j with
  | .inl i => kostantRootSubgroupCoordinateMap e h ρ M hM i.1 (hnil i.1) b
  | .inr _ => GeneralLinear.weightTorusCoordinateMap wt

/-- The defining Hopf ideal of the closed subgroup scheme generated by the represented weight
torus and exactly the Kostant root subgroups whose indices lie in `S`. -/
noncomputable def kostantToralSubsystemDefiningIdeal (S : Set I) :
    HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n) :=
  CommHopfAlgCat.commonKernelHopfIdeal
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S)

/-- A Hopf ideal lies in the subsystem defining ideal exactly when the selected root-subgroup
maps and the weight-torus map kill it. This is the coordinate universal property of the closed
carrier. -/
theorem le_kostantToralSubsystemDefiningIdeal_iff (S : Set I)
    (J : HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ n)) :
    J ≤ kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S ↔
      (∀ i ∈ S, J.toIdeal ≤ RingHom.ker
        (kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b).hom.toAlgHom.toRingHom) ∧
      J.toIdeal ≤ RingHom.ker
        (GeneralLinear.weightTorusCoordinateMap wt).hom.toAlgHom.toRingHom := by
  rw [kostantToralSubsystemDefiningIdeal,
    CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
  constructor
  · intro hJ
    exact ⟨fun i hi => hJ (.inl ⟨i, hi⟩), hJ (.inr ())⟩
  · rintro ⟨hroot, htorus⟩ (i | _)
    · exact hroot i.1 i.2
    · exact htorus

/-- Enlarging the selected set can only shrink its common-kernel defining ideal. Equivalently,
the associated closed subgroup scheme grows with the selected root set. -/
theorem kostantToralSubsystemDefiningIdeal_antitone {S T : Set I} (hST : S ⊆ T) :
    kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt T ≤
      kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S := by
  rw [le_kostantToralSubsystemDefiningIdeal_iff]
  exact ⟨fun i hi =>
    (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt T _).mp le_rfl |>.1
      i (hST hi),
    (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt T _).mp le_rfl |>.2⟩

/-- The full toral defining ideal lies in every subsystem defining ideal. -/
theorem kostantToralDefiningIdeal_le_kostantToralSubsystemDefiningIdeal (S : Set I) :
    kostantToralDefiningIdeal e h ρ M hM hnil b wt ≤
      kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S := by
  rw [le_kostantToralSubsystemDefiningIdeal_iff]
  exact ⟨fun i _ =>
    kostantToralDefiningIdeal_toIdeal_le_root_ker e h ρ M hM hnil b wt i,
    kostantToralDefiningIdeal_toIdeal_le_torus_ker e h ρ M hM hnil b wt⟩

/-- Selecting every root subgroup recovers the defining ideal of the full toral closure. -/
@[simp]
theorem kostantToralSubsystemDefiningIdeal_univ :
    kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt Set.univ =
      kostantToralDefiningIdeal e h ρ M hM hnil b wt := by
  apply le_antisymm
  · rw [le_kostantToralDefiningIdeal_iff]
    exact ⟨fun i =>
      (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt Set.univ _).mp
        le_rfl |>.1 i (Set.mem_univ i),
      (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt Set.univ _).mp
        le_rfl |>.2⟩
  · exact kostantToralDefiningIdeal_le_kostantToralSubsystemDefiningIdeal
      e h ρ M hM hnil b wt Set.univ

/-- Every selected represented root-subgroup coordinate map kills the subsystem defining ideal. -/
theorem kostantToralSubsystemDefiningIdeal_toIdeal_le_root_ker (S : Set I)
    {i : I} (hi : i ∈ S) :
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S).toIdeal ≤
      RingHom.ker
        (kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b).hom.toAlgHom.toRingHom :=
  (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt S _).mp le_rfl |>.1 i hi

/-- The represented weight-torus coordinate map kills every subsystem defining ideal. -/
theorem kostantToralSubsystemDefiningIdeal_toIdeal_le_torus_ker (S : Set I) :
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S).toIdeal ≤
      RingHom.ker
        (GeneralLinear.weightTorusCoordinateMap wt).hom.toAlgHom.toRingHom :=
  (le_kostantToralSubsystemDefiningIdeal_iff e h ρ M hM hnil b wt S _).mp le_rfl |>.2

/-- The affine group scheme generated by the selected root subgroups and the weight torus. -/
noncomputable abbrev kostantToralSubsystemGroupScheme (S : Set I) :
    Grp (Over (Spec (CommRingCat.of ℤ))) :=
  CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra ℤ n)
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S)

/-- The inclusion of a toral-subsystem carrier into `GLₙ`. -/
noncomputable def kostantToralSubsystemGroupSchemeι (S : Set I) :
    kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S ⟶
      GeneralLinear.groupScheme ℤ n :=
  CommHopfAlgCat.quotientSpecι (GeneralLinear.coordinateHopfAlgebra ℤ n)
      (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ≫
    eqToHom (GeneralLinear.groupScheme_def ℤ n).symm

/-- The toral-subsystem inclusion into `GLₙ` is a closed immersion. -/
instance isClosedImmersion_kostantToralSubsystemGroupSchemeι (S : Set I) :
    IsClosedImmersion
      (kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S).hom.hom.left := by
  rw [kostantToralSubsystemGroupSchemeι, CommHopfAlgCat.quotientSpecι_def]
  apply (CommHopfAlgCat.isClosedImmersion_hopfSpec_map_comp_eqToHom_iff
    (GeneralLinear.groupScheme_def ℤ n)
    (CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
      (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S))).mpr
  exact Ideal.Quotient.mkₐ_surjective ℤ
    (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S).toIdeal

/-- An inclusion `S ⊆ T` induces the closed immersion from the carrier generated by `S` into
the carrier generated by `T`. -/
noncomputable def kostantToralSubsystemMapOfSubset {S T : Set I} (hST : S ⊆ T) :
    kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S ⟶
      kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt T :=
  CommHopfAlgCat.quotientSpecMapOfLe (GeneralLinear.coordinateHopfAlgebra ℤ n)
    (kostantToralSubsystemDefiningIdeal_antitone e h ρ M hM hnil b wt hST)

/-- The map induced by inclusion of selected root sets is a closed immersion. -/
instance isClosedImmersion_kostantToralSubsystemMapOfSubset {S T : Set I} (hST : S ⊆ T) :
    IsClosedImmersion
      (kostantToralSubsystemMapOfSubset e h ρ M hM hnil b wt hST).hom.hom.left := by
  unfold kostantToralSubsystemMapOfSubset
  infer_instance

/-- The inclusion induced by `S ⊆ T`, followed by the inclusion into `GLₙ`, is the direct
inclusion of the `S`-carrier. -/
@[simp]
theorem kostantToralSubsystemMapOfSubset_comp_ι {S T : Set I} (hST : S ⊆ T) :
    kostantToralSubsystemMapOfSubset e h ρ M hM hnil b wt hST ≫
        kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt T =
      kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S := by
  rw [kostantToralSubsystemMapOfSubset, kostantToralSubsystemGroupSchemeι,
    kostantToralSubsystemGroupSchemeι, ← Category.assoc,
    CommHopfAlgCat.quotientSpecMapOfLe_comp_quotientSpecι]

/-- Closed subsystem inclusions compose along inclusions of selected root sets. -/
@[simp]
theorem kostantToralSubsystemMapOfSubset_comp {S T U : Set I}
    (hST : S ⊆ T) (hTU : T ⊆ U) :
    kostantToralSubsystemMapOfSubset e h ρ M hM hnil b wt hST ≫
        kostantToralSubsystemMapOfSubset e h ρ M hM hnil b wt hTU =
      kostantToralSubsystemMapOfSubset e h ρ M hM hnil b wt (hST.trans hTU) := by
  rw [kostantToralSubsystemMapOfSubset, kostantToralSubsystemMapOfSubset,
    kostantToralSubsystemMapOfSubset,
    CommHopfAlgCat.quotientSpecMapOfLe_comp]

/-- The toral-subsystem carrier as a closed subgroup scheme of the full toral closure. -/
noncomputable def kostantToralSubsystemToToral (S : Set I) :
    kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S ⟶
      kostantToralGroupScheme e h ρ M hM hnil b wt :=
  CommHopfAlgCat.quotientSpecMapOfLe (GeneralLinear.coordinateHopfAlgebra ℤ n)
    (kostantToralDefiningIdeal_le_kostantToralSubsystemDefiningIdeal
      e h ρ M hM hnil b wt S)

/-- The subsystem carrier includes into the full toral closure as a closed immersion. -/
instance isClosedImmersion_kostantToralSubsystemToToral (S : Set I) :
    IsClosedImmersion (kostantToralSubsystemToToral e h ρ M hM hnil b wt S).hom.hom.left := by
  unfold kostantToralSubsystemToToral
  infer_instance

/-- The subsystem inclusion followed by the full toral inclusion is its direct inclusion into
`GLₙ`. -/
@[simp]
theorem kostantToralSubsystemToToral_comp_ι (S : Set I) :
    kostantToralSubsystemToToral e h ρ M hM hnil b wt S ≫
        kostantToralGroupSchemeι e h ρ M hM hnil b wt =
      kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S := by
  rw [kostantToralSubsystemToToral, kostantToralGroupSchemeι_def,
    kostantToralSubsystemGroupSchemeι, ← Category.assoc,
    CommHopfAlgCat.quotientSpecMapOfLe_comp_quotientSpecι]

/-- A toral-subsystem carrier, regarded as a closed subgroup scheme of the full toral closure. -/
noncomputable def kostantToralSubsystemClosedSubgroup (S : Set I) :
    ClosedSubgroupScheme (kostantToralGroupScheme e h ρ M hM hnil b wt) :=
  ClosedSubgroupScheme.mk (kostantToralSubsystemToToral e h ρ M hM hnil b wt S)

/-- The underlying subobject of a toral subsystem is represented by its canonical inclusion. -/
@[simp]
theorem coe_kostantToralSubsystemClosedSubgroup (S : Set I) :
    (kostantToralSubsystemClosedSubgroup e h ρ M hM hnil b wt S).1 =
      Subobject.mk (kostantToralSubsystemToToral e h ρ M hM hnil b wt S) :=
  ClosedSubgroupScheme.coe_mk _

/-- The coordinate map through which a selected root subgroup factors into its subsystem
carrier. -/
noncomputable def kostantRootSubgroupToralSubsystemCoordinateMap (S : Set I)
    {i : I} (hi : i ∈ S) :
    CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
        (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ⟶
      AdditiveGroup.coordinateHopfAlgebra ℤ :=
  CommHopfAlgCat.commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inl ⟨i, hi⟩)

/-- The selected root-subgroup factorization recovers its represented coordinate map. -/
@[simp]
theorem mkQuotient_comp_kostantRootSubgroupToralSubsystemCoordinateMap (S : Set I)
    {i : I} (hi : i ∈ S) :
    CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ≫
        kostantRootSubgroupToralSubsystemCoordinateMap e h ρ M hM hnil b wt S hi =
      kostantRootSubgroupCoordinateMap e h ρ M hM i (hnil i) b :=
  CommHopfAlgCat.mkQuotient_comp_commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inl ⟨i, hi⟩)

/-- The coordinate map through which the weight torus factors into a subsystem carrier. -/
noncomputable def kostantWeightTorusToralSubsystemCoordinateMap (S : Set I) :
    CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
        (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ⟶
      (DiagonalizableGroup.coordinateRing ℤ (SplitTorus.characterGroup κ)).obj :=
  CommHopfAlgCat.commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inr ())

/-- The weight-torus factorization recovers its represented coordinate map. -/
@[simp]
theorem mkQuotient_comp_kostantWeightTorusToralSubsystemCoordinateMap (S : Set I) :
    CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ n)
          (kostantToralSubsystemDefiningIdeal e h ρ M hM hnil b wt S) ≫
        kostantWeightTorusToralSubsystemCoordinateMap e h ρ M hM hnil b wt S =
      GeneralLinear.weightTorusCoordinateMap wt :=
  CommHopfAlgCat.mkQuotient_comp_commonKernelLift
    (kostantToralSubsystemGeneratorMap e h ρ M hM hnil b wt S) (.inr ())

/-- A selected represented Kostant root subgroup, factored through the subsystem carrier. -/
noncomputable def kostantRootSubgroupToToralSubsystem (S : Set I) {i : I} (hi : i ∈ S) :
    AdditiveGroup.groupScheme ℤ ⟶
      kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S :=
  eqToHom (AdditiveGroup.groupScheme_def ℤ) ≫
    (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map
      (kostantRootSubgroupToralSubsystemCoordinateMap e h ρ M hM hnil b wt S hi).op

/-- Factoring a selected root subgroup through its subsystem carrier and then including into
`GLₙ` recovers the represented root-subgroup morphism. -/
@[simp]
theorem kostantRootSubgroupToToralSubsystem_comp_ι (S : Set I) {i : I} (hi : i ∈ S) :
    kostantRootSubgroupToToralSubsystem e h ρ M hM hnil b wt S hi ≫
        kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S =
      kostantRootSubgroup e h ρ M hM i (hnil i) b := by
  rw [kostantRootSubgroupToToralSubsystem, kostantToralSubsystemGroupSchemeι,
    CommHopfAlgCat.quotientSpecι_def, kostantRootSubgroup_def]
  slice_lhs 2 3 =>
    rw [← (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map_comp,
      ← op_comp, mkQuotient_comp_kostantRootSubgroupToralSubsystemCoordinateMap]

/-- Factoring a selected root subgroup through its subsystem and then into the full toral closure
agrees with the direct toral factorization. -/
@[simp]
theorem kostantRootSubgroupToToralSubsystem_comp_kostantToralSubsystemToToral
    (S : Set I) {i : I} (hi : i ∈ S) :
    kostantRootSubgroupToToralSubsystem e h ρ M hM hnil b wt S hi ≫
        kostantToralSubsystemToToral e h ρ M hM hnil b wt S =
      kostantRootSubgroupToToral e h ρ M hM hnil b wt i := by
  apply (cancel_mono (kostantToralGroupSchemeι e h ρ M hM hnil b wt)).1
  rw [Category.assoc, kostantToralSubsystemToToral_comp_ι,
    kostantRootSubgroupToToralSubsystem_comp_ι, kostantRootSubgroupToToral_comp_ι]

/-- The represented weight torus, factored through a toral-subsystem carrier. -/
noncomputable def kostantWeightTorusToToralSubsystem (S : Set I) :
    SplitTorus.groupScheme ℤ κ ⟶
      kostantToralSubsystemGroupScheme e h ρ M hM hnil b wt S :=
  eqToHom (DiagonalizableGroup.groupScheme_def ℤ (SplitTorus.characterGroup κ)) ≫
    (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map
      (kostantWeightTorusToralSubsystemCoordinateMap e h ρ M hM hnil b wt S).op

/-- Factoring the weight torus through a subsystem carrier and then including into `GLₙ`
recovers the represented weight-torus morphism. -/
@[simp]
theorem kostantWeightTorusToToralSubsystem_comp_ι (S : Set I) :
    kostantWeightTorusToToralSubsystem e h ρ M hM hnil b wt S ≫
        kostantToralSubsystemGroupSchemeι e h ρ M hM hnil b wt S =
      GeneralLinear.weightTorus (R := ℤ) wt := by
  rw [kostantWeightTorusToToralSubsystem, kostantToralSubsystemGroupSchemeι,
    CommHopfAlgCat.quotientSpecι_def, GeneralLinear.weightTorus_def]
  slice_lhs 2 3 =>
    rw [← (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).map_comp,
      ← op_comp, mkQuotient_comp_kostantWeightTorusToralSubsystemCoordinateMap]

/-- Factoring the weight torus through a subsystem and then into the full toral closure agrees
with the direct toral factorization. -/
@[simp]
theorem kostantWeightTorusToToralSubsystem_comp_kostantToralSubsystemToToral (S : Set I) :
    kostantWeightTorusToToralSubsystem e h ρ M hM hnil b wt S ≫
        kostantToralSubsystemToToral e h ρ M hM hnil b wt S =
      kostantWeightTorusToToral e h ρ M hM hnil b wt := by
  apply (cancel_mono (kostantToralGroupSchemeι e h ρ M hM hnil b wt)).1
  rw [Category.assoc, kostantToralSubsystemToToral_comp_ι,
    kostantWeightTorusToToralSubsystem_comp_ι, kostantWeightTorusToToral_comp_ι]

end TauCeti.UniversalEnvelopingAlgebra
