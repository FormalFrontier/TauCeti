module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Exponential
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Orbit

/-!
# Root subgroup actions on Kostant-stable lattices

Let `U_ℤ = kostantForm e h` be a Kostant integral form in `U(L)`, let `ρ` be a representation of
`U(L)` on a rational vector space `V`, and let `M ≤ V` be an additive subgroup preserved by
`ρ(U_ℤ)`. If the endomorphism `ρ(eᵢ)` is nilpotent, the integral exponentials

```text
x_i(t) = exp (t ρ(eᵢ)),   t ∈ ℤ,
```

preserve `M`. This file strengthens preservation to the action-level statement needed by the
Chevalley--Demazure construction: the maps `x_i(t)` form a group homomorphism from the additive
group of integers to the additive automorphisms of `M`.

The construction uses `TauCeti.expZSMulAddAut`, which packages the action of integral nilpotent
exponentials on any additive subgroup stable under the corresponding divided powers. Stability
under the whole Kostant form supplies that hypothesis because the divided powers of every
designated root vector are Kostant generators.

## Main result

* `TauCeti.UniversalEnvelopingAlgebra.expZSMulKostantAddAut`: the integral one-parameter root
  subgroup acts by additive automorphisms on every Kostant-stable lattice.
* `TauCeti.UniversalEnvelopingAlgebra.expZSMulKostantOrbitAddAut`: the canonical specialization to
  the integral orbit generated by a vector under the Kostant form.

This advances Layer 9, “Root subgroup maps,” of the ReductiveGroups roadmap. The resulting integral
action is the pointwise algebra needed before these automorphisms are assembled into the root
subgroup morphisms `x_α : 𝔾ₐ → G` of the pinned Chevalley--Demazure group scheme.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26--27.
* R. W. Carter, *Simple Groups of Lie Type*, §4.4.
-/

public section

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v w

variable {L : Type u} [LieRing L] [LieAlgebra ℚ L]
variable {ι : Type w} {κ : Type*}
variable {V : Type v} [AddCommGroup V] [Module ℚ V]

/-- The integral one-parameter root subgroup attached to `e i`, acting on an additive subgroup
preserved by the Kostant form.

The target is the additive automorphism group of `M`, written multiplicatively so that the
one-parameter group law is exposed as a `MonoidHom`. No freeness or finite-generation assumption on
`M` is needed for this action-level statement. -/
noncomputable def expZSMulKostantAddAut (e : ι → L) (h : κ → L)
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V) (M : AddSubgroup V)
    (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M) (i : ι)
    (hnil : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))) :
    Multiplicative ℤ →* Multiplicative (AddAut M) :=
  TauCeti.expZSMulAddAut hnil M fun n v hv => by
    rw [← Associative.map_dividedPower ρ n]
    exact hM _ (dividedPower_mem_kostantForm e h i n) v hv

/-- The root subgroup action on a Kostant-stable lattice is the ambient nilpotent exponential. -/
@[simp]
theorem coe_expZSMulKostantAddAut (e : ι → L) (h : κ → L)
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V) (M : AddSubgroup V)
    (hM : ∀ u ∈ kostantForm e h, ∀ v ∈ M, ρ u v ∈ M) (i : ι)
    (hnil : IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
    (t : Multiplicative ℤ) (v : M) :
    ((Multiplicative.toAdd (expZSMulKostantAddAut e h ρ M hM i hnil t) v : M) : V) =
      IsNilpotent.exp ((Multiplicative.toAdd t : ℤ) •
        ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))) (v : V) := by
  simp only [expZSMulKostantAddAut, TauCeti.coe_expZSMulAddAut, Module.End.smul_def]

/-! ## The action on the canonical Kostant orbit -/

variable [Module (_root_.UniversalEnvelopingAlgebra ℚ L) V]
variable [IsScalarTower ℚ (_root_.UniversalEnvelopingAlgebra ℚ L) V]

/-- The integral one-parameter root subgroup acting on the Kostant orbit generated by `v`.

Unlike `expZSMulKostantAddAut`, this specialization has no separate stability hypothesis: the
Kostant orbit is stable under the whole Kostant form by construction. The only remaining
hypothesis is the genuine representation-theoretic condition that the chosen root vector acts
nilpotently on `V`. -/
noncomputable def expZSMulKostantOrbitAddAut (e : ι → L) (h : κ → L) (v : V) (i : ι)
    (hnil : IsNilpotent ((Algebra.lsmul ℚ ℚ V)
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i)))) :
    Multiplicative ℤ →* Multiplicative (AddAut (kostantOrbit e h v)) :=
  expZSMulKostantAddAut e h (Algebra.lsmul ℚ ℚ V) (kostantOrbit e h v).toAddSubgroup
    (fun _ hu _ hx => smul_mem_kostantOrbit hu hx) i hnil

/-- On the ambient rational representation, the action on the Kostant orbit is the nilpotent
exponential of the chosen root-vector endomorphism. -/
@[simp]
theorem coe_expZSMulKostantOrbitAddAut (e : ι → L) (h : κ → L) (v : V) (i : ι)
    (hnil : IsNilpotent ((Algebra.lsmul ℚ ℚ V)
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))))
    (t : Multiplicative ℤ) (x : kostantOrbit e h v) :
    ((Multiplicative.toAdd (expZSMulKostantOrbitAddAut e h v i hnil t) x :
      kostantOrbit e h v) : V) =
      IsNilpotent.exp ((Multiplicative.toAdd t : ℤ) •
        (Algebra.lsmul ℚ ℚ V) (_root_.UniversalEnvelopingAlgebra.ι ℚ (e i))) (x : V) := by
  apply coe_expZSMulKostantAddAut

end TauCeti.UniversalEnvelopingAlgebra
