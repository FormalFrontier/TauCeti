public section

/-!
# The subalgebra of an enveloping algebra generated by a Lie subalgebra

For a Lie subalgebra `A` of `L`, this file names the `R`-subalgebra
`TauCeti.UniversalEnvelopingAlgebra.envelopingSubalgebra R A` of `U(L)` generated by the canonical
Lie generators of `A`, identifies it with the image of `U(A)` under the functorial map
`U(A) → U(L)` of `TauCeti/Algebra/Lie/UniversalEnveloping/Functoriality.lean`, and proves the
factorisation of `U(L)` that a splitting of a Lie subalgebra into two Lie subalgebras induces.

## The factorisation

Let `C` be a Lie subalgebra of `L` whose underlying submodule is the sum of the underlying
submodules of two Lie subalgebras `A` and `B`, so that `C = A + B` as modules — the sum is not
assumed to be direct, and neither summand is assumed to be an ideal. Then

`U(A) · U(B) = U(C)`

as `R`-submodules of `U(L)`, where `U(A) · U(B)` denotes the submodule spanned by the products.
The proof is a straightening argument: a generator of `B` moves to the right across a word in the
generators of `A` at the cost of a bracket, and that bracket is again a sum of an element of `A`
and an element of `B` because `C` is closed under the bracket.

No Poincaré--Birkhoff--Witt input is used, and correspondingly the conclusion is a *spanning*
statement about a product of submodules. It is strictly weaker than the assertion that `U(C)` is
free as a left `U(A)`-module on a basis of `U(B)`, which is the Poincaré--Birkhoff--Witt half and
is not proved here.

## Main definitions

* `TauCeti.UniversalEnvelopingAlgebra.envelopingSubalgebra`: the subalgebra of `U(L)` generated by
  the canonical Lie generators of a Lie subalgebra of `L`.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.envelopingSubalgebra_le_iff`: the elimination rule, saying
  that the enveloping subalgebra of `A` is the smallest subalgebra containing the canonical Lie
  generators of `A`.
* `TauCeti.UniversalEnvelopingAlgebra.envelopingSubalgebra_eq_range_map`: the enveloping
  subalgebra of `A` is the image of `U(A)` in `U(L)`, which is what makes the name accurate, and
  `TauCeti.UniversalEnvelopingAlgebra.mem_envelopingSubalgebra_iff`, its membership form.
* `envelopingSubalgebra_mul_envelopingSubalgebra_eq_envelopingSubalgebra`: **the factorisation**
  `U(A) · U(B) = U(C)` for a Lie subalgebra `C` with `C = A + B` as modules, and
  `TauCeti.UniversalEnvelopingAlgebra.envelopingSubalgebra_mul_envelopingSubalgebra_eq_top`, its
  reading at `C = L`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §17.2.
-/

open UniversalEnvelopingAlgebra

namespace TauCeti.UniversalEnvelopingAlgebra

universe u v

variable (R : Type u) {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "U" => _root_.UniversalEnvelopingAlgebra R L

-- Mathlib does not register the Lie ring of an associative ring as a global instance; the
-- canonical Lie generators of `U(L)` are a Lie algebra homomorphism into it.
attribute [local instance 100] LieRing.ofAssociativeRing

/-! ### The subalgebra generated by a Lie subalgebra -/

/-- **The enveloping subalgebra of a Lie subalgebra** `A` of `L`: the `R`-subalgebra of `U(L)`
generated by the canonical Lie generators `ι R x` for `x` in `A`.

It is the image of `U(A)` in `U(L)`, which is
`TauCeti.UniversalEnvelopingAlgebra.envelopingSubalgebra_eq_range_map`, but it is defined here as
a subalgebra of `U(L)` so that statements comparing several of them — the factorisation below
first of all — are statements inside the single algebra `U(L)`. -/
def envelopingSubalgebra (A : LieSubalgebra R L) : Subalgebra R U :=
  Algebra.adjoin R ((ι R : L →ₗ⁅R⁆ U) '' (A : Set L))

/-- The enveloping subalgebra of `A` is the subalgebra generated by the canonical Lie generators
of `A`. -/
theorem envelopingSubalgebra_eq_adjoin (A : LieSubalgebra R L) :
    envelopingSubalgebra R A = Algebra.adjoin R ((ι R : L →ₗ⁅R⁆ U) '' (A : Set L)) :=
  (rfl)

/-- The canonical Lie generator of an element of `A` lies in the enveloping subalgebra of `A`. -/
theorem ι_mem_envelopingSubalgebra {A : LieSubalgebra R L} {x : L} (hx : x ∈ A) :
    (ι R x : U) ∈ envelopingSubalgebra R A :=
  Algebra.subset_adjoin ⟨x, hx, rfl⟩

/-- **The elimination rule**: the enveloping subalgebra of `A` is the smallest subalgebra of `U(L)`
containing the canonical Lie generators of `A`. -/
@[simp]
theorem envelopingSubalgebra_le_iff {A : LieSubalgebra R L} {S : Subalgebra R U} :
    envelopingSubalgebra R A ≤ S ↔ ∀ x ∈ A, (ι R x : U) ∈ S := by
  rw [envelopingSubalgebra_eq_adjoin, Algebra.adjoin_le_iff]
  exact ⟨fun h x hx => h ⟨x, hx, rfl⟩, by rintro h _ ⟨x, hx, rfl⟩; exact h x hx⟩

/-- **Monotonicity**: an inclusion `h : A ≤ B` of Lie subalgebras of `L` induces an inclusion of
their enveloping subalgebras, the canonical Lie generators of `A` being among those of `B`. -/
@[gcongr]
theorem envelopingSubalgebra_mono {A B : LieSubalgebra R L} (h : A ≤ B) :
    envelopingSubalgebra R A ≤ envelopingSubalgebra R B :=
  (envelopingSubalgebra_le_iff R).mpr fun _ hx => ι_mem_envelopingSubalgebra R (h hx)

/-- The enveloping subalgebra generated by the zero Lie subalgebra consists only of scalars. -/
@[simp]
theorem envelopingSubalgebra_bot :
    envelopingSubalgebra R (⊥ : LieSubalgebra R L) = ⊥ := by
  refine bot_unique ((envelopingSubalgebra_le_iff R).mpr fun x hx => ?_)
  simp only [LieSubalgebra.mem_bot] at hx
  subst x
  simpa only [map_zero] using (⊥ : Subalgebra R U).zero_mem

/-- The enveloping subalgebra generated by a supremum is the supremum of the enveloping
subalgebras. -/
@[simp]
theorem envelopingSubalgebra_sup (A B : LieSubalgebra R L) :
    envelopingSubalgebra R (A ⊔ B) = envelopingSubalgebra R A ⊔ envelopingSubalgebra R B := by
  apply le_antisymm
  · rw [envelopingSubalgebra_le_iff]
    let S : LieSubalgebra R L := LieSubalgebra.comap (ι R : L →ₗ⁅R⁆ U)
      (lieSubalgebraOfSubalgebra R U
        (envelopingSubalgebra R A ⊔ envelopingSubalgebra R B))
    -- Membership of `x` in `S` is, by definition of `LieSubalgebra.comap`, membership of the
    -- canonical Lie generator `ι R x` in the join, so the two inequalities of subalgebras below
    -- are exactly what places the generators of `A` and of `B` in the join.
    have hAle : envelopingSubalgebra R A ≤ envelopingSubalgebra R A ⊔ envelopingSubalgebra R B :=
      le_sup_left
    have hBle : envelopingSubalgebra R B ≤ envelopingSubalgebra R A ⊔ envelopingSubalgebra R B :=
      le_sup_right
    have hA : A ≤ S := fun _ hx => hAle (ι_mem_envelopingSubalgebra R hx)
    have hB : B ≤ S := fun _ hx => hBle (ι_mem_envelopingSubalgebra R hx)
    exact sup_le hA hB
  · exact sup_le (envelopingSubalgebra_mono R le_sup_left)
      (envelopingSubalgebra_mono R le_sup_right)

/-- The enveloping subalgebra of `L` itself is all of `U(L)`, the canonical Lie generators
generating `U(L)`. -/
@[simp]
theorem envelopingSubalgebra_top :
    envelopingSubalgebra R (⊤ : LieSubalgebra R L) = ⊤ := by
  rw [envelopingSubalgebra_eq_adjoin, LieSubalgebra.top_coe, Set.image_univ, adjoin_range_ι R L]

/-- **The enveloping subalgebra of `A` is the image of `U(A)` in `U(L)`.** This identifies the
subalgebra named here with the enveloping algebra of `A`, and is what licenses reading
`envelopingSubalgebra R A` as `U(A)`. -/
theorem envelopingSubalgebra_eq_range_map (A : LieSubalgebra R L) :
    envelopingSubalgebra R A = (map R A.incl).range := by
  refine le_antisymm ((envelopingSubalgebra_le_iff R).mpr fun x hx =>
    (AlgHom.mem_range _).mpr ⟨ι R (⟨x, hx⟩ : A), by rw [map_ι, LieSubalgebra.coe_incl]⟩)
    fun u hu => ?_
  obtain ⟨w, rfl⟩ := (AlgHom.mem_range _).mp hu
  clear hu
  induction w using induction_ι with
  | ι x => rw [map_ι]; exact ι_mem_envelopingSubalgebra R x.2
  | algebraMap r => rw [AlgHom.commutes]; exact Subalgebra.algebraMap_mem _ r
  | add a b ha hb => rw [map_add]; exact add_mem ha hb
  | mul a b ha hb => rw [map_mul]; exact mul_mem ha hb

/-- **Membership in the enveloping subalgebra of `A`**: an element of `U(L)` lies in it exactly when
it is the image of an element of `U(A)` under the functorial map. This is the membership form of
`TauCeti.UniversalEnvelopingAlgebra.envelopingSubalgebra_eq_range_map`. -/
@[simp]
theorem mem_envelopingSubalgebra_iff {A : LieSubalgebra R L} {u : U} :
    u ∈ envelopingSubalgebra R A ↔ ∃ w, map R A.incl w = u := by
  rw [envelopingSubalgebra_eq_range_map, AlgHom.mem_range]

/-! ### The factorisation induced by a splitting of a Lie subalgebra -/

section Factorisation

variable {R}
variable {A B C : LieSubalgebra R L}

/-- Left multiplication by a canonical Lie generator of `A` preserves the product `U(A) · U(B)`,
because it preserves the left factor. -/
private theorem ι_mul_mem_mul_of_mem_left {x : L} (hx : x ∈ A) {t : U}
    (ht : t ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
      Subalgebra.toSubmodule (envelopingSubalgebra R B)) :
    (ι R x : U) * t ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
      Subalgebra.toSubmodule (envelopingSubalgebra R B) := by
  refine Submodule.mul_induction_on ht (fun m hm n hn => ?_) (fun y z hy hz => ?_)
  · rw [← mul_assoc]
    exact Submodule.mul_mem_mul ((Subalgebra.mem_toSubmodule _).mpr
      (mul_mem (ι_mem_envelopingSubalgebra R hx) ((Subalgebra.mem_toSubmodule _).mp hm))) hn
  · rw [mul_add]
    exact Submodule.add_mem _ hy hz

/-- Right multiplication by an element of `U(B)` preserves the product `U(A) · U(B)`, because it
preserves the right factor. -/
private theorem mul_mem_mul_of_mem_right {t n : U}
    (ht : t ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
      Subalgebra.toSubmodule (envelopingSubalgebra R B))
    (hn : n ∈ envelopingSubalgebra R B) :
    t * n ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
      Subalgebra.toSubmodule (envelopingSubalgebra R B) := by
  refine Submodule.mul_induction_on ht (fun m hm n' hn' => ?_) (fun y z hy hz => ?_)
  · rw [mul_assoc]
    exact Submodule.mul_mem_mul hm ((Subalgebra.mem_toSubmodule _).mpr
      (mul_mem ((Subalgebra.mem_toSubmodule _).mp hn') hn))
  · rw [add_mul]
    exact Submodule.add_mem _ hy hz

/-- The product `U(A) · U(B)` contains `U(A)`, the right factor containing `1`. -/
private theorem le_mul_envelopingSubalgebra_left :
    Subalgebra.toSubmodule (envelopingSubalgebra R A) ≤
      Subalgebra.toSubmodule (envelopingSubalgebra R A) *
        Subalgebra.toSubmodule (envelopingSubalgebra R B) := fun a ha => by
  simpa using Submodule.mul_mem_mul ha
    ((Subalgebra.mem_toSubmodule (envelopingSubalgebra R B)).mpr (one_mem _))

/-- The product `U(A) · U(B)` contains `U(B)`, the left factor containing `1`. -/
private theorem le_mul_envelopingSubalgebra_right :
    Subalgebra.toSubmodule (envelopingSubalgebra R B) ≤
      Subalgebra.toSubmodule (envelopingSubalgebra R A) *
        Subalgebra.toSubmodule (envelopingSubalgebra R B) := fun c hc => by
  simpa using Submodule.mul_mem_mul
    ((Subalgebra.mem_toSubmodule (envelopingSubalgebra R A)).mpr (one_mem _)) hc

/-- The product `U(A) · U(B)` contains `1`. -/
private theorem one_mem_mul_envelopingSubalgebra :
    (1 : U) ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
      Subalgebra.toSubmodule (envelopingSubalgebra R B) :=
  le_mul_envelopingSubalgebra_left
    ((Subalgebra.mem_toSubmodule (envelopingSubalgebra R A)).mpr (one_mem _))

/-- **The commutation rule for the canonical Lie generators.** Moving the generator of `y` past the
generator of `z` in `U(L)` costs the generator of the bracket `⁅y, z⁆`. -/
private theorem ι_mul_ι_eq_ι_mul_ι_add_ι_lie (y z : L) :
    (ι R y : U) * ι R z = ι R z * ι R y + ι R ⁅y, z⁆ := by
  have h := mul_sub_mul_eq_map_ι_lie (AlgHom.id R U) y z
  simp only [AlgHom.id_apply] at h
  rw [← h]
  abel

/-- **The straightening identity.** If the bracket `⁅y, z⁆` splits as `wa + wb`, then moving the
canonical Lie generator of `y` past that of `z` in front of an element `a` of `U(L)` costs exactly
the two generators `ι R wa` and `ι R wb` acting on `a`. -/
private theorem ι_mul_ι_mul_eq_of_add_eq_lie {y z wa wb : L} (hsum : wa + wb = ⁅y, z⁆) (a : U) :
    (ι R y : U) * (ι R z * a) = ι R z * (ι R y * a) + (ι R wa * a + ι R wb * a) :=
  calc (ι R y : U) * (ι R z * a)
      = ((ι R z : U) * ι R y + ι R ⁅y, z⁆) * a := by
        rw [← mul_assoc, ι_mul_ι_eq_ι_mul_ι_add_ι_lie]
    _ = ι R z * (ι R y * a) + ι R ⁅y, z⁆ * a := by rw [add_mul, mul_assoc]
    _ = ι R z * (ι R y * a) + (ι R wa * a + ι R wb * a) := by rw [← hsum, map_add, add_mul]

/-- **The straightening step.** A canonical Lie generator of `B` moves to the right across an
element of `U(A)` at the cost of brackets, and those brackets are again sums of elements of `A`
and of `B`, so the result stays in `U(A) · U(B)`.

The statement quantifies over the generator of `B` because the induction on the word in the
generators of `A` produces new generators of `B`, namely the `B`-components of the brackets. -/
private theorem ι_mul_mem_mul_of_mem_envelopingSubalgebra
    (hbr : ∀ y ∈ B, ∀ z ∈ A, ⁅y, z⁆ ∈ (A : Submodule R L) ⊔ (B : Submodule R L))
    {a : U} (ha : a ∈ envelopingSubalgebra R A) :
    ∀ y ∈ B, (ι R y : U) * a ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
      Subalgebra.toSubmodule (envelopingSubalgebra R B) := by
  rw [← Subalgebra.mem_toSubmodule, envelopingSubalgebra_eq_adjoin,
    Algebra.adjoin_eq_span] at ha
  induction ha using Submodule.span_induction with
  | mem a hmem =>
    induction hmem using Submonoid.closure_induction_left with
    | one =>
      intro y hy
      rw [mul_one]
      exact le_mul_envelopingSubalgebra_right ((Subalgebra.mem_toSubmodule _).mpr
        (ι_mem_envelopingSubalgebra R hy))
    | mul_left w hw a' ha' ih =>
      obtain ⟨z, hz, rfl⟩ := hw
      intro y hy
      obtain ⟨wa, hwa, wb, hwb, hsum⟩ := Submodule.mem_sup.mp (hbr y hy z hz)
      have haA : a' ∈ envelopingSubalgebra R A := by
        rw [← Subalgebra.mem_toSubmodule, envelopingSubalgebra_eq_adjoin, Algebra.adjoin_eq_span]
        exact Submodule.subset_span ha'
      rw [ι_mul_ι_mul_eq_of_add_eq_lie hsum]
      refine Submodule.add_mem _ ?_ (Submodule.add_mem _ ?_ ?_)
      · exact ι_mul_mem_mul_of_mem_left hz (ih y hy)
      · exact le_mul_envelopingSubalgebra_left ((Subalgebra.mem_toSubmodule _).mpr
          (mul_mem (ι_mem_envelopingSubalgebra R hwa) haA))
      · exact ih wb hwb
  | zero => intro y _; simp
  | add a a' _ _ hfst hsnd =>
    intro y hy
    rw [mul_add]
    exact Submodule.add_mem _ (hfst y hy) (hsnd y hy)
  | smul r a _ hfst =>
    intro y hy
    rw [mul_smul_comm]
    exact Submodule.smul_mem _ r (hfst y hy)

/-- **The product `U(A) · U(B)` absorbs left multiplication by `U(C)`.** The canonical Lie
generators of `C` split as a generator of `A` plus a generator of `B`; the first kind is absorbed
by the left factor and the second by the straightening step above, and the elements absorbing left
multiplication form a subalgebra. -/
private theorem mul_mem_mul_of_mem_envelopingSubalgebra
    (hC : (C : Submodule R L) = (A : Submodule R L) ⊔ (B : Submodule R L))
    (hbr : ∀ y ∈ B, ∀ z ∈ A, ⁅y, z⁆ ∈ (A : Submodule R L) ⊔ (B : Submodule R L))
    {w : U} (hw : w ∈ envelopingSubalgebra R C) :
    ∀ t ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
      Subalgebra.toSubmodule (envelopingSubalgebra R B),
      w * t ∈ Subalgebra.toSubmodule (envelopingSubalgebra R A) *
        Subalgebra.toSubmodule (envelopingSubalgebra R B) := by
  rw [envelopingSubalgebra_eq_adjoin] at hw
  induction hw using Algebra.adjoin_induction with
  | mem w hw =>
    obtain ⟨x, hx, rfl⟩ := hw
    have hx' : x ∈ (A : Submodule R L) ⊔ (B : Submodule R L) := by rw [← hC]; exact hx
    obtain ⟨xa, hxa, xb, hxb, rfl⟩ := Submodule.mem_sup.mp hx'
    intro t ht
    rw [map_add, add_mul]
    refine Submodule.add_mem _ (ι_mul_mem_mul_of_mem_left hxa ht) ?_
    refine Submodule.mul_induction_on ht (fun m hm n hn => ?_) (fun y z hy hz => ?_)
    · rw [← mul_assoc]
      exact mul_mem_mul_of_mem_right
        (ι_mul_mem_mul_of_mem_envelopingSubalgebra hbr
          ((Subalgebra.mem_toSubmodule _).mp hm) xb hxb)
        ((Subalgebra.mem_toSubmodule _).mp hn)
    · rw [mul_add]
      exact Submodule.add_mem _ hy hz
  | algebraMap r =>
    intro t ht
    rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
    exact Submodule.smul_mem _ r ht
  | add a a' _ _ ha ha' =>
    intro t ht
    rw [add_mul]
    exact Submodule.add_mem _ (ha t ht) (ha' t ht)
  | mul a a' _ _ ha ha' =>
    intro t ht
    rw [mul_assoc]
    exact ha _ (ha' t ht)

/-- **The factorisation `U(A) · U(B) = U(C)`** for Lie subalgebras `A`, `B` and `C` of `L` whose
underlying submodules satisfy `C = A + B`.

The inclusion `⊇` is the substance: the product `U(A) · U(B)` absorbs left multiplication by every
element of `U(C)` and contains `1`. The converse inclusion holds because `U(C)` is a subalgebra
containing `U(A)` and `U(B)`.

This is a statement about spanning; it does not say that `U(C)` is free as a left `U(A)`-module,
which is the Poincaré--Birkhoff--Witt half and needs a basis of `L` adapted to the splitting. -/
theorem envelopingSubalgebra_mul_envelopingSubalgebra_eq_envelopingSubalgebra
    (hC : (C : Submodule R L) = (A : Submodule R L) ⊔ (B : Submodule R L)) :
    Subalgebra.toSubmodule (envelopingSubalgebra R A) *
        Subalgebra.toSubmodule (envelopingSubalgebra R B) =
      Subalgebra.toSubmodule (envelopingSubalgebra R C) := by
  have hAC : A ≤ C := fun x hx => by
    rw [← LieSubalgebra.mem_toSubmodule, hC]; exact Submodule.mem_sup_left hx
  have hBC : B ≤ C := fun x hx => by
    rw [← LieSubalgebra.mem_toSubmodule, hC]; exact Submodule.mem_sup_right hx
  have hbr : ∀ y ∈ B, ∀ z ∈ A, ⁅y, z⁆ ∈ (A : Submodule R L) ⊔ (B : Submodule R L) :=
    fun y hy z hz => hC ▸ C.lie_mem (hBC hy) (hAC hz)
  refine le_antisymm (Submodule.mul_le.mpr fun m hm n hn => ?_) fun u hu => ?_
  · exact (Subalgebra.mem_toSubmodule _).mpr
      (mul_mem (envelopingSubalgebra_mono R hAC ((Subalgebra.mem_toSubmodule _).mp hm))
        (envelopingSubalgebra_mono R hBC ((Subalgebra.mem_toSubmodule _).mp hn)))
  · simpa using mul_mem_mul_of_mem_envelopingSubalgebra hC hbr
      ((Subalgebra.mem_toSubmodule _).mp hu) 1 one_mem_mul_envelopingSubalgebra

/-- **The factorisation `U(A) · U(B) = U(L)`** for Lie subalgebras `A` and `B` of `L` whose
underlying submodules span `L`. -/
theorem envelopingSubalgebra_mul_envelopingSubalgebra_eq_top
    (hAB : (A : Submodule R L) ⊔ (B : Submodule R L) = ⊤) :
    Subalgebra.toSubmodule (envelopingSubalgebra R A) *
        Subalgebra.toSubmodule (envelopingSubalgebra R B) = ⊤ := by
  rw [envelopingSubalgebra_mul_envelopingSubalgebra_eq_envelopingSubalgebra (C := ⊤)
      (by rw [hAB, LieSubalgebra.top_toSubmodule]),
    envelopingSubalgebra_top]
  exact Algebra.top_toSubmodule

end Factorisation

end TauCeti.UniversalEnvelopingAlgebra
