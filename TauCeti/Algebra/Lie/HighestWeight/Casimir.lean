/-!
# The Casimir scalar of a highest weight vector

The Casimir element `Ω ∈ U(L)` of `TauCeti/Algebra/Lie/UniversalEnveloping/Casimir.lean` is
central, so it acts on a module generated by an eigenvector by a scalar. This file computes that
scalar on a highest weight vector: if `v` is a highest weight vector of weight `λ` in a module
over a finite-dimensional Lie algebra with non-degenerate Killing form in characteristic zero, then

`Ω · v = (⟨λ, λ⟩ + ⟨λ, 2ρ⟩) · v`,

where `⟨·,·⟩` is the invariant form `TauCeti.invForm` on weights and `2ρ` is the sum of the
positive roots. Completing the square rewrites the scalar as `⟨λ + ρ, λ + ρ⟩ - ⟨ρ, ρ⟩`, the form
in which it enters Weyl's complete reducibility theorem and the Harish-Chandra homomorphism; that
is `TauCeti.IsHighestWeightVector.representation_casimirElement_apply_eq_smul_weylVector`.

The computation is the classical one. Evaluate `Ω = ∑ᵢ xᵢ yᵢ` against the basis of
`TauCeti/Algebra/Lie/Weights/Root/Basis.lean`, adapted to the root space decomposition. The Cartan
block contributes `⟨λ, λ⟩`, because expanding the vector representing `λ` in the Killing-dual basis
of `H` is exactly the sum `∑ᵢ λ(hᵢ) λ(hᵢ*)`. A negative root `α` contributes nothing, since the
positive root vector `x (-α)` annihilates `v`. A positive root `α` contributes `⟨λ, α⟩`, because
moving `x α` past `x (-α)` leaves only the bracket `⁅x α, x (-α)⁆ = α^∨`, and the normalisation
`⟨λ, α^∨⟩ ⟨α, α⟩ = 2 ⟨λ, α⟩` of the invariant form turns the coroot pairing into `⟨λ, α⟩`. Summing
over the positive roots gives `⟨λ, 2ρ⟩`.

Centrality upgrades this from the generator to the whole module: the eigenspace of `Ω` is a Lie
submodule, so on a highest weight module — one generated by `v` — the Casimir element acts by the
same scalar everywhere
(`TauCeti.IsHighestWeightVector.representation_casimirElement_apply_eq_smul_of_lieSpan_eq_top`).

## Main results

* `TauCeti.IsHighestWeightVector.representation_casimirElement_apply_eq_smul`: the Casimir element
  sends a highest weight vector `v` to `(⟨λ, λ⟩ + ⟨λ, 2ρ⟩) • v`.
* `TauCeti.IsHighestWeightVector.representation_casimirElement_apply_eq_smul_weylVector`: the
  completed-square form `⟨λ + ρ, λ + ρ⟩ - ⟨ρ, ρ⟩`.
* `TauCeti.IsHighestWeightVector.representation_casimirElement_apply_eq_smul_of_lieSpan_eq_top`:
  on a highest weight module the Casimir element acts by that scalar on every vector;
  `IsHighestWeightVector.representation_casimirElement_apply_eq_smul_weylVector_of_lieSpan_eq_top`
  is the same statement with the square completed.

## References

This supplies the eigenvalue half of the "Casimir element" item of Layer 5 of
`TauCetiRoadmap/RepresentationTheory/LieHighestWeight/README.md`, whose centrality half is
`TauCeti.casimirElement_mem_center`.

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §22.3 and
  §23.2.
-/

public section

noncomputable section

namespace TauCeti

open Finset LieAlgebra LieAlgebra.IsKilling LieModule Module
open _root_.TauCeti.UniversalEnvelopingAlgebra
  (representation representation_apply_eq_smul_of_lieSpan_eq_top)

universe u v w

variable {K : Type u} {L : Type v} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]

/-- `2` is invertible in a field of characteristic zero: the Casimir computation halves the
coefficient of the Cartan generator coming from each `sl₂`-triple. -/
local instance invertibleTwo : Invertible (2 : K) := invertibleOfNonzero two_ne_zero

/-! ### The two blocks of the sum -/

omit [CharZero K] [IsTriangularizable K H L] in
/-- **The Cartan block of the Casimir sum is `⟨λ, λ⟩`.** Expanding the vector of `H` that
represents `λ` under the Killing form in the Killing-dual basis produces exactly the coefficients
`λ(hᵢ)`, so pairing the expansion with `λ` again gives `∑ᵢ λ(hᵢ*) λ(hᵢ) = ⟨λ, λ⟩`. -/
private theorem sum_lie_lie_cartanKillingDualBasis {ιH : Type*} [Fintype ιH] [DecidableEq ιH]
    (bH : Basis ιH K H) {lam : Dual K H} {v : M} (hv : ∀ u : H, ⁅(u : L), v⁆ = lam u • v) :
    ∑ i, ⁅(bH i : L), ⁅(cartanKillingDualBasis bH i : L), v⁆⁆ = invForm lam lam • v := by
  have hpair : ∀ u : H, killingForm K L (u : L) (((cartanEquivDual H).symm lam : H) : L)
      = lam u := fun u ↦ by
    have hrestrict : killingForm K L (u : L) (((cartanEquivDual H).symm lam : H) : L) =
        LieModule.traceForm K H L u ((cartanEquivDual H).symm lam) :=
      DFunLike.congr_fun (LinearMap.congr_fun (LieAlgebra.restrict_killingForm K L H) u)
        ((cartanEquivDual H).symm lam)
    exact hrestrict.trans (by
      simpa using ((invForm_apply_apply_eq_traceForm (cartanEquivDual H u) lam).symm.trans
        (invForm_cartanEquivDual_left u lam)))
  have hexp := congrArg (⇑lam) (sum_killingForm_smul_cartanKillingDualBasis bH
    ((cartanEquivDual H).symm lam))
  rw [map_sum] at hexp
  have hscalar : ∑ i, lam (cartanKillingDualBasis bH i) * lam (bH i) = invForm lam lam := by
    rw [invForm_apply_apply, ← hexp]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_smul, smul_eq_mul, hpair, mul_comm]
  rw [← hscalar, Finset.sum_smul]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [hv (cartanKillingDualBasis bH i), lie_smul, hv (bH i), smul_smul]

/-- The Killing pairing of opposite root vectors, read through the invariant form on weights:
`κ(x α, x (-α)) = 2 / ⟨α, α⟩`. -/
private theorem killingForm_root_neg_eq_invForm {x : Weight K H L → L} (hx : IsSl2System x)
    {α : Weight K H L} (hα : α.IsNonZero) :
    killingForm K L (x α) (x (-α)) = 2 * (invForm (α : Dual K H) (α : Dual K H))⁻¹ := by
  rw [hx.killingForm_root_neg_eq α hα, invForm_apply_apply]
  simp [Weight.toLinear_apply]

/-- The scalar contributed by commuting a positive root vector past its negative. -/
private theorem inv_killingForm_root_neg_mul_apply_coroot_eq_invForm
    {x : Weight K H L → L} (hx : IsSl2System x) {lam : Dual K H} {α : Weight K H L}
    (hα : α.IsNonZero) :
    (killingForm K L (x α) (x (-α)))⁻¹ * lam (coroot α) = invForm lam (α : Dual K H) := by
  calc
    (killingForm K L (x α) (x (-α)))⁻¹ * lam (coroot α) =
        (2 * (invForm (α : Dual K H) α)⁻¹)⁻¹ * lam (coroot α) := by
      rw [killingForm_root_neg_eq_invForm hx hα]
    _ = 2⁻¹ * (lam (coroot α) * invForm (α : Dual K H) α) := by
      rw [mul_inv, inv_inv]
      ring
    _ = 2⁻¹ * (2 * invForm lam (α : Dual K H)) := by rw [invForm_coroot_weight]
    _ = invForm lam (α : Dual K H) := by
      rw [← mul_assoc, inv_mul_cancel₀ (two_ne_zero : (2 : K) ≠ 0), one_mul]

/-- **The root block of the Casimir sum is `⟨λ, 2ρ⟩`.** A negative root contributes nothing,
because the opposite root vector is positive and annihilates `v`; a positive root `α` contributes
`⟨λ, α⟩`, the bracket `⁅x α, x (-α)⁆` being the coroot `α^∨` and the invariant form being
normalised by `⟨λ, α^∨⟩ ⟨α, α⟩ = 2 ⟨λ, α⟩`. -/
private theorem sum_lie_lie_cartanRootDualFamily {x : Weight K H L → L} (hx : IsSl2System x)
    {b : (IsKilling.rootSystem H).Base} {lam : Dual K H} {v : M}
    (hv : IsHighestWeightVector b lam v) :
    ∑ α : H.root, ⁅x (α : Weight K H L),
        ⁅(killingForm K L (x (α : Weight K H L)) (x (-(α : Weight K H L))))⁻¹ •
          x (-(α : Weight K H L)), v⁆⁆ =
      invForm lam (twoWeylVector (IsKilling.rootSystem H) b) • v := by
  classical
  rw [← posRootsFinset_union_negRootsFinset (IsKilling.rootSystem H) b,
    Finset.sum_union (disjoint_posRootsFinset_negRootsFinset (IsKilling.rootSystem H) b)]
  have hneg : ∑ α ∈ negRootsFinset (IsKilling.rootSystem H) b, ⁅x (α : Weight K H L),
      ⁅(killingForm K L (x (α : Weight K H L)) (x (-(α : Weight K H L))))⁻¹ •
        x (-(α : Weight K H L)), v⁆⁆ = 0 := by
    refine Finset.sum_eq_zero fun α hα ↦ ?_
    have hpos : -α ∈ posRoots (IsKilling.rootSystem H) b := by
      rw [← rootSystem_reflectionPerm_self_eq_neg]
      exact (reflectionPerm_self_mem_posRoots_iff_mem_negRoots (IsKilling.rootSystem H) b α).mpr
        ((mem_negRootsFinset (IsKilling.rootSystem H) b α).mp hα)
    have h0 : ⁅x (-(α : Weight K H L)), v⁆ = 0 :=
      hv.lie_eq_zero_of_mem_rootSpace (α := -α) hpos
        (hx.mem_rootSpace (-(α : Weight K H L)))
    rw [smul_lie, h0, smul_zero, lie_zero]
  have hposterm : ∀ α ∈ posRootsFinset (IsKilling.rootSystem H) b, ⁅x (α : Weight K H L),
      ⁅(killingForm K L (x (α : Weight K H L)) (x (-(α : Weight K H L))))⁻¹ •
        x (-(α : Weight K H L)), v⁆⁆ =
      invForm lam ((IsKilling.rootSystem H).root α) • v := by
    intro α hα
    have hnz : (α : Weight K H L).IsNonZero := LieSubalgebra.isNonZero_coe_root α
    have hzero : ⁅x (α : Weight K H L), v⁆ = 0 :=
      hv.lie_eq_zero_of_mem_rootSpace ((mem_posRootsFinset (IsKilling.rootSystem H) b α).mp hα)
        (hx.mem_rootSpace (α : Weight K H L))
    have hleib : ⁅x (α : Weight K H L), ⁅x (-(α : Weight K H L)), v⁆⁆ =
        lam (coroot (α : Weight K H L)) • v := by
      rw [leibniz_lie, hx.lie_neg _ hnz, hzero, lie_zero, add_zero, hv.lie_eq_smul]
    have hcoeff : (killingForm K L (x (α : Weight K H L)) (x (-(α : Weight K H L))))⁻¹ *
        lam (coroot (α : Weight K H L)) =
        invForm lam ((IsKilling.rootSystem H).root α) := by
      simpa only [rootSystem_root_apply] using
        inv_killingForm_root_neg_mul_apply_coroot_eq_invForm hx (lam := lam) hnz
    rw [smul_lie, lie_smul, hleib, smul_smul, hcoeff]
  rw [Finset.sum_congr rfl hposterm, hneg, add_zero, ← Finset.sum_smul, ← map_sum,
    twoWeylVector_def]

/-! ### The Casimir scalar -/

namespace IsHighestWeightVector

variable {b : (IsKilling.rootSystem H).Base} {lam : Dual K H} {v : M}

/-- **The Casimir scalar of a highest weight vector.** If `v` is a highest weight vector of weight
`λ`, then the Casimir element acts on it by `⟨λ, λ⟩ + ⟨λ, 2ρ⟩`, where `⟨·,·⟩` is the invariant
form on weights and `2ρ` is the sum of the positive roots. -/
theorem representation_casimirElement_apply_eq_smul (hv : IsHighestWeightVector b lam v) :
    representation K L M (casimirElement K L) v =
      (invForm lam lam + invForm lam (twoWeylVector (IsKilling.rootSystem H) b)) • v := by
  classical
  obtain ⟨x, hx⟩ := exists_isSl2System K H (L := L)
  rw [representation_casimirElement_apply (hx.cartanRootBasis (Module.finBasis K H)) v]
  simp only [hx.coe_cartanRootBasis, hx.coe_killingDualBasis_cartanRootBasis, Fintype.sum_sum_type,
    cartanRootFamily_inl, cartanRootFamily_inr, cartanRootDualFamily_inl,
    cartanRootDualFamily_inr]
  rw [sum_lie_lie_cartanKillingDualBasis (Module.finBasis K H) hv.lie_eq_smul,
    sum_lie_lie_cartanRootDualFamily hx hv, add_smul]

/-- **The Casimir scalar of a highest weight vector, with the square completed**:
`⟨λ + ρ, λ + ρ⟩ - ⟨ρ, ρ⟩`, where `ρ` is the Weyl vector. This is the shape in which the scalars of
two highest weights are compared. -/
theorem representation_casimirElement_apply_eq_smul_weylVector
    (hv : IsHighestWeightVector b lam v) :
    representation K L M (casimirElement K L) v =
      (invForm (lam + weylVector (IsKilling.rootSystem H) b)
            (lam + weylVector (IsKilling.rootSystem H) b) -
          invForm (weylVector (IsKilling.rootSystem H) b)
            (weylVector (IsKilling.rootSystem H) b)) • v := by
  rw [hv.representation_casimirElement_apply_eq_smul,
    ← two_smul_weylVector (IsKilling.rootSystem H) b]
  congr 1
  simp only [map_add, map_smul, LinearMap.add_apply, smul_eq_mul]
  rw [(invForm_isSymm (H := H)).eq (weylVector (IsKilling.rootSystem H) b) lam]
  ring

/-- **The Casimir element acts on a highest weight module by its scalar.** The eigenspace of a
central element is a Lie submodule, so once the generator is an eigenvector every vector is. -/
theorem representation_casimirElement_apply_eq_smul_of_lieSpan_eq_top
    (hv : IsHighestWeightVector b lam v) (hgen : LieSubmodule.lieSpan K L {v} = ⊤) (m : M) :
    representation K L M (casimirElement K L) m =
      (invForm lam lam + invForm lam (twoWeylVector (IsKilling.rootSystem H) b)) • m :=
  representation_apply_eq_smul_of_lieSpan_eq_top (casimirElement_mem_center K L)
    hv.representation_casimirElement_apply_eq_smul hgen m

/-- **The Casimir element acts on a highest weight module by its scalar, with the square
completed**: `⟨λ + ρ, λ + ρ⟩ - ⟨ρ, ρ⟩`, where `ρ` is the Weyl vector. -/
theorem representation_casimirElement_apply_eq_smul_weylVector_of_lieSpan_eq_top
    (hv : IsHighestWeightVector b lam v) (hgen : LieSubmodule.lieSpan K L {v} = ⊤) (m : M) :
    representation K L M (casimirElement K L) m =
      (invForm (lam + weylVector (IsKilling.rootSystem H) b)
            (lam + weylVector (IsKilling.rootSystem H) b) -
          invForm (weylVector (IsKilling.rootSystem H) b)
            (weylVector (IsKilling.rootSystem H) b)) • m :=
  representation_apply_eq_smul_of_lieSpan_eq_top (casimirElement_mem_center K L)
    hv.representation_casimirElement_apply_eq_smul_weylVector hgen m

end IsHighestWeightVector

end TauCeti
