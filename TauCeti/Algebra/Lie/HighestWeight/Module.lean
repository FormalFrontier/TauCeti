public import TauCeti.Algebra.Lie.HighestWeight.Basic

public section

/-!
# Highest weight modules: the weight cone and the highest weight line

A **highest weight module** of weight `lam` is a module generated by a highest weight vector `v` of
weight `lam`, that is one with `LieSubmodule.lieSpan K L {v} = ⊤`. This file proves the two
structural facts that make the notion useful, both for an arbitrary such module, finite-dimensional
or not.

* Its weights lie in `lam - Q⁺`, where `Q⁺` is the cone of nonnegative integer combinations of the
  simple roots (`TauCeti.posRootCone`): the weight spaces at those weights already exhaust the
  module (`TauCeti.iSup_genWeightSpace_sub_eq_top`), so no other weight can occur
  (`TauCeti.sub_mem_posRootCone_of_genWeightSpace_ne_bot`).
* Its `lam`-weight space is the line `K ∙ v`
  (`TauCeti.genWeightSpace_eq_span_singleton_of_lieSpan_eq_top`), so `lam` really is the highest
  weight and `v` really is its highest weight vector, up to a nonzero scalar.

## The argument

Neither statement follows from the weight-space decomposition alone: the span of the weight spaces
at the weights `lam - ν` with `ν ∈ Q⁺` is *not* stable under `L`, a positive root vector moving the
top weight space out of the cone. What is true is that the module is exhausted by repeatedly
applying the negative nilradical `n⁻` to `v`, which is the statement `M = U(n⁻) · v` written before
the enveloping algebra is available. It is proved here through a filtration whose `n`-th stage is
spanned by the vectors obtained from `v` by at most `n` brackets with elements of `n⁻`. The key
point is that this filtration is stable under the Borel subalgebra `𝔟 = H + n⁺`, by induction on
`n`: moving `x ∈ 𝔟` past a bracket with `f ∈ n⁻` costs a term `⁅⁅x, f⁆, -⁆`, and the triangular
decomposition `L = n⁻ + 𝔟`
(`TauCeti.negativeNilradical_sup_borelSubalgebra_eq_top`) splits `⁅x, f⁆` into a piece that stays
inside the filtration and a piece the inductive hypothesis handles. With `𝔟` and `n⁻` both
preserving the union of the stages, that union is an `L`-submodule containing `v`, hence everything.

The rest is bookkeeping against the cone. Each stage lies in the span of the weight spaces indexed
by a set of weights stable under adding negative roots, so the union does too, and the independence
of the weight spaces (`LieModule.iSupIndep_genWeightSpace`) converts an inclusion of spans into a
statement about individual weights. Taking the indexing set to exclude `lam` itself is what isolates
the highest weight line, and it is legitimate because a positive root is never cancelled inside the
cone (`TauCeti.add_ne_zero_of_mem_posRootCone`).

## Main results

* `TauCeti.iSup_genWeightSpace_sub_eq_top`: the weight spaces at the weights `lam - ν`, `ν ∈ Q⁺`,
  span a highest weight module.
* `TauCeti.sub_mem_posRootCone_of_genWeightSpace_ne_bot`: hence every weight `chi` of a highest
  weight module satisfies `lam - chi ∈ Q⁺`, and
  `TauCeti.eq_of_isHighestWeightVector_of_lieSpan_eq_top`: a module is a highest weight module for
  at most one weight.
* `TauCeti.genWeightSpace_eq_span_singleton_of_lieSpan_eq_top`: the `lam`-weight space of a highest
  weight module is the line spanned by its highest weight vector.
* `TauCeti.exists_smul_of_isHighestWeightVector_of_lieSpan_eq_top`: consequently any highest weight
  vector of weight `lam` in it is a nonzero multiple of the generating one.

## References

This file supplies the "highest weight modules" half of the "highest weight vectors and modules"
item of Layer 3 of `TauCetiRoadmap/RepresentationTheory/LieHighestWeight/README.md`: "a highest
weight module of weight `λ` is one generated by such a `v`; its weights all lie in `λ - (ℕ-span of
simple roots)`, and its `λ`-weight space is the line `K·v`".

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §20.2.
-/

namespace TauCeti

open LieAlgebra LieModule Module

universe u v w

variable {K : Type u} {L : Type v} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]

/-! ### Elements of the Lie algebra preserving a submodule -/

/-- The elements of `L` preserving a `K`-submodule `N` of `M`, as a Lie subalgebra: the bracket is
linear in its left argument, and the Leibniz rule `lie_lie` closes the set under brackets.

Being a Lie *subalgebra* is what lets `TauCeti.negativeNilradical_le_iff`, whose target is a Lie
subalgebra, reduce stability of `N` under `n⁻` to stability under each negative root space. -/
private def stabilizer (N : Submodule K M) : LieSubalgebra K L where
  carrier := {x : L | ∀ m ∈ N, ⁅x, m⁆ ∈ N}
  add_mem' hx hy m hm := by rw [add_lie]; exact add_mem (hx m hm) (hy m hm)
  zero_mem' m _ := by rw [zero_lie]; exact N.zero_mem
  smul_mem' c x hx m hm := by rw [smul_lie]; exact N.smul_mem c (hx m hm)
  lie_mem' hx hy m hm := by rw [lie_lie]; exact sub_mem (hx _ (hy m hm)) (hy _ (hx m hm))

omit [CharZero K] [IsKilling K L] [FiniteDimensional K L] [IsTriangularizable K H L] in
private theorem mem_stabilizer {N : Submodule K M} {x : L} :
    x ∈ (stabilizer N : LieSubalgebra K L) ↔ ∀ m ∈ N, ⁅x, m⁆ ∈ N :=
  Iff.rfl

omit [CharZero K] [IsKilling K L] [FiniteDimensional K L] [IsTriangularizable K H L] in
/-- The stabilizer condition, phrased so that it can be checked by `sup_le` and `iSup_le`. -/
private theorem mem_stabilizer_iff {N : Submodule K M} {x : L} :
    x ∈ (stabilizer N : LieSubalgebra K L) ↔ N ≤ Submodule.comap (toEnd K L M x) N :=
  ⟨fun h _ hm => Submodule.mem_comap.mpr (by rw [toEnd_apply_apply]; exact h _ hm),
    fun h _ hm => by
      have := h hm
      rwa [Submodule.mem_comap, toEnd_apply_apply] at this⟩

variable (H)
variable (b : (IsKilling.rootSystem H).Base)

/-- **A submodule stable under `n⁻` and under `𝔟` is stable under `L`**, by the triangular
decomposition `L = n⁻ + (H + n⁺)`. -/
private theorem lie_mem_of_stabilizer (N : Submodule K M)
    (hneg : negativeNilradical H b ≤ stabilizer N)
    (hbor : borelSubalgebra H b ≤ stabilizer N) {x : L} {m : M} (hm : m ∈ N) : ⁅x, m⁆ ∈ N := by
  have hx : x ∈ (negativeNilradical H b : Submodule K L)
      ⊔ (borelSubalgebra H b : Submodule K L) := by
    rw [negativeNilradical_sup_borelSubalgebra_eq_top]; trivial
  obtain ⟨g, hg, y, hy, rfl⟩ := Submodule.mem_sup.mp hx
  rw [add_lie]
  exact add_mem (hneg hg m hm) (hbor hy m hm)

/-! ### The filtration by the number of lowering operators -/

/-- One step of the lowering filtration: the span of the brackets `⁅x, m⁆` of an element `x` of the
negative nilradical with an element `m` of `N`. -/
private def lieStep (N : Submodule K M) : Submodule K M :=
  Submodule.span K {y : M | ∃ x ∈ negativeNilradical H b, ∃ m ∈ N, y = ⁅x, m⁆}

variable {H b}

omit [LieModule K L M] in
private theorem lie_mem_lieStep {N : Submodule K M} {x : L}
    (hx : x ∈ negativeNilradical H b) {m : M} (hm : m ∈ N) : ⁅x, m⁆ ∈ lieStep H b N :=
  Submodule.subset_span ⟨x, hx, m, hm, rfl⟩

omit [LieModule K L M] in
private theorem lieStep_le {N P : Submodule K M}
    (h : ∀ x ∈ negativeNilradical H b, ∀ m ∈ N, ⁅x, m⁆ ∈ P) : lieStep H b N ≤ P := by
  refine Submodule.span_le.mpr ?_
  rintro y ⟨x, hx, m, hm, rfl⟩
  exact h x hx m hm

variable (H b) (v : M)

/-- The `n`-th stage of the **lowering filtration** of `M` generated by `v`: the span of the
vectors obtained from `v` by at most `n` brackets with elements of the negative nilradical. -/
private def lowerStep : ℕ → Submodule K M
  | 0 => Submodule.span K {v}
  | n + 1 => lowerStep n ⊔ lieStep H b (lowerStep n)

/-- The union of the stages of the lowering filtration. It is the module `U(n⁻) · v`, described
without the enveloping algebra. -/
private def lowerSpan : Submodule K M := ⨆ n, lowerStep H b v n

variable {H b v}

omit [LieModule K L M] in
private theorem lowerStep_zero : lowerStep H b v 0 = Submodule.span K {v} := rfl

omit [LieModule K L M] in
private theorem lowerStep_succ (n : ℕ) :
    lowerStep H b v (n + 1) = lowerStep H b v n ⊔ lieStep H b (lowerStep H b v n) := rfl

omit [LieModule K L M] in
private theorem lowerSpan_eq_iSup : lowerSpan H b v = ⨆ n, lowerStep H b v n := rfl

omit [LieModule K L M] in
private theorem lowerStep_le_lowerSpan (n : ℕ) : lowerStep H b v n ≤ lowerSpan H b v :=
  le_iSup (fun n => lowerStep H b v n) n

omit [LieModule K L M] in
private theorem mem_lowerSpan_self : v ∈ lowerSpan H b v :=
  lowerStep_le_lowerSpan 0 (Submodule.mem_span_singleton_self v)

variable {lam : Dual K H}

/-- **The lowering filtration is stable under the Borel subalgebra.** For `x ∈ 𝔟` and a stage
`⁅f, m⁆` of the filtration with `f ∈ n⁻`, the Leibniz rule replaces `⁅x, ⁅f, m⁆⁆` by
`⁅⁅x, f⁆, m⁆ + ⁅f, ⁅x, m⁆⁆`; the second term stays inside the filtration by the inductive
hypothesis, and the first is handled by splitting `⁅x, f⁆` along the triangular decomposition
`L = n⁻ + 𝔟`. -/
private theorem lie_mem_lowerStep_of_mem_borelSubalgebra (hv : IsHighestWeightVector b lam v) :
    ∀ (n : ℕ), ∀ x ∈ borelSubalgebra H b, ∀ m ∈ lowerStep H b v n, ⁅x, m⁆ ∈ lowerStep H b v n := by
  intro n
  induction n with
  | zero =>
    intro x hx m hm
    rw [lowerStep_zero] at hm ⊢
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hm
    rw [← LieSubalgebra.mem_toSubmodule, borelSubalgebra_toSubmodule, Submodule.mem_sup] at hx
    obtain ⟨u, hu, p, hp, rfl⟩ := hx
    rw [add_lie, lie_smul, lie_smul, hv.lie_eq_zero_of_mem_positiveNilradical hp,
      show ⁅u, v⁆ = lam ⟨u, hu⟩ • v from hv.lie_eq_smul ⟨u, hu⟩, smul_zero, add_zero, smul_smul]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v)
  | succ n ih =>
    intro x hx m hm
    have key : lowerStep H b v (n + 1) ≤
        Submodule.comap (toEnd K L M x) (lowerStep H b v (n + 1)) := by
      rw [lowerStep_succ]
      refine sup_le (fun y hy => ?_) (lieStep_le fun f hf y hy => ?_)
      · refine Submodule.mem_comap.mpr ?_
        rw [toEnd_apply_apply]
        exact Submodule.mem_sup_left (ih x hx y hy)
      · refine Submodule.mem_comap.mpr ?_
        rw [toEnd_apply_apply, show ⁅x, ⁅f, y⁆⁆ = ⁅⁅x, f⁆, y⁆ + ⁅f, ⁅x, y⁆⁆ by
          rw [lie_lie]; abel]
        refine add_mem ?_ (Submodule.mem_sup_right (lie_mem_lieStep hf (ih x hx y hy)))
        have hxf : ⁅x, f⁆ ∈ (negativeNilradical H b : Submodule K L)
            ⊔ (borelSubalgebra H b : Submodule K L) := by
          rw [negativeNilradical_sup_borelSubalgebra_eq_top]; trivial
        obtain ⟨g, hg, z, hz, hgz⟩ := Submodule.mem_sup.mp hxf
        rw [← hgz, add_lie]
        exact add_mem (Submodule.mem_sup_right (lie_mem_lieStep hg hy))
          (Submodule.mem_sup_left (ih z hz y hy))
    have := key hm
    rwa [Submodule.mem_comap, toEnd_apply_apply] at this

/-- **The lowering filtration exhausts a highest weight module.** Its union is stable under `n⁻` by
construction and under `𝔟` by `TauCeti.lie_mem_lowerStep_of_mem_borelSubalgebra`, hence under all
of `L`; it contains the generator `v`. -/
private theorem lowerSpan_eq_top (hv : IsHighestWeightVector b lam v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) : lowerSpan H b v = ⊤ := by
  have hneg : negativeNilradical H b ≤ stabilizer (lowerSpan H b v) := fun x hx =>
    mem_stabilizer_iff.mpr <| by
      rw [lowerSpan_eq_iSup]
      refine iSup_le fun n y hy => Submodule.mem_comap.mpr ?_
      rw [toEnd_apply_apply]
      exact lowerStep_le_lowerSpan (n + 1)
        (by rw [lowerStep_succ]; exact Submodule.mem_sup_right (lie_mem_lieStep hx hy))
  have hbor : borelSubalgebra H b ≤ stabilizer (lowerSpan H b v) := fun x hx =>
    mem_stabilizer_iff.mpr <| by
      rw [lowerSpan_eq_iSup]
      refine iSup_le fun n y hy => Submodule.mem_comap.mpr ?_
      rw [toEnd_apply_apply]
      exact lowerStep_le_lowerSpan n (lie_mem_lowerStep_of_mem_borelSubalgebra hv n x hx y hy)
  have hle : LieSubmodule.lieSpan K L {v} ≤
      (⟨lowerSpan H b v, fun hm => lie_mem_of_stabilizer H b _ hneg hbor hm⟩ :
        LieSubmodule K L M) :=
    LieSubmodule.lieSpan_le.mpr (by simpa using mem_lowerSpan_self)
  rw [hgen] at hle
  exact eq_top_iff.mpr fun m _ => hle (by trivial)

/-- The bound the main theorems are read off: a submodule containing `v` and stable under the
negative nilradical contains the whole of the lowering span. -/
private theorem lowerSpan_le {N : Submodule K M} (hv0 : v ∈ N)
    (hstab : negativeNilradical H b ≤ stabilizer N) : lowerSpan H b v ≤ N := by
  rw [lowerSpan_eq_iSup]
  refine iSup_le fun n => ?_
  induction n with
  | zero => rw [lowerStep_zero]; exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hv0)
  | succ n ih =>
    rw [lowerStep_succ]
    exact sup_le ih (lieStep_le fun x hx m hm => mem_stabilizer.mp (hstab hx) m (ih hm))

/-! ### The span of a set of weight spaces -/

variable (H M) in
/-- The span of the weight spaces of `M` indexed by a set `S` of linear forms on the Cartan
subalgebra. -/
private def genWeightSpaceSpan (S : Set (Dual K H)) : LieSubmodule K H M :=
  ⨆ chi : S, genWeightSpace M ((chi : Dual K H) : H → K)

omit [CharZero K] [IsKilling K L] [FiniteDimensional K L] [IsTriangularizable K H L] in
private theorem genWeightSpace_le_genWeightSpaceSpan {S : Set (Dual K H)} {chi : Dual K H}
    (h : chi ∈ S) :
    genWeightSpace M ((chi : Dual K H) : H → K) ≤ genWeightSpaceSpan H M S :=
  le_iSup (fun chi : S => genWeightSpace M ((chi : Dual K H) : H → K)) ⟨chi, h⟩

/-- **A root vector moves the span of a set of weight spaces to the span of the shifted set.** This
is the one place the weight bookkeeping happens: a vector in the root space of `α` carries the
weight space at `chi` into the weight space at `α + chi`. -/
private theorem lie_mem_genWeightSpaceSpan {S T : Set (Dual K H)} {alpha : H.root} {x : L}
    (hx : x ∈ rootSpace H (alpha : H → K))
    (hST : ∀ chi ∈ S, (IsKilling.rootSystem H).root alpha + chi ∈ T)
    {m : M} (hm : m ∈ genWeightSpaceSpan H M S) : ⁅x, m⁆ ∈ genWeightSpaceSpan H M T := by
  refine LieSubmodule.iSup_induction
    (fun chi : S => genWeightSpace M ((chi : Dual K H) : H → K))
    (motive := fun m => ⁅x, m⁆ ∈ genWeightSpaceSpan H M T) hm (fun chi y hy => ?_) (by simp)
    (fun y z hy hz => by rw [lie_add]; exact add_mem hy hz)
  have hmem := lie_mem_genWeightSpace_of_mem_genWeightSpace (M := M) hx hy
  have hfun : (alpha : H → K) + ((chi : Dual K H) : H → K)
      = ((((IsKilling.rootSystem H).root alpha + (chi : Dual K H) : Dual K H)) : H → K) := by
    ext y
    simp
  rw [hfun] at hmem
  exact genWeightSpace_le_genWeightSpaceSpan (hST _ chi.2) hmem

/-! ### The weights below the highest weight -/

variable (b) in
/-- The weights `chi` with `lam - chi` in the positive root cone. -/
private def lowerSet (lam : Dual K H) : Set (Dual K H) :=
  {chi | lam - chi ∈ posRootCone (IsKilling.rootSystem H) b}

variable (b) in
/-- The same weights with the top weight `lam` itself removed. -/
private def strictLowerSet (lam : Dual K H) : Set (Dual K H) :=
  {chi | lam - chi ∈ posRootCone (IsKilling.rootSystem H) b ∧ chi ≠ lam}

private theorem mem_lowerSet {chi : Dual K H} :
    chi ∈ lowerSet b lam ↔ lam - chi ∈ posRootCone (IsKilling.rootSystem H) b :=
  Iff.rfl

private theorem mem_strictLowerSet {chi : Dual K H} :
    chi ∈ strictLowerSet b lam ↔
      lam - chi ∈ posRootCone (IsKilling.rootSystem H) b ∧ chi ≠ lam :=
  Iff.rfl

private theorem self_mem_lowerSet : lam ∈ lowerSet b lam := by
  rw [mem_lowerSet, sub_self]
  exact zero_mem _

/-- Negating a negative root gives a positive root, hence a member of the cone. -/
private theorem root_reflectionPerm_mem_posRootCone {gamma : H.root}
    (hgamma : gamma ∈ negRoots (IsKilling.rootSystem H) b) :
    (IsKilling.rootSystem H).root ((IsKilling.rootSystem H).reflectionPerm gamma gamma)
      ∈ posRootCone (IsKilling.rootSystem H) b :=
  root_mem_posRootCone (IsKilling.rootSystem H) b
    ((reflectionPerm_self_mem_posRoots_iff_mem_negRoots (IsKilling.rootSystem H) b gamma).mpr
      hgamma)

private theorem sub_add_eq {gamma : H.root} {chi : Dual K H} :
    lam - ((IsKilling.rootSystem H).root gamma + chi)
      = (IsKilling.rootSystem H).root ((IsKilling.rootSystem H).reflectionPerm gamma gamma)
        + (lam - chi) := by
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self]
  abel

/-- Adding a negative root to a weight below `lam` keeps it below `lam`. -/
private theorem add_mem_lowerSet {gamma : H.root}
    (hgamma : gamma ∈ negRoots (IsKilling.rootSystem H) b) {chi : Dual K H}
    (hchi : chi ∈ lowerSet b lam) :
    (IsKilling.rootSystem H).root gamma + chi ∈ lowerSet b lam := by
  rw [mem_lowerSet, sub_add_eq]
  exact add_mem (root_reflectionPerm_mem_posRootCone hgamma) hchi

/-- Adding a negative root to a weight below `lam` moves it *strictly* below `lam`: a positive root
is never cancelled inside the cone. -/
private theorem add_mem_strictLowerSet {gamma : H.root}
    (hgamma : gamma ∈ negRoots (IsKilling.rootSystem H) b) {chi : Dual K H}
    (hchi : chi ∈ lowerSet b lam) :
    (IsKilling.rootSystem H).root gamma + chi ∈ strictLowerSet b lam := by
  rw [mem_strictLowerSet]
  refine ⟨(mem_lowerSet).mp (add_mem_lowerSet hgamma hchi), fun hcontra => ?_⟩
  have hsub : lam - ((IsKilling.rootSystem H).root gamma + chi)
      = (IsKilling.rootSystem H).root ((IsKilling.rootSystem H).reflectionPerm gamma gamma)
        + (lam - chi) := sub_add_eq
  rw [hcontra, sub_self] at hsub
  exact add_ne_zero_of_mem_posRootCone (IsKilling.rootSystem H) b
    ((reflectionPerm_self_mem_posRoots_iff_mem_negRoots (IsKilling.rootSystem H) b gamma).mpr
      hgamma) hchi hsub.symm

/-! ### The weights of a highest weight module -/

variable (M b) in
/-- **The weight spaces below `lam` span a highest weight module.** Equivalently `M = U(n⁻) · v`
lands inside the weight spaces at the weights `lam - ν` with `ν` in the positive root cone. -/
theorem iSup_genWeightSpace_sub_eq_top {v : M} (hv : IsHighestWeightVector b lam v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) :
    ⨆ nu ∈ posRootCone (IsKilling.rootSystem H) b,
      genWeightSpace M ((lam - nu : Dual K H) : H → K) = ⊤ := by
  have hstab : negativeNilradical H b ≤
      stabilizer (genWeightSpaceSpan H M (lowerSet b lam) : Submodule K M) :=
    (negativeNilradical_le_iff H b).mpr fun gamma hgamma x hx =>
      mem_stabilizer.mpr fun m hm =>
        lie_mem_genWeightSpaceSpan hx (fun _ hchi => add_mem_lowerSet hgamma hchi) hm
  have hspan : (genWeightSpaceSpan H M (lowerSet b lam) : Submodule K M) = ⊤ := by
    refine eq_top_iff.mpr ?_
    rw [← lowerSpan_eq_top hv hgen]
    exact lowerSpan_le (genWeightSpace_le_genWeightSpaceSpan self_mem_lowerSet
      hv.mem_genWeightSpace) hstab
  have htop : genWeightSpaceSpan H M (lowerSet b lam) = ⊤ :=
    (LieSubmodule.toSubmodule_eq_top _).mp hspan
  refine eq_top_iff.mpr (htop ▸ ?_)
  refine iSup_le fun chi => le_iSup₂_of_le (lam - (chi : Dual K H)) chi.2 (le_of_eq ?_)
  rw [sub_sub_cancel]

variable (M b) in
/-- **The weights of a highest weight module lie in `lam - Q⁺`.** A weight outside the cone would
have its weight space disjoint from the ones that already exhaust the module. -/
theorem sub_mem_posRootCone_of_genWeightSpace_ne_bot {v : M} (hv : IsHighestWeightVector b lam v)
    (hgen : LieSubmodule.lieSpan K L {v} = ⊤) {chi : Dual K H}
    (hchi : genWeightSpace M ((chi : Dual K H) : H → K) ≠ ⊥) :
    lam - chi ∈ posRootCone (IsKilling.rootSystem H) b := by
  by_contra hcontra
  refine hchi (eq_bot_iff.mpr ?_)
  have hdisj := iSupIndep_genWeightSpace K H M ((chi : Dual K H) : H → K)
  have hle : (⊤ : LieSubmodule K H M) ≤
      ⨆ psi, ⨆ (_ : psi ≠ ((chi : Dual K H) : H → K)), genWeightSpace M psi := by
    rw [← iSup_genWeightSpace_sub_eq_top M b hv hgen]
    refine iSup₂_le fun nu hnu => le_iSup₂_of_le ((lam - nu : Dual K H) : H → K) ?_ le_rfl
    intro hne
    refine hcontra ?_
    have hnu' : (lam - nu : Dual K H) = chi := DFunLike.coe_injective hne
    rw [show lam - chi = nu by rw [← hnu']; abel]
    exact hnu
  calc genWeightSpace M ((chi : Dual K H) : H → K)
      = genWeightSpace M ((chi : Dual K H) : H → K) ⊓ ⊤ := (inf_top_eq _).symm
    _ ≤ genWeightSpace M ((chi : Dual K H) : H → K) ⊓
        ⨆ psi, ⨆ (_ : psi ≠ ((chi : Dual K H) : H → K)), genWeightSpace M psi :=
          inf_le_inf_left _ hle
    _ = ⊥ := disjoint_iff.mp hdisj

variable (M b) in
/-- **A module is a highest weight module for at most one weight.** If two highest weight vectors
both generate `M`, each of their weights lies below the other, and the cone is sharp. -/
theorem eq_of_isHighestWeightVector_of_lieSpan_eq_top {v w : M} {mu : Dual K H}
    (hv : IsHighestWeightVector b lam v) (hgv : LieSubmodule.lieSpan K L {v} = ⊤)
    (hw : IsHighestWeightVector b mu w) (hgw : LieSubmodule.lieSpan K L {w} = ⊤) : lam = mu := by
  have hlam : lam - mu ∈ posRootCone (IsKilling.rootSystem H) b :=
    sub_mem_posRootCone_of_genWeightSpace_ne_bot M b hv hgv hw.genWeightSpace_ne_bot
  have hmu : mu - lam ∈ posRootCone (IsKilling.rootSystem H) b :=
    sub_mem_posRootCone_of_genWeightSpace_ne_bot M b hw hgw hv.genWeightSpace_ne_bot
  exact sub_eq_zero.mp
    (eq_zero_of_add_eq_zero_of_mem_posRootCone (IsKilling.rootSystem H) b hlam hmu (by abel))

/-! ### The highest weight line -/

variable (M b) in
/-- **The top weight space of a highest weight module is a line.** Splitting off the weight spaces
strictly below `lam`, what is left of the module at weight `lam` is the span of the generator. -/
theorem genWeightSpace_eq_span_singleton_of_lieSpan_eq_top {v : M}
    (hv : IsHighestWeightVector b lam v) (hgen : LieSubmodule.lieSpan K L {v} = ⊤) :
    (genWeightSpace M ((lam : Dual K H) : H → K) : Submodule K M) = Submodule.span K {v} := by
  have hvmem : v ∈ (genWeightSpaceSpan H M (lowerSet b lam) : Submodule K M) :=
    genWeightSpace_le_genWeightSpaceSpan self_mem_lowerSet hv.mem_genWeightSpace
  -- the generator together with the weight spaces strictly below `lam` exhaust `M`
  have hsplit : Submodule.span K {v} ⊔
      (genWeightSpaceSpan H M (strictLowerSet b lam) : Submodule K M) = ⊤ := by
    have hstab : negativeNilradical H b ≤ stabilizer (Submodule.span K {v} ⊔
        (genWeightSpaceSpan H M (strictLowerSet b lam) : Submodule K M)) := by
      refine (negativeNilradical_le_iff H b).mpr fun gamma hgamma x hx =>
        mem_stabilizer_iff.mpr (sup_le (fun y hy => ?_) (fun y hy => ?_))
      · refine Submodule.mem_comap.mpr ?_
        rw [toEnd_apply_apply]
        obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hy
        rw [lie_smul]
        exact Submodule.smul_mem _ _ (Submodule.mem_sup_right
          (lie_mem_genWeightSpaceSpan hx (fun _ hchi => add_mem_strictLowerSet hgamma hchi) hvmem))
      · refine Submodule.mem_comap.mpr ?_
        rw [toEnd_apply_apply]
        exact Submodule.mem_sup_right (lie_mem_genWeightSpaceSpan hx
          (fun _ hchi =>
            add_mem_strictLowerSet hgamma (mem_lowerSet.mpr (mem_strictLowerSet.mp hchi).1)) hy)
    refine eq_top_iff.mpr ?_
    rw [← lowerSpan_eq_top hv hgen]
    exact lowerSpan_le (Submodule.mem_sup_left (Submodule.mem_span_singleton_self v)) hstab
  -- the `lam`-weight space meets those strictly lower weight spaces trivially
  have hdisj : Disjoint (genWeightSpace M ((lam : Dual K H) : H → K))
      (genWeightSpaceSpan H M (strictLowerSet b lam)) := by
    refine (iSupIndep_genWeightSpace K H M ((lam : Dual K H) : H → K)).mono_right ?_
    refine iSup_le fun chi => le_iSup₂_of_le ((chi : Dual K H) : H → K) ?_ le_rfl
    exact fun hne => (mem_strictLowerSet.mp chi.2).2 (DFunLike.coe_injective hne)
  have hdisj' : (genWeightSpace M ((lam : Dual K H) : H → K) : Submodule K M) ⊓
      (genWeightSpaceSpan H M (strictLowerSet b lam) : Submodule K M) = ⊥ := by
    rw [← LieSubmodule.inf_toSubmodule, disjoint_iff.mp hdisj, LieSubmodule.bot_toSubmodule]
  refine le_antisymm (fun m hm => ?_)
    (Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hv.mem_genWeightSpace))
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (hsplit ▸ Submodule.mem_top (x := m))
  have hyw : y ∈ (genWeightSpace M ((lam : Dual K H) : H → K) : Submodule K M) :=
    Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hv.mem_genWeightSpace) hy
  have hzw : z ∈ (genWeightSpace M ((lam : Dual K H) : H → K) : Submodule K M) := by
    rw [show z = y + z - y by abel]
    exact sub_mem hm hyw
  have hz0 : z = 0 := by
    have : z ∈ (⊥ : Submodule K M) := hdisj' ▸ Submodule.mem_inf.mpr ⟨hzw, hz⟩
    simpa using this
  rw [hz0, add_zero]
  exact hy

variable (M b) in
/-- **The highest weight vector of a highest weight module is unique up to scale.** Any highest
weight vector of the same weight lies in the line the generator spans. -/
theorem exists_smul_of_isHighestWeightVector_of_lieSpan_eq_top {v w : M}
    (hv : IsHighestWeightVector b lam v) (hgen : LieSubmodule.lieSpan K L {v} = ⊤)
    (hw : IsHighestWeightVector b lam w) : ∃ c : K, c ≠ 0 ∧ w = c • v := by
  have hmem : w ∈ Submodule.span K {v} := by
    rw [← genWeightSpace_eq_span_singleton_of_lieSpan_eq_top M b hv hgen]
    exact hw.mem_genWeightSpace
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
  exact ⟨c, fun hzero => hw.ne_zero (by rw [← hc, hzero, zero_smul]), hc.symm⟩

end TauCeti
