module

public import Mathlib.Algebra.Lie.Semisimple.Defs
public import Mathlib.Algebra.Lie.UniversalEnveloping
public import Mathlib.RingTheory.SimpleModule.Basic

/-!
# Lie modules are modules over the universal enveloping algebra

Mathlib builds the universal enveloping algebra `U(L)` of a Lie algebra `L` over a commutative
ring `R` and its universal property, but stops there: nothing connects `U(L)` to Lie modules, so
the whole ring-level module theory — simple and semisimple modules, isotypic components,
Jordan-Hölder — is out of reach of a `LieModule`.

This file supplies the bridge. A Lie module `M` becomes a `U(L)`-module through
`UniversalEnvelopingAlgebra.lift R (LieModule.toEnd R L M)` (`TauCeti.ueaModule`), and the two
notions of submodule then agree: `TauCeti.lieSubmoduleOrderIsoUEA` is an order isomorphism
`LieSubmodule R L M ≃o Submodule (UniversalEnvelopingAlgebra R L) M` fixing the underlying set.
Morphisms agree too (`TauCeti.lieModuleHomEquivUEA`): a map of Lie modules is exactly a
`U(L)`-linear map. Consequently a Lie module is irreducible exactly when it is simple over `U(L)`,
and the lattice of Lie submodules is complemented exactly when it is semisimple over `U(L)`.

The engine is `TauCeti.UniversalEnvelopingAlgebra.adjoin_range_ι`: `U(L)` is generated as an
`R`-algebra by the image of `L`. That is what turns "stable under `⁅x, -⁆` for every `x`" into
"stable under every element of `U(L)`", and Mathlib does not record it — its universal property
gives *uniqueness* of a lift, which is the statement that two algebra maps agreeing on `ι '' L`
agree, but not the generation statement itself.

## Main definitions

* `TauCeti.ueaModule`: the `U(L)`-module structure on a Lie module. Deliberately a `def` and not
  an instance: a global instance would compete with the restriction-of-scalars structures that a
  `U(L)`-module already carries, and `M = U(L)` would be a diamond.
* `TauCeti.lieSubmoduleOrderIsoUEA`: **the enveloping-algebra dictionary**, the order isomorphism
  between Lie submodules and `U(L)`-submodules.
* `TauCeti.lieModuleHomEquivUEA`: the same dictionary for morphisms.

## Main results

* `TauCeti.UniversalEnvelopingAlgebra.adjoin_range_ι`: `U(L)` is generated by the image of `L`.
* `TauCeti.smul_mem_of_lieSubmodule` and `TauCeti.map_smul_of_map_lie`: stability under the
  bracket upgrades to stability under `U(L)`, for submodules and for maps.
* `TauCeti.isSimpleModule_iff_isIrreducible` and
  `TauCeti.isSemisimpleModule_iff_complementedLattice`: irreducibility and complete reducibility
  of a Lie module are simplicity and semisimplicity of the associated `U(L)`-module.

## Implementation notes

The dictionary is stated for an arbitrary `U(L)`-module structure on `M` that is compatible with
the `R`-structure (`IsScalarTower`) and with the bracket (`ι R x • m = ⁅x, m⁆`), rather than only
for `TauCeti.ueaModule`. That is the form the consumers need: a module built as a `U(L)`-module in
the first place — a Verma module, say — carries its Lie structure by transport, and asking it to be
*definitionally* `TauCeti.ueaModule` would be false. `TauCeti.ueaModule_ι_smul` and
`TauCeti.ueaModule_isScalarTower` supply the two hypotheses for the canonical structure.

## References

This builds the enveloping-algebra dictionary (`ueaModule`, `lieSubmoduleOrderIsoUEA`) of the
decomposition toolkit of the
[highest-weight roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/LieHighestWeight/README.md),
the route from Mathlib's ring-level module theory to Lie modules. See J. E. Humphreys,
*Introduction to Lie Algebras and Representation Theory*, GTM 9, §17, and J. Dixmier,
*Enveloping Algebras*, North-Holland (1977), §2.1.
-/

public section

namespace TauCeti

universe u v w z

namespace UniversalEnvelopingAlgebra

section Generation

variable (R : Type u) (L : Type v) [CommRing R] [LieRing L] [LieAlgebra R L]

attribute [local instance 100] LieRing.ofAssociativeRing

/-- **The universal enveloping algebra is generated by the Lie algebra.** The `R`-subalgebra of
`U(L)` generated by the image of `ι` is everything.

The universal property gives this by a retraction: the subalgebra `A` generated by `ι '' L` is
itself an associative algebra, so `ι` corestricts to a Lie algebra morphism `L → A`, whose lift
`U(L) → A` is a section of the inclusion `A → U(L)` because the composite fixes `ι '' L` and
`U(L)` has no two distinct endomorphisms doing that. Every element of `U(L)` is therefore in the
image of `A`, that is, in `A`. -/
theorem adjoin_range_ι :
    Algebra.adjoin R (Set.range ⇑(_root_.UniversalEnvelopingAlgebra.ι R (L := L))) = ⊤ := by
  set A := Algebra.adjoin R (Set.range ⇑(_root_.UniversalEnvelopingAlgebra.ι R (L := L)))
  have hmem (x : L) : _root_.UniversalEnvelopingAlgebra.ι R x ∈ A :=
    Algebra.subset_adjoin ⟨x, rfl⟩
  -- The corestriction of `ι` to the generated subalgebra.
  let f : L →ₗ⁅R⁆ A :=
    { toFun x := ⟨_root_.UniversalEnvelopingAlgebra.ι R x, hmem x⟩
      map_add' x y := Subtype.ext (map_add _ x y)
      map_smul' r x := Subtype.ext (map_smul _ r x)
      map_lie' {x y} := Subtype.ext <| by
        simp [LieRing.of_associative_ring_bracket] }
  have hsection : A.val.comp (_root_.UniversalEnvelopingAlgebra.lift R f) = AlgHom.id R _ :=
    _root_.UniversalEnvelopingAlgebra.hom_ext (R := R) <| LieHom.ext fun x =>
      congrArg Subtype.val (_root_.UniversalEnvelopingAlgebra.lift_ι_apply R f x)
  refine top_unique fun u _ => ?_
  have hu : ((_root_.UniversalEnvelopingAlgebra.lift R f u : A) :
      _root_.UniversalEnvelopingAlgebra R L) = u :=
    congrArg (fun g : _root_.UniversalEnvelopingAlgebra R L →ₐ[R] _ => g u) hsection
  exact hu ▸ (_root_.UniversalEnvelopingAlgebra.lift R f u).2

end Generation

end UniversalEnvelopingAlgebra

section Dictionary

variable {R : Type u} {L : Type v} {M : Type w} [CommRing R] [LieRing L] [LieAlgebra R L]
  [AddCommGroup M] [Module R M] [LieRingModule L M]
  [Module (UniversalEnvelopingAlgebra R L) M]
  [IsScalarTower R (UniversalEnvelopingAlgebra R L) M]
  (hcompat : ∀ (x : L) (m : M), UniversalEnvelopingAlgebra.ι R x • m = ⁅x, m⁆)

include hcompat

/-- A Lie submodule of `M` is stable under the whole enveloping algebra. The elements of `U(L)`
preserving an `R`-submodule form an `R`-subalgebra, and it contains the image of `L` exactly
because the submodule is a Lie submodule, so it is everything by
`TauCeti.UniversalEnvelopingAlgebra.adjoin_range_ι`. -/
theorem smul_mem_of_lieSubmodule (N : LieSubmodule R L M) (u : UniversalEnvelopingAlgebra R L)
    {m : M} (hm : m ∈ N) : u • m ∈ N := by
  -- The stabilizer of `N` inside `U(L)`.
  let S : Subalgebra R (UniversalEnvelopingAlgebra R L) :=
    { carrier := {u | ∀ m ∈ N, u • m ∈ N}
      mul_mem' {a b} ha hb m hm := by rw [mul_smul]; exact ha _ (hb m hm)
      one_mem' m hm := by rwa [one_smul]
      add_mem' {a b} ha hb m hm := by rw [add_smul]; exact N.add_mem (ha m hm) (hb m hm)
      zero_mem' m _ := by rw [zero_smul]; exact N.zero_mem
      algebraMap_mem' r m hm := by
        rw [algebraMap_smul]; exact N.smul_mem r hm }
  have hS : (⊤ : Subalgebra R (UniversalEnvelopingAlgebra R L)) ≤ S := by
    rw [← UniversalEnvelopingAlgebra.adjoin_range_ι R L]
    refine Algebra.adjoin_le ?_
    rintro _ ⟨x, rfl⟩ m hm
    rw [hcompat]
    exact N.lie_mem hm
  exact hS Algebra.mem_top m hm

/-- A Lie submodule of `M`, read as a `U(L)`-submodule. -/
def LieSubmodule.toUEASubmodule (N : LieSubmodule R L M) :
    Submodule (UniversalEnvelopingAlgebra R L) M where
  carrier := N
  add_mem' := N.add_mem
  zero_mem' := N.zero_mem
  smul_mem' u _ hm := smul_mem_of_lieSubmodule hcompat N u hm

/-- A `U(L)`-submodule of `M`, read as a Lie submodule: it is an `R`-submodule by restriction of
scalars, and stable under the bracket because the bracket is the action of `ι R x`. -/
def Submodule.toLieSubmodule (P : Submodule (UniversalEnvelopingAlgebra R L) M) :
    LieSubmodule R L M where
  __ := P.restrictScalars R
  lie_mem {x m} hm := by
    rw [← hcompat x m]
    exact P.smul_mem _ hm

/-- Reading a Lie submodule as a `U(L)`-submodule does not change its underlying set. -/
@[simp]
theorem LieSubmodule.coe_toUEASubmodule (N : LieSubmodule R L M) :
    (LieSubmodule.toUEASubmodule hcompat N : Set M) = N :=
  (rfl)

/-- Reading a `U(L)`-submodule as a Lie submodule does not change its underlying set. -/
@[simp]
theorem Submodule.coe_toLieSubmodule (P : Submodule (UniversalEnvelopingAlgebra R L) M) :
    (Submodule.toLieSubmodule hcompat P : Set M) = P :=
  (rfl)

/-- **The enveloping-algebra dictionary.** For a `U(L)`-module structure on `M` compatible with
the `R`-action and with the bracket, the Lie submodules of `M` are exactly the `U(L)`-submodules,
and the correspondence is the identity on underlying sets. -/
def lieSubmoduleOrderIsoUEA :
    LieSubmodule R L M ≃o Submodule (UniversalEnvelopingAlgebra R L) M where
  toFun := LieSubmodule.toUEASubmodule hcompat
  invFun := Submodule.toLieSubmodule hcompat
  left_inv _ := SetLike.coe_injective (rfl)
  right_inv _ := SetLike.coe_injective (rfl)
  map_rel_iff' := Iff.rfl

/-- The dictionary is the identity on underlying sets. -/
@[simp]
theorem coe_lieSubmoduleOrderIsoUEA (N : LieSubmodule R L M) :
    (lieSubmoduleOrderIsoUEA hcompat N : Set M) = N :=
  (rfl)

/-- The inverse dictionary is the identity on underlying sets. -/
@[simp]
theorem coe_lieSubmoduleOrderIsoUEA_symm (P : Submodule (UniversalEnvelopingAlgebra R L) M) :
    ((lieSubmoduleOrderIsoUEA hcompat).symm P : Set M) = P :=
  (rfl)

/-- Membership in the `U(L)`-submodule attached to a Lie submodule. -/
@[simp]
theorem mem_lieSubmoduleOrderIsoUEA {N : LieSubmodule R L M} {m : M} :
    m ∈ lieSubmoduleOrderIsoUEA hcompat N ↔ m ∈ N :=
  Iff.rfl

/-- Membership in the Lie submodule attached to a `U(L)`-submodule. -/
@[simp]
theorem mem_lieSubmoduleOrderIsoUEA_symm
    {P : Submodule (UniversalEnvelopingAlgebra R L) M} {m : M} :
    m ∈ (lieSubmoduleOrderIsoUEA hcompat).symm P ↔ m ∈ P :=
  Iff.rfl

/-- **A Lie module is irreducible exactly when it is simple over the enveloping algebra.** -/
theorem isSimpleModule_iff_isIrreducible :
    IsSimpleModule (UniversalEnvelopingAlgebra R L) M ↔ LieModule.IsIrreducible R L M := by
  rw [isSimpleModule_iff]
  exact (OrderIso.isSimpleOrder_iff (lieSubmoduleOrderIsoUEA hcompat)).symm

/-- **A Lie module is completely reducible exactly when it is semisimple over the enveloping
algebra**: the lattice of Lie submodules is complemented exactly when the lattice of
`U(L)`-submodules is. -/
theorem isSemisimpleModule_iff_complementedLattice :
    IsSemisimpleModule (UniversalEnvelopingAlgebra R L) M ↔
      ComplementedLattice (LieSubmodule R L M) := by
  rw [isSemisimpleModule_iff]
  exact (OrderIso.complementedLattice_iff (lieSubmoduleOrderIsoUEA hcompat)).symm

section Hom

variable {N : Type z} [AddCommGroup N] [Module R N] [LieRingModule L N]
  [Module (UniversalEnvelopingAlgebra R L) N]
  [IsScalarTower R (UniversalEnvelopingAlgebra R L) N]
  (hcompatN : ∀ (x : L) (n : N), UniversalEnvelopingAlgebra.ι R x • n = ⁅x, n⁆)

include hcompatN

/-- An `R`-linear map commuting with the bracket commutes with the whole enveloping algebra: the
elements of `U(L)` it commutes with form an `R`-subalgebra containing the image of `L`. -/
theorem map_smul_of_map_lie (f : M →ₗ[R] N) (hf : ∀ (x : L) (m : M), f ⁅x, m⁆ = ⁅x, f m⁆)
    (u : UniversalEnvelopingAlgebra R L) (m : M) : f (u • m) = u • f m := by
  let S : Subalgebra R (UniversalEnvelopingAlgebra R L) :=
    { carrier := {u | ∀ m : M, f (u • m) = u • f m}
      mul_mem' {a b} ha hb m := by rw [mul_smul, ha, hb, mul_smul]
      one_mem' m := by rw [one_smul, one_smul]
      add_mem' {a b} ha hb m := by rw [add_smul, map_add, ha, hb, add_smul]
      zero_mem' m := by rw [zero_smul, zero_smul, map_zero]
      algebraMap_mem' r m := by rw [algebraMap_smul, algebraMap_smul, map_smul] }
  have hS : (⊤ : Subalgebra R (UniversalEnvelopingAlgebra R L)) ≤ S := by
    rw [← UniversalEnvelopingAlgebra.adjoin_range_ι R L]
    refine Algebra.adjoin_le ?_
    rintro _ ⟨x, rfl⟩ m
    rw [hcompat, hcompatN, hf]
  exact hS Algebra.mem_top m

/-- **The dictionary for morphisms**: a morphism of Lie modules is exactly a `U(L)`-linear map.
Together with `TauCeti.lieSubmoduleOrderIsoUEA` this is what carries the ring-level module theory
— Schur's lemma, isotypic components, endomorphism rings — over to Lie modules. -/
def lieModuleHomEquivUEA :
    (M →ₗ⁅R,L⁆ N) ≃ (M →ₗ[UniversalEnvelopingAlgebra R L] N) where
  toFun f :=
    { toFun := f
      map_add' := f.map_add
      map_smul' u m := map_smul_of_map_lie hcompat hcompatN f.toLinearMap
        (fun x m => f.map_lie x m) u m }
  invFun g :=
    { toFun := g
      map_add' := g.map_add
      map_smul' r m := by
        rw [RingHom.id_apply, ← algebraMap_smul (UniversalEnvelopingAlgebra R L) r m,
          ← algebraMap_smul (UniversalEnvelopingAlgebra R L) r (g m), g.map_smul]
      map_lie' {x m} := by rw [← hcompat, ← hcompatN, g.map_smul] }
  left_inv _ := rfl
  right_inv _ := rfl

/-- The morphism dictionary does not change the underlying function. -/
@[simp]
theorem coe_lieModuleHomEquivUEA (f : M →ₗ⁅R,L⁆ N) :
    ⇑(lieModuleHomEquivUEA hcompat hcompatN f) = ⇑f :=
  (rfl)

/-- The inverse morphism dictionary does not change the underlying function. -/
@[simp]
theorem coe_lieModuleHomEquivUEA_symm (g : M →ₗ[UniversalEnvelopingAlgebra R L] N) :
    ⇑((lieModuleHomEquivUEA hcompat hcompatN).symm g) = ⇑g :=
  (rfl)

end Hom

end Dictionary

section UeaModule

variable (R : Type u) (L : Type v) {M : Type w} [CommRing R] [LieRing L] [LieAlgebra R L]
  [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M]

/-- **The enveloping-algebra module structure on a Lie module**, obtained by lifting
`LieModule.toEnd R L M` along the universal property.

This is a `def`, not an instance: as an instance it would fire on every Lie module, competing with
the `U(L)`-module structures that arise by other routes (a Verma module is a `U(L)`-module first
and a Lie module second), and at `M = U(L)` it would clash with the action of `U(L)` on itself.
Bring it into scope with `letI := TauCeti.ueaModule R L`. -/
@[reducible]
noncomputable def ueaModule : Module (UniversalEnvelopingAlgebra R L) M :=
  Module.compHom M (UniversalEnvelopingAlgebra.lift R (LieModule.toEnd R L M)).toRingHom

attribute [local instance] ueaModule

/-- The action of `U(L)` on a Lie module, unfolded: it is the lift of `LieModule.toEnd`. -/
theorem ueaModule_smul_def (u : UniversalEnvelopingAlgebra R L) (m : M) :
    u • m = UniversalEnvelopingAlgebra.lift R (LieModule.toEnd R L M) u m :=
  (rfl)

/-- The enveloping algebra acts on a Lie module through the bracket: this is the compatibility
`TauCeti.lieSubmoduleOrderIsoUEA` asks for. -/
theorem ueaModule_ι_smul (x : L) (m : M) :
    UniversalEnvelopingAlgebra.ι R x • m = ⁅x, m⁆ := by
  rw [ueaModule_smul_def, UniversalEnvelopingAlgebra.lift_ι_apply]
  rfl

/-- The scalars of the base ring act the same way through `R` and through `U(L)`. -/
theorem ueaModule_isScalarTower :
    IsScalarTower R (UniversalEnvelopingAlgebra R L) M :=
  IsScalarTower.of_algebraMap_smul fun r m => by
    rw [ueaModule_smul_def, AlgHom.commutes, Module.algebraMap_end_apply]

attribute [local instance] ueaModule_isScalarTower

/-- **The dictionary for the canonical structure**: the Lie submodules of `M` are the
`U(L)`-submodules for `TauCeti.ueaModule`. -/
noncomputable def lieSubmoduleOrderIsoUeaModule :
    LieSubmodule R L M ≃o Submodule (UniversalEnvelopingAlgebra R L) M :=
  lieSubmoduleOrderIsoUEA (ueaModule_ι_smul R L)

/-- The dictionary for the canonical structure is the identity on underlying sets. -/
@[simp]
theorem coe_lieSubmoduleOrderIsoUeaModule (N : LieSubmodule R L M) :
    (lieSubmoduleOrderIsoUeaModule R L N : Set M) = N :=
  (rfl)

/-- A Lie module is irreducible exactly when it is simple over `U(L)` with the canonical
structure. -/
theorem isSimpleModule_ueaModule_iff_isIrreducible :
    IsSimpleModule (UniversalEnvelopingAlgebra R L) M ↔ LieModule.IsIrreducible R L M :=
  isSimpleModule_iff_isIrreducible (ueaModule_ι_smul R L)

/-- A Lie module is completely reducible exactly when it is semisimple over `U(L)` with the
canonical structure. -/
theorem isSemisimpleModule_ueaModule_iff_complementedLattice :
    IsSemisimpleModule (UniversalEnvelopingAlgebra R L) M ↔
      ComplementedLattice (LieSubmodule R L M) :=
  isSemisimpleModule_iff_complementedLattice (ueaModule_ι_smul R L)

end UeaModule

end TauCeti
