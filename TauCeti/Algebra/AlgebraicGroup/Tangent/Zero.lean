module

public import TauCeti.Algebra.AlgebraicGroup.Connected.CommHopfAlgCat
public import TauCeti.Algebra.AlgebraicGroup.Tangent.Dimension
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Augmentation
import Mathlib.RingTheory.Ideal.IdempotentFG
import TauCeti.RingTheory.Ideal.Cotangent.Basic

/-!
# Connected affine groups with zero tangent space

Let `H` be the coordinate Hopf algebra of an affine group over a field. If its tangent Lie
algebra at the identity is zero, then the augmentation ideal `m` satisfies `m / m ^ 2 = 0`.
When `m` is finitely generated, this equality upgrades to `m ^ 2 = m`, so `m` is generated by
an idempotent. Connectedness of `Spec H` forces that idempotent to be zero or one. It cannot be
one because the counit has nonzero codomain, and hence `m = 0`.

Thus a connected affine group of finite type with zero Lie algebra is trivial: its counit is
an equivalence by `HopfIdeal.counitBialgEquivOfAugmentationEqBot`. The result is formulated first
with the exact connectedness and finite-generation assumptions used in the proof, then
specialized to geometrically connected finite-type commutative Hopf algebras.

This is the zero-dimensional quotient input for the equal-dimension containment argument in
Layer 5, "The unipotent radical", of the ReductiveGroups roadmap.

## Main declarations

* `TauCeti.HopfIdeal.augmentation_eq_bot_iff_finrank_lie_eq_zero`: for a connected coordinate
  Hopf algebra with finitely generated augmentation ideal, that ideal vanishes exactly when its
  Lie algebra has dimension zero.
* `TauCeti.geometricallyConnectedCommHopfAlgProperty.augmentation_eq_bot_of_finrank_lie_eq_zero`:
  the finite-type geometrically connected specialization.
* `TauCeti.geometricallyConnectedCommHopfAlgProperty.counitBialgEquivOfFinrankLieEqZero`:
  the resulting equivalence with the base field via the counit.

## References

* J. S. Milne, *Algebraic Groups* (2017), §§2.15--2.17 and Appendix A.51, for the
  zero-tangent/triviality result.
* J. S. Milne, *Algebraic Groups* (2017), Proposition 6.42 and §§6.45--6.46, and A. Borel,
  *Linear Algebraic Groups*, §11.21, for the downstream maximality application.
-/

public section

namespace TauCeti

universe u v

noncomputable section

namespace HopfIdeal

variable {k : Type u} {H : Type v}
variable [Field k] [CommRing H] [HopfAlgebra k H]

/-- **A connected affine group with finitely generated augmentation ideal has zero augmentation
ideal exactly when its tangent Lie algebra has dimension zero.** -/
theorem augmentation_eq_bot_iff_finrank_lie_eq_zero
    [ConnectedSpace (PrimeSpectrum H)]
    (hfg : (Bialgebra.AugmentationIdeal k H).FG) :
    augmentation k H = ⊥ ↔
      Module.finrank k
        (Derivation k H (Bialgebra.CounitAlgebra k H k)) = 0 := by
  let _ : Module.Finite k (Bialgebra.CotangentSpace k H) :=
    AlgHom.finite_cotangent_ker_of_fg (Bialgebra.counitAlgHom k H) hfg
  constructor
  · intro haugmentation
    rw [Derivation.finrank_eq_finrank_cotangentSpace]
    apply Module.finrank_zero_iff.mpr
    apply (Ideal.cotangent_subsingleton_iff
      (I := Bialgebra.AugmentationIdeal k H)).mpr
    have haugmentationIdeal : Bialgebra.AugmentationIdeal k H = ⊥ := by
      calc
        Bialgebra.AugmentationIdeal k H = (augmentation k H).toIdeal :=
          (augmentation_toIdeal k H).symm
        _ = (⊥ : HopfIdeal k H).toIdeal := congrArg HopfIdeal.toIdeal haugmentation
        _ = ⊥ := bot_toIdeal
    rw [haugmentationIdeal]
    exact IsIdempotentElem.zero
  · intro hlie
    have hcotangent :
        Module.finrank k (Bialgebra.CotangentSpace k H) = 0 := by
      rw [← Derivation.finrank_eq_finrank_cotangentSpace]
      exact hlie
    have hsubsingleton : Subsingleton (Bialgebra.CotangentSpace k H) :=
      Module.finrank_zero_iff.mp hcotangent
    have hidempotent : IsIdempotentElem (Bialgebra.AugmentationIdeal k H) :=
      (Ideal.cotangent_subsingleton_iff
        (I := Bialgebra.AugmentationIdeal k H)).mp hsubsingleton
    obtain ⟨e, he, hspan⟩ :=
      (Ideal.isIdempotentElem_iff_of_fg
        (Bialgebra.AugmentationIdeal k H)
        hfg).mp hidempotent
    rcases eq_zero_or_eq_one_of_isIdempotentElem he with hezero | heone
    · have haugmentationIdeal : Bialgebra.AugmentationIdeal k H = ⊥ := by
        simpa [hezero] using hspan
      apply HopfIdeal.ext
      intro x
      rw [← mem_toIdeal, ← mem_toIdeal, augmentation_toIdeal, bot_toIdeal]
      simpa only [Bialgebra.AugmentationIdeal, RingHom.ker_coe_toRingHom] using
        SetLike.ext_iff.mp haugmentationIdeal x
    · exfalso
      apply RingHom.ker_ne_top (Bialgebra.counitAlgHom k H).toRingHom
      simpa [Bialgebra.AugmentationIdeal, heone] using hspan

end HopfIdeal

namespace geometricallyConnectedCommHopfAlgProperty

variable {k : Type u} {H : Type u}
variable [Field k] [CommRing H] [HopfAlgebra k H] [Algebra.FiniteType k H]

/-- A geometrically connected affine group of finite type whose tangent Lie algebra has
dimension zero has zero augmentation ideal, and is therefore trivial via the counit.

This is the coordinate-ring form of the fact that a connected zero-dimensional algebraic group
is trivial. -/
theorem augmentation_eq_bot_of_finrank_lie_eq_zero
    (hconnected : geometricallyConnectedCommHopfAlgProperty k
      (_root_.CommHopfAlgCat.of k H))
    (hlie : Module.finrank k
      (Derivation k H (Bialgebra.CounitAlgebra k H k)) = 0) :
    HopfIdeal.augmentation k H = ⊥ := by
  let _ : IsNoetherianRing H := Algebra.FiniteType.isNoetherianRing k H
  let _ : ConnectedSpace (PrimeSpectrum H) :=
    hconnected.connectedSpace k (_root_.CommHopfAlgCat.of k H)
  exact (HopfIdeal.augmentation_eq_bot_iff_finrank_lie_eq_zero
    (Bialgebra.AugmentationIdeal k H).fg_of_isNoetherianRing).mpr hlie

/-- A geometrically connected affine group of finite type with zero-dimensional tangent Lie
algebra is bialgebra-equivalent to the base field via the counit. -/
noncomputable def counitBialgEquivOfFinrankLieEqZero
    (hconnected : geometricallyConnectedCommHopfAlgProperty k
      (_root_.CommHopfAlgCat.of k H))
    (hlie : Module.finrank k
      (Derivation k H (Bialgebra.CounitAlgebra k H k)) = 0) :
    H ≃ₐc[k] k :=
  HopfIdeal.counitBialgEquivOfAugmentationEqBot
    (hconnected.augmentation_eq_bot_of_finrank_lie_eq_zero hlie)

/-- The zero-tangent equivalence from the coordinate algebra to the base field is the counit. -/
@[simp]
theorem counitBialgEquivOfFinrankLieEqZero_apply
    (hconnected : geometricallyConnectedCommHopfAlgProperty k
      (_root_.CommHopfAlgCat.of k H))
    (hlie : Module.finrank k
      (Derivation k H (Bialgebra.CounitAlgebra k H k)) = 0)
    (x : H) :
    hconnected.counitBialgEquivOfFinrankLieEqZero hlie x =
      Bialgebra.counitBialgHom k H x := by
  rw [counitBialgEquivOfFinrankLieEqZero]
  exact HopfIdeal.counitBialgEquivOfAugmentationEqBot_apply _ _

/-- The inverse zero-tangent equivalence from the base field is the structure map. -/
@[simp]
theorem counitBialgEquivOfFinrankLieEqZero_symm_apply
    (hconnected : geometricallyConnectedCommHopfAlgProperty k
      (_root_.CommHopfAlgCat.of k H))
    (hlie : Module.finrank k
      (Derivation k H (Bialgebra.CounitAlgebra k H k)) = 0)
    (r : k) :
    (hconnected.counitBialgEquivOfFinrankLieEqZero hlie).symm r = algebraMap k H r := by
  rw [counitBialgEquivOfFinrankLieEqZero]
  exact HopfIdeal.counitBialgEquivOfAugmentationEqBot_symm_apply _ _

end geometricallyConnectedCommHopfAlgProperty

end

end TauCeti
