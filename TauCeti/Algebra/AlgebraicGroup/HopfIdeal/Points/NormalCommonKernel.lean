module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Normal.CommonKernel
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.CommonKernel
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Order

/-!
# Points of a normal closed subgroup generated by morphisms

This file gives the point-level consequences of the normal common-kernel construction. The
quotient cuts out a normal subgroup over every commutative value algebra, and the abstract
subgroup generated by the defining point images lies in it. No equality of point sets is asserted.

## Main declarations

* `TauCeti.CommHopfAlgCat.normalCommonKernelPoints_normal`: normality on algebra-valued points.
* `TauCeti.CommHopfAlgCat.mapPoints_normalCommonKernel_mem_quotientPointsSubgroup`: every point
  in one of the defining families belongs to the normal common-kernel quotient points.
* `TauCeti.CommHopfAlgCat.closure_iUnion_range_mapPoints_le_normalCommonKernelPoints`: the
  abstract subgroup generated by the defining point images lies in the normal quotient points.
-/

public section

open WithConv

namespace TauCeti.CommHopfAlgCat

universe u v w x

variable {R : Type u} [CommRing R]
variable {H : _root_.CommHopfAlgCat.{v} R}
variable {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} R}

/-- The normal common-kernel quotient cuts out a normal subgroup of the ambient point group over
every commutative value algebra. -/
instance normalCommonKernelPoints_normal (f : ∀ i, H ⟶ K i) (A : CommAlgCat.{x} R) :
    (quotientPointsSubgroup H (normalCommonKernelHopfIdeal f) A).Normal :=
  quotientPointsSubgroup_normal H (normalCommonKernelHopfIdeal f)
    (HopfIdeal.isNormal_normalCore (commonKernelHopfIdeal f)) A

/-- Every point obtained from one of the defining morphisms belongs to the normal closed subgroup
generated by the family. -/
theorem mapPoints_normalCommonKernel_mem_quotientPointsSubgroup
    (f : ∀ i, H ⟶ K i) (i : ι) (A : CommAlgCat.{x} R)
    (p : HopfAlgebra.points (R := R) (H := K i) A) :
    toConv (p.ofConv.comp ((f i).hom : H →ₐ[R] K i)) ∈
      quotientPointsSubgroup H (normalCommonKernelHopfIdeal f) A :=
  mem_quotientPointsSubgroup_of_le H (HopfIdeal.normalCore_le (commonKernelHopfIdeal f)) A
    (mapPoints_commonKernel_mem_quotientPointsSubgroup f i A p)

/-- The abstract subgroup generated by all point images lies in their normal generated closed
subgroup. The target subgroup is normal by `normalCommonKernelPoints_normal`; no equality of point
sets is asserted. -/
theorem closure_iUnion_range_mapPoints_le_normalCommonKernelPoints
    (f : ∀ i, H ⟶ K i) (A : CommAlgCat.{x} R) :
    Subgroup.closure (⋃ i, Set.range (fun p : HopfAlgebra.points (R := R) (H := K i) A ↦
      toConv (p.ofConv.comp ((f i).hom : H →ₐ[R] K i)))) ≤
      quotientPointsSubgroup H (normalCommonKernelHopfIdeal f) A :=
  (closure_iUnion_range_mapPoints_le_commonKernelPoints f A).trans
    (quotientPointsSubgroup_le_of_le H (HopfIdeal.normalCore_le (commonKernelHopfIdeal f)) A)

end TauCeti.CommHopfAlgCat
