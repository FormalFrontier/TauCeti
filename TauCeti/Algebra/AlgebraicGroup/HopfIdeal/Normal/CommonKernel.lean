module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Normal.Basic

/-!
# Normal closed subgroups generated by morphisms

Let `f i : H ⟶ K i` be morphisms of commutative Hopf algebras. The ordinary common-kernel
construction takes the largest Hopf ideal killed by every `f i`; contravariantly, its quotient is
the smallest closed subgroup scheme of `Spec H` containing all the images. This file adds the
normal version: take the supremum only over *normal* Hopf ideals killed by every `f i`.

The resulting quotient represents the smallest normal closed subgroup scheme containing the
family. It comes with its universal property, factorization maps to every `K i`, and a comparison
with the ordinary generated subgroup. If the ordinary common-kernel ideal is already normal, the
normal and ordinary generated subgroups agree.

## Main declarations

* `TauCeti.CommHopfAlgCat.normalCommonKernelHopfIdeal`: the largest normal Hopf ideal killed by a
  family of morphisms.
* `TauCeti.CommHopfAlgCat.le_normalCommonKernelHopfIdeal`: its universal property.
* `TauCeti.CommHopfAlgCat.normalCommonKernelLift`: the induced factorization through the normal
  generated subgroup.
* `TauCeti.CommHopfAlgCat.normalCommonKernelHopfIdeal_eq_commonKernelHopfIdeal_of_isNormal`:
  comparison when the ordinary generated subgroup is normal.

## References

* W. C. Waterhouse, *Introduction to Affine Group Schemes*, Chapter 15.

This is subgroup-generation infrastructure for Layer 5, "The unipotent radical", of the
ReductiveGroups roadmap. The radical construction must form a normal closed subgroup containing
all connected normal unipotent candidates before proving that the generated subgroup remains
connected and unipotent.
-/

public section

open CategoryTheory

namespace TauCeti.CommHopfAlgCat

universe u v w

variable {R : Type u} [CommRing R]
variable {H : _root_.CommHopfAlgCat.{v} R}
variable {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} R}

/-- The largest normal Hopf ideal of `H` contained in the kernels of every morphism in `f`.

Contravariantly, quotienting by this ideal gives the smallest normal closed subgroup scheme of
`Spec H` through which all the morphisms `Spec (K i) ⟶ Spec H` factor. -/
noncomputable def normalCommonKernelHopfIdeal (f : ∀ i, H ⟶ K i) : HopfIdeal R H :=
  (commonKernelHopfIdeal f).normalCore

/-- The normal common-kernel ideal is normal. -/
@[simp]
theorem isNormal_normalCommonKernelHopfIdeal (f : ∀ i, H ⟶ K i) :
    (normalCommonKernelHopfIdeal f).IsNormal :=
  HopfIdeal.isNormal_normalCore (commonKernelHopfIdeal f)

/-- Every member of the defining family kills the normal common-kernel ideal. -/
theorem normalCommonKernelHopfIdeal_toIdeal_le_ker (f : ∀ i, H ⟶ K i) (i : ι) :
    (normalCommonKernelHopfIdeal f).toIdeal ≤
      RingHom.ker (f i).hom.toAlgHom.toRingHom :=
  (HopfIdeal.toIdeal_le_toIdeal.mpr (HopfIdeal.normalCore_le (commonKernelHopfIdeal f))).trans
    (commonKernelHopfIdeal_toIdeal_le_ker f i)

/-- A normal Hopf ideal killed by every member of the family lies below the normal common-kernel
ideal. This is the coordinate form of minimality of the normal closed subgroup generated by the
family. -/
theorem le_normalCommonKernelHopfIdeal (f : ∀ i, H ⟶ K i) (I : HopfIdeal R H)
    (hI : I.IsNormal)
    (hker : ∀ i, I.toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom) :
    I ≤ normalCommonKernelHopfIdeal f :=
  HopfIdeal.le_normalCore I (commonKernelHopfIdeal f) hI
    ((le_commonKernelHopfIdeal_iff f I).mpr hker)

/-- A normal Hopf ideal lies below the normal common-kernel ideal exactly when every member of the
family kills it. -/
theorem le_normalCommonKernelHopfIdeal_iff_of_isNormal
    (f : ∀ i, H ⟶ K i) (I : HopfIdeal R H)
    (hI : I.IsNormal) :
    I ≤ normalCommonKernelHopfIdeal f ↔
      ∀ i, I.toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom := by
  rw [normalCommonKernelHopfIdeal, HopfIdeal.le_normalCore_iff_of_isNormal I _ hI,
    le_commonKernelHopfIdeal_iff]

/-- The normal common-kernel ideal is contained in the ordinary common-kernel ideal.
Contravariantly, the normal closed subgroup generated by a family contains the closed subgroup
generated by that family. -/
theorem normalCommonKernelHopfIdeal_le_commonKernelHopfIdeal (f : ∀ i, H ⟶ K i) :
    normalCommonKernelHopfIdeal f ≤ commonKernelHopfIdeal f :=
  HopfIdeal.normalCore_le (commonKernelHopfIdeal f)

/-- If the ordinary common-kernel ideal is normal, it already is the normal common-kernel ideal. -/
theorem normalCommonKernelHopfIdeal_eq_commonKernelHopfIdeal_of_isNormal
    (f : ∀ i, H ⟶ K i)
    (h : (commonKernelHopfIdeal f).IsNormal) :
    normalCommonKernelHopfIdeal f = commonKernelHopfIdeal f :=
  HopfIdeal.normalCore_eq_self_of_isNormal (commonKernelHopfIdeal f) h

/-- The morphism from the normal common-kernel quotient induced by the `i`th member of the
family. -/
noncomputable def normalCommonKernelLift (f : ∀ i, H ⟶ K i) (i : ι) :
    quotient H (normalCommonKernelHopfIdeal f) ⟶ K i :=
  liftQuotient (normalCommonKernelHopfIdeal f) (f i)
    (normalCommonKernelHopfIdeal_toIdeal_le_ker f i)

/-- The quotient morphism followed by the normal common-kernel lift is the original morphism. -/
@[simp]
theorem mkQuotient_comp_normalCommonKernelLift (f : ∀ i, H ⟶ K i) (i : ι) :
    mkQuotient H (normalCommonKernelHopfIdeal f) ≫ normalCommonKernelLift f i = f i :=
  mkQuotient_comp_liftQuotient (normalCommonKernelHopfIdeal f) (f i)
    (normalCommonKernelHopfIdeal_toIdeal_le_ker f i)

/-- A surjective member of the family remains surjective after factoring through the normal
generated subgroup. -/
theorem normalCommonKernelLift_surjective_of_surjective (f : ∀ i, H ⟶ K i) (i : ι)
    (hi : Function.Surjective (f i).hom) :
    Function.Surjective (normalCommonKernelLift f i).hom :=
  liftQuotient_surjective_of_surjective (normalCommonKernelHopfIdeal f) (f i)
    (normalCommonKernelHopfIdeal_toIdeal_le_ker f i) hi

end TauCeti.CommHopfAlgCat
