module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Quotient.Basic

/-!
# The largest Hopf ideal in a family of kernels

Given morphisms `f i : H ⟶ K i` of commutative Hopf algebras, the ordinary intersection of
their ring-theoretic kernels need not come equipped with the structure of a Hopf ideal. This file
instead takes the supremum of all Hopf ideals contained in every kernel. The result is the largest
Hopf ideal through which every `f i` factors after quotienting `H`.

Contravariantly, this is the coordinate-algebra construction of the smallest closed subgroup
scheme containing a family of affine group-scheme morphisms into `Spec H`. The construction is
used by the Chevalley--Demazure lane of the reductive-groups roadmap to form the closed subgroup
scheme generated by the Kostant root subgroups.

## Main declarations

* `TauCeti.CommHopfAlgCat.commonKernelHopfIdeal`: the largest Hopf ideal contained in all the
  kernels.
* `TauCeti.CommHopfAlgCat.le_commonKernelHopfIdeal_iff`: its universal property.
* `TauCeti.CommHopfAlgCat.commonKernelLift`: the induced morphism from the quotient to each
  codomain.
-/

public section

namespace TauCeti.CommHopfAlgCat

open CategoryTheory

universe u v w

variable {R : Type u} [CommRing R]
variable {H : _root_.CommHopfAlgCat.{v} R}
variable {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} R}

/-- The largest Hopf ideal of `H` contained in the kernels of every morphism in `f`.

The supremum is taken in the complete upper semilattice of Hopf ideals. It is preferable to an
ordinary intersection of kernels: no assertion that a ring-theoretic kernel is itself a Hopf
ideal is needed. -/
noncomputable def commonKernelHopfIdeal (f : ∀ i, H ⟶ K i) : HopfIdeal R H :=
  sSup {I | ∀ i, I.toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom}

/-- The common-kernel Hopf ideal is contained in the kernel of each member of the family. -/
theorem commonKernelHopfIdeal_toIdeal_le_ker (f : ∀ i, H ⟶ K i) (i : ι) :
    (commonKernelHopfIdeal f).toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom := by
  rw [commonKernelHopfIdeal, HopfIdeal.sSup_toIdeal]
  exact iSup_le fun I ↦ I.2 i

/-- A Hopf ideal lies below the common-kernel ideal exactly when every morphism kills it. -/
theorem le_commonKernelHopfIdeal_iff (f : ∀ i, H ⟶ K i) (I : HopfIdeal R H) :
    I ≤ commonKernelHopfIdeal f ↔
      ∀ i, I.toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom := by
  rw [commonKernelHopfIdeal]
  constructor
  · intro h i
    exact (HopfIdeal.toIdeal_le_toIdeal.mpr h).trans
      (commonKernelHopfIdeal_toIdeal_le_ker f i)
  · intro h
    exact le_sSup h

/-- The morphism from the common-kernel quotient induced by the `i`th member of the family. -/
noncomputable abbrev commonKernelLift (f : ∀ i, H ⟶ K i) (i : ι) :
    quotient H (commonKernelHopfIdeal f) ⟶ K i :=
  liftQuotient (commonKernelHopfIdeal f) (f i)
    (commonKernelHopfIdeal_toIdeal_le_ker f i)

/-- The quotient morphism followed by a common-kernel lift is the original morphism. -/
@[simp]
theorem mkQuotient_comp_commonKernelLift (f : ∀ i, H ⟶ K i) (i : ι) :
    mkQuotient H (commonKernelHopfIdeal f) ≫ commonKernelLift f i = f i :=
  mkQuotient_comp_liftQuotient (commonKernelHopfIdeal f) (f i)
    (commonKernelHopfIdeal_toIdeal_le_ker f i)

/-- A morphism from the common-kernel quotient is determined by its composite with the quotient
morphism. -/
theorem commonKernelLift_unique (f : ∀ i, H ⟶ K i) (i : ι)
    (g : quotient H (commonKernelHopfIdeal f) ⟶ K i)
    (hg : mkQuotient H (commonKernelHopfIdeal f) ≫ g = f i) :
    g = commonKernelLift f i :=
  liftQuotient_unique (commonKernelHopfIdeal f) (f i)
    (commonKernelHopfIdeal_toIdeal_le_ker f i) g hg

end TauCeti.CommHopfAlgCat
