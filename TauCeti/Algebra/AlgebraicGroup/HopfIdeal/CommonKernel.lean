module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Quotient.Comap

/-!
# The largest Hopf ideal in a family of kernels

Given morphisms `f i : H ⟶ K i` of commutative Hopf algebras, the ordinary intersection of
their ring-theoretic kernels need not come equipped with the structure of a Hopf ideal. This file
instead takes the supremum of all Hopf ideals contained in every kernel. The result is the largest
Hopf ideal through which every `f i` factors after quotienting `H`.

Contravariantly, this is the coordinate-algebra construction of the smallest closed subgroup
scheme containing a family of affine group-scheme morphisms into `Spec H`. The construction is
used by the Chevalley--Demazure lane of the reductive-groups roadmap to form the closed subgroup
scheme generated by the Kostant root subgroups.

## Main declarations

* `TauCeti.CommHopfAlgCat.commonKernelHopfIdeal`: the largest Hopf ideal contained in all the
  kernels.
* `TauCeti.CommHopfAlgCat.le_commonKernelHopfIdeal_iff`: its universal property.
* `TauCeti.CommHopfAlgCat.comap_commonKernelHopfIdeal_le_of_comp_eq`: an endomorphism that
  intertwines the family along a reindexing pulls the common-kernel ideal back into itself.
* `TauCeti.CommHopfAlgCat.commonKernelLift`: the induced morphism from the quotient to each
  codomain.
* `TauCeti.CommHopfAlgCat.commonKernelLift_surjective_of_surjective`: a surjective member of the
  family remains surjective after factoring through the common-kernel quotient.
* `TauCeti.CommHopfAlgCat.commonKernelHopfIdeal_commonKernelLift_eq_bot`: the quotient carries no
  further common kernel for the lifted family.
-/

public section

namespace TauCeti.CommHopfAlgCat

open CategoryTheory

universe u v w

variable {R : Type u} [CommRing R]
variable {H : _root_.CommHopfAlgCat.{v} R}
variable {ι : Type w} {K : ι → _root_.CommHopfAlgCat.{v} R}

/-- The largest Hopf ideal of `H` contained in the kernels of every morphism in `f`.

The supremum is taken in the complete upper semilattice of Hopf ideals. It is preferable to an
ordinary intersection of kernels: no assertion that a ring-theoretic kernel is itself a Hopf
ideal is needed. -/
noncomputable def commonKernelHopfIdeal (f : ∀ i, H ⟶ K i) : HopfIdeal R H :=
  sSup {I | ∀ i, I.toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom}

/-- The common-kernel Hopf ideal is contained in the kernel of each member of the family. -/
theorem commonKernelHopfIdeal_toIdeal_le_ker (f : ∀ i, H ⟶ K i) (i : ι) :
    (commonKernelHopfIdeal f).toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom := by
  rw [commonKernelHopfIdeal, HopfIdeal.sSup_toIdeal]
  exact iSup_le fun I ↦ I.2 i

/-- A Hopf ideal lies below the common-kernel ideal exactly when every morphism kills it. -/
theorem le_commonKernelHopfIdeal_iff (f : ∀ i, H ⟶ K i) (I : HopfIdeal R H) :
    I ≤ commonKernelHopfIdeal f ↔
      ∀ i, I.toIdeal ≤ RingHom.ker (f i).hom.toAlgHom.toRingHom := by
  rw [commonKernelHopfIdeal]
  constructor
  · intro h i
    exact (HopfIdeal.toIdeal_le_toIdeal.mpr h).trans
      (commonKernelHopfIdeal_toIdeal_le_ker f i)
  · intro h
    exact le_sSup h

/-- **An endomorphism that intertwines the family along a reindexing pulls the common-kernel ideal
back into itself.** If every `f i` factors as `φ` followed by some other member `f (s i)` of the
family, then the inverse image of the common-kernel ideal along `φ` is again contained in it.

The conclusion is one containment, not invariance: an automorphism fixing the ideal needs this
lemma once for itself and once for its inverse.

The reindexing `s` is an arbitrary function `ι → ι`; at `s = id` the hypothesis reads `φ ≫ f i =
f i`, so the statement specialises to an endomorphism fixing the family pointwise. -/
theorem comap_commonKernelHopfIdeal_le_of_comp_eq {L : _root_.CommHopfAlgCat.{v} R}
    (f : ι → (H ⟶ L)) (φ : H ⟶ H) (hφ : Function.Surjective φ.hom) (s : ι → ι)
    (hs : ∀ i, φ ≫ f (s i) = f i) :
    (commonKernelHopfIdeal f).comap φ.hom hφ ≤ commonKernelHopfIdeal f := by
  -- `x` in the inverse image means `φ x` lies in the ideal, hence is killed by `f (s i)`;
  -- the intertwining square turns that into `f i x = 0`
  rw [le_commonKernelHopfIdeal_iff]
  intro i x hx
  simpa [← hs i] using
    RingHom.mem_ker.mp (commonKernelHopfIdeal_toIdeal_le_ker f (s i) (HopfIdeal.mem_comap.mp hx))

/-- The morphism from the common-kernel quotient induced by the `i`th member of the family. -/
noncomputable def commonKernelLift (f : ∀ i, H ⟶ K i) (i : ι) :
    quotient H (commonKernelHopfIdeal f) ⟶ K i :=
  liftQuotient (commonKernelHopfIdeal f) (f i)
    (commonKernelHopfIdeal_toIdeal_le_ker f i)

/-- The quotient morphism followed by a common-kernel lift is the original morphism. -/
@[simp]
theorem mkQuotient_comp_commonKernelLift (f : ∀ i, H ⟶ K i) (i : ι) :
    mkQuotient H (commonKernelHopfIdeal f) ≫ commonKernelLift f i = f i :=
  mkQuotient_comp_liftQuotient (commonKernelHopfIdeal f) (f i)
    (commonKernelHopfIdeal_toIdeal_le_ker f i)

/-- A surjective member of a family remains surjective after factoring through the common-kernel
quotient. Equivalently, its contravariant map of affine group schemes remains a closed immersion
after the target is replaced by the closed subgroup generated by the family. -/
theorem commonKernelLift_surjective_of_surjective (f : ∀ i, H ⟶ K i) (i : ι)
    (hi : Function.Surjective (f i).hom) :
    Function.Surjective (commonKernelLift f i).hom :=
  liftQuotient_surjective_of_surjective (commonKernelHopfIdeal f) (f i)
    (commonKernelHopfIdeal_toIdeal_le_ker f i) hi

/-- A morphism from the common-kernel quotient is determined by its composite with the quotient
morphism. -/
theorem commonKernelLift_unique (f : ∀ i, H ⟶ K i) (i : ι)
    (g : quotient H (commonKernelHopfIdeal f) ⟶ K i)
    (hg : mkQuotient H (commonKernelHopfIdeal f) ≫ g = f i) :
    g = commonKernelLift f i :=
  liftQuotient_unique (commonKernelHopfIdeal f) (f i)
    (commonKernelHopfIdeal_toIdeal_le_ker f i) g hg

/-- The common-kernel quotient carries no further common kernel: the lifted family separates it.

Contravariantly, the closed subgroup scheme generated by a family of morphisms is generated by
their factorizations through it. -/
theorem commonKernelHopfIdeal_commonKernelLift_eq_bot (f : ∀ i, H ⟶ K i) :
    commonKernelHopfIdeal (commonKernelLift f) = ⊥ := by
  refine eq_bot_of_comap_le _ ?_
  rw [le_commonKernelHopfIdeal_iff]
  intro i x hx
  have hxJ : (mkQuotient H (commonKernelHopfIdeal f)).hom x ∈
      commonKernelHopfIdeal (commonKernelLift f) := HopfIdeal.mem_comap.1 hx
  have hzero : (commonKernelLift f i).hom
      ((mkQuotient H (commonKernelHopfIdeal f)).hom x) = 0 :=
    RingHom.mem_ker.1 (commonKernelHopfIdeal_toIdeal_le_ker (commonKernelLift f) i hxJ)
  have hcomp : (commonKernelLift f i).hom
      ((mkQuotient H (commonKernelHopfIdeal f)).hom x) = (f i).hom x :=
    congrArg (fun m : H ⟶ K i => m.hom x) (mkQuotient_comp_commonKernelLift f i)
  rw [RingHom.mem_ker]
  simpa only [BialgHom.coe_toAlgHom, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] using
    hcomp.symm.trans hzero

end TauCeti.CommHopfAlgCat
