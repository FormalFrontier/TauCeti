module

public import TauCeti.Combinatorics.Brauer.LoopCount

/-!
# The Brauer generators and their relations

Besides the permutation diagrams, the Brauer diagrams on `k` strands are generated by the
**cap-cup diagrams**: for a pair of distinct indices `a ≠ b`, the diagram `TauCeti.capCup` whose
only horizontal arcs are the cap joining the bottom points `a` and `b` and the cup joining the
top points `a` and `b`, every other boundary point lying on the through strand joining the two
points with its index. These are the diagrams written `e` in Brauer's presentation; the classical
generator `eᵢ` of `B_k(δ)` is `capCup` on the adjacent pair `{i, i + 1}`, but nothing below needs
the pair to be adjacent, so the pair is arbitrary throughout.

This file builds these diagrams and proves, on the diagram basis, the relations that the loop-
weighted multiplication `D₁ * D₂ = δ ^ middleLoopCount D₁ D₂ • composeDiagram D₁ D₂` of the
Brauer algebra turns into Brauer's relations:

* `e * e = δ • e`: stacking a cap-cup diagram on itself returns that diagram
  (`TauCeti.composeDiagram_capCup_capCup`) and closes up exactly one loop in the middle
  (`TauCeti.middleLoopCount_capCup_capCup`), the single loop formed by the cap of the upper copy
  and the cup of the lower one. This is the relation the loop rule exists for, and the first
  place the middle-loop count is computed exactly rather than bounded.
* `s * e = e = e * s` for the transposition `s` of the pair
  (`TauCeti.composeDiagram_permToBrauer_swap_capCup` and
  `TauCeti.composeDiagram_capCup_permToBrauer_swap`), with no loop closing up because a
  permutation diagram has neither a cap nor a cup.
* the mixed permutation/generator relation `σ e_{a,b} σ⁻¹ = e_{σ a, σ b}`
  (`TauCeti.composeDiagram_permToBrauer_conj_capCup`): conjugating a cap-cup diagram by a
  permutation diagram moves it to the renamed pair. Its far-commutation special case,
  `σ e_{a,b} σ⁻¹ = e_{a,b}` whenever `σ` fixes `a` and `b`, is the relation that makes distant
  generators and transpositions commute.

The Brauer relation `s * s = 1` is `TauCeti.composeDiagram_permToBrauer` together with
`Equiv.swap_mul_self`, and the braid relations are the same lemma applied to the braid relation
in `Equiv.Perm (Fin k)`; both are already available on the permutation diagrams and are not
restated here.

## Main definitions

* `TauCeti.capCupArc`: the arcs of a cap-cup diagram, as an involution of the boundary points.
* `TauCeti.capCup`: the cap-cup diagram on a pair of distinct indices, the Brauer generator `e`.

## Main results

* `TauCeti.capCup_comm`, `TauCeti.capCup_eq_capCup_iff`: a cap-cup diagram depends exactly on the
  unordered pair it caps.
* `TauCeti.bottomCap_capCup`, `TauCeti.topCup_capCup`: its cap and its cup are the pair.
* `TauCeti.capCup_ne_permToBrauer`: a cap-cup diagram is not a permutation diagram.
* `TauCeti.composeDiagram_capCup_capCup`, `TauCeti.middleLoopCount_capCup_capCup`: the relation
  `e * e = δ • e`.
* `TauCeti.composeDiagram_permToBrauer_swap_capCup`,
  `TauCeti.composeDiagram_capCup_permToBrauer_swap`: the relation `s * e = e = e * s`.
* `TauCeti.composeDiagram_permToBrauer_conj_capCup`: conjugating a generator by a permutation
  diagram renames its pair.

## References

* [R. Brauer, *On algebras which are connected with the semisimple continuous groups*][brauer1937],
  Annals of Mathematics 38 (1937), 857-872.
* [Schur--Weyl roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/SchurWeyl/README.md),
  Layer 9.
-/

public section

namespace TauCeti

variable {k : ℕ} {a b i j : Fin k}

/-- **The arcs of a cap-cup diagram.** The two bottom points `a` and `b` are joined to each other
by a cap and the two top points `a` and `b` by a cup, while every other boundary point is joined
to the point of the opposite boundary with the same index. -/
def capCupArc (a b : Fin k) : Fin k ⊕ Fin k → Fin k ⊕ Fin k
  | Sum.inl i => if i = a then Sum.inl b else if i = b then Sum.inl a else Sum.inr i
  | Sum.inr j => if j = a then Sum.inr b else if j = b then Sum.inr a else Sum.inl j

/-- The arcs of a cap-cup diagram form an involution: following an arc twice returns to its
starting point. -/
theorem capCupArc_involutive (hab : a ≠ b) : Function.Involutive (capCupArc a b) := by
  have hba : b ≠ a := hab.symm
  rintro (i | i)
  · rcases eq_or_ne i a with rfl | hia
    · simp [capCupArc, hba]
    · rcases eq_or_ne i b with rfl | hib
      · simp [capCupArc, hia]
      · simp [capCupArc, hia, hib]
  · rcases eq_or_ne i a with rfl | hia
    · simp [capCupArc, hba]
    · rcases eq_or_ne i b with rfl | hib
      · simp [capCupArc, hia]
      · simp [capCupArc, hia, hib]

/-- No arc of a cap-cup diagram joins a boundary point to itself. -/
theorem capCupArc_ne (hab : a ≠ b) (x : Fin k ⊕ Fin k) : capCupArc a b x ≠ x := by
  have hba : b ≠ a := hab.symm
  rcases x with i | i
  · rcases eq_or_ne i a with rfl | hia
    · simp [capCupArc, hba]
    · rcases eq_or_ne i b with rfl | hib
      · simp [capCupArc, hia, hab]
      · simp [capCupArc, hia, hib]
  · rcases eq_or_ne i a with rfl | hia
    · simp [capCupArc, hba]
    · rcases eq_or_ne i b with rfl | hib
      · simp [capCupArc, hia, hab]
      · simp [capCupArc, hia, hib]

/-- **The cap-cup diagram** on the pair `{a, b}`: the Brauer diagram whose only horizontal arcs
are the cap joining the bottom points `a` and `b` and the cup joining the top points `a` and `b`.
It is the Brauer generator `e` of the pair; the classical generator `eᵢ` is the case of the
adjacent pair `{i, i + 1}`. -/
def capCup (hab : a ≠ b) : BrauerDiagram k :=
  .mk ((capCupArc_involutive hab).toPerm _)
    (fun x => by
      simp only [Function.Involutive.coe_toPerm]
      exact capCupArc_involutive hab x)
    (fun x => by
      simp only [Function.Involutive.coe_toPerm]
      exact capCupArc_ne hab x)

/-- The arcs of the cap-cup diagram are the arcs `TauCeti.capCupArc`. -/
theorem capCup_val_apply (hab : a ≠ b) (x : Fin k ⊕ Fin k) :
    (capCup hab).val x = capCupArc a b x := by
  rw [capCup, PerfectMatching.val_mk, Function.Involutive.coe_toPerm]

/-! ### The arcs of a cap-cup diagram -/

/-- The cap of `capCup hab` joins the bottom point `a` to the bottom point `b`. -/
@[simp]
theorem capCup_val_inl_left (hab : a ≠ b) : (capCup hab).val (Sum.inl a) = Sum.inl b := by
  rw [capCup_val_apply]; simp [capCupArc]

/-- The cap of `capCup hab` joins the bottom point `b` to the bottom point `a`. -/
@[simp]
theorem capCup_val_inl_right (hab : a ≠ b) : (capCup hab).val (Sum.inl b) = Sum.inl a := by
  rw [capCup_val_apply]; simp [capCupArc, hab.symm]

/-- Away from the capped pair, `capCup hab` joins the bottom point `i` to the top point `i`. -/
theorem capCup_val_inl_of_ne (hab : a ≠ b) (hia : i ≠ a) (hib : i ≠ b) :
    (capCup hab).val (Sum.inl i) = Sum.inr i := by
  rw [capCup_val_apply]; simp [capCupArc, hia, hib]

/-- The cup of `capCup hab` joins the top point `a` to the top point `b`. -/
@[simp]
theorem capCup_val_inr_left (hab : a ≠ b) : (capCup hab).val (Sum.inr a) = Sum.inr b := by
  rw [capCup_val_apply]; simp [capCupArc]

/-- The cup of `capCup hab` joins the top point `b` to the top point `a`. -/
@[simp]
theorem capCup_val_inr_right (hab : a ≠ b) : (capCup hab).val (Sum.inr b) = Sum.inr a := by
  rw [capCup_val_apply]; simp [capCupArc, hab.symm]

/-- Away from the cupped pair, `capCup hab` joins the top point `j` to the bottom point `j`. -/
theorem capCup_val_inr_of_ne (hab : a ≠ b) (hja : j ≠ a) (hjb : j ≠ b) :
    (capCup hab).val (Sum.inr j) = Sum.inl j := by
  rw [capCup_val_apply]; simp [capCupArc, hja, hjb]

/-- **A cap-cup diagram caps exactly its pair**: a bottom point of `capCup hab` lies on a cap
exactly when it is `a` or `b`. -/
theorem isCap_capCup_inl_iff (hab : a ≠ b) :
    (capCup hab).IsCap (Sum.inl i) ↔ i = a ∨ i = b := by
  rcases eq_or_ne i a with rfl | hia
  · simp [BrauerDiagram.isCap_def]
  · rcases eq_or_ne i b with rfl | hib
    · simp [BrauerDiagram.isCap_def]
    · simp [BrauerDiagram.isCap_def, capCup_val_inl_of_ne hab hia hib, hia, hib]

/-- **A cap-cup diagram cups exactly its pair**: a top point of `capCup hab` lies on a cup
exactly when it is `a` or `b`. -/
theorem isCup_capCup_inr_iff (hab : a ≠ b) :
    (capCup hab).IsCup (Sum.inr j) ↔ j = a ∨ j = b := by
  rcases eq_or_ne j a with rfl | hja
  · simp [BrauerDiagram.isCup_def]
  · rcases eq_or_ne j b with rfl | hjb
    · simp [BrauerDiagram.isCup_def]
    · simp [BrauerDiagram.isCup_def, capCup_val_inr_of_ne hab hja hjb, hja, hjb]

/-- **The through strands of a cap-cup diagram** are the ones off its pair. -/
theorem isThrough_capCup_inl_iff (hab : a ≠ b) :
    (capCup hab).IsThrough (Sum.inl i) ↔ i ≠ a ∧ i ≠ b := by
  rcases eq_or_ne i a with rfl | hia
  · simp [BrauerDiagram.isThrough_def]
  · rcases eq_or_ne i b with rfl | hib
    · simp [BrauerDiagram.isThrough_def]
    · simp [BrauerDiagram.isThrough_def, capCup_val_inl_of_ne hab hia hib, hia, hib]

/-- The capped bottom points of `capCup hab` are `a` and `b`. -/
theorem bottomCap_capCup (hab : a ≠ b) : (capCup hab).bottomCap = {a, b} := by
  ext i
  rw [BrauerDiagram.mem_bottomCap, isCap_capCup_inl_iff hab]
  simp

/-- The cupped top points of `capCup hab` are `a` and `b`. -/
theorem topCup_capCup (hab : a ≠ b) : (capCup hab).topCup = {a, b} := by
  ext j
  rw [BrauerDiagram.mem_topCup, isCup_capCup_inr_iff hab]
  simp

/-- **A cap-cup diagram is not a permutation diagram**: it has a cap, and every arc of a
permutation diagram goes through. -/
theorem capCup_ne_permToBrauer (hab : a ≠ b) (σ : Equiv.Perm (Fin k)) :
    capCup hab ≠ permToBrauer σ := by
  intro h
  have hcap : (capCup hab).IsCap (Sum.inl a) := (isCap_capCup_inl_iff hab).mpr (Or.inl rfl)
  rw [h] at hcap
  exact BrauerDiagram.not_isThrough_of_isCap _ _ hcap
    (BrauerDiagram.isThrough_permToBrauer σ (Sum.inl a))

/-! ### A cap-cup diagram depends only on the unordered pair -/

/-- The arcs of a cap-cup diagram do not depend on the order of the pair. -/
theorem capCupArc_symm (hab : a ≠ b) : capCupArc b a = capCupArc a b := by
  funext x
  rcases x with i | i
  · rcases eq_or_ne i a with rfl | hia
    · simp [capCupArc]
    · rcases eq_or_ne i b with rfl | hib
      · simp [capCupArc, hia]
      · simp [capCupArc, hia, hib]
  · rcases eq_or_ne i a with rfl | hia
    · simp [capCupArc]
    · rcases eq_or_ne i b with rfl | hib
      · simp [capCupArc, hia]
      · simp [capCupArc, hia, hib]

/-- **A cap-cup diagram depends only on the unordered pair it caps.** -/
theorem capCup_comm (hab : a ≠ b) : capCup hab.symm = capCup hab :=
  Subtype.ext (Equiv.ext fun x => by
    rw [capCup_val_apply, capCup_val_apply, capCupArc_symm hab])

/-- **Two cap-cup diagrams agree exactly when they cap the same unordered pair.** -/
theorem capCup_eq_capCup_iff {c d : Fin k} (hab : a ≠ b) (hcd : c ≠ d) :
    capCup hab = capCup hcd ↔ (a = c ∧ b = d) ∨ (a = d ∧ b = c) := by
  refine ⟨fun h => ?_, ?_⟩
  · have hval : (capCup hcd).val (Sum.inl a) = Sum.inl b := by
      rw [← h, capCup_val_inl_left]
    rcases eq_or_ne a c with rfl | hac
    · rw [capCup_val_inl_left] at hval
      exact Or.inl ⟨rfl, (Sum.inl_injective hval).symm⟩
    · rcases eq_or_ne a d with rfl | had
      · rw [capCup_val_inl_right] at hval
        exact Or.inr ⟨rfl, (Sum.inl_injective hval).symm⟩
      · rw [capCup_val_inl_of_ne hcd hac had] at hval
        exact absurd hval (by simp)
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · rfl
    · exact capCup_comm hcd

/-! ### Relabelling a cap-cup diagram -/

/-- **Relabelling both boundaries of a cap-cup diagram by the same permutation** moves it to the
renamed pair. -/
theorem relabel_capCup (hab : a ≠ b) (σ : Equiv.Perm (Fin k)) :
    (capCup hab).relabel σ σ = capCup (show σ a ≠ σ b from fun h => hab (σ.injective h)) := by
  refine Subtype.ext (Equiv.ext fun x => ?_)
  rcases x with i | i
  · rw [BrauerDiagram.relabel_val_inl]
    rcases eq_or_ne i (σ a) with rfl | hia
    · rw [capCup_val_inl_left, Equiv.symm_apply_apply, capCup_val_inl_left, Sum.map_inl]
    · rcases eq_or_ne i (σ b) with rfl | hib
      · rw [capCup_val_inl_right, Equiv.symm_apply_apply, capCup_val_inl_right, Sum.map_inl]
      · rw [capCup_val_inl_of_ne _ (fun h => hia (by rw [← h, Equiv.apply_symm_apply]))
          (fun h => hib (by rw [← h, Equiv.apply_symm_apply])), Sum.map_inr,
          Equiv.apply_symm_apply, capCup_val_inl_of_ne _ hia hib]
  · rw [BrauerDiagram.relabel_val_inr]
    rcases eq_or_ne i (σ a) with rfl | hia
    · rw [capCup_val_inr_left, Equiv.symm_apply_apply, capCup_val_inr_left, Sum.map_inr]
    · rcases eq_or_ne i (σ b) with rfl | hib
      · rw [capCup_val_inr_right, Equiv.symm_apply_apply, capCup_val_inr_right, Sum.map_inr]
      · rw [capCup_val_inr_of_ne _ (fun h => hia (by rw [← h, Equiv.apply_symm_apply]))
          (fun h => hib (by rw [← h, Equiv.apply_symm_apply])), Sum.map_inl,
          Equiv.apply_symm_apply, capCup_val_inr_of_ne _ hia hib]

/-- **Renaming the top boundary by the transposition of the pair fixes a cap-cup diagram**: the
cap and the cup of `capCup hab` are both the pair `{a, b}`, which the transposition preserves. -/
theorem relabel_one_swap_capCup (hab : a ≠ b) :
    (capCup hab).relabel 1 (Equiv.swap a b) = capCup hab := by
  refine Subtype.ext (Equiv.ext fun x => ?_)
  rcases x with i | i
  · rcases eq_or_ne i a with rfl | hia
    · simp [Equiv.Perm.one_def]
    · rcases eq_or_ne i b with rfl | hib
      · simp [Equiv.Perm.one_def]
      · simp [Equiv.Perm.one_def, capCup_val_inl_of_ne hab hia hib,
          Equiv.swap_apply_of_ne_of_ne hia hib]
  · rcases eq_or_ne i a with rfl | hia
    · simp [Equiv.Perm.one_def]
    · rcases eq_or_ne i b with rfl | hib
      · simp [Equiv.Perm.one_def]
      · simp [Equiv.Perm.one_def, Equiv.swap_apply_of_ne_of_ne hia hib,
          capCup_val_inr_of_ne hab hia hib]

/-- **Renaming the bottom boundary by the transposition of the pair fixes a cap-cup diagram.** -/
theorem relabel_swap_one_capCup (hab : a ≠ b) :
    (capCup hab).relabel (Equiv.swap a b) 1 = capCup hab := by
  refine Subtype.ext (Equiv.ext fun x => ?_)
  rcases x with i | i
  · rcases eq_or_ne i a with rfl | hia
    · simp [Equiv.Perm.one_def]
    · rcases eq_or_ne i b with rfl | hib
      · simp [Equiv.Perm.one_def]
      · simp [Equiv.Perm.one_def, Equiv.swap_apply_of_ne_of_ne hia hib,
          capCup_val_inl_of_ne hab hia hib]
  · rcases eq_or_ne i a with rfl | hia
    · simp [Equiv.Perm.one_def]
    · rcases eq_or_ne i b with rfl | hib
      · simp [Equiv.Perm.one_def]
      · simp [Equiv.Perm.one_def, capCup_val_inr_of_ne hab hia hib,
          Equiv.swap_apply_of_ne_of_ne hia hib]

/-! ### The Brauer relations on the diagram basis -/

/-- **`e * e` is `e` on the diagram basis**: stacking a cap-cup diagram on itself returns that
diagram. Together with `TauCeti.middleLoopCount_capCup_capCup` this is Brauer's relation
`e * e = δ • e`. -/
theorem composeDiagram_capCup_capCup (hab : a ≠ b) :
    composeDiagram (capCup hab) (capCup hab) = capCup hab := by
  refine Subtype.ext (Equiv.ext fun x => ?_)
  rcases x with i | i
  · rcases eq_or_ne i a with rfl | hia
    · rw [composeDiagram_val_inl_eq_inl_of_cap_lower _ _ (capCup_val_inl_left hab),
        capCup_val_inl_left]
    · rcases eq_or_ne i b with rfl | hib
      · rw [composeDiagram_val_inl_eq_inl_of_cap_lower _ _ (capCup_val_inl_right hab),
          capCup_val_inl_right]
      · rw [composeDiagram_val_inl_eq_inr_of_through _ _ (capCup_val_inl_of_ne hab hia hib)
          (capCup_val_inl_of_ne hab hia hib), capCup_val_inl_of_ne hab hia hib]
  · rcases eq_or_ne i a with rfl | hia
    · rw [composeDiagram_val_inr_eq_inr_of_cup_upper _ _ (capCup_val_inr_left hab),
        capCup_val_inr_left]
    · rcases eq_or_ne i b with rfl | hib
      · rw [composeDiagram_val_inr_eq_inr_of_cup_upper _ _ (capCup_val_inr_right hab),
          capCup_val_inr_right]
      · rw [composeDiagram_val_inr_eq_inl_of_through _ _ (capCup_val_inr_of_ne hab hia hib)
          (capCup_val_inr_of_ne hab hia hib), capCup_val_inr_of_ne hab hia hib]

/-- The middle points that keep both of their arcs in the middle when a cap-cup diagram is
stacked on itself are exactly the two points of its pair. -/
theorem isMiddleVertex_capCup_iff (hab : a ≠ b) {x : Fin k} :
    IsMiddleVertex (capCup hab) (capCup hab) x ↔ x = a ∨ x = b := by
  rw [isMiddleVertex_def, isCap_capCup_inl_iff hab, isCup_capCup_inr_iff hab, and_self]

/-- The middle graph of a cap-cup diagram stacked on itself joins the two points of its pair and
nothing else. -/
theorem middleAdj_capCup_iff (hab : a ≠ b) {x y : Fin k} :
    MiddleAdj (capCup hab) (capCup hab) x y ↔ (x = a ∧ y = b) ∨ (x = b ∧ y = a) := by
  rw [middleAdj_def]
  rcases eq_or_ne x a with rfl | hxa
  · rw [capCup_val_inl_left, capCup_val_inr_left]
    refine ⟨fun h => Or.inl ⟨rfl, ?_⟩, ?_⟩
    · rcases h with h | h
      · exact (Sum.inl_injective h).symm
      · exact (Sum.inr_injective h).symm
    · rintro (⟨-, rfl⟩ | ⟨h, -⟩)
      · exact Or.inl rfl
      · exact absurd h hab
  · rcases eq_or_ne x b with rfl | hxb
    · rw [capCup_val_inl_right, capCup_val_inr_right]
      refine ⟨fun h => Or.inr ⟨rfl, ?_⟩, ?_⟩
      · rcases h with h | h
        · exact (Sum.inl_injective h).symm
        · exact (Sum.inr_injective h).symm
      · rintro (⟨h, -⟩ | ⟨-, rfl⟩)
        · exact absurd h hxa
        · exact Or.inl rfl
    · rw [capCup_val_inl_of_ne hab hxa hxb, capCup_val_inr_of_ne hab hxa hxb]
      simp [hxa, hxb]

/-- Walking in the middle graph of a cap-cup diagram stacked on itself never leaves its pair. -/
theorem mem_pair_of_reflTransGen_middleAdj_capCup (hab : a ≠ b) {x y : Fin k}
    (hx : x = a ∨ x = b) (h : Relation.ReflTransGen (MiddleAdj (capCup hab) (capCup hab)) x y) :
    y = a ∨ y = b := by
  induction h with
  | refl => exact hx
  | tail _ huv _ =>
    rcases (middleAdj_capCup_iff hab).mp huv with ⟨-, rfl⟩ | ⟨-, rfl⟩
    · exact Or.inr rfl
    · exact Or.inl rfl

/-- **The middle loop of `e * e`**: the middle points lying on a closed loop when a cap-cup
diagram is stacked on itself are exactly the two points of its pair, which the cap of the upper
copy and the cup of the lower one join into a single loop. -/
theorem onMiddleLoop_capCup_iff (hab : a ≠ b) {x : Fin k} :
    OnMiddleLoop (capCup hab) (capCup hab) x ↔ x = a ∨ x = b := by
  refine ⟨fun h => (isMiddleVertex_capCup_iff hab).mp h.isMiddleVertex, fun hx => ?_⟩
  rw [onMiddleLoop_def]
  exact fun y hy => (isMiddleVertex_capCup_iff hab).mpr
    (mem_pair_of_reflTransGen_middleAdj_capCup hab hx hy)

/-- **`e * e = δ • e`, the loop half**: stacking a cap-cup diagram on itself closes up exactly
one loop in the middle, so the loop-weighted multiplication of the Brauer algebra sends
`e * e` to `δ • e`. -/
theorem middleLoopCount_capCup_capCup (hab : a ≠ b) :
    middleLoopCount (capCup hab) (capCup hab) = 1 := by
  have hreach : ∀ {x y : Fin k}, x = a ∨ x = b →
      Relation.ReflTransGen (MiddleAdj (capCup hab) (capCup hab)) x y → y = a ∨ y = b :=
    fun hx hy => mem_pair_of_reflTransGen_middleAdj_capCup hab hx hy
  have hab' : Relation.ReflTransGen (MiddleAdj (capCup hab) (capCup hab)) a b :=
    .single ((middleAdj_capCup_iff hab).mpr (Or.inl ⟨rfl, rfl⟩))
  have hba' : Relation.ReflTransGen (MiddleAdj (capCup hab) (capCup hab)) b a :=
    .single ((middleAdj_capCup_iff hab).mpr (Or.inr ⟨rfl, rfl⟩))
  have hmem : ∀ {x : Fin k}, IsMiddleLoopMin (capCup hab) (capCup hab) x ↔
      (x = a ∧ a ≤ b) ∨ (x = b ∧ b ≤ a) := by
    intro x
    rw [isMiddleLoopMin_def]
    constructor
    · rintro ⟨hloop, hmin⟩
      rcases (onMiddleLoop_capCup_iff hab).mp hloop with rfl | rfl
      · exact Or.inl ⟨rfl, hmin _ hab'⟩
      · exact Or.inr ⟨rfl, hmin _ hba'⟩
    · rintro (⟨rfl, hle⟩ | ⟨rfl, hle⟩)
      · exact ⟨(onMiddleLoop_capCup_iff hab).mpr (Or.inl rfl), fun y hy => by
          rcases hreach (Or.inl rfl) hy with rfl | rfl
          · exact le_rfl
          · exact hle⟩
      · exact ⟨(onMiddleLoop_capCup_iff hab).mpr (Or.inr rfl), fun y hy => by
          rcases hreach (Or.inr rfl) hy with rfl | rfl
          · exact hle
          · exact le_rfl⟩
  rw [middleLoopCount_def]
  have hset : {x : Fin k | IsMiddleLoopMin (capCup hab) (capCup hab) x} = {min a b} := by
    ext x
    rw [Set.mem_ofPred_eq, hmem, Set.mem_singleton_iff]
    rcases le_total a b with hle | hle
    · rw [min_eq_left hle]
      constructor
      · rintro (⟨rfl, -⟩ | ⟨rfl, hle'⟩)
        · rfl
        · exact le_antisymm hle' hle
      · rintro rfl
        exact Or.inl ⟨rfl, hle⟩
    · rw [min_eq_right hle]
      constructor
      · rintro (⟨rfl, hle'⟩ | ⟨rfl, -⟩)
        · exact le_antisymm hle' hle
        · rfl
      · rintro rfl
        exact Or.inr ⟨rfl, hle⟩
  rw [hset, Set.ncard_singleton]

/-- **`s * e = e` on the diagram basis**: stacking the diagram of the transposition of the pair
above a cap-cup diagram returns that diagram. No loop closes up in the middle
(`TauCeti.middleLoopCount_permToBrauer_left`), so this is Brauer's relation `s * e = e`. -/
theorem composeDiagram_permToBrauer_swap_capCup (hab : a ≠ b) :
    composeDiagram (permToBrauer (Equiv.swap a b)) (capCup hab) = capCup hab := by
  rw [composeDiagram_permToBrauer_left, relabel_one_swap_capCup]

/-- **`e * s = e` on the diagram basis**: stacking a cap-cup diagram above the diagram of the
transposition of its pair returns that diagram. No loop closes up in the middle
(`TauCeti.middleLoopCount_permToBrauer_right`), so this is Brauer's relation `e * s = e`. -/
theorem composeDiagram_capCup_permToBrauer_swap (hab : a ≠ b) :
    composeDiagram (capCup hab) (permToBrauer (Equiv.swap a b)) = capCup hab := by
  rw [composeDiagram_permToBrauer_right, Equiv.Perm.inv_def, Equiv.symm_swap,
    relabel_swap_one_capCup]

/-- **The mixed permutation/generator relation**: conjugating a cap-cup diagram by a permutation
diagram moves it to the cap-cup diagram on the renamed pair. Taking `σ` to fix `a` and `b` gives
the far-commutation relation `σ e = e σ`, and taking `σ` to be a transposition inside the pair
recovers `TauCeti.composeDiagram_permToBrauer_swap_capCup`. -/
theorem composeDiagram_permToBrauer_conj_capCup (hab : a ≠ b) (σ : Equiv.Perm (Fin k)) :
    composeDiagram (permToBrauer σ) (composeDiagram (capCup hab) (permToBrauer σ⁻¹)) =
      capCup (show σ a ≠ σ b from fun h => hab (σ.injective h)) := by
  rw [composeDiagram_permToBrauer_right, composeDiagram_permToBrauer_left, inv_inv,
    BrauerDiagram.relabel_relabel, one_mul, mul_one, relabel_capCup]

end TauCeti
