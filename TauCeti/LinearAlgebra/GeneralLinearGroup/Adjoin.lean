module

public import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.RingTheory.Artinian.Algebra
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# Algebra generated by a unit

This file records algebraic facts used for linear automorphisms. In a finite-dimensional algebra
over a field, the inverse of a unit belongs to the algebra generated by that unit. It also provides
basic coercion lemmas for the equivalence between linear equivalences and the general linear group.
The inverse result uses Mathlib's
`IsArtinianRing.isUnit_of_isIntegral_of_nonZeroDivisor`.

## Main declarations

* `TauCeti.Units.coe_inv_mem_adjoin`: the inverse of a unit in a finite-dimensional algebra is
  contained in the algebra generated by that unit.
-/

public section

namespace TauCeti

universe u v

namespace Units

open nonZeroDivisors

variable {K : Type u} {A : Type v} [Field K] [Ring A] [Algebra K A]
  [FiniteDimensional K A]

/-- The inverse of a unit in a finite-dimensional algebra over a field belongs to the algebra
generated by that unit. -/
theorem coe_inv_mem_adjoin (u : Aˣ) :
    ((u⁻¹ : Aˣ) : A) ∈ Algebra.adjoin K {(u : A)} := by
  let B : Subalgebra K A := Algebra.adjoin K {(u : A)}
  let x : B := ⟨(u : A), Algebra.subset_adjoin (Set.mem_singleton _)⟩
  have hx_integral : IsIntegral K x :=
    (isIntegral_algHom_iff B.val Subtype.val_injective).mp
      (IsIntegral.of_finite K (u : A))
  have hinjective : Function.Injective B.subtype := Subtype.val_injective
  have hx_regular : x ∈ B⁰ :=
    comap_nonZeroDivisors_le_of_injective hinjective
      u.isUnit.mem_nonZeroDivisors
  have hx : IsUnit x :=
    IsArtinianRing.isUnit_of_isIntegral_of_nonZeroDivisor hx_integral hx_regular
  have hunit : hx.unit.map B.subtype = u := by
    apply Units.ext
    exact congrArg Subtype.val hx.unit_spec
  have hinv : ((u⁻¹ : Aˣ) : A) = (((hx.unit⁻¹ : Bˣ) : B) : A) := by
    rw [← hunit]
    rfl
  rw [hinv]
  exact ((hx.unit⁻¹ : Bˣ) : B).2

end Units

namespace GeneralLinearGroup

open LinearMap

variable {K : Type u} {V : Type v} [Semiring K] [AddCommMonoid V] [Module K V]

/-- Converting a linear equivalence to a general-linear-group element and back is the identity. -/
@[simp]
theorem toLinearEquiv_ofLinearEquiv (e : V ≃ₗ[K] V) :
    (LinearMap.GeneralLinearGroup.ofLinearEquiv e).toLinearEquiv = e :=
  rfl

/-- The linear map underlying a general-linear-group element's linear equivalence is the
underlying endomorphism of the group element. -/
@[simp]
theorem toLinearEquiv_toLinearMap (g : GeneralLinearGroup K V) :
    g.toLinearEquiv.toLinearMap = (g : Module.End K V) :=
  rfl

/-- The endomorphism underlying the general-linear-group element associated to a linear
equivalence is its underlying linear map. -/
@[simp]
theorem coe_ofLinearEquiv_toLinearMap (e : V ≃ₗ[K] V) :
    ((LinearMap.GeneralLinearGroup.ofLinearEquiv e : GeneralLinearGroup K V) :
      Module.End K V) = e.toLinearMap :=
  rfl

/-- Converting a power of a linear equivalence to the general linear group preserves powers. -/
theorem ofLinearEquiv_pow (e : V ≃ₗ[K] V) (n : ℕ) :
    LinearMap.GeneralLinearGroup.ofLinearEquiv (e ^ n) =
      LinearMap.GeneralLinearGroup.ofLinearEquiv e ^ n :=
  map_pow (LinearMap.GeneralLinearGroup.generalLinearEquiv K V).symm e n

end GeneralLinearGroup

end TauCeti
