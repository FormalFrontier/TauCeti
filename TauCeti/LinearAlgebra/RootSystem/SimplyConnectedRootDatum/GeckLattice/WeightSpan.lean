module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree

/-!
# The character lattice generated by the pinned Geck weights

For a valid Dynkin type `t`, the standard coordinates of Geck's representation have weight zero
on the Cartan coordinates and have the roots of `t` as their remaining weights. This file records
that fact integrally and identifies the lattice generated by those weights with the root lattice
inside the character lattice of `TauCeti.DynkinType.simplyConnectedRootDatum`.

That distinction matters for the Chevalley--Demazure construction. The torus in the explicit Geck
carrier acts through the lattice generated by the representation's weights. In general this is
only the root lattice, so the carrier is a candidate for the adjoint form rather than the simply
connected form needed by milestone L0 of the CFSG statement roadmap. For the unimodular types
`E₈`, `F₄`, and `G₂`, however, the roots span the full weight lattice. The existing Geck
admissible lattice therefore has the full character lattice in precisely those three exceptional
cases.

This file proves only the lattice statement. Identifying the resulting group scheme as split
reductive with the pinned root datum, and constructing suitable admissible lattices for the other
types, remain Layer 9 work in the reductive-groups roadmap.

## Main results

* `TauCeti.DynkinType.geckWeight_inl_eq_zero`: a Cartan coordinate of the Geck module has
  weight zero.
* `TauCeti.DynkinType.geckWeight_inr_eq_root`: a root coordinate of the Geck module has exactly
  the corresponding integral root as its weight.
* `TauCeti.DynkinType.span_range_geckWeight_eq_span_range_root`: the Geck weights generate the
  root lattice.
* `TauCeti.DynkinType.span_range_geckWeight_E8_eq_top`, and the analogous `F4` and `G2` results:
  in the three unimodular exceptional types, the Geck weights generate the full character lattice.

## References

The use of an admissible lattice and its weights follows J. E. Humphreys, *Linear Algebraic
Groups*, §27. The determinants of the Cartan matrices and the identification of the root and
weight lattices follow Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Plates VII--IX.
-/

public section

namespace TauCeti.DynkinType

open Function Set

noncomputable section

variable (t : DynkinType) (ht : t.Valid)

/-- **A Cartan coordinate of the pinned Geck module has weight zero.** -/
theorem geckWeight_inl_eq_zero (x : (t.rationalBase ht).support) :
    t.geckWeight ht (Sum.inl x) = 0 := by
  ext i
  exact geckWeight_inl t ht x i

/-- **A root coordinate of the pinned Geck module has the corresponding integral root as its
weight.** -/
theorem geckWeight_inr_eq_root (k : Fin t.numRoots) :
    t.geckWeight ht (Sum.inr k) = (t.simplyConnectedRootDatum ht).root k := by
  ext i
  have h := congrFun (intCast_geckWeight_inr t ht k) i
  rw [root_rationalRootSystem] at h
  exact_mod_cast h

/-- **The weights of the pinned Geck representation generate exactly the root lattice.** Its
Cartan coordinates have weight zero, while its remaining coordinates carry every root once. -/
theorem span_range_geckWeight_eq_span_range_root :
    Submodule.span ℤ (Set.range (t.geckWeight ht)) =
      Submodule.span ℤ (Set.range (t.simplyConnectedRootDatum ht).root) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨x, rfl⟩
    cases x with
    | inl x =>
        rw [geckWeight_inl_eq_zero]
        exact Submodule.zero_mem _
    | inr k =>
        rw [geckWeight_inr_eq_root]
        exact Submodule.subset_span (Set.mem_range_self k)
  · apply Submodule.span_mono
    rintro _ ⟨k, rfl⟩
    exact ⟨Sum.inr k, geckWeight_inr_eq_root t ht k⟩

/-- If the roots of the pinned datum span its character lattice, then so do the weights of the
Geck representation. -/
theorem span_range_geckWeight_eq_top_of_span_range_root_eq_top
    (hroot : Submodule.span ℤ (Set.range (t.simplyConnectedRootDatum ht).root) = ⊤) :
    Submodule.span ℤ (Set.range (t.geckWeight ht)) = ⊤ := by
  rw [span_range_geckWeight_eq_span_range_root]
  exact hroot

/-- **The pinned Geck weights of type `E₈` generate the full character lattice.** This is the
unimodularity of the type `E₈` Cartan matrix read in the representation used by the explicit
Chevalley carrier. -/
theorem span_range_geckWeight_E8_eq_top (ht : E8.Valid) :
    Submodule.span ℤ (Set.range (E8.geckWeight ht)) = ⊤ := by
  apply span_range_geckWeight_eq_top_of_span_range_root_eq_top
  rw [simplyConnectedRootDatum_E8]
  exact span_root_e8SimplyConnectedRootDatum_eq_top

/-- **The pinned Geck weights of type `F₄` generate the full character lattice.** -/
theorem span_range_geckWeight_F4_eq_top (ht : F4.Valid) :
    Submodule.span ℤ (Set.range (F4.geckWeight ht)) = ⊤ := by
  apply span_range_geckWeight_eq_top_of_span_range_root_eq_top
  rw [simplyConnectedRootDatum_F4]
  exact span_root_f4SimplyConnectedRootDatum_eq_top

/-- **The pinned Geck weights of type `G₂` generate the full character lattice.** -/
theorem span_range_geckWeight_G2_eq_top (ht : G2.Valid) :
    Submodule.span ℤ (Set.range (G2.geckWeight ht)) = ⊤ := by
  apply span_range_geckWeight_eq_top_of_span_range_root_eq_top
  rw [simplyConnectedRootDatum_G2]
  exact span_root_g2SimplyConnectedRootDatum_eq_top

end

end TauCeti.DynkinType
