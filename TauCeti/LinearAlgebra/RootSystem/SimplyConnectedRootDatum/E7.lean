/-- The permutation table for reflection in each of the sixty-three positive `E₇` roots, acting on
the one hundred and twenty-six root indices. Reflection in the corresponding negative root is the
same permutation, so only the positive half is tabulated. The seven chunks above hold nine rows
each; the grouping has no mathematical content. -/
private def e7ReflectionTable (i : Fin 63) (j : Fin 126) : Fin 126 :=
  ![e7ReflectionChunk0, e7ReflectionChunk1, e7ReflectionChunk2, e7ReflectionChunk3,
    e7ReflectionChunk4, e7ReflectionChunk5, e7ReflectionChunk6]
    ⟨(i : ℕ) / 9, by omega⟩ ⟨(i : ℕ) % 9, by omega⟩ j

/-- Reflection in the root indexed by `i`, as an operation on root indices. Only the residue of `i`
modulo `63` is used, a positive root and its negative reflecting alike. -/
private def e7ReflectionIndex (i j : Fin 126) : Fin 126 :=
  e7ReflectionTable ⟨(i : ℕ) % 63, Nat.mod_lt _ (by omega)⟩ j

private lemma e7ReflectionIndex_coroot_pos (i : Fin 63) (j : Fin 126) :
    e7Coroot j - (e7Root (Fin.castAdd 63 i) ⬝ᵥ e7Coroot j) • e7Coroot (Fin.castAdd 63 i) =
      e7Coroot (e7ReflectionIndex (Fin.castAdd 63 i) j) := by
  decide +kernel +revert

private lemma e7ReflectionIndex_addNat (i : Fin 63) (j : Fin 126) :
    e7ReflectionIndex (Fin.addNat i 63) j = e7ReflectionIndex (Fin.castAdd 63 i) j :=
  congrArg (e7ReflectionTable · j)
    (Fin.ext (by simp only [Fin.val_addNat, Fin.val_castAdd, Nat.add_mod_right]))

private lemma e7ReflectionIndex_coroot (i j : Fin 126) :
    e7Coroot j - (e7Root i ⬝ᵥ e7Coroot j) • e7Coroot i = e7Coroot (e7ReflectionIndex i j) := by
  rcases lt_or_ge (i : ℕ) 63 with hi | hi
  · rw [show i = Fin.castAdd 63 ⟨i, hi⟩ from Fin.ext rfl]
    exact e7ReflectionIndex_coroot_pos _ j
  · rw [show i = Fin.addNat (⟨(i : ℕ) - 63, by omega⟩ : Fin 63) 63 from Fin.ext (by simp; omega),
      e7Coroot_addNat, e7Root_addNat, e7ReflectionIndex_addNat, neg_dotProduct, neg_smul,
      smul_neg, neg_neg]
    exact e7ReflectionIndex_coroot_pos _ j

/-- **The root coordinates are the Cartan-matrix image of the coroot coordinates.** Writing a
coroot as `β^∨ = ∑ i, cᵢ αᵢ^∨` in the simple coroots, the pairings of `β` against the simple
coroots are `⟨β, αⱼ^∨⟩ = ∑ i, cᵢ ⟨αᵢ, αⱼ^∨⟩`; the stored row-vector product of `e7Root_apply` is
also the matrix acting on the left because `CartanMatrix.E₇` is symmetric. -/
theorem e7Root_eq_mulVec (j : Fin 126) : e7Root j = CartanMatrix.E₇ *ᵥ e7Coroot j := by
  rw [e7Root_apply, ← mulVec_transpose, CartanMatrix.E₇_transpose]

/-- The pairing of the pinned tables is symmetric. This is the simply-laced feature of `E₇`: the
pairing is the symmetric bilinear form attached to `CartanMatrix.E₇`, read on the shared
simple-root coordinates of a root and its coroot. -/
theorem e7Root_dotProduct_e7Coroot_comm (i j : Fin 126) :
    e7Root i ⬝ᵥ e7Coroot j = e7Root j ⬝ᵥ e7Coroot i := by
  rw [e7Root_eq_mulVec, e7Root_eq_mulVec]
  calc
    (CartanMatrix.E₇ *ᵥ e7Coroot i) ⬝ᵥ e7Coroot j =
        e7Coroot j ⬝ᵥ CartanMatrix.E₇ *ᵥ e7Coroot i := dotProduct_comm _ _
    _ = e7Coroot i ⬝ᵥ CartanMatrix.E₇ᵀ *ᵥ e7Coroot j :=
      (dotProduct_transpose_mulVec CartanMatrix.E₇ (e7Coroot i) (e7Coroot j)).symm
    _ = e7Coroot i ⬝ᵥ CartanMatrix.E₇ *ᵥ e7Coroot j := by rw [CartanMatrix.E₇_transpose]
    _ = (CartanMatrix.E₇ *ᵥ e7Coroot j) ⬝ᵥ e7Coroot i := dotProduct_comm _ _

/-- The root reflections are the image of the coroot reflections under the Cartan-matrix map, so
they need no second table. -/
private lemma e7ReflectionIndex_root (i j : Fin 126) :
    e7Root j - (e7Root j ⬝ᵥ e7Coroot i) • e7Root i = e7Root (e7ReflectionIndex i j) := by
  have h : CartanMatrix.E₇ *ᵥ (e7Coroot j - (e7Root i ⬝ᵥ e7Coroot j) • e7Coroot i) =
      CartanMatrix.E₇ *ᵥ e7Coroot (e7ReflectionIndex i j) :=
    congrArg _ (e7ReflectionIndex_coroot i j)
  rw [mulVec_sub, mulVec_smul] at h
  simp only [← e7Root_eq_mulVec] at h
  rw [e7Root_dotProduct_e7Coroot_comm j i]
  exact h

private lemma e7ReflectionIndex_involutive (i : Fin 126) :
    Function.Involutive (e7ReflectionIndex i) := by
  intro j
  apply e7Root.injective
  rw [← e7ReflectionIndex_root i (e7ReflectionIndex i j), ← e7ReflectionIndex_root i j]
  have hpair : (e7Root j - (e7Root j ⬝ᵥ e7Coroot i) • e7Root i) ⬝ᵥ e7Coroot i =
      -(e7Root j ⬝ᵥ e7Coroot i) := by
    rw [sub_dotProduct, smul_dotProduct, e7Root_dotProduct_coroot]
    ring
  rw [hpair]
  simp

/-- Reflection in an `E₇` root as a permutation of the pinned root indices. -/
private def e7ReflectionPerm (i : Fin 126) : Fin 126 ≃ Fin 126 :=
  Function.Involutive.toPerm (e7ReflectionIndex i) (e7ReflectionIndex_involutive i)

/-! ## The pinned datum -/

/-- The pinned simply connected root datum of type `E₇`.

Both lattices are `Fin 7 → ℤ`: the character lattice in the fundamental-weight basis and the
cocharacter lattice in the simple-coroot basis. Root indices `0` through `6` are the Bourbaki
simple roots; see `TauCeti.DynkinType.root_e7SimpleIndex`. -/
def e7SimplyConnectedRootDatum : RootDatum (Fin 126) (Fin 7 → ℤ) (Fin 7 → ℤ) where
  toLinearMap := (dotProductEquiv ℤ (Fin 7)).toLinearMap
  root := e7Root
  coroot := e7Coroot
  root_coroot_two i := e7Root_dotProduct_coroot i
  reflectionPerm := e7ReflectionPerm
  reflectionPerm_root i j := e7ReflectionIndex_root i j
  reflectionPerm_coroot i j := e7ReflectionIndex_coroot i j

/-- The root embedding of the pinned `E₇` datum is the explicit table `e7Root`. -/
@[simp] lemma e7SimplyConnectedRootDatum_root : e7SimplyConnectedRootDatum.root = e7Root := (rfl)

/-- The coroot embedding of the pinned `E₇` datum is the explicit table `e7Coroot`. -/
@[simp] lemma e7SimplyConnectedRootDatum_coroot :
    e7SimplyConnectedRootDatum.coroot = e7Coroot := (rfl)

/-- The perfect pairing of the pinned `E₇` datum is the dot product of coordinate vectors, the
fundamental-weight and simple-coroot bases being dual to one another. -/
@[simp] lemma e7SimplyConnectedRootDatum_toLinearMap (x y : Fin 7 → ℤ) :
    e7SimplyConnectedRootDatum.toLinearMap x y = x ⬝ᵥ y := (rfl)

/-- Pairing a pinned `E₇` root with a coroot computes as their coordinate dot product. -/
@[simp] lemma e7SimplyConnectedRootDatum_pairing (i j : Fin 126) :
    e7SimplyConnectedRootDatum.pairing i j = e7Root i ⬝ᵥ e7Coroot j := (rfl)

/-- **The coroots of the pinned type `E₇` datum span the cocharacter lattice.** This is the simply
connected lattice condition required by the pinned Chevalley--Demazure construction. Its
counterpart for the roots is deliberately absent: they span the root lattice, which sits inside the
weight lattice with index two, the determinant of `CartanMatrix.E₇`, so the datum carries no
`RootPairing.IsRootSystem` instance. That asymmetry is what "simply connected" means here. -/
theorem corootSpan_e7SimplyConnectedRootDatum_eq_top :
    e7SimplyConnectedRootDatum.corootSpan ℤ = ⊤ :=
  corootSpan_eq_top_of_coroot_eq_single coroot_e7SimpleIndex

/-! ## The pinned base -/

/-- The support of the pinned base of type `E₇`: the first seven root indices. -/
private abbrev e7SimpleSupport : Finset (Fin 126) := simpleSupport e7SimpleIndex_injective

/-- Every `E₇` coroot has simple-coroot coordinates that are all nonnegative or all nonpositive,
the positive half of the table being nonnegative and the negative half its negation. -/
private lemma e7Coroot_nonneg_or_nonpos (j : Fin 126) :
    (∀ k, 0 ≤ e7Coroot j k) ∨ (∀ k, e7Coroot j k ≤ 0) := by
  rcases lt_or_ge (j : ℕ) 63 with hj | hj
  · refine Or.inl fun k => ?_
    rw [show j = Fin.castAdd 63 ⟨j, hj⟩ from Fin.ext rfl]
    exact e7Coroot_nonneg _ k
  · refine Or.inr fun k => ?_
    have h := e7Coroot_nonneg ⟨(j : ℕ) - 63, by omega⟩ k
    rw [show j = Fin.addNat (⟨(j : ℕ) - 63, by omega⟩ : Fin 63) 63 from Fin.ext (by simp; omega),
      e7Coroot_addNat, Pi.neg_apply, neg_nonpos]
    exact h

/-- In the cocharacter lattice a coroot is the combination of the simple coroots recorded by its
own coordinates, the simple coroots being the standard basis. -/
private lemma sum_smul_coroot_e7SimpleIndex (j : Fin 126) :
    ∑ k : Fin 7, e7Coroot j k • e7Coroot (e7SimpleIndex k) = e7Coroot j := by
  funext m
  simp only [coroot_e7SimpleIndex, Finset.sum_apply, Pi.smul_apply, Pi.single_apply,
    smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]

/-- In the character lattice a root is the combination of the simple roots recorded by the same
coordinates, the two tables differing by the Cartan-matrix map. -/
private lemma sum_smul_root_e7SimpleIndex (j : Fin 126) :
    ∑ k : Fin 7, e7Coroot j k • e7Root (e7SimpleIndex k) = e7Root j := by
  have h := congrArg CartanMatrix.E₇.mulVecLin (sum_smul_coroot_e7SimpleIndex j)
  rw [map_sum] at h
  simpa only [map_zsmul, mulVecLin_apply, ← e7Root_eq_mulVec] using h

private lemma linearIndependent_root_e7SimpleIndex :
    LinearIndependent ℤ fun i : Fin 7 => e7Root (e7SimpleIndex i) := by
  have h : (fun i : Fin 7 => e7Root (e7SimpleIndex i)) = fun i => CartanMatrix.E₇ i :=
    funext root_e7SimpleIndex
  rw [h]
  exact linearIndependent_rows_of_det_ne_zero (by rw [CartanMatrix.E₇_det]; norm_num)

private lemma linearIndependent_coroot_e7SimpleIndex :
    LinearIndependent ℤ fun i : Fin 7 => e7Coroot (e7SimpleIndex i) := by
  simpa only [coroot_e7SimpleIndex] using Pi.linearIndependent_single_one (Fin 7) ℤ

/-- The Bourbaki-numbered base of the pinned simply connected root datum of type `E₇`. Its support
is the set of the first seven root indices, carrying the simple roots in Bourbaki order. -/
def e7SimplyConnectedBase : e7SimplyConnectedRootDatum.Base where
  support := e7SimpleSupport
  linearIndepOn_root :=
    linearIndepOn_simpleSupport _ _ linearIndependent_root_e7SimpleIndex
  linearIndepOn_coroot :=
    linearIndepOn_simpleSupport _ _ linearIndependent_coroot_e7SimpleIndex
  root_mem_or_neg_mem k := by
    simp only [e7SimplyConnectedRootDatum_root]
    rw [image_simpleSupport, ← sum_smul_root_e7SimpleIndex k]
    exact sum_smul_mem_or_neg_mem_closure _ _ (e7Coroot_nonneg_or_nonpos k)
  coroot_mem_or_neg_mem k := by
    simp only [e7SimplyConnectedRootDatum_coroot]
    rw [image_simpleSupport, ← sum_smul_coroot_e7SimpleIndex k]
    exact sum_smul_mem_or_neg_mem_closure _ _ (e7Coroot_nonneg_or_nonpos k)

/-- Membership in the pinned base support is exactly membership among the first seven root
indices. -/
@[simp] theorem mem_e7SimplyConnectedBase_support {k : Fin 126} :
    k ∈ e7SimplyConnectedBase.support ↔ (k : ℕ) < 7 := by
  rw [show e7SimplyConnectedBase.support = simpleSupport e7SimpleIndex_injective from rfl,
    mem_simpleSupport]
  constructor
  · rintro ⟨i, rfl⟩
    exact i.isLt
  · exact fun hk => ⟨⟨k, hk⟩, Fin.ext rfl⟩

/-- **The Cartan integers at the first seven root indices are Mathlib's Bourbaki-numbered `E₇`
matrix.** This pins the node order independently of the existential relabelling in
`TauCeti.HasCartanType`. -/
theorem pairing_e7SimpleIndex (i j : Fin 7) :
    e7SimplyConnectedRootDatum.pairing (e7SimpleIndex i) (e7SimpleIndex j) =
      CartanMatrix.E₇ i j := by
  rw [e7SimplyConnectedRootDatum_pairing, root_e7SimpleIndex, coroot_e7SimpleIndex,
    dotProduct_single, mul_one]

/-- **The pinned datum of type `E₇` has Cartan type `E7`.** Its Bourbaki-numbered base realizes the
standard Cartan matrix `CartanMatrix.E₇`, with the node numbering of `TauCeti.DynkinType`. -/
theorem hasCartanType_e7SimplyConnectedRootDatum :
    HasCartanType e7SimplyConnectedRootDatum e7SimplyConnectedBase E7 :=
  hasCartanType_of_pairing_eq e7SimpleIndex_injective rfl fun i j =>
    (pairing_e7SimpleIndex i j).trans (by simp)

end DynkinType
end TauCeti
