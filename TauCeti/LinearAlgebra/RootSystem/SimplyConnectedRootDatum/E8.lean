/-- The permutation table for reflection in each of the one hundred and twenty positive `E₈` roots,
acting on the indices of the one hundred and twenty positive roots. Reflection in the corresponding
negative root is the same permutation, and reflection in a negative root index is the negative of
the tabulated value, so this is the whole table. -/
private def e8ReflectionTable (i j : Fin 120) : Fin 240 :=
  ![e8ReflectionChunk0, e8ReflectionChunk1, e8ReflectionChunk2, e8ReflectionChunk3,
    e8ReflectionChunk4, e8ReflectionChunk5, e8ReflectionChunk6, e8ReflectionChunk7,
    e8ReflectionChunk8, e8ReflectionChunk9, e8ReflectionChunk10, e8ReflectionChunk11]
    ⟨(i : ℕ) / 10, by omega⟩ ⟨(i : ℕ) % 10, by omega⟩ j

/-- The row of the reflection table sitting at position `i` of the block `c`, the blocks being the
twelve chunks in which the table is stored. -/
private def e8BlockIndex (c : Fin 12) (i : Fin 10) : Fin 120 := ⟨10 * c + i, by omega⟩

/-- The index among the positive roots of the root index `k`, which is `k` itself on the positive
half and the index of its negative on the negative half. -/
private def e8Residue (k : Fin 240) : Fin 120 := ⟨(k : ℕ) % 120, Nat.mod_lt _ (by omega)⟩

/-- The index of the negative of the root indexed by `k`: the two halves of the enumeration are
exchanged by adding one hundred and twenty modulo two hundred and forty. -/
private def e8NegIndex (k : Fin 240) : Fin 240 := ⟨((k : ℕ) + 120) % 240, Nat.mod_lt _ (by omega)⟩

/-- Reflection in the root indexed by `i`, as an operation on root indices. Only the residue of `i`
modulo `120` is used, a positive root and its negative reflecting alike, and the negative half of
`j` is sent to the negative of the image of its positive counterpart. -/
private def e8ReflectionIndex (i j : Fin 240) : Fin 240 :=
  if (j : ℕ) < 120 then e8ReflectionTable (e8Residue i) (e8Residue j)
  else e8NegIndex (e8ReflectionTable (e8Residue i) (e8Residue j))

@[simp] private lemma e8Residue_castAdd (i : Fin 120) : e8Residue (Fin.castAdd 120 i) = i := by
  apply Fin.ext
  simp only [e8Residue, Fin.val_castAdd, Fin.val_mk, Nat.mod_eq_of_lt i.isLt]

@[simp] private lemma e8Residue_addNat (i : Fin 120) : e8Residue (Fin.addNat i 120) = i := by
  apply Fin.ext
  simp only [e8Residue, Fin.val_addNat, Fin.val_mk, Nat.add_mod_right,
    Nat.mod_eq_of_lt i.isLt]

private lemma e8NegIndex_castAdd (i : Fin 120) :
    e8NegIndex (Fin.castAdd 120 i) = Fin.addNat i 120 := by
  apply Fin.ext
  simp only [e8NegIndex, Fin.val_castAdd, Fin.val_addNat, Fin.val_mk]
  omega

private lemma e8NegIndex_addNat (i : Fin 120) :
    e8NegIndex (Fin.addNat i 120) = Fin.castAdd 120 i := by
  apply Fin.ext
  simp only [e8NegIndex, Fin.val_castAdd, Fin.val_addNat, Fin.val_mk]
  omega

/-- The index involution `e8NegIndex` negates the stored coordinates. -/
private lemma e8Coroot_negIndex (k : Fin 240) : e8Coroot (e8NegIndex k) = -e8Coroot k := by
  induction k using Fin.addCases (m := 120) (n := 120) with
  | left k => rw [e8NegIndex_castAdd, e8Coroot_addNat, e8Coroot_castAdd]
  | right k =>
    rw [Fin.natAdd_eq_addNat, e8NegIndex_addNat, e8Coroot_addNat, e8Coroot_castAdd, neg_neg]

private lemma e8ReflectionIndex_castAdd (i : Fin 240) (j : Fin 120) :
    e8ReflectionIndex i (Fin.castAdd 120 j) = e8ReflectionTable (e8Residue i) j := by
  have h : ((Fin.castAdd 120 j : Fin 240) : ℕ) < 120 := j.isLt
  rw [e8ReflectionIndex, ite_eq_left h, e8Residue_castAdd]

private lemma e8ReflectionIndex_addNat (i : Fin 240) (j : Fin 120) :
    e8ReflectionIndex i (Fin.addNat j 120) = e8NegIndex (e8ReflectionTable (e8Residue i) j) := by
  have h : ¬((Fin.addNat j 120 : Fin 240) : ℕ) < 120 := by
    rw [Fin.val_addNat]
    omega
  rw [e8ReflectionIndex, ite_eq_right h, e8Residue_addNat]

/-- The reflection identity the table is checked against: reflecting the `j`-th positive coroot in
the `i`-th positive root lands on the coroot at the tabulated index. Reflection is written on the
positive table directly, `CartanMatrix.E₈` turning a coroot into the matching root, so that the
check unfolds the two-block concatenation `e8Coroot` only on the tabulated side. -/
private abbrev ReflectsPositive (i j : Fin 120) : Prop :=
  e8PositiveCoroot j -
      ((e8PositiveCoroot i ᵥ* CartanMatrix.E₈) ⬝ᵥ e8PositiveCoroot j) • e8PositiveCoroot i =
    e8Coroot (e8ReflectionTable i j)

private lemma reflectsPositive_block0 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 0 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block1 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 1 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block2 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 2 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block3 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 3 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block4 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 4 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block5 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 5 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block6 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 6 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block7 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 7 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block8 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 8 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block9 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 9 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block10 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 10 i) j := by
  decide +kernel +revert

private lemma reflectsPositive_block11 (i : Fin 10) (j : Fin 120) :
    ReflectsPositive (e8BlockIndex 11 i) j := by
  decide +kernel +revert

/-- **Every tabulated entry is the reflection its coordinates compute.** The kernel checks all
`120 × 120` identities against the stored coordinate vectors, one block of ten rows at a time. -/
private lemma e8ReflectionTable_coroot (i j : Fin 120) :
    e8Coroot (Fin.castAdd 120 j) -
        (e8Root (Fin.castAdd 120 i) ⬝ᵥ e8Coroot (Fin.castAdd 120 j)) •
          e8Coroot (Fin.castAdd 120 i) = e8Coroot (e8ReflectionTable i j) := by
  obtain ⟨c, r, rfl⟩ : ∃ (c : Fin 12) (r : Fin 10), i = e8BlockIndex c r :=
    ⟨⟨(i : ℕ) / 10, by omega⟩, ⟨(i : ℕ) % 10, by omega⟩,
      Fin.ext (by simp only [e8BlockIndex]; omega)⟩
  simp only [e8Root_apply, e8Coroot_castAdd]
  fin_cases c
  exacts [reflectsPositive_block0 r j,
    reflectsPositive_block1 r j,
    reflectsPositive_block2 r j,
    reflectsPositive_block3 r j,
    reflectsPositive_block4 r j,
    reflectsPositive_block5 r j,
    reflectsPositive_block6 r j,
    reflectsPositive_block7 r j,
    reflectsPositive_block8 r j,
    reflectsPositive_block9 r j,
    reflectsPositive_block10 r j,
    reflectsPositive_block11 r j]

private lemma e8ReflectionIndex_coroot_castAdd (i : Fin 240) (j : Fin 120) :
    e8Coroot (Fin.castAdd 120 j) - (e8Root i ⬝ᵥ e8Coroot (Fin.castAdd 120 j)) • e8Coroot i =
      e8Coroot (e8ReflectionIndex i (Fin.castAdd 120 j)) := by
  rw [e8ReflectionIndex_castAdd]
  induction i using Fin.addCases (m := 120) (n := 120) with
  | left i =>
    rw [e8Residue_castAdd]
    exact e8ReflectionTable_coroot _ j
  | right i =>
    rw [Fin.natAdd_eq_addNat, e8Residue_addNat, e8Coroot_addNat, e8Root_addNat,
      ← e8Coroot_castAdd, neg_dotProduct, neg_smul, smul_neg, neg_neg]
    exact e8ReflectionTable_coroot _ j

private lemma e8ReflectionIndex_coroot (i j : Fin 240) :
    e8Coroot j - (e8Root i ⬝ᵥ e8Coroot j) • e8Coroot i = e8Coroot (e8ReflectionIndex i j) := by
  induction j using Fin.addCases (m := 120) (n := 120) with
  | left j => exact e8ReflectionIndex_coroot_castAdd i j
  | right j =>
    have h := e8ReflectionIndex_coroot_castAdd i j
    rw [e8ReflectionIndex_castAdd] at h
    rw [Fin.natAdd_eq_addNat, e8ReflectionIndex_addNat, e8Coroot_negIndex, ← h,
      e8Coroot_addNat, ← e8Coroot_castAdd, dotProduct_neg, neg_smul]
    abel

/-- The root reflections are the image of the coroot reflections under the Cartan-matrix map, so
they need no second table. -/
private lemma e8ReflectionIndex_root (i j : Fin 240) :
    e8Root j - (e8Root j ⬝ᵥ e8Coroot i) • e8Root i = e8Root (e8ReflectionIndex i j) := by
  have h : CartanMatrix.E₈ *ᵥ (e8Coroot j - (e8Root i ⬝ᵥ e8Coroot j) • e8Coroot i) =
      CartanMatrix.E₈ *ᵥ e8Coroot (e8ReflectionIndex i j) :=
    congrArg _ (e8ReflectionIndex_coroot i j)
  rw [mulVec_sub, mulVec_smul] at h
  simp only [← e8Root_eq_mulVec] at h
  rw [e8Root_dotProduct_e8Coroot_comm j i]
  exact h

private lemma e8ReflectionIndex_involutive (i : Fin 240) :
    Function.Involutive (e8ReflectionIndex i) := by
  intro j
  apply e8Root.injective
  rw [← e8ReflectionIndex_root i (e8ReflectionIndex i j), ← e8ReflectionIndex_root i j]
  have hpair : (e8Root j - (e8Root j ⬝ᵥ e8Coroot i) • e8Root i) ⬝ᵥ e8Coroot i =
      -(e8Root j ⬝ᵥ e8Coroot i) := by
    rw [sub_dotProduct, smul_dotProduct, e8Root_dotProduct_coroot]
    ring
  rw [hpair]
  simp

/-- Reflection in the `E₈` root indexed by `i`, as a permutation of the two hundred and forty root
indices. It is the reflection permutation of the pinned datum of
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.E8.Datum`. -/
def e8ReflectionPerm (i : Fin 240) : Fin 240 ≃ Fin 240 :=
  Function.Involutive.toPerm (e8ReflectionIndex i) (e8ReflectionIndex_involutive i)

/-- **The tabulated permutation reflects the coroots.** Together with
`TauCeti.DynkinType.e8ReflectionPerm_root` this is what makes the two tables a root datum. -/
theorem e8ReflectionPerm_coroot (i j : Fin 240) :
    e8Coroot j - (e8Root i ⬝ᵥ e8Coroot j) • e8Coroot i = e8Coroot (e8ReflectionPerm i j) :=
  e8ReflectionIndex_coroot i j

/-- **The tabulated permutation reflects the roots.** -/
theorem e8ReflectionPerm_root (i j : Fin 240) :
    e8Root j - (e8Root j ⬝ᵥ e8Coroot i) • e8Root i = e8Root (e8ReflectionPerm i j) :=
  e8ReflectionIndex_root i j

end DynkinType

end TauCeti
