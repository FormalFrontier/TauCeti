module

public import TauCeti.LinearAlgebra.RootSystem.Inversions.DominantChamber

/-!
# The closed dominant chamber is a strict fundamental domain

The Weyl translates of the closed dominant chamber of a base cover the whole weight space
(`TauCeti.exists_mem_dominantChamber`). This file proves that they overlap only where they must:
two dominant weights in the same Weyl orbit are equal, and the stabilizer of a dominant weight is
generated by the simple reflections in the walls through it. Together with the covering statement
this is the closed dominant chamber being a *strict* fundamental domain for the Weyl group.

For a weight interior to the chamber no wall passes through it, so the stabilizer is trivial and
the moving element is the identity; that case is
`TauCeti.eq_one_of_smul_mem_dominantChamber`. The theorems here need no interiority.

The argument is an induction on the number of inversions, run along
`TauCeti.exists_mem_support_mem_inversions_of_ne_one`: a Weyl-group element other than the identity
inverts a *simple* root. If `w` carries the dominant weight `x` to a dominant weight and inverts
the simple root `αᵢ`, then `⟨αᵢ^∨, x⟩` is at once nonnegative (`x` is dominant) and nonpositive (it
equals `⟨w αᵢ^∨, w • x⟩`, the value of a negative coroot on a dominant weight), so it vanishes: `x`
lies on the wall `αᵢ` and `sᵢ` fixes it. Replacing `w` by `w sᵢ` moves `x` to the same place and
has one inversion fewer, which is the inductive step.

## Main definitions

* `TauCeti.wallReflections`: the simple reflections of a base that fix a given weight, namely those
  whose simple coroot vanishes on it.

## Main results

* `TauCeti.mem_closure_wallReflections_of_smul_mem_dominantChamber` and
  `TauCeti.stabilizer_eq_closure_wallReflections`: **the stabilizer of a dominant weight is
  generated by the simple reflections in the walls through it.**
* `TauCeti.smul_eq_self_of_mem_dominantChamber` and
  `TauCeti.eq_of_mem_orbit_of_mem_dominantChamber`: **a dominant weight is the only dominant weight
  in its Weyl orbit.**
* `TauCeti.existsUnique_mem_orbit_inter_dominantChamber`: every weight has exactly one dominant
  weight in its Weyl orbit, so the closed dominant chamber is a strict fundamental domain.

## Implementation notes

The generation statement is the primitive one here: uniqueness of the dominant representative is
read off it, since the generators fix the weight. Stating it needs the walls through a weight as a
set of Weyl-group elements, which is `TauCeti.wallReflections`. That set is cut out by the
vanishing of a simple coroot rather than by the fixed-point condition `sᵢ • x = x`: the vanishing
is what the induction produces, and it is the stronger of the two, since `sᵢ • x = x` says only
that `⟨αᵢ^∨, x⟩ • αᵢ` vanishes.

Only the existence half `TauCeti.exists_mem_dominantChamber` needs a finite Weyl group, so it alone
carries `[P.IsRootSystem]`; the uniqueness statements hold for a crystallographic reduced pairing
with finitely many roots and no further hypothesis.

## References

This file completes the fundamental-domain item of Layer 4 in
`TauCetiRoadmap/RepresentationTheory/RootSystems/README.md`, whose uniqueness half was previously
proved only for weights interior to the chamber. The argument is the one in J. E. Humphreys,
*Introduction to Lie Algebras and Representation Theory*, GTM 9, Ch. III, §10.3, Theorem (b).
-/

public section

namespace TauCeti

universe u v w x

variable {ι : Type u} {R : Type v} {M : Type w} {N : Type x}
  [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : _root_.RootPairing ι R M N) (b : P.Base)

/-! ### The walls through a weight -/

/-- The simple reflections of the base `b` that fix the weight `x`: those whose simple coroot
vanishes on `x`, that is, the reflections in the walls of the dominant chamber through `x`. -/
def wallReflections (x : M) : Set P.weylGroup :=
  {w | ∃ i ∈ b.support, P.coroot' i x = 0 ∧ w = _root_.RootPairing.weylGroup.ofIdx P i}

variable {P b}

/-- A simple reflection whose simple coroot kills a weight fixes that weight. -/
lemma ofIdx_smul_eq_self_of_coroot'_eq_zero {i : ι} {x : M} (h : P.coroot' i x = 0) :
    _root_.RootPairing.weylGroup.ofIdx P i • x = x := by
  rw [_root_.RootPairing.weylGroup.ofIdx_smul, _root_.RootPairing.Equiv.reflection_smul,
    P.reflection_apply, h, zero_smul, sub_zero]

/-- The reflection in a wall through `x` belongs to `wallReflections`. -/
lemma ofIdx_mem_wallReflections {i : ι} {x : M} (hi : i ∈ b.support)
    (h : P.coroot' i x = 0) : _root_.RootPairing.weylGroup.ofIdx P i ∈ wallReflections P b x :=
  ⟨i, hi, h, rfl⟩

/-- Every reflection in a wall through `x` fixes `x`. -/
lemma smul_eq_self_of_mem_wallReflections {x : M} {w : P.weylGroup}
    (hw : w ∈ wallReflections P b x) : w • x = x := by
  obtain ⟨i, -, h, rfl⟩ := hw
  exact ofIdx_smul_eq_self_of_coroot'_eq_zero h

/-- The walls through `x` fix `x`, so they lie in its stabilizer. -/
lemma wallReflections_subset_stabilizer (x : M) :
    wallReflections P b x ⊆ MulAction.stabilizer P.weylGroup x :=
  fun _ hw ↦ smul_eq_self_of_mem_wallReflections hw

variable (P b) [LinearOrder R]

/-- No wall of the dominant chamber passes through a weight interior to it. -/
theorem wallReflections_eq_empty_of_mem_openDominantChamber {x : M}
    (hx : x ∈ openDominantChamber P b) : wallReflections P b x = ∅ :=
  Set.eq_empty_iff_forall_notMem.mpr fun _ ⟨i, hi, hzero, _⟩ ↦
    ((mem_openDominantChamber P b x).mp hx i hi).ne' hzero

/-! ### The stabilizer of a dominant weight -/

variable [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic] [P.IsReduced] [P.flip.IsReduced]

/-- The inductive step, isolated: a Weyl-group element carrying a dominant weight to a dominant
weight and inverting the simple root `αᵢ` is killed by `αᵢ`, so the wall `αᵢ` passes through the
weight. -/
private theorem coroot'_eq_zero_of_mem_inversions {w : P.weylGroup} {x : M}
    (hx : x ∈ dominantChamber P b) (hw : w • x ∈ dominantChamber P b) {i : ι}
    (hiw : i ∈ inversions P b w) (hi : i ∈ b.support) : P.coroot' i x = 0 := by
  have hneg : P.weylGroupToPerm w i ∈ negRoots P b :=
    (mem_negRoots P b _).mpr ((mem_inversions P b w i).mp hiw).2
  have hle := coroot'_nonpos_of_mem_negRoots P b hw hneg
  rw [RootPairing.coroot'_weylGroupToPerm_smul] at hle
  exact le_antisymm hle ((mem_dominantChamber P b x).mp hx i hi)

/-- The induction behind `TauCeti.mem_closure_wallReflections_of_smul_mem_dominantChamber`, run on
a bound for the number of inversions. -/
private theorem mem_closure_wallReflections_aux (n : ℕ) (w : P.weylGroup)
    (hn : (inversions P b w).ncard ≤ n) {x : M} (hx : x ∈ dominantChamber P b)
    (hw : w • x ∈ dominantChamber P b) : w ∈ Subgroup.closure (wallReflections P b x) := by
  induction n generalizing w with
  | zero =>
    have : inversions P b w = ∅ :=
      (Set.ncard_eq_zero (Set.toFinite _)).mp (Nat.le_zero.mp hn)
    rw [eq_one_of_inversions_eq_empty this]
    exact one_mem _
  | succ n ih =>
    rcases eq_or_ne w 1 with rfl | hne
    · exact one_mem _
    obtain ⟨i, hi, hiw⟩ := exists_mem_support_mem_inversions_of_ne_one P b hne
    have hzero := coroot'_eq_zero_of_mem_inversions P b hx hw hiw hi
    have hsx : _root_.RootPairing.weylGroup.ofIdx P i • x = x :=
      ofIdx_smul_eq_self_of_coroot'_eq_zero hzero
    -- Right multiplication by the wall reflection removes exactly the inversion `i`.
    have hcount := ncard_inversions_mul_ofIdx_of_mem P w b hi hiw
    have hmul : (w * _root_.RootPairing.weylGroup.ofIdx P i) • x = w • x := by
      rw [mul_smul, hsx]
    have hrec := ih (w * _root_.RootPairing.weylGroup.ofIdx P i) (by omega)
      (by rw [hmul]; exact hw)
    have hw' : w = (w * _root_.RootPairing.weylGroup.ofIdx P i) *
        _root_.RootPairing.weylGroup.ofIdx P i := by
      rw [mul_assoc, RootPairing.weylGroup.ofIdx_mul_self, mul_one]
    rw [hw']
    exact mul_mem hrec (Subgroup.subset_closure (ofIdx_mem_wallReflections hi hzero))

/-- **A Weyl-group element carrying a dominant weight to a dominant weight is a product of
reflections in the walls through that weight.** -/
theorem mem_closure_wallReflections_of_smul_mem_dominantChamber (w : P.weylGroup) {x : M}
    (hx : x ∈ dominantChamber P b) (hw : w • x ∈ dominantChamber P b) :
    w ∈ Subgroup.closure (wallReflections P b x) :=
  mem_closure_wallReflections_aux P b (inversions P b w).ncard w le_rfl hx hw

/-- **The stabilizer of a dominant weight is generated by the reflections in the walls through
it.** -/
theorem stabilizer_eq_closure_wallReflections {x : M} (hx : x ∈ dominantChamber P b) :
    MulAction.stabilizer P.weylGroup x = Subgroup.closure (wallReflections P b x) := by
  refine le_antisymm (fun w hw ↦ ?_)
    ((Subgroup.closure_le _).mpr (wallReflections_subset_stabilizer x))
  refine mem_closure_wallReflections_of_smul_mem_dominantChamber P b w hx ?_
  rw [MulAction.mem_stabilizer_iff.mp hw]
  exact hx

/-! ### Uniqueness of the dominant representative -/

/-- **A Weyl-group element carrying a dominant weight to a dominant weight fixes it.** No
interiority is needed: the element is a product of reflections in walls through the weight, and
each of those fixes it. -/
theorem smul_eq_self_of_mem_dominantChamber (w : P.weylGroup) {x : M}
    (hx : x ∈ dominantChamber P b) (hw : w • x ∈ dominantChamber P b) : w • x = x := by
  have hmem := mem_closure_wallReflections_of_smul_mem_dominantChamber P b w hx hw
  rw [← stabilizer_eq_closure_wallReflections P b hx] at hmem
  exact MulAction.mem_stabilizer_iff.mp hmem

/-- **A dominant weight is the only dominant weight in its Weyl orbit.** -/
theorem eq_of_mem_orbit_of_mem_dominantChamber {x y : M}
    (hxy : y ∈ MulAction.orbit P.weylGroup x) (hx : x ∈ dominantChamber P b)
    (hy : y ∈ dominantChamber P b) : y = x := by
  obtain ⟨w, rfl⟩ := hxy
  exact smul_eq_self_of_mem_dominantChamber P b w hx hy

/-- **A Weyl orbit meets the closed dominant chamber at most once.** -/
theorem subsingleton_orbit_inter_dominantChamber (x : M) :
    (MulAction.orbit P.weylGroup x ∩ dominantChamber P b).Subsingleton := by
  rintro y ⟨⟨v, rfl⟩, hyd⟩ z ⟨⟨u, rfl⟩, hzd⟩
  have h : (u * v⁻¹) • (v • x) = u • x := by rw [mul_smul, inv_smul_smul]
  have hfix := smul_eq_self_of_mem_dominantChamber P b (u * v⁻¹) hyd (by rw [h]; exact hzd)
  rw [h] at hfix
  exact hfix.symm

/-- **The closed dominant chamber is a strict fundamental domain for the Weyl group**: every weight
has exactly one dominant weight in its Weyl orbit. -/
theorem existsUnique_mem_orbit_inter_dominantChamber [P.IsRootSystem] (x : M) :
    ∃! y, y ∈ MulAction.orbit P.weylGroup x ∩ dominantChamber P b := by
  obtain ⟨w, hw⟩ := exists_mem_dominantChamber P b x
  exact ⟨w • x, ⟨MulAction.mem_orbit x w, hw⟩, fun _ hy ↦
    subsingleton_orbit_inter_dominantChamber P b x hy ⟨MulAction.mem_orbit x w, hw⟩⟩

end TauCeti
