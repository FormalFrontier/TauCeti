public import TauCeti.LinearAlgebra.IntegralLattice.Discriminant.Cardinality
public import TauCeti.LinearAlgebra.IntegralLattice.Discriminant.Quadratic

/-!
# The checkerboard lattice and the type `Dₙ` discriminant form

This file constructs the *checkerboard lattice* `{x ∈ ℤⁿ | ∑ xᵢ is even}` inside `ℚⁿ`, computes
its dual lattice, and identifies its discriminant form.  For `n ≥ 4` this is the positive root
lattice of type `Dₙ` in the Conway--Sloane coordinate model, and the discriminant form computed
here is the `Dₙ` row of the ADE table.  The same coordinate formula defines the underlying lattice
at every rank.  The dual description, named representatives, and order-four discriminant results
below assume `n > 0`; they include the low ranks `1 ≤ n ≤ 3`, at which the Dynkin type `Dₙ` is not
defined and where the lattice may have no roots at all, as for `n = 1`.  None of those results needs
`4 ≤ n`, so the declarations are named after the coordinate model rather than after the Dynkin type.

The lattice carries the standard dot product.  It is even, because a sum of squares of integers is
congruent modulo two to the sum of those integers.  Its dual lattice is `ℤⁿ ∪ (s + ℤⁿ)`, described
here by the two conditions that all coordinate differences are integers and that the doubled last
coordinate is an integer.

The discriminant group is generated by the three Conway--Sloane representatives

* the vector class `v = eₙ`, of half-norm `1 / 2`;
* the spinor class `s = (e₁ + ⋯ + eₙ) / 2`, of half-norm `n / 8`;
* the cospinor class `c = s - eₙ`, again of half-norm `n / 8`.

These three classes together with the zero class exhaust the discriminant group, which therefore
has order four; the form is positive definite, so the Gram determinant in any integral basis is
`4`.  The group is cyclic of order four when `n` is odd, generated by the spinor class with
`2s = v`, and is `(ℤ/2)²` when `n` is even.  The two spinor classes then carry the same quadratic
value, and their mutual pairing is `b(s, c) = (n - 2) / 4`.

The representatives are the ones fixed by Conway and Sloane, so that later glue calculations —
in particular the enlargement of `D₈` to `E₈` — can reuse them without a change of
representative.

## Main definitions

* `TauCeti.IntegralLattice.checkerboardCarrier`: the integer vectors of `ℚⁿ` with even
  coordinate sum.
* `TauCeti.IntegralLattice.checkerboardLattice`: the checkerboard lattice itself, the type `Dₙ`
  root lattice for `n ≥ 4`.
* `TauCeti.IntegralLattice.checkerboardVector`, `checkerboardSpinor`, `checkerboardCospinor`:
  the Conway--Sloane representatives `v`, `s`, `c` of the nonzero discriminant classes.
* `TauCeti.IntegralLattice.checkerboardVectorClass`, `checkerboardSpinorClass`,
  `checkerboardCospinorClass`: their classes in the discriminant group.
* `TauCeti.IntegralLattice.zmodFourAddEquivCheckerboardDiscriminantGroup`: the discriminant
  group of an odd-rank checkerboard lattice is `ℤ/4`.
* `TauCeti.IntegralLattice.zmodTwoProdAddEquivCheckerboardDiscriminantGroup`: the discriminant
  group of an even-rank checkerboard lattice is `(ℤ/2)²`.

## Main results

* `TauCeti.IntegralLattice.isEven_checkerboardLattice`: the checkerboard lattice is even.
* `TauCeti.IntegralLattice.mem_checkerboardLattice_dualCarrier_iff`: the dual lattice.
* `checkerboardDiscriminantGroup_eq_zero_or_vectorClass_or_spinorClass_or_cospinorClass`:
  the four classes exhaust the discriminant group.
* `TauCeti.IntegralLattice.natCard_discriminantGroup_checkerboardLattice` and
  `discriminant_checkerboardLattice`: the discriminant group has order four.
* `TauCeti.IntegralLattice.discriminantQuadraticMap_checkerboardVectorClass`,
  `discriminantQuadraticMap_checkerboardSpinorClass`,
  `discriminantQuadraticMap_checkerboardCospinorClass`: the quadratic values `1 / 2`, `n / 8`,
  `n / 8`.
* `TauCeti.IntegralLattice.discriminantPairing_checkerboardSpinorClass_checkerboardCospinorClass`:
  the mutual pairing `(n - 2) / 4` of the spinor and cospinor classes.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, §4.7.1.
* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*, §1.
* W. Ebeling, *Lattices and Codes*, Chapter 1.
* `TauCetiRoadmap/IntegralLattices/README.md`, Layer 5, the `Dₙ` rows of the ADE table.
-/

public section

namespace TauCeti

namespace IntegralLattice

open Module

variable (n : ℕ)

/-- The carrier of the checkerboard lattice. -/
def checkerboardCarrier : Submodule ℤ (Fin n → ℚ) where
  carrier := {x | (∀ i, ∃ z : ℤ, x i = (z : ℚ)) ∧ ∃ m : ℤ, ∑ i, x i = 2 * (m : ℚ)}
  add_mem' := by
    rintro a b ⟨ha, ma, hma⟩ ⟨hb, mb, hmb⟩
    refine ⟨fun i ↦ ?_, ma + mb, ?_⟩
    · obtain ⟨za, hza⟩ := ha i
      obtain ⟨zb, hzb⟩ := hb i
      exact ⟨za + zb, by simp [hza, hzb]⟩
    · simp only [Pi.add_apply]
      rw [Finset.sum_add_distrib, hma, hmb]
      push_cast
      ring
  zero_mem' := ⟨fun i ↦ ⟨0, by simp⟩, 0, by simp⟩
  smul_mem' := by
    rintro c a ⟨ha, ma, hma⟩
    refine ⟨fun i ↦ ?_, c * ma, ?_⟩
    · obtain ⟨za, hza⟩ := ha i
      exact ⟨c * za, by simp [hza]⟩
    · simp only [Pi.smul_apply, zsmul_eq_mul]
      rw [← Finset.mul_sum, hma]
      push_cast
      ring

variable {n}

/-- Membership in the checkerboard carrier: every coordinate is an integer and their sum is even. -/
@[simp]
theorem mem_checkerboardCarrier_iff (x : Fin n → ℚ) :
    x ∈ checkerboardCarrier n ↔ (∀ i, ∃ z : ℤ, x i = (z : ℚ)) ∧ ∃ m : ℤ, ∑ i, x i = 2 * (m : ℚ) :=
  Iff.rfl

variable (n)

/-- The doubled standard vector `2 eᵢ` lies in the checkerboard carrier. -/
private theorem single_two_mem_checkerboardCarrier (i : Fin n) :
    Pi.single i (2 : ℚ) ∈ checkerboardCarrier n := by
  refine ⟨fun j ↦ ?_, 1, ?_⟩
  · rcases eq_or_ne i j with rfl | h
    · exact ⟨2, by simp⟩
    · exact ⟨0, by simp [Ne.symm h]⟩
  · simp

/-- A difference of two standard vectors lies in the checkerboard carrier. -/
private theorem single_sub_single_mem_checkerboardCarrier (i j : Fin n) :
    Pi.single i (1 : ℚ) - Pi.single j (1 : ℚ) ∈ checkerboardCarrier n := by
  refine ⟨fun k ↦ ?_, 0, ?_⟩
  · refine ⟨(if k = i then 1 else 0) - (if k = j then 1 else 0), ?_⟩
    simp only [Pi.sub_apply, Pi.single_apply]
    split_ifs <;> norm_num
  · simp

/-- The checkerboard carrier is contained in the standard integer lattice `ℤⁿ`. -/
private theorem checkerboardCarrier_le_intSpan :
    checkerboardCarrier n ≤ Submodule.span ℤ (Set.range (Pi.basisFun ℚ (Fin n))) := by
  intro x hx
  rw [Module.Basis.mem_span_iff_repr_mem]
  intro i
  obtain ⟨z, hz⟩ := hx.1 i
  exact ⟨z, by simp [Pi.basisFun_repr, hz]⟩

/-- The checkerboard carrier is finitely generated: it is a submodule of the finitely generated
module `ℤⁿ` over the Noetherian ring `ℤ`. -/
private theorem checkerboardCarrier_fg : (checkerboardCarrier n).FG := by
  set M := Submodule.span ℤ (Set.range (Pi.basisFun ℚ (Fin n))) with hM
  have : IsNoetherian ℤ M := isNoetherian_span_of_finite ℤ (Set.finite_range _)
  have hfg : ((checkerboardCarrier n).comap M.subtype).FG := IsNoetherian.noetherian _
  have hmap : ((checkerboardCarrier n).comap M.subtype).map M.subtype = checkerboardCarrier n := by
    rw [Submodule.map_comap_subtype, inf_eq_right.mpr (checkerboardCarrier_le_intSpan n)]
  exact hmap ▸ hfg.map _

/-- The checkerboard carrier spans the ambient rational space, since it contains every `2 eᵢ`. -/
private theorem checkerboardCarrier_span_eq_top :
    Submodule.span ℚ (checkerboardCarrier n : Set (Fin n → ℚ)) = ⊤ := by
  rw [eq_top_iff, ← (Pi.basisFun ℚ (Fin n)).span_eq, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  have h2 : Pi.single i (2 : ℚ) ∈ Submodule.span ℚ (checkerboardCarrier n : Set (Fin n → ℚ)) :=
    Submodule.subset_span (single_two_mem_checkerboardCarrier n i)
  have hs : (Pi.basisFun ℚ (Fin n)) i = (2 : ℚ)⁻¹ • Pi.single i (2 : ℚ) := by
    ext k
    simp only [Pi.basisFun_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
    split_ifs <;> norm_num
  rw [SetLike.mem_coe, hs]
  exact Submodule.smul_mem _ _ h2

/-- The checkerboard carrier is a full lattice in `ℚⁿ`. -/
instance instIsLatticeCheckerboardCarrier : (checkerboardCarrier n).IsLattice ℚ :=
  ⟨checkerboardCarrier_fg n, checkerboardCarrier_span_eq_top n⟩

/-! ## The lattice -/

/-- The ambient form of the checkerboard lattice, the standard dot product on `Fin n → ℚ`,
expanded in coordinates.  This is a construction helper: once the lattice is available, use
`checkerboardLattice_form_apply` instead. -/
private theorem checkerboardAmbientForm_apply (x y : Fin n → ℚ) :
    Matrix.toBilin' (1 : Matrix (Fin n) (Fin n) ℚ) x y = ∑ i, x i * y i := by
  rw [Matrix.toBilin'_apply', Matrix.one_mulVec]
  rfl

/-- **The checkerboard lattice** in the Conway–Sloane coordinate model: the integer vectors of
`ℚⁿ` whose coordinate sum is even, with the standard dot product.  For `n ≥ 4` this is the
positive root lattice of type `Dₙ`. -/
noncomputable def checkerboardLattice : IntegralLattice (Fin n → ℚ) :=
  ofSubmodule (checkerboardCarrier n) (Matrix.toBilin' 1)
    (Matrix.isSymm_toBilin'_iff_isSymm.mpr Matrix.isSymm_one) (by
    rintro x ⟨hx, -⟩ y ⟨hy, -⟩
    choose zx hzx using hx
    choose zy hzy using hy
    refine Submodule.mem_one.mpr ⟨∑ i, zx i * zy i, ?_⟩
    rw [checkerboardAmbientForm_apply]
    push_cast [hzx, hzy]
    rfl)

/-- The carrier of the checkerboard lattice. -/
@[simp]
theorem checkerboardLattice_carrier : (checkerboardLattice n).carrier = checkerboardCarrier n :=
  ofSubmodule_carrier _ _ _ _

/-- The rational form of the checkerboard lattice is the identity Gram form. -/
@[simp]
theorem checkerboardLattice_form : (checkerboardLattice n).form = Matrix.toBilin' 1 :=
  ofSubmodule_form _ _ _ _

/-- The form of the checkerboard lattice is the standard dot product. -/
theorem checkerboardLattice_form_apply (x y : Fin n → ℚ) :
    (checkerboardLattice n).form x y = ∑ i, x i * y i := by
  rw [checkerboardLattice_form, checkerboardAmbientForm_apply]

variable {n} in
/-- Membership in the checkerboard lattice: every coordinate is an integer and their sum is
even. -/
theorem mem_checkerboardLattice_carrier_iff (x : Fin n → ℚ) :
    x ∈ (checkerboardLattice n).carrier ↔
      (∀ i, ∃ z : ℤ, x i = (z : ℚ)) ∧ ∃ m : ℤ, ∑ i, x i = 2 * (m : ℚ) := by
  rw [checkerboardLattice_carrier]
  exact mem_checkerboardCarrier_iff x

/-- The checkerboard lattice is nondegenerate, the identity Gram matrix being invertible. -/
instance instIsNondegenerateCheckerboardLattice : (checkerboardLattice n).IsNondegenerate := by
  refine ⟨?_⟩
  rw [checkerboardLattice_form]
  exact LinearMap.BilinForm.nondegenerate_toBilin'_of_det_ne_zero' 1 (by simp)

/-- **The checkerboard lattice is even**: the sum of squares of integers with even sum is
itself even. -/
theorem isEven_checkerboardLattice : (checkerboardLattice n).IsEven := by
  rw [isEven_iff_forall_norm]
  rintro ⟨x, hx⟩
  obtain ⟨hint, m, hm⟩ := (mem_checkerboardLattice_carrier_iff x).mp hx
  choose z hz using hint
  have hsum : ∑ i, z i = 2 * m := by
    have : ((∑ i, z i : ℤ) : ℚ) = ((2 * m : ℤ) : ℚ) := by push_cast [← hz]; exact hm
    exact_mod_cast this
  have heven : Even (∑ i, z i ^ 2) := by
    have hsplit : ∑ i, z i ^ 2 = (∑ i, (z i ^ 2 - z i)) + ∑ i, z i := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ ↦ by ring
    rw [hsplit]
    refine Even.add (Finset.even_sum _ fun i _ ↦ ?_) ⟨m, by omega⟩
    have : z i ^ 2 - z i = (z i - 1) * ((z i - 1) + 1) := by ring
    rw [this]
    exact Int.even_mul_succ_self _
  obtain ⟨k, hk⟩ := heven
  refine ⟨k, ?_⟩
  rw [norm_apply, checkerboardLattice_form_apply]
  have : ∑ i, x i * x i = ((∑ i, z i ^ 2 : ℤ) : ℚ) := by push_cast [hz]; ring_nf
  rw [this, hk]
  push_cast
  ring

/-! ## The dual lattice -/

/-- Pairing an arbitrary vector against a single coordinate vector. -/
theorem checkerboardLattice_form_single (x : Fin n → ℚ) (i : Fin n) (a : ℚ) :
    (checkerboardLattice n).form x (Pi.single i a) = x i * a := by
  rw [checkerboardLattice_form, Matrix.toBilin'_apply', Matrix.one_mulVec]
  simp

/-- Pairing an arbitrary vector against a difference of two coordinate vectors. -/
theorem checkerboardLattice_form_single_sub_single (x : Fin n → ℚ) (i j : Fin n) :
    (checkerboardLattice n).form x (Pi.single i (1 : ℚ) - Pi.single j (1 : ℚ)) = x i - x j := by
  rw [map_sub, checkerboardLattice_form_single, checkerboardLattice_form_single, mul_one, mul_one]

variable [NeZero n]

/-- The final coordinate index `n - 1` of `Fin n`.  The Conway–Sloane vector class of the
checkerboard discriminant group is the standard vector at this index. -/
def checkerboardLastIndex : Fin n := ⟨n - 1, Nat.sub_lt (NeZero.pos n) Nat.one_pos⟩

variable {n} in
/-- **The dual of the checkerboard lattice**: a rational vector pairs integrally with every
lattice vector exactly when all of its coordinate differences are integers and its doubled last
coordinate is an integer.  Equivalently the dual lattice is `ℤⁿ ∪ (s + ℤⁿ)` for the
half-sum `s`. -/
@[simp]
theorem mem_checkerboardLattice_dualCarrier_iff (y : Fin n → ℚ) :
    y ∈ (checkerboardLattice n).dualCarrier ↔
      (∀ i, ∃ z : ℤ, y i - y (checkerboardLastIndex n) = (z : ℚ)) ∧
        ∃ z : ℤ, 2 * y (checkerboardLastIndex n) = (z : ℚ) := by
  rw [IntegralLattice.dualCarrier, LinearMap.BilinForm.mem_dualSubmodule]
  simp only [checkerboardLattice_carrier, Submodule.mem_one]
  constructor
  · intro hy
    refine ⟨fun i ↦ ?_, ?_⟩
    · obtain ⟨w, hw⟩ :=
        hy _ (single_sub_single_mem_checkerboardCarrier n i (checkerboardLastIndex n))
      rw [checkerboardLattice_form_single_sub_single] at hw
      exact ⟨w, by simpa using hw.symm⟩
    · obtain ⟨w, hw⟩ := hy _ (single_two_mem_checkerboardCarrier n (checkerboardLastIndex n))
      rw [checkerboardLattice_form_single, mul_comm] at hw
      exact ⟨w, by simpa using hw.symm⟩
  · rintro ⟨hdiff, t, ht⟩ x hx
    obtain ⟨hint, m, hm⟩ := (mem_checkerboardCarrier_iff x).mp hx
    choose d hd using hdiff
    choose z hz using hint
    refine ⟨(∑ i, d i * z i) + t * m, ?_⟩
    rw [checkerboardLattice_form_apply]
    have hsplit : ∑ i, y i * x i =
        (∑ i, (y i - y (checkerboardLastIndex n)) * x i) +
          y (checkerboardLastIndex n) * ∑ i, x i := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ ↦ by ring
    have hfirst : ∑ i, (y i - y (checkerboardLastIndex n)) * x i = ((∑ i, d i * z i : ℤ) : ℚ) := by
      push_cast
      exact Finset.sum_congr rfl fun i _ ↦ by rw [hd i, hz i]
    have hsecond : y (checkerboardLastIndex n) * ∑ i, x i = (t : ℚ) * m := by
      rw [hm, ← ht]
      ring
    rw [hsplit, hfirst, hsecond]
    simp only [algebraMap_int_eq, eq_intCast]
    push_cast
    ring

/-! ## The three nontrivial discriminant classes -/

/-- The Conway–Sloane vector representative `v = eₙ` of the checkerboard discriminant group. -/
def checkerboardVector : Fin n → ℚ := Pi.single (checkerboardLastIndex n) 1

/-- The Conway–Sloane spinor representative `s = (e₁ + ⋯ + eₙ) / 2`. -/
def checkerboardSpinor : Fin n → ℚ := fun _ ↦ 1 / 2

/-- The Conway–Sloane cospinor representative `c = s - eₙ`. -/
def checkerboardCospinor : Fin n → ℚ := checkerboardSpinor n - checkerboardVector n

variable {n}

/-- The coordinates of the vector representative. -/
@[simp]
theorem checkerboardVector_apply (i : Fin n) :
    checkerboardVector n i = if i = checkerboardLastIndex n then 1 else 0 := by
  rw [checkerboardVector, Pi.single_apply]

omit [NeZero n] in
/-- The coordinates of the spinor representative. -/
@[simp]
theorem checkerboardSpinor_apply (i : Fin n) : checkerboardSpinor n i = 1 / 2 := by
  rw [checkerboardSpinor]

/-- The coordinates of the cospinor representative. -/
@[simp]
theorem checkerboardCospinor_apply (i : Fin n) :
    checkerboardCospinor n i = 1 / 2 - if i = checkerboardLastIndex n then 1 else 0 := by
  rw [checkerboardCospinor, Pi.sub_apply, checkerboardSpinor_apply, checkerboardVector_apply]

/-- The vector representative lies in the dual lattice. -/
theorem checkerboardVector_mem_dualCarrier :
    checkerboardVector n ∈ (checkerboardLattice n).dualCarrier := by
  rw [mem_checkerboardLattice_dualCarrier_iff]
  refine ⟨fun i ↦ ⟨if i = checkerboardLastIndex n then 0 else -1, ?_⟩, 2, by simp⟩
  simp only [checkerboardVector_apply]
  rcases eq_or_ne i (checkerboardLastIndex n) with h | h <;> simp [h]

/-- The spinor representative lies in the dual lattice. -/
theorem checkerboardSpinor_mem_dualCarrier :
    checkerboardSpinor n ∈ (checkerboardLattice n).dualCarrier := by
  rw [mem_checkerboardLattice_dualCarrier_iff]
  exact ⟨fun i ↦ ⟨0, by simp⟩, 1, by norm_num⟩

/-- The cospinor representative lies in the dual lattice. -/
theorem checkerboardCospinor_mem_dualCarrier :
    checkerboardCospinor n ∈ (checkerboardLattice n).dualCarrier :=
  Submodule.sub_mem _ checkerboardSpinor_mem_dualCarrier checkerboardVector_mem_dualCarrier

/-! ## Pairings among the representatives -/

/-- The last coordinate of the vector representative is `1`. -/
theorem checkerboardVector_checkerboardLastIndex :
    checkerboardVector n (checkerboardLastIndex n) = 1 := by
  simp [checkerboardVector]

/-- The last coordinate of the cospinor representative is `-1 / 2`. -/
theorem checkerboardCospinor_checkerboardLastIndex :
    checkerboardCospinor n (checkerboardLastIndex n) = -(1 / 2) := by
  rw [checkerboardCospinor, Pi.sub_apply, checkerboardSpinor_apply,
    checkerboardVector_checkerboardLastIndex]
  ring

/-- The coordinate sum of the vector representative is `1`. -/
theorem sum_checkerboardVector : ∑ i, checkerboardVector n i = 1 := by
  simp [checkerboardVector]

omit [NeZero n] in
/-- The coordinate sum of the spinor representative is `n / 2`. -/
theorem sum_checkerboardSpinor : ∑ i, checkerboardSpinor n i = (n : ℚ) / 2 := by
  simp only [checkerboardSpinor_apply, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    nsmul_eq_mul]
  ring

/-- The coordinate sum of the cospinor representative is `n / 2 - 1`. -/
theorem sum_checkerboardCospinor : ∑ i, checkerboardCospinor n i = (n : ℚ) / 2 - 1 := by
  simp only [checkerboardCospinor, Pi.sub_apply]
  rw [Finset.sum_sub_distrib, sum_checkerboardSpinor, sum_checkerboardVector]

/-- Pairing an arbitrary vector against the vector representative reads off its last
coordinate. -/
theorem checkerboardLattice_form_checkerboardVector (x : Fin n → ℚ) :
    (checkerboardLattice n).form x (checkerboardVector n) = x (checkerboardLastIndex n) := by
  rw [checkerboardVector, checkerboardLattice_form_single, mul_one]

omit [NeZero n] in
/-- Pairing an arbitrary vector against the spinor representative halves its coordinate sum. -/
theorem checkerboardLattice_form_checkerboardSpinor (x : Fin n → ℚ) :
    (checkerboardLattice n).form x (checkerboardSpinor n) = (∑ i, x i) / 2 := by
  rw [checkerboardLattice_form_apply, Finset.sum_div]
  exact Finset.sum_congr rfl fun i _ ↦ by rw [checkerboardSpinor_apply]; ring

/-- Pairing an arbitrary vector against the cospinor representative. -/
theorem checkerboardLattice_form_checkerboardCospinor (x : Fin n → ℚ) :
    (checkerboardLattice n).form x (checkerboardCospinor n) =
      (∑ i, x i) / 2 - x (checkerboardLastIndex n) := by
  rw [checkerboardCospinor, map_sub, checkerboardLattice_form_checkerboardSpinor,
    checkerboardLattice_form_checkerboardVector]

/-- **The vector representative has norm one.** -/
theorem checkerboardLattice_form_checkerboardVector_self :
    (checkerboardLattice n).form (checkerboardVector n) (checkerboardVector n) = 1 := by
  rw [checkerboardLattice_form_checkerboardVector, checkerboardVector_checkerboardLastIndex]

omit [NeZero n] in
/-- **The spinor representative has norm `n / 4`.** -/
theorem checkerboardLattice_form_checkerboardSpinor_self :
    (checkerboardLattice n).form (checkerboardSpinor n) (checkerboardSpinor n) = (n : ℚ) / 4 := by
  rw [checkerboardLattice_form_checkerboardSpinor, sum_checkerboardSpinor]
  ring

/-- **The cospinor representative has norm `n / 4`.** -/
theorem checkerboardLattice_form_checkerboardCospinor_self :
    (checkerboardLattice n).form (checkerboardCospinor n) (checkerboardCospinor n) =
      (n : ℚ) / 4 := by
  rw [checkerboardLattice_form_checkerboardCospinor, sum_checkerboardCospinor,
    checkerboardCospinor_checkerboardLastIndex]
  ring

/-- The vector and spinor representatives pair to `1 / 2`. -/
theorem checkerboardLattice_form_checkerboardVector_checkerboardSpinor :
    (checkerboardLattice n).form (checkerboardVector n) (checkerboardSpinor n) = 1 / 2 := by
  rw [checkerboardLattice_form_checkerboardSpinor, sum_checkerboardVector]

/-- **The spinor and cospinor representatives pair to `(n - 2) / 4`.** -/
theorem checkerboardLattice_form_checkerboardSpinor_checkerboardCospinor :
    (checkerboardLattice n).form (checkerboardSpinor n) (checkerboardCospinor n) =
      ((n : ℚ) - 2) / 4 := by
  rw [checkerboardLattice_form_checkerboardCospinor, sum_checkerboardSpinor,
    checkerboardSpinor_apply]
  ring

/-! ## The discriminant group -/

variable (n)

/-- The class of the vector representative `v` in the checkerboard discriminant group. -/
noncomputable def checkerboardVectorClass : (checkerboardLattice n).DiscriminantGroup :=
  Submodule.Quotient.mk ⟨checkerboardVector n, checkerboardVector_mem_dualCarrier⟩

/-- The class of the spinor representative `s` in the checkerboard discriminant group. -/
noncomputable def checkerboardSpinorClass : (checkerboardLattice n).DiscriminantGroup :=
  Submodule.Quotient.mk ⟨checkerboardSpinor n, checkerboardSpinor_mem_dualCarrier⟩

/-- The spinor class is represented by the Conway--Sloane spinor vector. -/
theorem checkerboardSpinorClass_eq_mk :
    checkerboardSpinorClass n =
      Submodule.Quotient.mk ⟨checkerboardSpinor n, checkerboardSpinor_mem_dualCarrier⟩ :=
  (rfl)

/-- The class of the cospinor representative `c` in the checkerboard discriminant group. -/
noncomputable def checkerboardCospinorClass : (checkerboardLattice n).DiscriminantGroup :=
  Submodule.Quotient.mk ⟨checkerboardCospinor n, checkerboardCospinor_mem_dualCarrier⟩

variable {n}

omit [NeZero n] in
/-- A rational vector with integral coordinates of even sum is a checkerboard lattice vector. -/
theorem mem_checkerboardCarrier_of {u : Fin n → ℚ} (w : Fin n → ℤ) (hw : ∀ i, u i = (w i : ℚ))
    (hsum : Even (∑ i, w i)) : u ∈ checkerboardCarrier n := by
  obtain ⟨k, hk⟩ := hsum
  refine ⟨fun i ↦ ⟨w i, hw i⟩, k, ?_⟩
  have hcast : ∑ i, u i = ((∑ i, w i : ℤ) : ℚ) := by
    push_cast
    exact Finset.sum_congr rfl fun i _ ↦ hw i
  rw [hcast, hk]
  push_cast
  ring

omit [NeZero n] in
/-- Two dual vectors define the same discriminant class as soon as their difference is an
integer vector with even coordinate sum. -/
theorem checkerboard_mk_eq_mk_of {u v : Fin n → ℚ} (hu : u ∈ (checkerboardLattice n).dualCarrier)
    (hv : v ∈ (checkerboardLattice n).dualCarrier) (w : Fin n → ℤ)
    (hw : ∀ i, u i - v i = (w i : ℚ)) (hsum : Even (∑ i, w i)) :
    (Submodule.Quotient.mk ⟨u, hu⟩ : (checkerboardLattice n).DiscriminantGroup) =
      Submodule.Quotient.mk ⟨v, hv⟩ := by
  rw [discriminantGroup_mk_eq_iff, checkerboardLattice_carrier]
  exact mem_checkerboardCarrier_of w hw hsum

/-- **The four Conway–Sloane classes exhaust the checkerboard discriminant group.** -/
theorem checkerboardDiscriminantGroup_eq_zero_or_vectorClass_or_spinorClass_or_cospinorClass
    (g : (checkerboardLattice n).DiscriminantGroup) :
    g = 0 ∨ g = checkerboardVectorClass n ∨ g = checkerboardSpinorClass n ∨
      g = checkerboardCospinorClass n := by
  induction g using Submodule.Quotient.induction_on with
  | _ y =>
    obtain ⟨hdiff, t, ht⟩ := (mem_checkerboardLattice_dualCarrier_iff (y : Fin n → ℚ)).mp y.2
    choose d hd using hdiff
    have hone : ∑ i : Fin n, (if i = checkerboardLastIndex n then (1 : ℤ) else 0) = 1 := by simp
    rcases Int.even_or_odd t with ⟨a, ha⟩ | ⟨a, ha⟩
    · have hlast : (y : Fin n → ℚ) (checkerboardLastIndex n) = (a : ℚ) := by
        rw [ha] at ht
        push_cast at ht
        linarith
      have hyi : ∀ i, (y : Fin n → ℚ) i = ((d i + a : ℤ) : ℚ) := fun i ↦ by
        push_cast
        linarith [hd i, hlast]
      rcases Int.even_or_odd (∑ i, (d i + a)) with hS | hS
      · refine Or.inl ?_
        rw [discriminantGroup_mk_eq_zero_iff, checkerboardLattice_carrier]
        exact mem_checkerboardCarrier_of (fun i ↦ d i + a) hyi hS
      · refine Or.inr (Or.inl ?_)
        refine checkerboard_mk_eq_mk_of y.2 checkerboardVector_mem_dualCarrier
          (fun i ↦ d i + a - if i = checkerboardLastIndex n then 1 else 0) (fun i ↦ ?_) ?_
        · rw [hyi i, checkerboardVector_apply]
          push_cast
          split_ifs <;> ring
        · rw [Finset.sum_sub_distrib, hone]
          obtain ⟨k, hk⟩ := hS
          exact ⟨k, by omega⟩
    · have hlast : (y : Fin n → ℚ) (checkerboardLastIndex n) = (a : ℚ) + 1 / 2 := by
        rw [ha] at ht
        push_cast at ht
        linarith
      have hyi : ∀ i, (y : Fin n → ℚ) i = ((d i + a : ℤ) : ℚ) + 1 / 2 := fun i ↦ by
        push_cast
        linarith [hd i, hlast]
      rcases Int.even_or_odd (∑ i, (d i + a)) with hS | hS
      · refine Or.inr (Or.inr (Or.inl ?_))
        refine checkerboard_mk_eq_mk_of y.2 checkerboardSpinor_mem_dualCarrier
          (fun i ↦ d i + a) (fun i ↦ ?_) hS
        rw [hyi i, checkerboardSpinor_apply]
        ring
      · refine Or.inr (Or.inr (Or.inr ?_))
        refine checkerboard_mk_eq_mk_of y.2 checkerboardCospinor_mem_dualCarrier
          (fun i ↦ d i + a + if i = checkerboardLastIndex n then 1 else 0) (fun i ↦ ?_) ?_
        · rw [hyi i, checkerboardCospinor_apply]
          push_cast
          split_ifs <;> ring
        · rw [Finset.sum_add_distrib, hone]
          obtain ⟨k, hk⟩ := hS
          exact ⟨k + 1, by omega⟩

/-! ## The four classes are distinct -/

omit [NeZero n] in
/-- A vector with a half-integral coordinate is not a lattice vector. -/
private theorem notMem_checkerboardCarrier_of_two_mul_odd {u : Fin n → ℚ} (i : Fin n) (k : ℤ)
    (h : 2 * u i = ((2 * k + 1 : ℤ) : ℚ)) : u ∉ checkerboardCarrier n := by
  rintro ⟨hint, -⟩
  obtain ⟨z, hz⟩ := hint i
  rw [hz] at h
  have hz2 : (2 * z : ℤ) = 2 * k + 1 := by exact_mod_cast h
  omega

omit [NeZero n] in
/-- A vector with odd coordinate sum is not a lattice vector. -/
private theorem notMem_checkerboardCarrier_of_sum_odd {u : Fin n → ℚ} (k : ℤ)
    (h : ∑ i, u i = ((2 * k + 1 : ℤ) : ℚ)) : u ∉ checkerboardCarrier n := by
  rintro ⟨-, m, hm⟩
  rw [hm] at h
  have hm2 : (2 * m : ℤ) = 2 * k + 1 := by exact_mod_cast h
  omega

variable (n)

/-- The vector representative is not a lattice vector: its coordinate sum is odd. -/
theorem checkerboardVector_notMem_checkerboardCarrier :
    checkerboardVector n ∉ checkerboardCarrier n :=
  notMem_checkerboardCarrier_of_sum_odd 0 (by rw [sum_checkerboardVector]; norm_num)

/-- The spinor representative is not a lattice vector: its coordinates are half-integral. -/
theorem checkerboardSpinor_notMem_checkerboardCarrier :
    checkerboardSpinor n ∉ checkerboardCarrier n :=
  notMem_checkerboardCarrier_of_two_mul_odd (checkerboardLastIndex n) 0
    (by rw [checkerboardSpinor_apply]; norm_num)

/-- The cospinor representative is not a lattice vector. -/
theorem checkerboardCospinor_notMem_checkerboardCarrier :
    checkerboardCospinor n ∉ checkerboardCarrier n :=
  notMem_checkerboardCarrier_of_two_mul_odd (checkerboardLastIndex n) (-1)
    (by rw [checkerboardCospinor_checkerboardLastIndex]; norm_num)

/-- The cospinor and vector representatives differ by a half-integral vector. -/
theorem checkerboardCospinor_sub_checkerboardVector_notMem_checkerboardCarrier :
    checkerboardCospinor n - checkerboardVector n ∉ checkerboardCarrier n :=
  notMem_checkerboardCarrier_of_two_mul_odd (checkerboardLastIndex n) (-2)
    (by
      rw [Pi.sub_apply, checkerboardCospinor_checkerboardLastIndex,
        checkerboardVector_checkerboardLastIndex]
      norm_num)

/-- The spinor and cospinor representatives differ by a vector of odd coordinate sum. -/
theorem checkerboardSpinor_sub_checkerboardCospinor_notMem_checkerboardCarrier :
    checkerboardSpinor n - checkerboardCospinor n ∉ checkerboardCarrier n :=
  notMem_checkerboardCarrier_of_sum_odd 0 (by
    simp only [Pi.sub_apply]
    rw [Finset.sum_sub_distrib, sum_checkerboardSpinor, sum_checkerboardCospinor]
    norm_num)

/-- The vector class is nonzero. -/
theorem checkerboardVectorClass_ne_zero : checkerboardVectorClass n ≠ 0 := by
  rw [checkerboardVectorClass, Ne, discriminantGroup_mk_eq_zero_iff, checkerboardLattice_carrier]
  exact checkerboardVector_notMem_checkerboardCarrier n

/-- The spinor class is nonzero. -/
theorem checkerboardSpinorClass_ne_zero : checkerboardSpinorClass n ≠ 0 := by
  rw [checkerboardSpinorClass, Ne, discriminantGroup_mk_eq_zero_iff, checkerboardLattice_carrier]
  exact checkerboardSpinor_notMem_checkerboardCarrier n

/-- The cospinor class is nonzero. -/
theorem checkerboardCospinorClass_ne_zero : checkerboardCospinorClass n ≠ 0 := by
  rw [checkerboardCospinorClass, Ne, discriminantGroup_mk_eq_zero_iff, checkerboardLattice_carrier]
  exact checkerboardCospinor_notMem_checkerboardCarrier n

/-- The spinor class differs from the vector class. -/
theorem checkerboardSpinorClass_ne_checkerboardVectorClass :
    checkerboardSpinorClass n ≠ checkerboardVectorClass n := by
  rw [checkerboardSpinorClass, checkerboardVectorClass, Ne, discriminantGroup_mk_eq_iff,
    checkerboardLattice_carrier]
  exact checkerboardCospinor_notMem_checkerboardCarrier n

/-- The cospinor class differs from the vector class. -/
theorem checkerboardCospinorClass_ne_checkerboardVectorClass :
    checkerboardCospinorClass n ≠ checkerboardVectorClass n := by
  rw [checkerboardCospinorClass, checkerboardVectorClass, Ne, discriminantGroup_mk_eq_iff,
    checkerboardLattice_carrier]
  exact checkerboardCospinor_sub_checkerboardVector_notMem_checkerboardCarrier n

/-- The spinor class differs from the cospinor class. -/
theorem checkerboardSpinorClass_ne_checkerboardCospinorClass :
    checkerboardSpinorClass n ≠ checkerboardCospinorClass n := by
  rw [checkerboardSpinorClass, checkerboardCospinorClass, Ne, discriminantGroup_mk_eq_iff,
    checkerboardLattice_carrier]
  exact checkerboardSpinor_sub_checkerboardCospinor_notMem_checkerboardCarrier n

/-! ## The order of the discriminant group -/

/-- **The checkerboard discriminant group has order four.** -/
theorem natCard_discriminantGroup_checkerboardLattice :
    Nat.card (checkerboardLattice n).DiscriminantGroup = 4 := by
  have huniv : (Set.univ : Set (checkerboardLattice n).DiscriminantGroup) =
      {0, checkerboardVectorClass n, checkerboardSpinorClass n, checkerboardCospinorClass n} := by
    ext g
    simp only [Set.mem_univ, true_iff, Set.mem_insert_iff, Set.mem_singleton_iff]
    exact
      checkerboardDiscriminantGroup_eq_zero_or_vectorClass_or_spinorClass_or_cospinorClass
        g
  have h2 : checkerboardVectorClass n ∉ ({checkerboardSpinorClass n, checkerboardCospinorClass n} :
      Set (checkerboardLattice n).DiscriminantGroup) := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨fun h ↦ checkerboardSpinorClass_ne_checkerboardVectorClass n h.symm,
      fun h ↦ checkerboardCospinorClass_ne_checkerboardVectorClass n h.symm⟩
  have h3 : (0 : (checkerboardLattice n).DiscriminantGroup) ∉
      ({checkerboardVectorClass n, checkerboardSpinorClass n, checkerboardCospinorClass n} :
        Set (checkerboardLattice n).DiscriminantGroup) := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨fun h ↦ checkerboardVectorClass_ne_zero n h.symm,
      fun h ↦ checkerboardSpinorClass_ne_zero n h.symm,
      fun h ↦ checkerboardCospinorClass_ne_zero n h.symm⟩
  rw [← Set.ncard_univ, huniv, Set.ncard_insert_of_notMem h3, Set.ncard_insert_of_notMem h2,
    Set.ncard_pair (checkerboardSpinorClass_ne_checkerboardCospinorClass n)]

/-- **The discriminant of the checkerboard lattice is `4`**.  The form is positive definite, so
the Gram determinant of any integral basis is `4` itself. -/
theorem discriminant_checkerboardLattice : (checkerboardLattice n).discriminant = 4 := by
  rw [← natCard_discriminantGroup, natCard_discriminantGroup_checkerboardLattice]

/-! ## The discriminant quadratic form on the three classes -/

/-- **The vector class has quadratic value `1 / 2`.** -/
@[simp]
theorem discriminantQuadraticMap_checkerboardVectorClass :
    (checkerboardLattice n).discriminantQuadraticMap (isEven_checkerboardLattice n)
      (checkerboardVectorClass n) = ((1 / 2 : ℚ) : AddCircle (1 : ℚ)) := by
  rw [checkerboardVectorClass, discriminantQuadraticMap_mk,
    checkerboardLattice_form_checkerboardVector_self]

/-- **The spinor class has quadratic value `n / 8`.** -/
@[simp]
theorem discriminantQuadraticMap_checkerboardSpinorClass :
    (checkerboardLattice n).discriminantQuadraticMap (isEven_checkerboardLattice n)
      (checkerboardSpinorClass n) = (((n : ℚ) / 8 : ℚ) : AddCircle (1 : ℚ)) := by
  rw [checkerboardSpinorClass, discriminantQuadraticMap_mk,
    checkerboardLattice_form_checkerboardSpinor_self]
  congr 1
  ring

/-- **The cospinor class also has quadratic value `n / 8`.** -/
@[simp]
theorem discriminantQuadraticMap_checkerboardCospinorClass :
    (checkerboardLattice n).discriminantQuadraticMap (isEven_checkerboardLattice n)
      (checkerboardCospinorClass n) = (((n : ℚ) / 8 : ℚ) : AddCircle (1 : ℚ)) := by
  rw [checkerboardCospinorClass, discriminantQuadraticMap_mk,
    checkerboardLattice_form_checkerboardCospinor_self]
  congr 1
  ring

/-- **The spinor and cospinor classes pair to `(n - 2) / 4`.** -/
@[simp]
theorem discriminantPairing_checkerboardSpinorClass_checkerboardCospinorClass :
    (checkerboardLattice n).discriminantPairing (checkerboardSpinorClass n)
        (checkerboardCospinorClass n) =
      ((((n : ℚ) - 2) / 4 : ℚ) : AddCircle (1 : ℚ)) := by
  rw [checkerboardSpinorClass, checkerboardCospinorClass, discriminantPairing_mk,
    checkerboardLattice_form_checkerboardSpinor_checkerboardCospinor]

/-! ## The group structure -/

/-- The cospinor class is the difference of the spinor and vector classes. -/
theorem checkerboardCospinorClass_eq_sub :
    checkerboardCospinorClass n = checkerboardSpinorClass n - checkerboardVectorClass n := by
  rw [checkerboardCospinorClass, checkerboardSpinorClass, checkerboardVectorClass,
    ← Submodule.Quotient.mk_sub]
  rfl

/-- **The vector class has order two**: `2 eₙ` is a lattice vector for every `n`. -/
theorem two_zsmul_checkerboardVectorClass : (2 : ℤ) • checkerboardVectorClass n = 0 := by
  rw [checkerboardVectorClass, ← Submodule.Quotient.mk_smul, discriminantGroup_mk_eq_zero_iff,
    checkerboardLattice_carrier]
  refine mem_checkerboardCarrier_of (fun i ↦ if i = checkerboardLastIndex n then 2 else 0)
    (fun i ↦ ?_) ⟨1, ?_⟩
  · simp only [Submodule.coe_smul, Pi.smul_apply, checkerboardVector_apply, zsmul_eq_mul]
    push_cast
    split_ifs <;> ring
  · simp

/-- **For even `n` the spinor class has order two**: the all-ones vector `2 s` has even
coordinate sum. -/
theorem two_zsmul_checkerboardSpinorClass_of_even (hn : Even n) :
    (2 : ℤ) • checkerboardSpinorClass n = 0 := by
  obtain ⟨k, hk⟩ := hn
  rw [checkerboardSpinorClass, ← Submodule.Quotient.mk_smul, discriminantGroup_mk_eq_zero_iff,
    checkerboardLattice_carrier]
  refine mem_checkerboardCarrier_of (fun _ ↦ (1 : ℤ)) (fun i ↦ ?_) ⟨k, ?_⟩
  · simp only [Submodule.coe_smul, Pi.smul_apply, checkerboardSpinor_apply, zsmul_eq_mul]
    norm_num
  · simp [hk]

/-- **For even `n` the spinor class has additive order two.** -/
theorem addOrderOf_checkerboardSpinorClass_of_even (hn : Even n) :
    addOrderOf (checkerboardSpinorClass n) = 2 := by
  exact addOrderOf_eq_prime
    (by
      rw [two_nsmul, ← two_zsmul]
      exact two_zsmul_checkerboardSpinorClass_of_even n hn)
    (checkerboardSpinorClass_ne_zero n)

/-- For even `n`, the multiples of the spinor class are exactly zero and the spinor class. -/
theorem mem_zmultiples_checkerboardSpinorClass_iff (hn : Even n)
    (x : (checkerboardLattice n).DiscriminantGroup) :
    x ∈ AddSubgroup.zmultiples (checkerboardSpinorClass n) ↔
      x = 0 ∨ x = checkerboardSpinorClass n := by
  constructor
  · intro hx
    obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
    have hmul (m : ℤ) : (2 * m : ℤ) • checkerboardSpinorClass n = 0 := by
      rw [mul_comm, mul_zsmul, two_zsmul_checkerboardSpinorClass_of_even n hn, zsmul_zero]
    obtain hk | hk := Int.even_or_odd k
    · obtain ⟨m, rfl⟩ := hk
      left
      simpa only [two_mul] using hmul m
    · obtain ⟨m, rfl⟩ := hk
      right
      rw [add_zsmul, hmul m, one_zsmul, zero_add]
  · rintro (rfl | rfl)
    · exact (AddSubgroup.zmultiples (checkerboardSpinorClass n)).zero_mem
    · exact AddSubgroup.mem_zmultiples_iff.mpr ⟨1, by rw [one_zsmul]⟩

omit [NeZero n] in
/-- **For odd `n` the vector class is twice the spinor class**, so the discriminant group is
cyclic of order four. -/
theorem two_zsmul_checkerboardSpinorClass_of_odd (hn : Odd n) :
    letI : NeZero n := ⟨by obtain ⟨k, hk⟩ := hn; omega⟩
    (2 : ℤ) • checkerboardSpinorClass n = checkerboardVectorClass n := by
  let _ : NeZero n := ⟨by obtain ⟨k, hk⟩ := hn; omega⟩
  obtain ⟨k, hk⟩ := hn
  rw [← sub_eq_zero, checkerboardSpinorClass, checkerboardVectorClass, ← Submodule.Quotient.mk_smul,
    ← Submodule.Quotient.mk_sub, discriminantGroup_mk_eq_zero_iff, checkerboardLattice_carrier]
  refine mem_checkerboardCarrier_of (fun i ↦ 1 - if i = checkerboardLastIndex n then 1 else 0)
    (fun i ↦ ?_) ⟨k, ?_⟩
  · simp only [Submodule.coe_sub, Submodule.coe_smul, Pi.sub_apply, Pi.smul_apply,
      checkerboardSpinor_apply, checkerboardVector_apply]
    simp only [zsmul_eq_mul]
    push_cast
    split_ifs <;> ring
  · rw [Finset.sum_sub_distrib]
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true, hk]
    push_cast
    ring

/-- The sum of the vector and spinor classes is the cospinor class. -/
theorem checkerboardVectorClass_add_checkerboardSpinorClass :
    checkerboardVectorClass n + checkerboardSpinorClass n = checkerboardCospinorClass n := by
  rw [checkerboardCospinorClass_eq_sub, ← sub_eq_zero]
  have h : checkerboardVectorClass n + checkerboardSpinorClass n -
      (checkerboardSpinorClass n - checkerboardVectorClass n) =
      (2 : ℤ) • checkerboardVectorClass n := by
    rw [two_zsmul]
    abel
  rw [h, two_zsmul_checkerboardVectorClass]

omit [NeZero n] in
/-- **For odd `n` the checkerboard discriminant group is cyclic of order four**, generated by the
spinor class. -/
noncomputable def zmodFourAddEquivCheckerboardDiscriminantGroup (hn : Odd n) :
    ZMod 4 ≃+ (checkerboardLattice n).DiscriminantGroup := by
  let _ : NeZero n := ⟨by obtain ⟨k, hk⟩ := hn; omega⟩
  exact
    zmodAddEquivOfGenerator (g := checkerboardSpinorClass n)
      (fun x ↦ by
        have hc : (-1 : ℤ) • checkerboardSpinorClass n = checkerboardCospinorClass n := by
          rw [checkerboardCospinorClass_eq_sub, ← two_zsmul_checkerboardSpinorClass_of_odd n hn]
          abel
        rcases
            checkerboardDiscriminantGroup_eq_zero_or_vectorClass_or_spinorClass_or_cospinorClass
              x with h | h | h | h
        · exact AddSubgroup.mem_zmultiples_iff.mpr ⟨0, by rw [h, zero_zsmul]⟩
        · exact AddSubgroup.mem_zmultiples_iff.mpr
            ⟨2, by rw [h, two_zsmul_checkerboardSpinorClass_of_odd n hn]⟩
        · exact AddSubgroup.mem_zmultiples_iff.mpr ⟨1, by rw [h, one_zsmul]⟩
        · exact AddSubgroup.mem_zmultiples_iff.mpr ⟨-1, by rw [h, hc]⟩)
      (natCard_discriminantGroup_checkerboardLattice n)

omit [NeZero n] in
/-- The odd-rank identification sends the generator `1` of `ℤ/4` to the spinor class. -/
@[simp]
theorem zmodFourAddEquivCheckerboardDiscriminantGroup_apply_one (hn : Odd n) :
    letI : NeZero n := ⟨by obtain ⟨k, hk⟩ := hn; omega⟩
    zmodFourAddEquivCheckerboardDiscriminantGroup n hn 1 = checkerboardSpinorClass n := by
  let _ : NeZero n := ⟨by obtain ⟨k, hk⟩ := hn; omega⟩
  rw [zmodFourAddEquivCheckerboardDiscriminantGroup]
  exact zmodAddEquivOfGenerator_apply_one _ _

variable {n} in
/-- The homomorphism `ℤ/2 → A_L` determined by an element of order dividing two. -/
private noncomputable def checkerboardZModTwoHom (x : (checkerboardLattice n).DiscriminantGroup)
    (hx : (2 : ℤ) • x = 0) : ZMod 2 →+ (checkerboardLattice n).DiscriminantGroup :=
  ZMod.lift 2 ⟨zmultiplesHom _ x, by simpa using hx⟩

omit [NeZero n] in
variable {n} in
/-- The homomorphism `checkerboardZModTwoHom` sends `1` to the chosen element. -/
private theorem checkerboardZModTwoHom_one (x : (checkerboardLattice n).DiscriminantGroup)
    (hx : (2 : ℤ) • x = 0) : checkerboardZModTwoHom x hx 1 = x := by
  rw [checkerboardZModTwoHom, ← Int.cast_one, ZMod.lift_coe]
  exact one_zsmul x

/-- **For even `n` the checkerboard discriminant group is `(ℤ/2)²`**, with the two factors
generated by the vector class and by the spinor class. -/
noncomputable def zmodTwoProdAddEquivCheckerboardDiscriminantGroup (hn : Even n) :
    ZMod 2 × ZMod 2 ≃+ (checkerboardLattice n).DiscriminantGroup := by
  refine AddEquiv.ofBijective
    ((checkerboardZModTwoHom _ (two_zsmul_checkerboardVectorClass n)).coprod
      (checkerboardZModTwoHom _ (two_zsmul_checkerboardSpinorClass_of_even n hn))) ?_
  rw [Nat.bijective_iff_surjective_and_card]
  refine ⟨fun g ↦ ?_, by simp [natCard_discriminantGroup_checkerboardLattice n]⟩
  rcases
      checkerboardDiscriminantGroup_eq_zero_or_vectorClass_or_spinorClass_or_cospinorClass
        g with h | h | h | h
  · exact ⟨(0, 0), by simp [h]⟩
  · exact ⟨(1, 0), by
      simp only [AddMonoidHom.coprod_apply, map_zero, add_zero, checkerboardZModTwoHom_one, h]⟩
  · exact ⟨(0, 1), by
      simp only [AddMonoidHom.coprod_apply, map_zero, zero_add, checkerboardZModTwoHom_one, h]⟩
  · exact ⟨(1, 1), by
      simp only [AddMonoidHom.coprod_apply, checkerboardZModTwoHom_one]
      rw [checkerboardVectorClass_add_checkerboardSpinorClass, h]⟩

/-- The even-rank identification sends the first generator of `(ℤ/2)²` to the vector class. -/
@[simp]
theorem zmodTwoProdAddEquivCheckerboardDiscriminantGroup_apply_one_zero (hn : Even n) :
    zmodTwoProdAddEquivCheckerboardDiscriminantGroup n hn (1, 0) =
      checkerboardVectorClass n := by
  rw [zmodTwoProdAddEquivCheckerboardDiscriminantGroup, AddEquiv.ofBijective_apply,
    AddMonoidHom.coprod_apply, map_zero, add_zero, checkerboardZModTwoHom_one]

/-- The even-rank identification sends the second generator of `(ℤ/2)²` to the spinor class. -/
@[simp]
theorem zmodTwoProdAddEquivCheckerboardDiscriminantGroup_apply_zero_one (hn : Even n) :
    zmodTwoProdAddEquivCheckerboardDiscriminantGroup n hn (0, 1) =
      checkerboardSpinorClass n := by
  rw [zmodTwoProdAddEquivCheckerboardDiscriminantGroup, AddEquiv.ofBijective_apply,
    AddMonoidHom.coprod_apply, map_zero, zero_add, checkerboardZModTwoHom_one]

end IntegralLattice

end TauCeti
