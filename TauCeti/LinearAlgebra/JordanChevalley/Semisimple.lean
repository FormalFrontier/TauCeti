module

public import TauCeti.LinearAlgebra.JordanChevalley.Functoriality

/-!
# Closure properties of semisimple linear automorphisms

A linear automorphism is semisimple when its underlying endomorphism is semisimple. This file
records the group-theoretic closure properties needed for semisimple elements of algebraic groups:
inverses, powers, products of commuting elements, and conjugates are semisimple.

The inverse statement uses finite-dimensionality in a concrete way. The inverse of an invertible
endomorphism belongs to the algebra generated by that endomorphism: multiplication by the
endomorphism is injective on this finite-dimensional algebra and hence surjective. Mathlib's
`Module.End.IsSemisimple.of_mem_adjoin_singleton` then transfers semisimplicity to the inverse.
Products of commuting semisimple maps require a perfect field, matching Mathlib's corresponding
theorem for endomorphisms.

## Main declarations

* `TauCeti.GeneralLinearGroup.coe_inv_mem_adjoin`: the inverse of an automorphism is polynomial
  in the automorphism.
* `TauCeti.GeneralLinearGroup.IsSemisimple.inv`: the inverse of a semisimple automorphism is
  semisimple.
* `TauCeti.GeneralLinearGroup.IsSemisimple.mul`: commuting semisimple automorphisms have
  semisimple product.
* `TauCeti.GeneralLinearGroup.IsSemisimple.pow`: natural powers of a semisimple automorphism are
  semisimple.
* `TauCeti.GeneralLinearGroup.isSemisimple_mul_mul_inv_iff`: semisimplicity is invariant under
  conjugation.

## References

* T. A. Springer, *Linear Algebraic Groups*, §2.4.
-/

public section

namespace TauCeti

open LinearMap

namespace GeneralLinearGroup

open _root_.Module

universe u v

variable {K : Type u} {V : Type v} [AddCommGroup V]

section CommRing

variable [CommRing K] [Module K V]

/-- Semisimplicity is invariant under conjugation by a linear automorphism. -/
@[simp]
theorem isSemisimple_mul_mul_inv_iff (g h : GeneralLinearGroup K V) :
    IsSemisimple (h * g * h⁻¹) ↔ IsSemisimple g := by
  have heq : h * g * h⁻¹ = LinearMap.GeneralLinearGroup.ofLinearEquiv
      (h.toLinearEquiv.symm.trans (g.toLinearEquiv.trans h.toLinearEquiv)) := by
    apply Units.ext
    rfl
  rw [heq]
  exact isSemisimple_congrLinearEquiv_iff h.toLinearEquiv g

end CommRing

section Field

variable [Field K] [Module K V]

section FiniteDimensional

variable [FiniteDimensional K V]

/-- The inverse of a linear automorphism belongs to the algebra generated by the automorphism.
Equivalently, on a finite-dimensional vector space the inverse is a polynomial in the original
endomorphism. -/
theorem coe_inv_mem_adjoin (g : GeneralLinearGroup K V) :
    ((g⁻¹ : GeneralLinearGroup K V) : End K V) ∈
      Algebra.adjoin K {(g : End K V)} := by
  let A : Subalgebra K (End K V) := Algebra.adjoin K {(g : End K V)}
  let x : A := ⟨(g : End K V), Algebra.subset_adjoin (Set.mem_singleton _)⟩
  let _ : FiniteDimensional K A := .of_fg
    (IsIntegral.of_finite K (g : End K V)).fg_adjoin_singleton
  have hx : Function.Injective (LinearMap.mulLeft K x) := by
    intro y z hyz
    apply Subtype.ext
    apply g.isUnit.mul_left_cancel
    exact congrArg Subtype.val hyz
  obtain ⟨y, hy⟩ :=
    (LinearMap.injective_iff_surjective.mp hx) (1 : A)
  have hy' := congrArg Subtype.val hy
  have hinv : ((g⁻¹ : GeneralLinearGroup K V) : End K V) = y := by
    apply g.isUnit.mul_left_cancel
    exact g.val_inv.trans hy'.symm
  rw [hinv]
  exact y.2

/-- The inverse of a semisimple linear automorphism is semisimple. -/
theorem IsSemisimple.inv {g : GeneralLinearGroup K V} (hg : IsSemisimple g) :
    IsSemisimple g⁻¹ := by
  rw [isSemisimple_def] at hg ⊢
  exact hg.of_mem_adjoin_singleton (coe_inv_mem_adjoin g)

/-- A linear automorphism is semisimple if and only if its inverse is semisimple. -/
@[simp]
theorem isSemisimple_inv_iff (g : GeneralLinearGroup K V) :
    IsSemisimple g⁻¹ ↔ IsSemisimple g := by
  constructor
  · intro hg
    have := hg.inv
    rwa [inv_inv] at this
  · exact IsSemisimple.inv

/-- Every natural power of a semisimple linear automorphism is semisimple. -/
theorem IsSemisimple.pow {g : GeneralLinearGroup K V} (hg : IsSemisimple g) (n : ℕ) :
    IsSemisimple (g ^ n) := by
  rw [isSemisimple_def] at hg ⊢
  simpa only [Units.val_pow_eq_pow_val] using hg.pow n

section PerfectField

variable [PerfectField K]

/-- The product of two commuting semisimple linear automorphisms is semisimple. -/
theorem IsSemisimple.mul {g h : GeneralLinearGroup K V}
    (hg : IsSemisimple g) (hh : IsSemisimple h) (hcomm : Commute g h) :
    IsSemisimple (g * h) := by
  rw [isSemisimple_def] at hg hh ⊢
  rw [Units.val_mul]
  exact hg.mul_of_commute hcomm.units_val hh

end PerfectField

end FiniteDimensional

end Field

end GeneralLinearGroup

end TauCeti
