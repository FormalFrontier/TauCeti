module

public import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.Calculus.Deriv.Shift
import Mathlib.Analysis.Calculus.MeanValue
import TauCeti.Analysis.Normed.Algebra.Basic

/-!
# One-parameter subgroups of the units of a Banach algebra

The unit group `Rˣ` of a real Banach algebra `R` is a Lie group whose Lie algebra is `R`, and its
exponential map is the Banach-algebra exponential `NormedSpace.exp`.  This file builds that
exponential as a map into the units, assembles the resulting one-parameter subgroups
`t ↦ exp (t • x)` as honest group homomorphisms `(ℝ, +) → Rˣ`, and proves that **every**
differentiable one-parameter subgroup arises this way, from a unique `x`.

Mathlib supplies the exponential itself, the fact that it lands in the units
(`NormedSpace.isUnit_exp`), the addition law for commuting elements
(`NormedSpace.exp_add_of_commute`) and the derivative of `t ↦ exp (t • x)`
(`NormedSpace.hasDerivAt_exp_smul_const`).  What it does not supply is the `Rˣ`-valued exponential,
the bundled homomorphism, or the converse direction, and the converse is the whole point: without
it, `expUnitsHom` is one family of one-parameter subgroups among possibly many, and the
identification of `R` with the Lie algebra of `Rˣ` is only a slogan.

The converse is proved by an ordinary uniqueness-of-solutions argument for a linear differential
equation, run without ever mentioning differential equations.  Let `φ : ℝ → R` satisfy
`φ (s + t) = φ s * φ t` and `φ 0 = 1`, and be differentiable at `0` with derivative `x`.  Two
consequences follow from the multiplicativity alone:

* `φ s` **commutes with `x`**, because `h ↦ φ s * φ h` and `h ↦ φ h * φ s` are the *same function*
  (both are `h ↦ φ (s + h)`, using `s + h = h + s`), so their derivatives at `0` agree;
* `φ` is differentiable **everywhere**, with `HasDerivAt φ (φ s * x) s`, because near `s` it is
  `h ↦ φ s * φ h` up to a translation of the variable.

Then `u ↦ exp (u • (-x)) * φ u` has derivative
`exp (u • (-x)) * (-x) * φ u + exp (u • (-x)) * (φ u * x)`, which vanishes precisely because `φ u`
commutes with `x`; so that function is constant, equal to its value `1` at `0`, and multiplying by
`exp (t • x)` gives `φ t = exp (t • x)`.

Only differentiability **at `0`** is assumed: the multiplicativity propagates it.  The stronger
classical statement, that a merely *continuous* one-parameter subgroup is already differentiable,
is a separate automatic-smoothness theorem and is not proved here.

## Main definitions

* `TauCeti.expUnits`: the exponential of a Banach-algebra element, as a unit.
* `TauCeti.expUnitsHom`: the one-parameter subgroup `t ↦ exp (t • x)` of `Rˣ`, bundled as a
  monoid homomorphism out of `Multiplicative ℝ`.

## Main results

* `TauCeti.exp_add_smul`: the one-parameter subgroup law
  `exp ((s + t) • x) = exp (s • x) * exp (t • x)`.
* `TauCeti.hasDerivAt_expUnitsHom_zero`: the one-parameter subgroup generated by `x` has velocity
  `x` at the identity.
* `TauCeti.eq_exp_smul_of_hasDerivAt`: a one-parameter subgroup of `R` that is differentiable at
  `0` with derivative `x` is `t ↦ exp (t • x)`.
* `TauCeti.eq_of_forall_exp_smul_eq`: distinct elements give distinct one-parameter subgroups.
* `TauCeti.existsUnique_forall_eq_exp_smul` and `TauCeti.existsUnique_expUnitsHom`: the resulting
  bijection between `R` and the one-parameter subgroups differentiable at `0`, stated for a
  multiplicative map `ℝ → R` and for a homomorphism `Multiplicative ℝ →* Rˣ`.

## References

* [Lie groups and the Lie algebra correspondence roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/LieGroups/README.md),
  Deliverable A, Layer 0, "One-parameter subgroups" and "The matrix and circle shadows".
* A. W. Knapp, *Lie Groups Beyond an Introduction*, second edition, Birkhäuser (2002), Chapter I.
-/

public section

open NormedSpace

namespace TauCeti

variable {R : Type*} [NormedRing R] [NormedAlgebra ℝ R] [CompleteSpace R]

attribute [local instance] TauCeti.normedAlgebraRatOfReal

/-! ### The exponential as a unit -/

/-- **The Banach-algebra exponential, as a unit.**  The exponential of any element of a Banach
algebra is invertible, with inverse the exponential of its negative, so it lifts to the unit
group; this is the exponential map of the Lie group `Rˣ`. -/
noncomputable def expUnits (x : R) : Rˣ :=
  (isUnit_exp x).unit

@[simp]
theorem expUnits_coe (x : R) : (expUnits x : R) = exp x :=
  (isUnit_exp x).unit_spec

@[simp]
theorem expUnits_inv_coe (x : R) : (((expUnits x)⁻¹ : Rˣ) : R) = exp (-x) :=
  Units.inv_eq_of_mul_eq_one_right <| by
    rw [expUnits_coe, ← exp_add_of_commute (Commute.refl x).neg_right, add_neg_cancel, exp_zero]

@[simp]
theorem expUnits_zero : expUnits (0 : R) = 1 :=
  Units.ext <| by simp

/-- Commuting elements have multiplicative exponentials, as units. -/
theorem expUnits_add_of_commute {x y : R} (h : Commute x y) :
    expUnits (x + y) = expUnits x * expUnits y :=
  Units.ext <| by simp [exp_add_of_commute h]

@[simp]
theorem expUnits_neg (x : R) : expUnits (-x) = (expUnits x)⁻¹ :=
  Units.ext <| by rw [expUnits_coe, expUnits_inv_coe]

/-! ### One-parameter subgroups -/

/-- **The one-parameter subgroup law.**  The real multiples of a fixed element commute, so the
exponential turns the addition of `ℝ` into the multiplication of `R` along the line `ℝ ∙ x`. -/
theorem exp_add_smul (x : R) (s t : ℝ) :
    exp ((s + t) • x) = exp (s • x) * exp (t • x) := by
  rw [add_smul, exp_add_of_commute (((Commute.refl x).smul_left s).smul_right t)]

/-- **The one-parameter subgroup of `Rˣ` generated by `x`**, the group homomorphism
`(ℝ, +) → Rˣ` sending `t` to `exp (t • x)`.  Its source is `Multiplicative ℝ` so that it is a
homomorphism of groups on the nose rather than an addition-to-multiplication law. -/
noncomputable def expUnitsHom (x : R) : Multiplicative ℝ →* Rˣ where
  toFun t := expUnits (Multiplicative.toAdd t • x)
  map_one' := by simp
  map_mul' s t :=
    Units.ext <| by
      simpa using exp_add_smul x (Multiplicative.toAdd s) (Multiplicative.toAdd t)

@[simp]
theorem expUnitsHom_apply (x : R) (t : Multiplicative ℝ) :
    expUnitsHom x t = expUnits (Multiplicative.toAdd t • x) :=
  (rfl)

/-- **The one-parameter subgroup generated by `x` has velocity `x` at the identity.**  Every
`expUnitsHom x` therefore satisfies the hypothesis of `TauCeti.existsUnique_expUnitsHom`, so that
theorem is an honest bijection and not a vacuous one. -/
theorem hasDerivAt_expUnitsHom_zero (x : R) :
    HasDerivAt (fun t : ℝ => ((expUnitsHom x (Multiplicative.ofAdd t) : Rˣ) : R)) x 0 := by
  simpa using hasDerivAt_exp_smul_const x (0 : ℝ)

/-! ### Every differentiable one-parameter subgroup is an exponential -/

/-- **Distinct velocities give distinct one-parameter subgroups**: the exponential one-parameter
subgroups are pairwise different, since `x` is recovered as the derivative at `0`. -/
theorem eq_of_forall_exp_smul_eq {x y : R} (h : ∀ t : ℝ, exp (t • x) = exp (t • y)) : x = y := by
  have hfun : (fun u : ℝ => exp (u • x)) = fun u : ℝ => exp (u • y) := funext h
  have hx : HasDerivAt (fun u : ℝ => exp (u • x)) (exp ((0 : ℝ) • x) * x) 0 :=
    hasDerivAt_exp_smul_const x 0
  have hy : HasDerivAt (fun u : ℝ => exp (u • x)) (exp ((0 : ℝ) • y) * y) 0 := by
    rw [hfun]
    exact hasDerivAt_exp_smul_const y 0
  have h2 := hx.unique hy
  simpa using h2

section Uniqueness

variable {φ : ℝ → R} {x : R}

omit [CompleteSpace R] in
/-- **Every value of a one-parameter subgroup commutes with its velocity.**  The functions
`h ↦ φ s * φ h` and `h ↦ φ h * φ s` are equal, both being `h ↦ φ (s + h)`, so their derivatives at
`0` agree. -/
theorem commute_of_hasDerivAt_zero (hmul : ∀ s t : ℝ, φ (s + t) = φ s * φ t)
    (hx : HasDerivAt φ x 0) (s : ℝ) : Commute (φ s) x := by
  have hfun : (fun h : ℝ => φ s * φ h) = fun h : ℝ => φ h * φ s := by
    funext h
    rw [← hmul, ← hmul, add_comm]
  have hl : HasDerivAt (fun h : ℝ => φ s * φ h) (φ s * x) 0 := hx.const_mul (φ s)
  have hr : HasDerivAt (fun h : ℝ => φ s * φ h) (x * φ s) 0 := by
    rw [hfun]
    exact hx.mul_const (φ s)
  have h : φ s * x = x * φ s := hl.unique hr
  exact h

omit [CompleteSpace R] in
/-- **A one-parameter subgroup differentiable at `0` is differentiable everywhere**, with velocity
`φ s * x` at `s`: near `s` it is the translate of `h ↦ φ s * φ h`. -/
theorem hasDerivAt_of_hasDerivAt_zero (hmul : ∀ s t : ℝ, φ (s + t) = φ s * φ t)
    (hx : HasDerivAt φ x 0) (s : ℝ) : HasDerivAt φ (φ s * x) s := by
  have h0 : HasDerivAt (fun h : ℝ => φ (s + h)) (φ s * x) 0 := by
    have hfun : (fun h : ℝ => φ (s + h)) = fun h : ℝ => φ s * φ h := funext fun h => hmul s h
    rw [hfun]
    exact hx.const_mul (φ s)
  have h2 : HasDerivAt (fun y : ℝ => φ (s + (-s + y))) (φ s * x) s :=
    HasDerivAt.comp_const_add (-s) s (by simpa using h0)
  simpa using h2

/-- **A differentiable one-parameter subgroup of a Banach algebra is an exponential.**  If
`φ : ℝ → R` is multiplicative, sends `0` to `1`, and is differentiable at `0` with derivative `x`,
then `φ t = exp (t • x)` for every `t`.

The velocity `x` is the only input: the multiplicativity upgrades differentiability at `0` to
differentiability everywhere, and `u ↦ exp (u • (-x)) * φ u` is then constant. -/
theorem eq_exp_smul_of_hasDerivAt (hmul : ∀ s t : ℝ, φ (s + t) = φ s * φ t) (h1 : φ 0 = 1)
    (hx : HasDerivAt φ x 0) (t : ℝ) : φ t = exp (t • x) := by
  have hcomm : ∀ s : ℝ, Commute (φ s) x := commute_of_hasDerivAt_zero hmul hx
  have hderiv : ∀ s : ℝ, HasDerivAt φ (φ s * x) s := hasDerivAt_of_hasDerivAt_zero hmul hx
  have hgderiv : ∀ s : ℝ, HasDerivAt (fun u : ℝ => exp (u • (-x)) * φ u) 0 s := by
    intro s
    have he : HasDerivAt (fun u : ℝ => exp (u • (-x))) (exp (s • (-x)) * (-x)) s :=
      hasDerivAt_exp_smul_const (-x) s
    have hz := he.mul (hderiv s)
    have key : exp (s • (-x)) * (-x) * φ s + exp (s • (-x)) * (φ s * x) = 0 := by
      have hc : x * φ s = φ s * x := (hcomm s).symm
      rw [mul_neg, neg_mul, mul_assoc, hc, neg_add_cancel]
    rwa [key] at hz
  have hgdiff : Differentiable ℝ fun u : ℝ => exp (u • (-x)) * φ u := fun s =>
    (hgderiv s).differentiableAt
  have hconst : exp (t • (-x)) * φ t = exp ((0 : ℝ) • (-x)) * φ 0 :=
    is_const_of_deriv_eq_zero hgdiff (fun u => (hgderiv u).deriv) t 0
  rw [zero_smul, exp_zero, h1, mul_one] at hconst
  have hinv : exp (t • x) * exp (t • (-x)) = 1 := by
    rw [smul_neg, ← exp_add_of_commute ((Commute.refl (t • x)).neg_right), add_neg_cancel, exp_zero]
  calc φ t = exp (t • x) * exp (t • (-x)) * φ t := by rw [hinv, one_mul]
    _ = exp (t • x) * (exp (t • (-x)) * φ t) := mul_assoc _ _ _
    _ = exp (t • x) := by rw [hconst, mul_one]

/-- **The one-parameter subgroups of `R` differentiable at `0` are exactly the exponentials.**
This is the bijection `Hom(ℝ, Rˣ) ≃ R` identifying `R` with the Lie algebra of `Rˣ`, in its
element-level form. -/
theorem existsUnique_forall_eq_exp_smul (hmul : ∀ s t : ℝ, φ (s + t) = φ s * φ t) (h1 : φ 0 = 1)
    (hdiff : DifferentiableAt ℝ φ 0) : ∃! x : R, ∀ t : ℝ, φ t = exp (t • x) := by
  refine ⟨deriv φ 0, eq_exp_smul_of_hasDerivAt hmul h1 hdiff.hasDerivAt, fun y hy => ?_⟩
  refine eq_of_forall_exp_smul_eq fun t => ?_
  rw [← hy t, eq_exp_smul_of_hasDerivAt hmul h1 hdiff.hasDerivAt t]

end Uniqueness

/-- **The one-parameter subgroups of `Rˣ` differentiable at `0` are exactly the `expUnitsHom x`.**
The bundled form of `TauCeti.existsUnique_forall_eq_exp_smul`: the differentiability hypothesis is
on the underlying `R`-valued path, since that is where the Banach-space derivative lives. -/
theorem existsUnique_expUnitsHom (φ : Multiplicative ℝ →* Rˣ)
    (hdiff : DifferentiableAt ℝ (fun t : ℝ => ((φ (Multiplicative.ofAdd t) : Rˣ) : R)) 0) :
    ∃! x : R, φ = expUnitsHom x := by
  have hmul : ∀ s t : ℝ, ((φ (Multiplicative.ofAdd (s + t)) : Rˣ) : R)
      = ((φ (Multiplicative.ofAdd s) : Rˣ) : R) * ((φ (Multiplicative.ofAdd t) : Rˣ) : R) := by
    intro s t
    have hadd : Multiplicative.ofAdd (s + t)
        = Multiplicative.ofAdd s * Multiplicative.ofAdd t := (rfl)
    rw [hadd, map_mul, Units.val_mul]
  have h1 : ((φ (Multiplicative.ofAdd (0 : ℝ)) : Rˣ) : R) = 1 := by simp
  obtain ⟨x, hx, huniq⟩ := existsUnique_forall_eq_exp_smul hmul h1 hdiff
  refine ⟨x, MonoidHom.ext fun a => Units.ext ?_, fun y hy => huniq y fun t => ?_⟩
  · simpa using hx (Multiplicative.toAdd a)
  · rw [hy]
    simp

end TauCeti
