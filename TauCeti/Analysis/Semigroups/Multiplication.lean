/-!
# The multiplication semigroup on bounded continuous functions

For a bounded continuous multiplier `m : α →ᵇ ℝ` this file constructs the **multiplication
semigroup** on the Banach space `α →ᵇ ℝ` of bounded continuous real functions:

`S(t) f = e^{-t·m} · f`, acting by pointwise multiplication.

This is the remaining concrete acceptance example for Part A of the one-parameter-semigroups
roadmap.  It is the bounded-operator semigroup `ofBounded` generated by multiplication by `-m`,
and we develop:

* `StronglyContinuousSemigroup.ofMultiplication m`: the C₀-semigroup `t ↦` multiplication by
  `e^{-t·m}`, with growth bound `(‖m⁻‖, 1)` controlled by the negative part of `m`;
* its generator: the domain is the whole space and the generator is multiplication by `-m`
  (`ofMultiplication_domain_eq_top`, `ofMultiplication_generator`);
* its resolvent: for `‖m⁻‖ < λ` the Laplace-transform resolvent acts as multiplication by the
  pointwise inverse `(λ + m)⁻¹` (`ofMultiplication_resolvent_eq`), which identifies it with the
  resolvent of the generator through the bridge lemma `generator_resolvent_eq`
  (`ofMultiplication_generator_resolvent_eq`);
* `ContractionSemigroup.ofMultiplication`: when `0 ≤ m` the semigroup is contractive, so the
  abstract bound `‖R(λ)‖ ≤ 1/λ` applies to it concretely.

## References
The multiplication semigroup is the standard first example of a C₀-semigroup; see Engel--Nagel,
*One-Parameter Semigroups for Linear Evolution Equations*, Ch. I, and Pazy, *Semigroups of
Linear Operators*, Ch. 1.
-/

public section

noncomputable section

open scoped NNReal Topology BoundedContinuousFunction
open NormedSpace

namespace TauCeti

namespace BoundedContinuousFunction

variable {α : Type*} [TopologicalSpace α]

/-! ## The exponential multiplier -/

/-- The exponential multiplier `x ↦ exp (-t · m x)` as a bounded continuous function. -/
def expNegMul (t : ℝ) (m : α →ᵇ ℝ) : α →ᵇ ℝ :=
  BoundedContinuousFunction.ofNormedAddCommGroup (fun x => Real.exp (-(t * m x)))
    (by fun_prop) (Real.exp (|t| * ‖m‖)) fun x => by
      have hx : |m x| ≤ ‖m‖ := m.norm_coe_le_norm x
      simp only [Real.norm_eq_abs, abs_of_nonneg (Real.exp_nonneg _)]
      refine Real.exp_le_exp.mpr (le_trans (le_abs_self _) ?_)
      rw [abs_neg, abs_mul]
      exact mul_le_mul_of_nonneg_left hx (abs_nonneg t)

/-- The coercion of `expNegMul t m` is the function `x ↦ exp (-(t * m x))`. -/
@[simp]
theorem coe_expNegMul (t : ℝ) (m : α →ᵇ ℝ) :
    ⇑(expNegMul t m) = fun x => Real.exp (-(t * m x)) :=
  BoundedContinuousFunction.coe_ofNormedAddCommGroup _ _ _ _

/-- Evaluation of the Banach-algebra exponential of a bounded continuous real function. -/
theorem exp_apply (g : α →ᵇ ℝ) (x : α) : (exp g) x = Real.exp (g x) := by
  let +nondep : NormedAlgebra ℚ (α →ᵇ ℝ) := .restrictScalars ℚ ℝ _
  let ev :=
    (ContinuousMap.evalAlgHom (S := ℝ) (R := ℝ) x).comp
      (BoundedContinuousFunction.toContinuousMapₐ ℝ)
  rw [Real.exp_eq_exp_ℝ]
  -- The algebra homomorphism `ev` and `evalCLM x` have definitionally equal coercions.
  exact map_exp ev (BoundedContinuousFunction.evalCLM (𝕜 := ℝ) x).continuous g

/-- The negative part of a bounded continuous function at a point is bounded by the norm of
its negative part. -/
private theorem negPart_apply_le_norm_negPart (m : α →ᵇ ℝ) (x : α) :
    (m x)⁻ ≤ ‖m⁻‖ := by
  simpa using BoundedContinuousFunction.apply_le_norm (m⁻) x

/-- The lower bound on `c + m x` supplied by the norm of the negative part of `m`. -/
private theorem sub_norm_negPart_le_add (c : ℝ) (m : α →ᵇ ℝ) (x : α) :
    c - ‖m⁻‖ ≤ c + m x := by
  linarith [neg_le_negPart (m x), negPart_apply_le_norm_negPart m x]

/-- For `t ≥ 0`, the exponential multiplier is bounded by `e^{t ‖m⁻‖}`. -/
theorem norm_expNegMul_le {t : ℝ} (ht : 0 ≤ t) (m : α →ᵇ ℝ) :
    ‖expNegMul t m‖ ≤ Real.exp (t * ‖m⁻‖) := by
  refine (BoundedContinuousFunction.norm_le (by positivity)).mpr fun x => ?_
  simp only [coe_expNegMul, Real.norm_eq_abs, abs_of_nonneg (Real.exp_nonneg _)]
  refine Real.exp_le_exp.mpr ?_
  calc -(t * m x) = t * (-m x) := (mul_neg t (m x)).symm
    _ ≤ t * (m x)⁻ := mul_le_mul_of_nonneg_left (neg_le_negPart (m x)) ht
    _ ≤ t * ‖m⁻‖ :=
      mul_le_mul_of_nonneg_left (negPart_apply_le_norm_negPart m x) ht

end BoundedContinuousFunction

namespace Semigroups

variable {α : Type*} [TopologicalSpace α]

/-! ## The multiplication semigroup -/

private theorem expNegMul_eq_exp (t : ℝ) (m : α →ᵇ ℝ) :
    BoundedContinuousFunction.expNegMul t m = exp (t • (-m)) := by
  ext x
  rw [BoundedContinuousFunction.coe_expNegMul, BoundedContinuousFunction.exp_apply]
  simp [smul_neg]

/-- **The multiplication semigroup**: for a bounded continuous multiplier `m`, the C₀-semigroup
on the Banach space `α →ᵇ ℝ` generated by multiplication by `-m`.  It is the bounded-operator
semigroup `ofBounded (ContinuousLinearMap.mul ℝ (α →ᵇ ℝ) (-m))`, and acts by pointwise
multiplication with `exp (-t·m)`, that is `S(t) f = e^{-t·m} · f`.  For `λ > ‖m⁻‖` its resolvent
acts as multiplication by the pointwise inverse `(λ + m)⁻¹` (`ofMultiplication_resolvent_eq`). -/
def StronglyContinuousSemigroup.ofMultiplication (m : α →ᵇ ℝ) :
    StronglyContinuousSemigroup (α →ᵇ ℝ) :=
  ofBounded (ContinuousLinearMap.mul ℝ (α →ᵇ ℝ) (-m))

/-- The multiplication semigroup is the bounded-generator semigroup for multiplication by
`-m`. -/
theorem StronglyContinuousSemigroup.ofMultiplication_eq_ofBounded (m : α →ᵇ ℝ) :
    ofMultiplication m = ofBounded (ContinuousLinearMap.mul ℝ (α →ᵇ ℝ) (-m)) := by
  rw [ofMultiplication]

/-- The operator of the multiplication semigroup at time `t` is multiplication by `e^{-t·m}`. -/
@[simp]
theorem StronglyContinuousSemigroup.ofMultiplication_apply (m : α →ᵇ ℝ) (t : ℝ≥0) :
    ofMultiplication m t =
      ContinuousLinearMap.mul ℝ (α →ᵇ ℝ)
        (BoundedContinuousFunction.expNegMul (t : ℝ) m) := by
  rw [ofMultiplication, ofBounded_apply, expNegMul_eq_exp, ← map_smul,
    TauCeti.Lie.exp_mulLeft]

/-- The multiplication semigroup at time `t` acts on `f` by multiplication with `e^{-t·m}`. -/
theorem StronglyContinuousSemigroup.ofMultiplication_apply_apply (m : α →ᵇ ℝ) (t : ℝ≥0)
    (f : α →ᵇ ℝ) :
    ofMultiplication m t f = BoundedContinuousFunction.expNegMul (t : ℝ) m * f := by
  rw [ofMultiplication_apply]
  exact ContinuousLinearMap.mul_apply' ℝ (α →ᵇ ℝ)
    (BoundedContinuousFunction.expNegMul (t : ℝ) m) f

/-- Pointwise action of the multiplication semigroup: `(S(t) f)(x) = e^{-t·m x} · f(x)`. -/
theorem StronglyContinuousSemigroup.ofMultiplication_apply_apply_apply (m : α →ᵇ ℝ) (t : ℝ≥0)
    (f : α →ᵇ ℝ) (x : α) : ofMultiplication m t f x = Real.exp (-((t : ℝ) * m x)) * f x := by
  rw [ofMultiplication_apply_apply, BoundedContinuousFunction.mul_apply,
    BoundedContinuousFunction.coe_expNegMul]

/-- The real-time operator of the multiplication semigroup at `t ≥ 0` is multiplication by
`e^{-t·m}`. -/
theorem StronglyContinuousSemigroup.ofMultiplication_realOperator_of_nonneg
    (m : α →ᵇ ℝ) {t : ℝ} (ht : 0 ≤ t) :
    (ofMultiplication m).realOperator t =
      ContinuousLinearMap.mul ℝ (α →ᵇ ℝ) (BoundedContinuousFunction.expNegMul t m) := by
  have ht_coe : ((t.toNNReal : ℝ) = t) := Real.coe_toNNReal t ht
  rw [← ht_coe, realOperator_coe, ofMultiplication_apply]

/-- The multiplication semigroup has growth bound `(‖m⁻‖, 1)`. -/
theorem StronglyContinuousSemigroup.ofMultiplication_hasGrowthBound (m : α →ᵇ ℝ) :
    (ofMultiplication m).HasGrowthBound ‖m⁻‖ 1 :=
  hasGrowthBound_of_bound le_rfl fun t ht => by
    rw [ofMultiplication_realOperator_of_nonneg m ht]
    refine le_trans (ContinuousLinearMap.opNorm_mul_apply_le ℝ _ _) ?_
    refine le_trans (BoundedContinuousFunction.norm_expNegMul_le ht _) ?_
    rw [one_mul, mul_comm t]

/-! ## The generator -/

/-- The generator domain of the multiplication semigroup is the whole space. -/
@[simp]
theorem StronglyContinuousSemigroup.ofMultiplication_domain_eq_top (m : α →ᵇ ℝ) :
    (ofMultiplication m).domain = ⊤ :=
  ofBounded_domain_eq_top _

/-- **The generator of the multiplication semigroup** is multiplication by `-m`, on the whole
space. -/
@[simp]
theorem StronglyContinuousSemigroup.ofMultiplication_generator (m : α →ᵇ ℝ) :
    (ofMultiplication m).generator =
      (ContinuousLinearMap.mul ℝ (α →ᵇ ℝ) (-m)).toLinearMap.toPMap ⊤ :=
  ofBounded_generator _


/-! ## The concrete resolvent -/

end Semigroups

namespace BoundedContinuousFunction

variable {α : Type*} [TopologicalSpace α]

/-- The hypothesis `‖m⁻‖ < c` guarantees `c + m x > 0` for every `x`. -/
private theorem add_pos_of_norm_negPart_lt {c : ℝ} {m : α →ᵇ ℝ} (hc : ‖m⁻‖ < c) (x : α) :
    0 < c + m x := by
  linarith [sub_norm_negPart_le_add c m x]

/-- The pointwise inverse `(c + m)⁻¹` of a positive perturbation of a bounded continuous
multiplier, as bounded continuous function.  The hypothesis `‖m⁻‖ < c` guarantees
`c + m x ≥ c - ‖m⁻‖ > 0` for every `x`. -/
def addInv (c : ℝ) (m : α →ᵇ ℝ) (hc : ‖m⁻‖ < c) : α →ᵇ ℝ :=
  BoundedContinuousFunction.ofNormedAddCommGroup (fun x => (c + m x)⁻¹)
    (by
      refine Continuous.inv₀ (continuous_const.add m.continuous) fun x => ?_
      exact ne_of_gt (add_pos_of_norm_negPart_lt hc x))
    (1 / (c - ‖m⁻‖)) fun x => by
      have hge : c - ‖m⁻‖ ≤ c + m x := sub_norm_negPart_le_add c m x
      have hpos : (0 : ℝ) < c - ‖m⁻‖ := by linarith
      have hxpos : (0 : ℝ) < c + m x := add_pos_of_norm_negPart_lt hc x
      rw [Real.norm_eq_abs, abs_inv, abs_of_pos hxpos, inv_eq_one_div]
      exact one_div_le_one_div_of_le hpos hge

/-- The coercion of `addInv c m hc` is the function `x ↦ (c + m x)⁻¹`. -/
@[simp]
theorem coe_addInv (c : ℝ) (m : α →ᵇ ℝ) (hc : ‖m⁻‖ < c) :
    ⇑(addInv c m hc) = fun x => (c + m x)⁻¹ :=
  BoundedContinuousFunction.coe_ofNormedAddCommGroup _ _ _ _

/-- The pointwise inverse `(c + m)⁻¹` has norm at most `1 / (c - ‖m⁻‖)`. -/
theorem norm_addInv_le (c : ℝ) (m : α →ᵇ ℝ) (hc : ‖m⁻‖ < c) :
    ‖addInv c m hc‖ ≤ 1 / (c - ‖m⁻‖) :=
  BoundedContinuousFunction.norm_ofNormedAddCommGroup_le _ (by positivity) _

end BoundedContinuousFunction

namespace Semigroups

variable {α : Type*} [TopologicalSpace α]

/-- **The resolvent of the multiplication semigroup**: for `‖m⁻‖ < λ`, the Laplace-transform
resolvent acts as multiplication by the pointwise inverse `(λ + m)⁻¹`,
that is `R(λ) f = (λ + m)⁻¹ · f`. -/
theorem StronglyContinuousSemigroup.ofMultiplication_resolvent_eq (m : α →ᵇ ℝ) {c : ℝ}
    (hc : ‖m⁻‖ < c) :
    (ofMultiplication m).resolvent (ofMultiplication_hasGrowthBound m) c hc
      = ContinuousLinearMap.mul ℝ (α →ᵇ ℝ) (BoundedContinuousFunction.addInv c m hc) := by
  refine ContinuousLinearMap.ext fun f => BoundedContinuousFunction.ext fun x => ?_
  have hcomm := ContinuousLinearMap.integral_comp_comm
    (BoundedContinuousFunction.evalCLM (𝕜 := ℝ) x)
    ((ofMultiplication m).integrableOn_resolvent_integrand
      (ofMultiplication_hasGrowthBound m) c hc f).integrable
  have hnorm : ∀ t : ℝ,
      Real.exp (-(c * t)) * Real.exp (-((t : ℝ) * m x)) * f x
        = f x * Real.exp (-((c + m x) * t)) := by
    intro t
    have hexp : -(c * t) + -(t * m x) = -((c + m x) * t) := by ring
    rw [← Real.exp_add, hexp]
    exact mul_comm _ _
  have hpt : ∀ t : ℝ,
      BoundedContinuousFunction.evalCLM (𝕜 := ℝ) x
          (Real.exp (-(c * t)) •
            (StronglyContinuousSemigroup.ofMultiplication m).realOperator t f)
        = Real.exp (-(c * t)) *
            ((StronglyContinuousSemigroup.ofMultiplication m) (t.toNNReal : ℝ≥0) f) x := by
    intro t
    rw [StronglyContinuousSemigroup.realOperator_def]
    simp only [map_smul, BoundedContinuousFunction.evalCLM_apply, smul_eq_mul]
  have hstep1 : ((ofMultiplication m).resolvent (ofMultiplication_hasGrowthBound m) c hc) f x
      = ∫ t : ℝ in Set.Ioi 0,
          Real.exp (-(c * t)) * Real.exp (-((t : ℝ) * m x)) * f x := by
    -- evaluate the Bochner integral at `x` through the continuous-linear evaluator
    rw [← BoundedContinuousFunction.evalCLM_apply (𝕜 := ℝ)]
    rw [StronglyContinuousSemigroup.resolvent_apply, ← hcomm]
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi ?_
    intro t ht
    have hu : ((t.toNNReal : ℝ≥0) : ℝ) = t := Real.coe_toNNReal t ht.le
    simp only
    rw [hpt t, StronglyContinuousSemigroup.ofMultiplication_apply_apply_apply, hu]
    ring
  rw [ContinuousLinearMap.mul_apply', BoundedContinuousFunction.mul_apply,
    BoundedContinuousFunction.coe_addInv, hstep1,
    MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
      fun t (_ : t ∈ Set.Ioi 0) => hnorm t,
    MeasureTheory.integral_const_mul]
  have hint : ∫ t : ℝ in Set.Ioi 0, Real.exp (-((c + m x) * t)) = (c + m x)⁻¹ := by
    simpa [pow_zero, one_mul] using
      integral_pow_mul_exp_neg_mul_Ioi 0
        (BoundedContinuousFunction.add_pos_of_norm_negPart_lt hc x)
  rw [hint]
  ring

/-- Through the bridge lemma `generator_resolvent_eq`, the concrete formula identifies the
resolvent of the generator: it is multiplication by the pointwise inverse `(λ + m)⁻¹`
for `λ > ‖m⁻‖`. -/
theorem StronglyContinuousSemigroup.ofMultiplication_generator_resolvent_eq (m : α →ᵇ ℝ)
    {c : ℝ} (hc : ‖m⁻‖ < c) :
    LinearPMap.resolvent (ofMultiplication m).generator c =
      ContinuousLinearMap.mul ℝ (α →ᵇ ℝ) (BoundedContinuousFunction.addInv c m hc) := by
  rw [generator_resolvent_eq _ (ofMultiplication_hasGrowthBound m) hc,
    ofMultiplication_resolvent_eq]

/-! ## The contraction case -/

/-- For a nonnegative multiplier `m ≥ 0`, the multiplication semigroup is contractive; in
particular the abstract bound `ContractionSemigroup.resolvent_norm_le` applies to it, giving
the concrete estimate `‖R(λ)‖ ≤ 1/λ` for `λ > 0`. -/
def ContractionSemigroup.ofMultiplication (m : α →ᵇ ℝ) (hm : 0 ≤ m) :
    ContractionSemigroup (α →ᵇ ℝ) where
  toStronglyContinuousSemigroup := StronglyContinuousSemigroup.ofMultiplication m
  contracting t := by
    have hneg : m⁻ = 0 := negPart_eq_zero.2 hm
    have hbound := (StronglyContinuousSemigroup.ofMultiplication_hasGrowthBound m).bound
      (t : ℝ) t.coe_nonneg
    rw [StronglyContinuousSemigroup.realOperator_coe, hneg, norm_zero, zero_mul, Real.exp_zero,
      one_mul] at hbound
    exact hbound

/-- The C₀-semigroup underlying the multiplication contraction semigroup is the multiplication
semigroup. -/
@[simp]
theorem ContractionSemigroup.ofMultiplication_toStronglyContinuousSemigroup
    (m : α →ᵇ ℝ) (hm : 0 ≤ m) :
    (ContractionSemigroup.ofMultiplication m hm).toStronglyContinuousSemigroup =
      StronglyContinuousSemigroup.ofMultiplication m := by
  rw [ContractionSemigroup.ofMultiplication]

/-- The operator of the multiplication contraction semigroup at time `t` is multiplication by
`e^{-t·m}`. -/
@[simp]
theorem ContractionSemigroup.ofMultiplication_apply (m : α →ᵇ ℝ) (hm : 0 ≤ m) (t : ℝ≥0) :
    ContractionSemigroup.ofMultiplication m hm t =
      ContinuousLinearMap.mul ℝ (α →ᵇ ℝ)
        (BoundedContinuousFunction.expNegMul (t : ℝ) m) := by
  rw [← ContractionSemigroup.toStronglyContinuousSemigroup_apply,
    ofMultiplication_toStronglyContinuousSemigroup,
    StronglyContinuousSemigroup.ofMultiplication_apply]

/-- The multiplication contraction semigroup acts on `f` by multiplication with `e^{-t·m}`. -/
theorem ContractionSemigroup.ofMultiplication_apply_apply (m : α →ᵇ ℝ) (hm : 0 ≤ m)
    (t : ℝ≥0) (f : α →ᵇ ℝ) :
    ContractionSemigroup.ofMultiplication m hm t f =
      BoundedContinuousFunction.expNegMul (t : ℝ) m * f := by
  rw [ofMultiplication_apply]
  exact ContinuousLinearMap.mul_apply' ℝ (α →ᵇ ℝ)
    (BoundedContinuousFunction.expNegMul (t : ℝ) m) f

/-- Pointwise action of the multiplication contraction semigroup. -/
theorem ContractionSemigroup.ofMultiplication_apply_apply_apply (m : α →ᵇ ℝ) (hm : 0 ≤ m)
    (t : ℝ≥0) (f : α →ᵇ ℝ) (x : α) :
    ContractionSemigroup.ofMultiplication m hm t f x =
      Real.exp (-((t : ℝ) * m x)) * f x := by
  rw [ofMultiplication_apply_apply, BoundedContinuousFunction.mul_apply,
    BoundedContinuousFunction.coe_expNegMul]

/-- The resolvent of the multiplication contraction semigroup is multiplication by
`(c + m)⁻¹`. -/
theorem ContractionSemigroup.ofMultiplication_resolvent_eq (m : α →ᵇ ℝ) (hm : 0 ≤ m)
    {c : ℝ} (hc : 0 < c) :
    (ContractionSemigroup.ofMultiplication m hm).resolvent c hc =
      ContinuousLinearMap.mul ℝ (α →ᵇ ℝ)
        (BoundedContinuousFunction.addInv c m (by
          rw [negPart_eq_zero.2 hm, norm_zero]
          exact hc)) := by
  have hneg : m⁻ = 0 := negPart_eq_zero.2 hm
  have hmc : ‖m⁻‖ < c := by simpa [hneg] using hc
  refine (ContractionSemigroup.resolvent_eq_stronglyContinuousSemigroup_resolvent
    (ContractionSemigroup.ofMultiplication m hm) c hc).trans ?_
  simp only [ofMultiplication_toStronglyContinuousSemigroup]
  simpa [hneg] using StronglyContinuousSemigroup.ofMultiplication_resolvent_eq m hmc

end Semigroups

end TauCeti
