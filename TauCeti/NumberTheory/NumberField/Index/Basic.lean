module

public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.LinearAlgebra.FreeModule.Finite.Quotient
public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.Adjoin.PowerBasis

/-!
# The index of an integral primitive element

An integral primitive element `θ` of a number field `K` generates a full-rank subring
`ℤ[θ]` of the ring of integers `𝓞 K`. Its *index* is the finite cardinality

`[𝓞 K : ℤ[θ]] = #(𝓞 K / ℤ[θ])`.

This file defines integral primitive elements and their index, proves that the defining
quotient is finite (and hence that the index is positive), and establishes the exact
invariances under translating the generator by an integer and negating it.

## Main definitions

* `TauCeti.NumberField.IntegralPrimitiveElement K`: integral elements generating `K` over `ℚ`.
* `TauCeti.NumberField.IntegralPrimitiveElement.index`: the index of `ℤ[θ]` in `𝓞 K`.

## Main results

* `TauCeti.NumberField.IntegralPrimitiveElement.finrank_adjoin`: `ℤ[θ]` has full rank in `𝓞 K`.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_pos`: the index is positive.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_addInt`: integer translation preserves
  the index.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_neg`: negation preserves the index.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter I, §2.
-/

public section

open scoped NumberField

namespace TauCeti.NumberField

variable {K : Type*} [Field K] [NumberField K]

/-- An integral primitive element of a number field `K`: an element of `𝓞 K` whose image in
`K` generates `K` as a `ℚ`-algebra. -/
@[expose]
def IntegralPrimitiveElement (K : Type*) [Field K] [NumberField K] : Type _ :=
  {θ : 𝓞 K // Algebra.adjoin ℚ {(θ : K)} = ⊤}

namespace IntegralPrimitiveElement

instance : Coe (IntegralPrimitiveElement K) (𝓞 K) :=
  ⟨Subtype.val⟩

/-- The `ℤ`-subalgebra of `𝓞 K` generated by an integral primitive element. -/
def adjoin (θ : IntegralPrimitiveElement K) : Subalgebra ℤ (𝓞 K) :=
  Algebra.adjoin ℤ {θ.1}

/-- The additive quotient of `𝓞 K` by the order `ℤ[θ]`. -/
abbrev Quotient (θ : IntegralPrimitiveElement K) :=
  𝓞 K ⧸ θ.adjoin.toSubmodule

/-- The index `[𝓞 K : ℤ[θ]]`, defined as the cardinality of the additive quotient. -/
noncomputable def index (θ : IntegralPrimitiveElement K) : ℕ :=
  Nat.card θ.Quotient

/-- The rank of `ℤ[θ]` is the degree of the integral minimal polynomial of `θ`. -/
theorem finrank_adjoin_eq_natDegree (θ : IntegralPrimitiveElement K) :
    Module.finrank ℤ θ.adjoin = (minpoly ℤ θ.1).natDegree := by
  exact (Algebra.adjoin.powerBasis' θ.1.isIntegral).finrank

/-- The integral and rational minimal polynomials of an integral primitive element have the
same degree. -/
theorem natDegree_minpoly_eq (θ : IntegralPrimitiveElement K) :
    (minpoly ℤ θ.1).natDegree = (minpoly ℚ (θ.1 : K)).natDegree := by
  rw [← _root_.NumberField.RingOfIntegers.minpoly_coe θ.1,
    minpoly.isIntegrallyClosed_eq_field_fractions' ℚ θ.1.isIntegral_coe,
    (minpoly.monic θ.1.isIntegral_coe).natDegree_map]

/-- The rational minimal polynomial of a primitive element has degree `[K : ℚ]`. -/
theorem natDegree_minpoly_eq_finrank (θ : IntegralPrimitiveElement K) :
    (minpoly ℚ (θ.1 : K)).natDegree = Module.finrank ℚ K := by
  let pb := PowerBasis.ofAdjoinEqTop θ.1.isIntegral_coe.tower_top θ.2
  calc
    (minpoly ℚ (θ.1 : K)).natDegree = pb.dim := by simp [pb]
    _ = Module.finrank ℚ K := pb.finrank.symm

/-- The order `ℤ[θ]` generated by an integral primitive element has full rank in `𝓞 K`. -/
theorem finrank_adjoin (θ : IntegralPrimitiveElement K) :
    Module.finrank ℤ θ.adjoin = Module.finrank ℤ (𝓞 K) := by
  rw [finrank_adjoin_eq_natDegree, natDegree_minpoly_eq,
    natDegree_minpoly_eq_finrank, _root_.NumberField.RingOfIntegers.rank]

/-- The quotient `𝓞 K / ℤ[θ]` is finite. -/
instance finite_quotient (θ : IntegralPrimitiveElement K) : Finite θ.Quotient :=
  Submodule.finiteQuotientOfFreeOfRankEq θ.adjoin.toSubmodule θ.finrank_adjoin

/-- The index of an integral primitive element is positive. -/
theorem index_pos (θ : IntegralPrimitiveElement K) : 0 < θ.index := by
  rw [index]
  exact Nat.card_pos

/-! ### Changing the generator -/

/-- Translating an integral primitive element by an integer gives another integral primitive
element. -/
@[expose]
def addInt (θ : IntegralPrimitiveElement K) (n : ℤ) : IntegralPrimitiveElement K :=
  ⟨θ.1 + algebraMap ℤ (𝓞 K) n, by
    change Algebra.adjoin ℚ {(θ.1 : K) + (n : K)} = ⊤
    have h : Algebra.adjoin ℚ {(θ.1 : K) + (n : K)} =
        Algebra.adjoin ℚ {(θ.1 : K)} := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        exact (Algebra.adjoin ℚ {(θ.1 : K)}).add_mem
          (Algebra.subset_adjoin (Set.mem_singleton (θ.1 : K)))
          ((Algebra.adjoin ℚ {(θ.1 : K)}).intCast_mem n)
      · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        simpa using (Algebra.adjoin ℚ {(θ.1 : K) + (n : K)}).sub_mem
          (Algebra.subset_adjoin (Set.mem_singleton ((θ.1 : K) + (n : K))))
          ((Algebra.adjoin ℚ {(θ.1 : K) + (n : K)}).intCast_mem n)
    exact h.trans θ.2⟩

@[simp]
theorem coe_addInt (θ : IntegralPrimitiveElement K) (n : ℤ) :
    (θ.addInt n : 𝓞 K) = θ.1 + algebraMap ℤ (𝓞 K) n :=
  rfl

/-- Integer translation does not change the generated `ℤ`-subalgebra. -/
@[simp]
theorem adjoin_addInt (θ : IntegralPrimitiveElement K) (n : ℤ) :
    (θ.addInt n).adjoin = θ.adjoin := by
  apply le_antisymm
  · rw [adjoin, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    exact (θ.adjoin.add_mem (Algebra.subset_adjoin (Set.mem_singleton θ.1)))
      (θ.adjoin.algebraMap_mem n)
  · rw [adjoin, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    simpa [addInt] using
      ((θ.addInt n).adjoin.sub_mem
        (Algebra.subset_adjoin (Set.mem_singleton (θ.addInt n).1))
        ((θ.addInt n).adjoin.algebraMap_mem n))

/-- Translating an integral primitive element by an integer preserves its index. -/
@[simp]
theorem index_addInt (θ : IntegralPrimitiveElement K) (n : ℤ) :
    (θ.addInt n).index = θ.index := by
  change Nat.card (𝓞 K ⧸ (θ.addInt n).adjoin.toSubmodule) =
    Nat.card (𝓞 K ⧸ θ.adjoin.toSubmodule)
  rw [adjoin_addInt]

/-- Negating an integral primitive element gives another integral primitive element. -/
@[expose]
protected def neg (θ : IntegralPrimitiveElement K) : IntegralPrimitiveElement K :=
  ⟨-θ.1, by
    change Algebra.adjoin ℚ {-((θ.1 : K))} = ⊤
    have h : Algebra.adjoin ℚ {-((θ.1 : K))} = Algebra.adjoin ℚ {(θ.1 : K)} := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        exact (Algebra.adjoin ℚ {(θ.1 : K)}).neg_mem
          (Algebra.subset_adjoin (Set.mem_singleton (θ.1 : K)))
      · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        simpa using (Algebra.adjoin ℚ {(-(θ.1 : K))}).neg_mem
          (Algebra.subset_adjoin (Set.mem_singleton (-(θ.1 : K))))
    exact h.trans θ.2⟩

instance : Neg (IntegralPrimitiveElement K) :=
  ⟨IntegralPrimitiveElement.neg⟩

@[simp]
theorem coe_neg (θ : IntegralPrimitiveElement K) :
    ((-θ : IntegralPrimitiveElement K) : 𝓞 K) = -θ.1 :=
  rfl

/-- Negation does not change the generated `ℤ`-subalgebra. -/
@[simp]
theorem adjoin_neg (θ : IntegralPrimitiveElement K) : (-θ).adjoin = θ.adjoin := by
  apply le_antisymm
  · rw [adjoin, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    exact θ.adjoin.neg_mem (Algebra.subset_adjoin (Set.mem_singleton θ.1))
  · rw [adjoin, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    simpa using (-θ).adjoin.neg_mem
      (Algebra.subset_adjoin (Set.mem_singleton ((-θ).1)))

/-- Negating an integral primitive element preserves its index. -/
@[simp]
theorem index_neg (θ : IntegralPrimitiveElement K) : (-θ).index = θ.index := by
  change Nat.card (𝓞 K ⧸ (-θ).adjoin.toSubmodule) =
    Nat.card (𝓞 K ⧸ θ.adjoin.toSubmodule)
  rw [adjoin_neg]

end IntegralPrimitiveElement

end TauCeti.NumberField
