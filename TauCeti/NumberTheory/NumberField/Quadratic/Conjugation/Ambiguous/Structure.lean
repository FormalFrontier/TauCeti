module

public import TauCeti.NumberTheory.NumberField.Quadratic.Conjugation.Norm
public import TauCeti.NumberTheory.NumberField.RamifiedPrimes
public import TauCeti.NumberTheory.NumberField.TotallyPositive
import TauCeti.NumberTheory.NumberField.Quadratic.Conjugation.Ambiguous.Basic
import TauCeti.NumberTheory.NumberField.Quadratic.Inert
import TauCeti.NumberTheory.NumberField.Quadratic.TotalRamification
import Mathlib.RingTheory.Ideal.Int

/-!
# The structure of an ambiguous ideal of a quadratic field

Let `K` be a quadratic number field with quadratic conjugation `σ`. An ideal `I` of `𝓞 K` is
*ambiguous* when `σI = I`. This file describes the *nonzero* ambiguous ideals completely: they are
exactly the products

`I = n 𝓞 K · ∏_{p ∈ s} 𝔭_p`

of a positive rational integer with a product of **distinct** primes above ramified rational primes.
The zero ideal is ambiguous as well, but it is not of this form, every such product being nonzero.

The proof is an induction on the absolute norm, peeling off at each step a conjugation-stable
divisor of one of two shapes. Let `𝔭` be a maximal ideal containing `I` and `p` the rational prime
below it.

* `σ𝔭 = 𝔭` and `p` ramifies. Then `𝔭` is the *only* prime of `𝓞 K` above `p`
  (`NumberField.primesOver_eq_singleton_of_mem_ramifiedPrimes`), so it is the chosen prime `Q p`.
* `σ𝔭 = 𝔭` and `p` does not ramify. Then `p` is inert and `𝔭 = p 𝓞 K`
  (`NumberField.map_span_eq_of_notMem_ramifiedPrimes`).
* `σ𝔭 ≠ 𝔭`. Then `𝔭` and `σ𝔭` are distinct maximal ideals, hence coprime, and both divide `I`
  because `I` is ambiguous; so their product divides `I`, and that product is `N(𝔭) 𝓞 K`
  (`NumberField.mul_map_ringOfIntegersQuadraticConj_eq_map_relNorm` together with
  `Ideal.relNorm_int`).

Repeated ramified primes are absorbed into the rational factor through `𝔭_p ^ 2 = p 𝓞 K`
(`NumberField.map_span_eq_sq_of_mem_ramifiedPrimes`), which is what makes the exponents in the
product squarefree.

Everything here is **signature-free**: the rational factor is generated by a *positive* natural
number, hence by a totally positive element
(`exists_isTotallyPositive_and_eq_span_singleton_mul_prod_of_map_eq_self`). So the description feeds
the narrow class group `Cl⁺(K)` exactly as it feeds the ordinary one, and it is the ordinary
consequence — the class of an ambiguous ideal is a product of classes of ramified primes
(`NumberField.classGroupMk0_mem_closure_of_map_eq_self`) — that gives the genus-theoretic upper
bound `2-rank ≤ t - 1` of `TauCeti.Multiquadratic.twoRank_le_ncard_ramifiedPrimes_sub_one`.

See F. Lemmermeyer, *Reciprocity Laws: From Euler to Eisenstein*, §2.2, and D. A. Cox, *Primes of
the Form x² + ny²*, §6.A, for the classical ambiguous class number formula this description opens.

## Main results

* `NumberField.exists_eq_span_singleton_mul_prod_of_map_eq_self`: a nonzero ambiguous ideal is a
  positive rational integer times a product of distinct primes above ramified rational primes.
* `NumberField.map_eq_self_of_eq_span_singleton_mul_prod`: the converse, that every such product is
  ambiguous.
* `NumberField.map_eq_self_iff_exists_eq_span_singleton_mul_prod`: the resulting characterisation of
  the nonzero ambiguous ideals.
* `NumberField.exists_isTotallyPositive_and_eq_span_singleton_mul_prod_of_map_eq_self`: the form the
  narrow class group consumes for a nonzero ambiguous ideal, with the rational factor replaced by a
  totally positive generator.
-/

public section

open Polynomial Ideal Module
open scoped NumberField

namespace NumberField

variable {K : Type*} [Field K] [NumberField K] {θ : 𝓞 K} {d : ℤ} {Q : ℕ → Ideal (𝓞 K)}

omit [NumberField K] in
/-- The ideal of `𝓞 K` generated by a natural number is the extension of the ideal it generates
in `ℤ`. -/
private theorem map_span_intCast_eq_span_natCast (a : ℕ) :
    Ideal.map (algebraMap ℤ (𝓞 K)) (span {(a : ℤ)}) = span {(a : 𝓞 K)} := by
  rw [Ideal.map_span, Set.image_singleton]
  norm_num

/-- Dividing an ideal fixed by a ring automorphism by a fixed divisor leaves a fixed quotient, and
splits the absolute norm. -/
private theorem exists_quotient_of_dvd {σ : 𝓞 K ≃+* 𝓞 K} {I A : Ideal (𝓞 K)} (hI0 : I ≠ 0)
    (hI : Ideal.map σ I = I) (hA : Ideal.map σ A = A) (hdvd : A ∣ I) :
    ∃ J : Ideal (𝓞 K), J ≠ 0 ∧ Ideal.map σ J = J ∧ I = A * J ∧
      Ideal.absNorm I = Ideal.absNorm A * Ideal.absNorm J := by
  obtain ⟨J, hJ⟩ := hdvd
  have hA0 : A ≠ 0 := by rintro rfl; exact hI0 (by rw [hJ, zero_mul])
  have hJ0 : J ≠ 0 := by rintro rfl; exact hI0 (by rw [hJ, mul_zero])
  refine ⟨J, hJ0, ?_, hJ, by rw [hJ, map_mul]⟩
  refine mul_left_cancel₀ hA0 ?_
  have hmap := congrArg (Ideal.map σ) hJ
  rw [hI, Ideal.map_mul, hA] at hmap
  exact hmap.symm.trans hJ

variable (hmin : minpoly ℤ θ = X ^ 2 - C d) (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤)
  (hprime : ∀ p ∈ ramifiedPrimes K, (Q p).IsPrime)
  (hover : ∀ p ∈ ramifiedPrimes K, (Q p).LiesOver (span {(p : ℤ)}))

include hmin hgen hprime hover

/-- The induction behind `exists_eq_span_singleton_mul_prod_of_map_eq_self`, on a bound for the
absolute norm of the ambiguous ideal. -/
private theorem exists_eq_span_singleton_mul_prod_aux (n : ℕ) :
    ∀ I : Ideal (𝓞 K), I ≠ 0 → Ideal.absNorm I ≤ n →
      Ideal.map (ringOfIntegersQuadraticConj hmin hgen) I = I →
      ∃ m : ℕ, 0 < m ∧ ∃ s : Finset ℕ, ↑s ⊆ ramifiedPrimes K ∧
        I = span {(m : 𝓞 K)} * ∏ p ∈ s, Q p := by
  set σ := ringOfIntegersQuadraticConj hmin hgen with hσdef
  have hK : finrank ℚ K = 2 := finrank_rat_eq_two hmin hgen
  have hne1 : quadraticConj hmin hgen ≠ 1 := quadraticConj_ne_one hmin hgen
  have hinv : Function.Involutive σ := ringOfIntegersQuadraticConj_involutive hmin hgen
  induction n with
  | zero =>
      intro I hI0 hle _
      exact absurd (Ideal.absNorm_eq_zero_iff.mp (Nat.le_zero.mp hle)) hI0
  | succ n ih =>
      intro I hI0 hle hI
      by_cases htop : I = ⊤
      · exact ⟨1, one_pos, ∅, by simp, by simp [htop]⟩
      -- It suffices to peel off a fixed proper divisor of one of the two admissible shapes.
      suffices hsuff : ∃ A : Ideal (𝓞 K), A ≠ 0 ∧ Ideal.map σ A = A ∧ A ∣ I ∧ A ≠ ⊤ ∧
          ((∃ a : ℕ, A = span {(a : 𝓞 K)}) ∨ ∃ p ∈ ramifiedPrimes K, A = Q p) by
        obtain ⟨A, hA0, hAfix, hAdvd, hAtop, hAshape⟩ := hsuff
        obtain ⟨J, hJ0, hJfix, hIAJ, hnorm⟩ := exists_quotient_of_dvd hI0 hI hAfix hAdvd
        have h2A : 2 ≤ Ideal.absNorm A := by
          have h0 : Ideal.absNorm A ≠ 0 := fun h ↦ hA0 (Ideal.absNorm_eq_zero_iff.mp h)
          have h1 : Ideal.absNorm A ≠ 1 := fun h ↦ hAtop (Ideal.absNorm_eq_one_iff.mp h)
          omega
        have h1J : 1 ≤ Ideal.absNorm J := by
          have h0 : Ideal.absNorm J ≠ 0 := fun h ↦ hJ0 (Ideal.absNorm_eq_zero_iff.mp h)
          omega
        have hJle : Ideal.absNorm J ≤ n := by
          have : 2 * Ideal.absNorm J ≤ Ideal.absNorm I := hnorm ▸ Nat.mul_le_mul_right _ h2A
          omega
        obtain ⟨m, hm0, s, hs, rfl⟩ := ih J hJ0 hJle hJfix
        rcases hAshape with ⟨a, rfl⟩ | ⟨p, hp, rfl⟩
        · -- A rational factor merges with the rational factor of the quotient.
          have ha0 : a ≠ 0 := by rintro rfl; exact hA0 (by simp)
          refine ⟨a * m, Nat.mul_pos (Nat.pos_of_ne_zero ha0) hm0, s, hs, ?_⟩
          rw [hIAJ, ← mul_assoc, Ideal.span_singleton_mul_span_singleton]
          norm_cast
        · -- A ramified prime is either new, or squares off into the rational factor.
          have := hprime p hp
          have := hover p hp
          by_cases hps : p ∈ s
          · have hsq : Q p * Q p = span {(p : 𝓞 K)} := by
              rw [← sq, ← map_span_eq_sq_of_mem_ramifiedPrimes hK hp (Q p),
                map_span_intCast_eq_span_natCast]
            have hspan : span {((m * p : ℕ) : 𝓞 K)} =
                span {(m : 𝓞 K)} * span {(p : 𝓞 K)} := by
              rw [Ideal.span_singleton_mul_span_singleton]
              norm_cast
            refine ⟨m * p, Nat.mul_pos hm0 (prime_of_mem_ramifiedPrimes hp).pos,
              s.erase p, hs.trans' (by simp), ?_⟩
            rw [hIAJ, ← Finset.mul_prod_erase _ _ hps, hspan, ← hsq]
            ring
          · exact ⟨m, hm0, insert p s, by
              rw [Finset.coe_insert, Set.insert_subset_iff]; exact ⟨hp, hs⟩,
              by rw [hIAJ, Finset.prod_insert hps, ← mul_assoc, mul_comm (Q p) _, mul_assoc]⟩
      -- A maximal ideal containing `I`, and the rational prime below it.
      obtain ⟨𝔭, h𝔭max, h𝔭le⟩ := Ideal.exists_le_maximal _ htop
      have h𝔭prime : 𝔭.IsPrime := h𝔭max.isPrime
      have h𝔭0 : 𝔭 ≠ 0 := by rintro rfl; exact hI0 (le_bot_iff.mp h𝔭le)
      have h𝔭nz : NeZero 𝔭 := ⟨h𝔭0⟩
      have h𝔭top : 𝔭 ≠ ⊤ := h𝔭max.ne_top
      have hdvd𝔭 : 𝔭 ∣ I := Ideal.dvd_iff_le.mpr h𝔭le
      obtain ⟨p, hpprime, hlo⟩ : ∃ p : ℕ, p.Prime ∧ 𝔭.LiesOver (span {(p : ℤ)}) :=
        ⟨Ideal.absNorm (Ideal.under ℤ 𝔭), Nat.absNorm_under_prime 𝔭, inferInstance⟩
      by_cases hfix : Ideal.map σ 𝔭 = 𝔭
      · refine ⟨𝔭, h𝔭0, hfix, hdvd𝔭, h𝔭top, ?_⟩
        by_cases hram : p ∈ ramifiedPrimes K
        · -- `𝔭` is the unique prime above a ramified rational prime, so it is `Q p`.
          have := hprime p hram
          have := hover p hram
          have hmem : 𝔭 ∈ (span {(p : ℤ)} : Ideal ℤ).primesOver (𝓞 K) := ⟨h𝔭prime, hlo⟩
          rw [primesOver_eq_singleton_of_mem_ramifiedPrimes hK hram (Q p),
            Set.mem_singleton_iff] at hmem
          exact Or.inr ⟨p, hram, hmem⟩
        · -- `p` is inert, so `𝔭` is generated by `p`.
          refine Or.inl ⟨p, ?_⟩
          rw [← map_span_eq_of_notMem_ramifiedPrimes hK hpprime hram hne1
            (coe_ringOfIntegersQuadraticConj hmin hgen) 𝔭 hfix,
            map_span_intCast_eq_span_natCast]
      · -- `𝔭` and `σ𝔭` are distinct primes, and their product is generated by `N 𝔭`.
        have hmap0 : Ideal.map σ 𝔭 ≠ 0 := by
          rw [ne_eq, Ideal.zero_eq_bot, Ideal.map_eq_bot_iff_of_injective σ.injective,
            ← Ideal.zero_eq_bot]
          exact h𝔭0
        have hmapprime : (Ideal.map σ 𝔭).IsPrime := inferInstance
        have hmapmax : (Ideal.map σ 𝔭).IsMaximal :=
          hmapprime.isMaximal (by rwa [← Ideal.zero_eq_bot])
        have hco : IsCoprime 𝔭 (Ideal.map σ 𝔭) :=
          Ideal.isCoprime_of_isMaximal fun h ↦ hfix h.symm
        obtain ⟨J', hJ'⟩ := id hdvd𝔭
        have hdvdσ : Ideal.map σ 𝔭 ∣ I := ⟨Ideal.map σ J', by rw [← Ideal.map_mul, ← hJ', hI]⟩
        refine ⟨𝔭 * Ideal.map σ 𝔭, mul_ne_zero h𝔭0 hmap0, ?_, hco.mul_dvd hdvd𝔭 hdvdσ, ?_,
          Or.inl ⟨Ideal.absNorm 𝔭, ?_⟩⟩
        · rw [Ideal.map_mul, Ideal.map_map_of_involutive hinv, mul_comm]
        · intro hAtop
          have hml : 𝔭 * Ideal.map σ 𝔭 ≤ 𝔭 := Ideal.mul_le_left
          rw [hAtop, top_le_iff] at hml
          exact h𝔭top hml
        · rw [hσdef, mul_map_ringOfIntegersQuadraticConj_eq_map_relNorm hmin hgen,
            Ideal.relNorm_int, map_span_intCast_eq_span_natCast]

omit hmin hgen in
/-- **Every rational multiple of a product of ramified primes is fixed by any automorphism.** The
converse half of `map_eq_self_iff_exists_eq_span_singleton_mul_prod`: a ring automorphism fixes the
ideal generated by a rational integer, and fixes each prime above a ramified rational prime, since
there is only one such prime. -/
theorem map_eq_self_of_eq_span_singleton_mul_prod (hK : finrank ℚ K = 2)
    (σ : 𝓞 K ≃+* 𝓞 K) (m : ℕ) {s : Finset ℕ}
    (hs : ↑s ⊆ ramifiedPrimes K) :
    Ideal.map σ (span {(m : 𝓞 K)} * ∏ p ∈ s, Q p) =
      span {(m : 𝓞 K)} * ∏ p ∈ s, Q p := by
  classical
  have hprod : ∀ t : Finset ℕ, ↑t ⊆ ramifiedPrimes K →
      Ideal.map σ (∏ p ∈ t, Q p) = ∏ p ∈ t, Q p := by
    intro t
    induction t using Finset.induction with
    | empty => intro _; rw [Finset.prod_empty, Ideal.one_eq_top, Ideal.map_top]
    | insert q t hq iht =>
        intro ht
        have hqmem : q ∈ ramifiedPrimes K := ht (by simp)
        have := hprime q hqmem
        have := hover q hqmem
        rw [Finset.prod_insert hq, Ideal.map_mul,
          map_eq_self_of_mem_ramifiedPrimes hK hqmem (Q q) σ,
          iht (ht.trans' (by simp))]
  rw [Ideal.map_mul, hprod s hs, Ideal.map_span, Set.image_singleton, map_natCast]

/-- **The structure of an ambiguous ideal.** Let `K` be a quadratic number field with quadratic
conjugation `σ`, and let `Q p` be a prime of `𝓞 K` above each ramified rational prime `p`. A nonzero
ideal `I` with `σI = I` is a positive rational integer times a product of *distinct* primes above
ramified rational primes: `I = m 𝓞 K · ∏_{p ∈ s} Q p`.

The exponents are squarefree because `Q p ^ 2 = p 𝓞 K` absorbs a repeated ramified prime into the
rational factor. -/
theorem exists_eq_span_singleton_mul_prod_of_map_eq_self {I : Ideal (𝓞 K)} (hI0 : I ≠ 0)
    (hI : Ideal.map (ringOfIntegersQuadraticConj hmin hgen) I = I) :
    ∃ m : ℕ, 0 < m ∧ ∃ s : Finset ℕ, ↑s ⊆ ramifiedPrimes K ∧
      I = span {(m : 𝓞 K)} * ∏ p ∈ s, Q p :=
  exists_eq_span_singleton_mul_prod_aux hmin hgen hprime hover _ I hI0 le_rfl hI

/-- **The ambiguous ideals of a quadratic field.** A nonzero ideal of `𝓞 K` is fixed by quadratic
conjugation exactly when it is a positive rational integer times a product of distinct primes above
ramified rational primes. -/
theorem map_eq_self_iff_exists_eq_span_singleton_mul_prod {I : Ideal (𝓞 K)} (hI0 : I ≠ 0) :
    Ideal.map (ringOfIntegersQuadraticConj hmin hgen) I = I ↔
      ∃ m : ℕ, 0 < m ∧ ∃ s : Finset ℕ, ↑s ⊆ ramifiedPrimes K ∧
        I = span {(m : 𝓞 K)} * ∏ p ∈ s, Q p :=
  ⟨exists_eq_span_singleton_mul_prod_of_map_eq_self hmin hgen hprime hover hI0,
    fun ⟨_, _, _, hs, hIeq⟩ ↦ by
      rw [hIeq]
      exact map_eq_self_of_eq_span_singleton_mul_prod hprime hover
        (finrank_rat_eq_two hmin hgen) (ringOfIntegersQuadraticConj hmin hgen) _ hs⟩

/-- **An ambiguous ideal is a totally positive principal ideal times ramified primes.** The
signature-free form of `exists_eq_span_singleton_mul_prod_of_map_eq_self`: the rational factor is
generated by a *positive* natural number, hence by a totally positive element. This is what the
narrow class group `Cl⁺(K)` consumes, where the ordinary class group only needs the generator to
exist. -/
theorem exists_isTotallyPositive_and_eq_span_singleton_mul_prod_of_map_eq_self
    {I : Ideal (𝓞 K)} (hI0 : I ≠ 0)
    (hI : Ideal.map (ringOfIntegersQuadraticConj hmin hgen) I = I) :
    ∃ α : 𝓞 K, α ≠ 0 ∧ IsTotallyPositive (α : K) ∧
      ∃ s : Finset ℕ, ↑s ⊆ ramifiedPrimes K ∧ I = span {α} * ∏ p ∈ s, Q p := by
  obtain ⟨m, hm0, s, hs, hIeq⟩ :=
    exists_eq_span_singleton_mul_prod_of_map_eq_self hmin hgen hprime hover hI0 hI
  refine ⟨(m : 𝓞 K), Nat.cast_ne_zero.mpr hm0.ne', isTotallyPositive_iff.mpr fun w hw => ?_,
    s, hs, hIeq⟩
  have hcast : ((m : 𝓞 K) : K) = (m : K) := by norm_cast
  rw [hcast, map_natCast]
  exact_mod_cast hm0

end NumberField
