module

public import Mathlib.NumberTheory.NumberField.Basic
public import TauCeti.RingTheory.DedekindDomain.Factorization
public import TauCeti.RingTheory.DedekindDomain.Ideal

/-!
# Fractional ideals away from finitely many primes

For a number field `K` and a finite set `S` of its finite places, this file defines the subgroup
`idealsAway S` of invertible fractional ideals whose multiplicity vanishes at every member of
`S`. It proves that this subgroup is generated by the prime ideals outside `S` and supplies the
inclusion induced by enlarging `S`.

The integral counterpart `integralIdealsAway S` consists of the nonzero integral ideals divisible
by no prime in `S`. Its map to `idealsAway S` is the restriction of Mathlib's
`FractionalIdeal.mk0`.

The generation proof transports Mathlib's unique factorization of a nonzero fractional ideal,
`FractionalIdeal.finprod_heightOneSpectrum_factorization'`, to fractional-ideal units.

## Main definitions

* `NumberFieldArithmetic.idealsAway`: unit fractional ideals trivial at the primes in `S`.
* `NumberFieldArithmetic.idealsAwayInclusion`: inclusion obtained from `S ⊆ S'`.
* `NumberFieldArithmetic.integralIdealsAway`: nonzero integral ideals prime to `S`.
* `NumberFieldArithmetic.integralIdealsAwayHom`: the map from integral to fractional ideals.

## References

The shared lift of fractional-ideal factorization to units,
`FractionalIdeal.finprod_unitOfPrime_zpow_count`, is also used by
`TauCeti.RingTheory.ClassGroup.HeightOneSpectrum`. It is adapted from Michael Stoll's
`EllipticCurves/Mathlib/FractionalIdeal.lean` at commit `66889eada51a` of the
`MichaelStollBayreuth/EllipticCurves` repository (Apache 2.0).
-/

public section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum NumberField
open scoped nonZeroDivisors NumberField

namespace TauCeti.NumberFieldArithmetic

variable {K : Type*} [Field K] [NumberField K]

/-- The subgroup of invertible fractional ideals whose multiplicity vanishes at every prime in
`S`. -/
def idealsAway (S : Finset (HeightOneSpectrum (𝓞 K))) :
    Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ where
  carrier := {I | ∀ v ∈ S, FractionalIdeal.count K v (I : FractionalIdeal (𝓞 K)⁰ K) = 0}
  one_mem' := fun v _ ↦ FractionalIdeal.count_one K v
  mul_mem' := by
    intro I J hI hJ v hv
    rw [Units.val_mul, FractionalIdeal.count_mul K v (Units.ne_zero I) (Units.ne_zero J),
      hI v hv, hJ v hv, add_zero]
  inv_mem' := by
    intro I hI v hv
    rw [Units.val_inv_eq_inv_val, FractionalIdeal.count_inv, hI v hv, neg_zero]

/-- Membership in `idealsAway S` means vanishing multiplicity at every prime in `S`. -/
@[simp]
theorem mem_idealsAway_iff {S : Finset (HeightOneSpectrum (𝓞 K))}
    {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ} :
    I ∈ idealsAway S ↔
      ∀ v ∈ S, FractionalIdeal.count K v (I : FractionalIdeal (𝓞 K)⁰ K) = 0 :=
  Iff.rfl

/-- Enlarging the excluded set of primes shrinks the group of fractional ideals away from it. -/
theorem idealsAway_antitone {S S' : Finset (HeightOneSpectrum (𝓞 K))} (h : S ⊆ S') :
    idealsAway (K := K) S' ≤ idealsAway (K := K) S := by
  intro I hI v hv
  exact hI v (h hv)

/-- The inclusion of fractional ideals away from `S'` into those away from `S`, for `S ⊆ S'`. -/
def idealsAwayInclusion {S S' : Finset (HeightOneSpectrum (𝓞 K))} (h : S ⊆ S') :
    idealsAway (K := K) S' →* idealsAway (K := K) S :=
  Subgroup.inclusion (idealsAway_antitone h)

/-- The inclusion between groups of ideals away from finite sets does not change the underlying
fractional ideal. -/
@[simp]
theorem coe_idealsAwayInclusion {S S' : Finset (HeightOneSpectrum (𝓞 K))} (h : S ⊆ S')
    (I : idealsAway (K := K) S') :
    ((idealsAwayInclusion h I : idealsAway (K := K) S) :
        (FractionalIdeal (𝓞 K)⁰ K)ˣ) = I := by
  simpa only [idealsAwayInclusion] using
    Subgroup.coe_inclusion (idealsAway_antitone h) I

/-- `idealsAway S` is generated by the height-one prime ideals outside `S`. -/
theorem idealsAway_eq_closure_primes (S : Finset (HeightOneSpectrum (𝓞 K))) :
    idealsAway S = Subgroup.closure {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ |
      ∃ v : HeightOneSpectrum (𝓞 K), v ∉ S ∧
        ((I : FractionalIdeal (𝓞 K)⁰ K) =
          (v.asIdeal : FractionalIdeal (𝓞 K)⁰ K))} := by
  apply le_antisymm
  · intro I hI
    classical
    have hfin := FractionalIdeal.hasFiniteMulSupport_unitOfPrime_zpow (K := K) I
    rw [FractionalIdeal.finprod_unitOfPrime_zpow_count I,
      finprod_eq_prod_of_mulSupport_toFinset_subset _ hfin (Finset.Subset.refl _)]
    refine Subgroup.prod_mem _ fun v hv ↦ Subgroup.zpow_mem _ (Subgroup.subset_closure ?_) _
    refine ⟨v, ?_, v.coe_unitOfPrime K⟩
    intro hvS
    exact (hfin.mem_toFinset.mp hv) (by simp only [hI v hvS, zpow_zero])
  · refine (Subgroup.closure_le _).mpr ?_
    rintro I ⟨v, hv, hI⟩ w hw
    have hwv : w ≠ v := fun hwv ↦ hv (hwv ▸ hw)
    rw [hI, FractionalIdeal.count_maximal_coprime K w hwv.symm]

/-- The monoid of nonzero integral ideals divisible by no prime in `S`. -/
def integralIdealsAway (S : Finset (HeightOneSpectrum (𝓞 K))) : Submonoid (Ideal (𝓞 K)) where
  carrier := {I | Ideal.IsPrimeTo I (S : Set (HeightOneSpectrum (𝓞 K)))}
  one_mem' := by
    -- Submonoid membership here reduces to the set-builder carrier in the definition above.
    change Ideal.IsPrimeTo (1 : Ideal (𝓞 K)) (S : Set _)
    simpa only [Ideal.one_eq_top] using
      (Ideal.isPrimeTo_top : Ideal.IsPrimeTo (⊤ : Ideal (𝓞 K)) (S : Set _))
  mul_mem' := fun hI hJ ↦ Ideal.isPrimeTo_mul_iff.mpr ⟨hI, hJ⟩

/-- Membership in `integralIdealsAway S` is nonvanishing together with divisibility by no prime
in `S`. -/
@[simp]
theorem mem_integralIdealsAway_iff {S : Finset (HeightOneSpectrum (𝓞 K))}
    {I : Ideal (𝓞 K)} :
    I ∈ integralIdealsAway S ↔ I ≠ ⊥ ∧ ∀ v ∈ S, ¬ v.asIdeal ∣ I := by
  -- Expose the set-builder carrier so the shared characterization applies directly.
  change Ideal.IsPrimeTo I (S : Set (HeightOneSpectrum (𝓞 K))) ↔ _
  exact Ideal.isPrimeTo_iff

/-- Membership in `integralIdealsAway S` is equivalently nonvanishing and vanishing fractional
ideal multiplicity at every prime in `S`. -/
theorem mem_integralIdealsAway_iff_count_eq_zero {S : Finset (HeightOneSpectrum (𝓞 K))}
    {I : Ideal (𝓞 K)} :
    I ∈ integralIdealsAway S ↔ I ≠ ⊥ ∧
      ∀ v ∈ S, FractionalIdeal.count K v (I : FractionalIdeal (𝓞 K)⁰ K) = 0 := by
  rw [mem_integralIdealsAway_iff]
  refine and_congr_right fun hI ↦ forall_congr' fun v ↦ forall_congr' fun _ ↦ ?_
  rw [FractionalIdeal.count_coe K v hI]
  simp only [Int.natCast_eq_zero]
  simpa only [not_ne_iff] using
    (not_congr (Associates.count_ne_zero_iff_dvd hI v.irreducible)).symm

/-- Map a nonzero integral ideal away from `S` to its invertible fractional ideal. -/
noncomputable def integralIdealsAwayHom (S : Finset (HeightOneSpectrum (𝓞 K))) :
    integralIdealsAway (K := K) S →* idealsAway (K := K) S where
  toFun I := ⟨FractionalIdeal.mk0 K
      ⟨I, mem_nonZeroDivisors_iff_ne_zero.mpr I.2.ne_bot⟩,
    (mem_integralIdealsAway_iff_count_eq_zero.mp I.2).2⟩
  map_one' := by
    apply Subtype.ext
    exact (FractionalIdeal.mk0 (R := 𝓞 K) K).map_one
  map_mul' I J := by
    apply Subtype.ext
    exact (FractionalIdeal.mk0 (R := 𝓞 K) K).map_mul
      ⟨I, mem_nonZeroDivisors_iff_ne_zero.mpr I.2.ne_bot⟩
      ⟨J, mem_nonZeroDivisors_iff_ne_zero.mpr J.2.ne_bot⟩

/-- The integral-to-fractional map does not change the underlying ideal. -/
@[simp]
theorem coe_integralIdealsAwayHom (S : Finset (HeightOneSpectrum (𝓞 K)))
    (I : integralIdealsAway (K := K) S) :
    (((integralIdealsAwayHom S I : idealsAway (K := K) S) :
        (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) = I := by
  -- Both codomain subtypes coerce away; expose the resulting `mk0` expression explicitly.
  change ((FractionalIdeal.mk0 (R := 𝓞 K) K _ :
    (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) = I
  exact FractionalIdeal.coe_mk0 (R := 𝓞 K) K _

end TauCeti.NumberFieldArithmetic
