import Mathlib.FieldTheory.PrimitiveElement

/-!
# An exponent-two Galois extension is multiquadratic

`TauCeti/NumberTheory/Multiquadratic/Galois` shows that adjoining square roots of a square-class
independent family gives a Galois extension (`TauCeti.Multiquadratic.isGalois`) whose group has
exponent two (`TauCeti.Multiquadratic.aut_exponent_dvd_two`), while
`TauCeti/NumberTheory/Multiquadratic/Degree` computes its degree as `2ⁿ`
(`TauCeti.Multiquadratic.finrank_adjoin_range`). This file proves the **converse**, which is
exponent-two Kummer theory: over a field where `2 ≠ 0`, a finite Galois extension whose group has
exponent two is generated by square roots of elements of the base field, and one can take the
radicands square-class independent, so the degree is again `2ⁿ`.

The argument is the Galois correspondence plus one linear-algebra fact about the group, in the
elementary form `TauCeti.exists_index_eq_two_notMem_of_exponent_two`: an elementary abelian
`2`-group is separated
by its index-two subgroups. If some `σ ≠ 1` fixed every square root, pick an index-two subgroup `H`
missing `σ`; Mathlib's Galois correspondence shows that its fixed field is quadratic over `K`,
hence generated by a square root
(`TauCeti.IntermediateField.exists_sq_mem_range_adjoin_simple_eq_of_finrank_eq_two`, where
completing the square is what needs `2 ≠ 0`), so `σ` fixes it and therefore lies in `H` — a
contradiction. So the square roots generate, and finite-dimensionality cuts the generating set
down to a finite one.

Square-class independence is then a *minimality* statement rather than extra work: choosing a
generating set of square roots of least cardinality, a square subset product would express one of
its members through the others, and dropping it would give a smaller generating set. Feeding the
independent family back into `TauCeti.Multiquadratic.finrank_adjoin_range` gives `[L : K] = 2ⁿ`.

This is the ingredient the genus-field milestone of `TauCetiRoadmap/Multiquadratic/README.md`
(Layer 3) calls for. The maximality half of the identification of `candidateGenusField` with the
genus field starts from an extension `M` of `K = ℚ(√d)` that is unramified everywhere and abelian
over `ℚ`; because `ℚ` has no unramified extension, the inertia subgroups generate `Gal(M/ℚ)` and
each of them meets `Gal(M/K)` trivially, so `Gal(M/ℚ)` has exponent two. What this file supplies is
the step from there: such an `M` is a compositum of quadratic fields, so Layer 0 applies to it.

Exponent-two Kummer theory is classical; see for instance S. Lang, *Algebra*, VI §8, or
D. A. Cox, *Primes of the Form x² + ny²*, §6.A, where the genus field is described exactly this
way.

## Main results

In the namespace `TauCeti.Multiquadratic`:

* `adjoin_setOf_sq_mem_range_eq_top`: the square roots of elements of `K` that lie in `L`
  generate `L` over `K`.
* `exists_finset_sq_mem_range_adjoin_eq_top`: a *finite* set of such square roots already
  generates.
* `exists_sqrt_family_adjoin_eq_adjoin`: any finite family of square roots can be replaced by a
  square-class independent family generating the same intermediate field.
* `exists_sqrt_family_adjoin_eq_top`: the sharp form — `L = K(√d₁, …, √dₙ)` for a square-class
  independent family, and consequently `[L : K] = 2ⁿ`.
-/

public section

open Module

namespace TauCeti.Multiquadratic

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

private theorem prod_root_eq_or_eq_neg_of_prod_eq_mul_self {ι : Type*} {d : ι → K} {root : ι → L}
    (hroot : ∀ i, root i ^ 2 = algebraMap K L (d i)) (S : Finset ι) {c : K}
    (hc : ∏ i ∈ S, d i = c * c) :
    (∏ i ∈ S, root i) = algebraMap K L c ∨ (∏ i ∈ S, root i) = -algebraMap K L c := by
  classical
  apply sq_eq_sq_iff_eq_or_eq_neg.mp
  rw [prod_root_sq hroot S, hc, map_mul, ← sq]

private theorem notMem_adjoin_erase [DecidableEq L] {s : Finset L}
    (hssq : ∀ x ∈ s, ∃ a : K, x ^ 2 = algebraMap K L a)
    (hmin : ∀ t : Finset L, (∀ x ∈ t, ∃ a : K, x ^ 2 = algebraMap K L a) →
      IntermediateField.adjoin K (t : Set L) = IntermediateField.adjoin K (s : Set L) →
      s.card ≤ t.card) {x : L} (hx : x ∈ s) :
    x ∉ IntermediateField.adjoin K ((s.erase x : Finset L) : Set L) := by
  classical
  intro hxadj
  have hadjoin : IntermediateField.adjoin K ((s.erase x : Finset L) : Set L) =
      IntermediateField.adjoin K (s : Set L) := by
    have hinsert :=
      IntermediateField.adjoin_insert_adjoin K ((s.erase x : Finset L) : Set L) x
    rw [Set.insert_eq_self.mpr hxadj, IntermediateField.adjoin_adjoin_right] at hinsert
    refine hinsert.trans (congrArg (IntermediateField.adjoin K) ?_)
    ext y
    by_cases hy : y = x
    · subst y
      simp [hx]
    · simp [hy]
  have hcard := hmin _ (fun y hy => hssq y (Finset.mem_of_mem_erase hy)) hadjoin
  rw [Finset.card_erase_of_mem hx] at hcard
  have hpos : 0 < s.card := Finset.card_pos.mpr ⟨x, hx⟩
  omega

private theorem exists_minimal_sq_generators (s : Finset L)
    (hssq : ∀ x ∈ s, ∃ a : K, x ^ 2 = algebraMap K L a) :
    ∃ t : Finset L, (∀ x ∈ t, ∃ a : K, x ^ 2 = algebraMap K L a) ∧
      IntermediateField.adjoin K (t : Set L) = IntermediateField.adjoin K (s : Set L) ∧
      (∀ u : Finset L, (∀ x ∈ u, ∃ a : K, x ^ 2 = algebraMap K L a) →
        IntermediateField.adjoin K (u : Set L) = IntermediateField.adjoin K (s : Set L) →
        t.card ≤ u.card) ∧ 0 ∉ t := by
  classical
  have hex : ∃ m, ∃ t : Finset L, t.card = m ∧
      (∀ x ∈ t, ∃ a : K, x ^ 2 = algebraMap K L a) ∧
      IntermediateField.adjoin K (t : Set L) = IntermediateField.adjoin K (s : Set L) :=
    ⟨s.card, s, rfl, hssq, rfl⟩
  obtain ⟨t, htcard, htsq, htadj⟩ := Nat.find_spec hex
  have hmin : ∀ u : Finset L, (∀ x ∈ u, ∃ a : K, x ^ 2 = algebraMap K L a) →
      IntermediateField.adjoin K (u : Set L) = IntermediateField.adjoin K (s : Set L) →
      t.card ≤ u.card := fun u hu hadj => htcard ▸ Nat.find_le ⟨u, rfl, hu, hadj⟩
  have hzero : (0 : L) ∉ t := fun h0 => notMem_adjoin_erase htsq
    (fun u hu hadj => hmin u hu (hadj.trans htadj)) h0 (zero_mem _)
  exact ⟨t, htsq, htadj, hmin, hzero⟩

/-- **An exponent-two Galois extension is generated by square roots.** If `2 ≠ 0` in `K` and
`L / K` is a finite Galois extension whose Galois group has exponent dividing two, then `L` is
generated over `K` by the elements whose square lies in `K`. -/
theorem adjoin_setOf_sq_mem_range_eq_top [FiniteDimensional K L] [IsGalois K L] [NeZero (2 : K)]
    (hexp : Monoid.exponent (L ≃ₐ[K] L) ∣ 2) :
    IntermediateField.adjoin K {x : L | ∃ a : K, x ^ 2 = algebraMap K L a} = ⊤ := by
  set M : IntermediateField K L :=
    IntermediateField.adjoin K {x : L | ∃ a : K, x ^ 2 = algebraMap K L a}
  -- No nontrivial automorphism fixes every square root.
  have hfix : M.fixingSubgroup = ⊥ := by
    rw [eq_bot_iff]
    intro σ hσ
    rw [Subgroup.mem_bot]
    by_contra hne
    -- Separate `σ` from an index-two subgroup and cut out its quadratic fixed field.
    obtain ⟨H, hHindex, hHσ⟩ :=
      TauCeti.exists_index_eq_two_notMem_of_exponent_two hexp hne
    have hE : finrank K (IntermediateField.fixedField H) = 2 := by
      rw [IntermediateField.finrank_eq_fixingSubgroup_index,
        IntermediateField.fixingSubgroup_fixedField, hHindex]
    obtain ⟨x, -, -, ⟨a, hxa⟩, hxadj⟩ :=
      TauCeti.IntermediateField.exists_sq_mem_range_adjoin_simple_eq_of_finrank_eq_two hE
    -- That quadratic field is generated by a square root, so `σ` fixes it and lies in `H`.
    have hxM : x ∈ M := IntermediateField.subset_adjoin K _ ⟨a, hxa⟩
    have hle : IntermediateField.fixedField H ≤ M := by
      rw [← hxadj]
      exact IntermediateField.adjoin_simple_le_iff.mpr hxM
    exact hHσ (IntermediateField.fixingSubgroup_fixedField H ▸
      IntermediateField.fixingSubgroup_le hle hσ)
  have h := IsGalois.fixedField_fixingSubgroup M
  rw [hfix, IntermediateField.fixedField_bot] at h
  exact h.symm

/-- **Finitely many square roots already generate.** The generating set of
`adjoin_setOf_sq_mem_range_eq_top` can be taken finite, because `L / K` is finite: a primitive
element already lies in the subfield generated by finitely many square roots. -/
theorem exists_finset_sq_mem_range_adjoin_eq_top [FiniteDimensional K L] [IsGalois K L]
    [NeZero (2 : K)] (hexp : Monoid.exponent (L ≃ₐ[K] L) ∣ 2) :
    ∃ s : Finset L, (∀ x ∈ s, ∃ a : K, x ^ 2 = algebraMap K L a) ∧
      IntermediateField.adjoin K (s : Set L) = ⊤ := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element K L
  have hmem : α ∈ IntermediateField.adjoin K {x : L | ∃ a : K, x ^ 2 = algebraMap K L a} := by
    rw [adjoin_setOf_sq_mem_range_eq_top hexp]
    exact IntermediateField.mem_top
  obtain ⟨s, hs, hαs⟩ := IntermediateField.exists_finset_of_mem_adjoin hmem
  refine ⟨s, fun x hx => hs (Finset.mem_coe.mpr hx), ?_⟩
  rw [eq_top_iff, ← hα]
  exact IntermediateField.adjoin_simple_le_iff.mpr hαs

/-- **A finite family of square roots can be replaced by an independent generating family.** If
every member of a finite set `s` squares into `K`, then the field it generates has a presentation
by a square-class independent family of square roots. Its degree is therefore a power of two. The
new family generates the same field but need not be drawn from `s`. -/
theorem exists_sqrt_family_adjoin_eq_adjoin [NeZero (2 : K)] (s : Finset L)
    (hssq : ∀ x ∈ s, ∃ a : K, x ^ 2 = algebraMap K L a) :
    ∃ (n : ℕ) (d : Fin n → K) (root : Fin n → L),
      (∀ i, root i ^ 2 = algebraMap K L (d i)) ∧
      (∀ S : Finset (Fin n), S.Nonempty → ¬ IsSquare (∏ i ∈ S, d i)) ∧
      IntermediateField.adjoin K (Set.range root) = IntermediateField.adjoin K (s : Set L) ∧
      finrank K (IntermediateField.adjoin K (s : Set L)) = 2 ^ n := by
  classical
  obtain ⟨t, htsq, htadj, hmin, hzero⟩ := exists_minimal_sq_generators s hssq
  -- Index the chosen square roots by `Fin t.card` and name their radicands.
  set e : Fin t.card ≃ {x // x ∈ t} := t.equivFin.symm
  set root : Fin t.card → L := fun i => (e i : L) with hroot_def
  have hroot_inj : Function.Injective root := fun _ _ hij => e.injective (Subtype.ext hij)
  have hroot_mem : ∀ i, root i ∈ t := fun i => (e i).2
  choose d hd using fun i : Fin t.card => htsq (root i) (hroot_mem i)
  have hrange : Set.range root = (t : Set L) := by
    ext x
    refine ⟨?_, fun hx => ⟨e.symm ⟨x, Finset.mem_coe.mp hx⟩, by simp [hroot_def]⟩⟩
    rintro ⟨i, rfl⟩
    exact Finset.mem_coe.mpr (hroot_mem i)
  have hadjoin : IntermediateField.adjoin K (Set.range root) =
      IntermediateField.adjoin K (s : Set L) := by rw [hrange]; exact htadj
  -- Square-class independence, by minimality.
  have hindep : ∀ S : Finset (Fin t.card), S.Nonempty → ¬ IsSquare (∏ i ∈ S, d i) := by
    rintro S ⟨i₀, hi₀⟩ ⟨c, hc⟩
    -- The product of the roots over `S` is `± c`, so `root i₀` lies in the field the others span.
    set F : IntermediateField K L :=
      IntermediateField.adjoin K ((t.erase (root i₀) : Finset L) : Set L)
    have hmemF : ∀ i ∈ S.erase i₀, root i ∈ F :=
      fun i hi => IntermediateField.subset_adjoin K _ (Finset.mem_coe.mpr
        (Finset.mem_erase.mpr ⟨fun h => (Finset.mem_erase.mp hi).1 (hroot_inj h),
          hroot_mem i⟩))
    have hne : ∀ i, root i ≠ 0 := fun i h => hzero (h ▸ hroot_mem i)
    set P : L := ∏ i ∈ S.erase i₀, root i with hP
    have hPmem : P ∈ F := Subalgebra.prod_mem _ fun i hi => hmemF i hi
    have hPne : P ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hne i
    have hprod : root i₀ * P = algebraMap K L c ∨ root i₀ * P = -algebraMap K L c := by
      rw [hP, Finset.mul_prod_erase S root hi₀]
      exact prod_root_eq_or_eq_neg_of_prod_eq_mul_self hd S hc
    have hi₀F : root i₀ ∈ F := by
      have hkey : root i₀ = (root i₀ * P) * P⁻¹ := by field_simp
      rw [hkey]
      refine mul_mem ?_ (inv_mem hPmem)
      rcases hprod with h | h
      · rw [h]; exact IntermediateField.algebraMap_mem _ _
      · rw [h]; exact neg_mem (IntermediateField.algebraMap_mem _ _)
    exact notMem_adjoin_erase htsq
      (fun u hu huadj => hmin u hu (huadj.trans htadj)) (hroot_mem i₀) hi₀F
  refine ⟨t.card, d, root, hd, hindep, hadjoin, ?_⟩
  rw [← hadjoin]
  simpa [Nat.card_eq_fintype_card] using finrank_adjoin_range (K := K) (L := L) hd hindep

/-- **The converse of the multiquadratic degree theorem.** Let `2 ≠ 0` in `K` and let `L / K` be a
finite Galois extension whose Galois group has exponent dividing two. Then `L = K(√d₁, …, √dₙ)`
for radicands `d₁, …, dₙ ∈ K` that are square-class independent — no nonempty subset product is a
square — and consequently `[L : K] = 2ⁿ`. -/
theorem exists_sqrt_family_adjoin_eq_top [FiniteDimensional K L] [IsGalois K L] [NeZero (2 : K)]
    (hexp : Monoid.exponent (L ≃ₐ[K] L) ∣ 2) :
    ∃ (n : ℕ) (d : Fin n → K) (root : Fin n → L),
      (∀ i, root i ^ 2 = algebraMap K L (d i)) ∧
      (∀ S : Finset (Fin n), S.Nonempty → ¬ IsSquare (∏ i ∈ S, d i)) ∧
      IntermediateField.adjoin K (Set.range root) = ⊤ ∧
      finrank K L = 2 ^ n := by
  obtain ⟨s, hssq, hstop⟩ := exists_finset_sq_mem_range_adjoin_eq_top hexp
  obtain ⟨n, d, root, hd, hindep, hadjoin, hfin⟩ :=
    exists_sqrt_family_adjoin_eq_adjoin s hssq
  refine ⟨n, d, root, hd, hindep, hadjoin.trans hstop, ?_⟩
  rw [hstop, IntermediateField.finrank_top'] at hfin
  exact hfin

end TauCeti.Multiquadratic
