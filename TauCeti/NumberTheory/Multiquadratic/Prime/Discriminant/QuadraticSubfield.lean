module

public import TauCeti.NumberTheory.Multiquadratic.Prime.Discriminant.Independence
public import TauCeti.NumberTheory.Multiquadratic.Subfield.Classification
public import TauCeti.NumberTheory.Multiquadratic.Quadratic.Discriminant

/-!
# Quadratic subfields of a prime-discriminant compositum

Let `D i` be distinct prime discriminants, with at most one even member, and let `root i` be
square roots of their radicands. Every quadratic subfield of the multiquadratic compositum
`ℚ(root i : i)` is generated by a product of a unique nonempty subset of the roots. This file
combines the field-generic subset-product classification of `Subfield/Classification` with the
arithmetic of prime discriminants: the discriminant of the subfield indexed by `S` is exactly
`∏ i ∈ S, D i`.

The arithmetic input is that a subset product of prime-discriminant radicands is squarefree and
has fundamental discriminant `∏ i ∈ S, D i`. The at-most-one-even hypothesis is what rules out
the pair `8`, `-8`, whose radicands are not coprime.

The prime-discriminant description is classical; see D. A. Cox, *Primes of the Form x² + ny²*,
§6.A, and F. Lemmermeyer, *Reciprocity Laws: From Euler to Eisenstein*, §2.2.

## Main results

* `TauCeti.Multiquadratic.fundamentalDiscriminant_prod_primeDiscriminantRadicands`: the
  fundamental discriminant of a subset product of prime-discriminant radicands is the product of
  the corresponding prime discriminants; the companion
  `squarefree_prod_primeDiscriminantRadicands_of_forall_isEvenPrimeDiscriminant_eq` records that
  such a product is squarefree.
* `TauCeti.Multiquadratic.discr_adjoin_prod_root_primeDiscriminants`: the quadratic
  subfield generated by a subset product has that product as its field discriminant.
* `TauCeti.Multiquadratic.exists_finset_discr_eq_of_finrank_two_primeDiscriminants`: every
  quadratic subfield of the compositum arises in this way.
-/

public section

open IntermediateField

namespace TauCeti.Multiquadratic

variable {ι : Type*} {D : ι → ℤ} {S : Finset ι}

/-- A non-even prime discriminant is its own radicand. -/
private theorem primeDiscriminantRadicand_eq_self_of_not_even {D : ℤ}
    (hD : IsPrimeDiscriminant D) (heven : ¬ IsEvenPrimeDiscriminant D) :
    primeDiscriminantRadicand D = D := by
  rcases isPrimeDiscriminant_iff.mp hD with h | ⟨p, _, hodd, rfl⟩
  · exact (heven h).elim
  · exact primeDiscriminantRadicand_oddPrimeDiscriminant hodd

/-- Products of radicands indexed by distinct prime discriminants with at most one even member are
squarefree. The at-most-one-even condition excludes the sole non-coprime pair of distinct
prime-discriminant radicands, those attached to `8` and `-8`. -/
theorem squarefree_prod_primeDiscriminantRadicands_of_forall_isEvenPrimeDiscriminant_eq
    (hD : ∀ i ∈ S, IsPrimeDiscriminant (D i)) (hinj : Set.InjOn D S)
    (heven : ∀ i ∈ S, ∀ j ∈ S, IsEvenPrimeDiscriminant (D i) →
      IsEvenPrimeDiscriminant (D j) → D i = D j) :
    Squarefree (∏ i ∈ S, primeDiscriminantRadicand (D i)) := by
  apply Finset.squarefree_prod_of_pairwise_isCoprime
  · intro i hi j hj hij
    apply (isCoprime_primeDiscriminantRadicand (hD i hi) (hD j hj)
      (fun h => hij (hinj hi hj h)) _).isRelPrime
    rintro (⟨hi8, hj8⟩ | ⟨hi8, hj8⟩)
    · exact hij (hinj hi hj (heven i hi j hj
        (hi8.symm ▸ isEvenPrimeDiscriminant_eight)
        (hj8.symm ▸ isEvenPrimeDiscriminant_neg_eight)))
    · exact hij (hinj hi hj (heven i hi j hj
        (hi8.symm ▸ isEvenPrimeDiscriminant_neg_eight)
        (hj8.symm ▸ isEvenPrimeDiscriminant_eight)))
  · exact fun i hi => squarefree_primeDiscriminantRadicand (hD i hi)

/-- **Fundamental discriminant of a subset product of prime-discriminant radicands.** For a
distinct family of prime discriminants with at most one even member,

`fundamentalDiscriminant (∏ i ∈ S, radicand (D i)) = ∏ i ∈ S, D i`.

The even factor is the load-bearing point: if it is present, it contributes the unique factor
`4` removed by `primeDiscriminantRadicand`; all other factors are odd and congruent to `1` modulo
`4`. If no even factor is present, every radicand is already its prime discriminant. -/
theorem fundamentalDiscriminant_prod_primeDiscriminantRadicands
    (hD : ∀ i ∈ S, IsPrimeDiscriminant (D i)) (hinj : Set.InjOn D S)
    (heven : ∀ i ∈ S, ∀ j ∈ S, IsEvenPrimeDiscriminant (D i) →
      IsEvenPrimeDiscriminant (D j) → D i = D j) :
    fundamentalDiscriminant (∏ i ∈ S, primeDiscriminantRadicand (D i)) =
      ∏ i ∈ S, D i := by
  classical
  by_cases hex : ∃ i ∈ S, IsEvenPrimeDiscriminant (D i)
  · obtain ⟨i, hi, hiEven⟩ := hex
    have hunique : ∀ j ∈ S, IsEvenPrimeDiscriminant (D j) → j = i := by
      intro j hj hjEven
      exact hinj hj hi (heven j hj i hi hjEven hiEven)
    have hodd : ∀ j ∈ S.erase i, ¬ IsEvenPrimeDiscriminant (D j) := by
      intro j hj hjEven
      exact Finset.ne_of_mem_erase hj (hunique j (Finset.mem_of_mem_erase hj) hjEven)
    have hrad : ∀ j ∈ S.erase i, primeDiscriminantRadicand (D j) = D j :=
      fun j hj => primeDiscriminantRadicand_eq_self_of_not_even
        (hD j (Finset.mem_of_mem_erase hj)) (hodd j hj)
    have hterms : ∏ j ∈ S.erase i, D j % 4 = 1 := by
      apply Finset.prod_eq_one
      intro j hj
      have h := (isEvenPrimeDiscriminant_or_primeDiscriminantRadicand_mod_four_eq_one
        (hD j (Finset.mem_of_mem_erase hj))).resolve_left (hodd j hj)
      rwa [hrad j hj] at h
    have hoddmod : (∏ j ∈ S.erase i, primeDiscriminantRadicand (D j)) % 4 = 1 := by
      rw [Finset.prod_congr rfl hrad, Finset.prod_int_mod, hterms]
      norm_num
    have hiMod := primeDiscriminantRadicand_mod_four_eq_three_or_two_of_even hiEven
    have hprodRad : (∏ j ∈ S, primeDiscriminantRadicand (D j)) =
        primeDiscriminantRadicand (D i) * ∏ j ∈ S.erase i,
          primeDiscriminantRadicand (D j) :=
      Finset.mul_prod_erase S (fun j => primeDiscriminantRadicand (D j)) hi |>.symm
    have hmod : (∏ j ∈ S, primeDiscriminantRadicand (D j)) % 4 ≠ 1 := by
      rw [hprodRad, Int.mul_emod, hoddmod]
      rcases hiMod with h | h <;> omega
    rw [fundamentalDiscriminant_of_mod_four_ne_one hmod]
    have hDi : D i = 4 * primeDiscriminantRadicand (D i) := by
      calc
        D i = 4 * evenPrimeDiscriminantRadicand (D i) :=
          evenPrimeDiscriminant_eq_four_mul_radicand hiEven
        _ = 4 * primeDiscriminantRadicand (D i) := congrArg (4 * ·)
          (primeDiscriminantRadicand_of_isEvenPrimeDiscriminant hiEven).symm
    calc
      4 * ∏ j ∈ S, primeDiscriminantRadicand (D j) = 4 *
          (primeDiscriminantRadicand (D i) * ∏ j ∈ S.erase i,
            primeDiscriminantRadicand (D j)) := congrArg (4 * ·) hprodRad
      _ = (4 * primeDiscriminantRadicand (D i)) *
          ∏ j ∈ S.erase i, primeDiscriminantRadicand (D j) := by ring
      _ = D i * ∏ j ∈ S.erase i, primeDiscriminantRadicand (D j) :=
        congrArg (· * ∏ j ∈ S.erase i, primeDiscriminantRadicand (D j)) hDi.symm
      _ = D i * ∏ j ∈ S.erase i, D j := by
            rw [Finset.prod_congr rfl hrad]
      _ = ∏ j ∈ S, D j := Finset.mul_prod_erase S D hi
  · have hodd : ∀ i ∈ S, ¬ IsEvenPrimeDiscriminant (D i) :=
      fun i hi hiEven => hex ⟨i, hi, hiEven⟩
    have hrad : ∀ i ∈ S, primeDiscriminantRadicand (D i) = D i :=
      fun i hi => primeDiscriminantRadicand_eq_self_of_not_even (hD i hi) (hodd i hi)
    have hterms : ∏ i ∈ S, D i % 4 = 1 := by
      apply Finset.prod_eq_one
      intro i hi
      have h := (isEvenPrimeDiscriminant_or_primeDiscriminantRadicand_mod_four_eq_one
        (hD i hi)).resolve_left (hodd i hi)
      rwa [hrad i hi] at h
    have hmod : (∏ i ∈ S, primeDiscriminantRadicand (D i)) % 4 = 1 := by
      rw [Finset.prod_congr rfl hrad, Finset.prod_int_mod, hterms]
      norm_num
    rw [fundamentalDiscriminant_of_mod_four_eq_one hmod, Finset.prod_congr rfl hrad]

section Subfields

variable {L : Type*} [Field L] [CharZero L] (D : ι → ℤ)
  (hD : ∀ i, IsPrimeDiscriminant (D i)) (hinj : Function.Injective D)
  (heven : ∀ i j, IsEvenPrimeDiscriminant (D i) →
    IsEvenPrimeDiscriminant (D j) → D i = D j)
  (root : ι → L)
  (hroot : ∀ i, root i ^ 2 = algebraMap ℚ L ((primeDiscriminantRadicand (D i) : ℤ) : ℚ))

include hD hinj heven hroot

/-- **Discriminant of a subset-product quadratic subfield.** The quadratic subfield generated by
`∏ i ∈ S, root i` has field discriminant `∏ i ∈ S, D i`. The ambient field need only have
characteristic zero; the subfield is a number field because the product root is integral. -/
theorem discr_adjoin_prod_root_primeDiscriminants
    (S : {S : Finset ι // S.Nonempty}) :
    let hxint : IsIntegral ℚ (∏ i ∈ S.1, root i) :=
      IsIntegral.of_pow (n := 2) (by norm_num) (by
        rw [prod_root_sq hroot]; exact isIntegral_algebraMap)
    letI : NumberField (adjoin ℚ {∏ i ∈ S.1, root i}) :=
      { to_finiteDimensional := adjoin.finiteDimensional hxint }
    NumberField.discr (adjoin ℚ {∏ i ∈ S.1, root i}) = ∏ i ∈ S.1, D i := by
  have hsf : Squarefree (∏ i ∈ S.1, primeDiscriminantRadicand (D i)) :=
    squarefree_prod_primeDiscriminantRadicands_of_forall_isEvenPrimeDiscriminant_eq
      (fun i _ => hD i) (fun _ _ _ _ h => hinj h) (fun i _ j _ => heven i j)
  have hsq : (∏ i ∈ S.1, root i) ^ 2 =
      algebraMap ℤ L (∏ i ∈ S.1, primeDiscriminantRadicand (D i)) := by
    rw [prod_root_sq hroot, IsScalarTower.algebraMap_apply ℤ ℚ L]
    norm_num
  have hnsq : ¬ IsSquare ((∏ i ∈ S.1, primeDiscriminantRadicand (D i) : ℤ) : ℚ) := by
    simpa only [Int.cast_prod] using
      (not_isSquare_prod_primeDiscriminantRadicands_of_forall_isEvenPrimeDiscriminant_eq
        D hD hinj heven S.1 S.2)
  exact (discr_adjoin_singleton_eq_fundamentalDiscriminant hsf hsq hnsq).trans
    (fundamentalDiscriminant_prod_primeDiscriminantRadicands
      (fun i _ => hD i) hinj.injOn (fun i _ j _ => heven i j))

/-- **Quadratic subfields of a prime-discriminant compositum.** Suppose the chosen roots generate
the ambient number field. Every quadratic intermediate field is generated by the product of a
nonempty subset of those roots, and its field discriminant is the product of the corresponding
prime discriminants. -/
theorem exists_finset_discr_eq_of_finrank_two_primeDiscriminants [NumberField L]
    [Finite ι] (htop : adjoin ℚ (Set.range root) = ⊤)
    (F : IntermediateField ℚ L) (hF : Module.finrank ℚ F = 2) :
    ∃ S : Finset ι, S.Nonempty ∧
      F = adjoin ℚ {∏ i ∈ S, root i} ∧
      NumberField.discr F = ∏ i ∈ S, D i := by
  let hindep :=
    not_isSquare_prod_primeDiscriminantRadicands_of_forall_isEvenPrimeDiscriminant_eq
      D hD hinj heven
  obtain ⟨S, hS, hFS⟩ :=
    exists_finset_of_finrank_two_of_adjoin_eq_top hroot hindep htop F hF
  refine ⟨S, hS, hFS, ?_⟩
  subst F
  exact discr_adjoin_prod_root_primeDiscriminants
    D hD hinj heven root hroot ⟨S, hS⟩

end Subfields

end TauCeti.Multiquadratic
