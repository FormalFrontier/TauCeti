module

public import TauCeti.NumberTheory.Multiquadratic.Prime.Discriminant.Independence
public import TauCeti.NumberTheory.Multiquadratic.Prime.Discriminant.Examples.Lists
public import TauCeti.NumberTheory.Multiquadratic.Subfield.Classification
public import Mathlib.Data.Complex.Basic
public import Mathlib.Analysis.Real.Sqrt
import TauCeti.NumberTheory.Multiquadratic.RelativeDegree

/-!
# The candidate genus field over `ℚ(√-5)`

The multiquadratic roadmap's first genus-field example uses the prime discriminants `-4` and `5`.
Their associated radicands are `-1` and `5`, with chosen complex roots `i` and `√5`. The ambient
compositum `ℚ(i, √5)` has degree four over `ℚ` (`finrank_adjoin_I_sqrt_five`); this file identifies
the quadratic subfield generated by the product of those roots and computes that the compositum has
degree two over it.

The product root squares to `-5`, so its simple extension is the copy of `ℚ(√-5)` inside the
candidate genus field. The relative-degree calculation then specializes
`TauCeti.Multiquadratic.finrank_top_over_intermediateField_of_finrank_eq_two`. This supplies the
field-degree part of the roadmap's `ℚ(√-5)` acceptance example (genus field `ℚ(√-1, √5)`,
`[K_gen : ℚ(√-5)] = 2 = 2 ^ (t - 1)` with `t = 2` ramified primes); identifying the ambient
compositum as the maximal unramified abelian extension is later work. It is the two-generator
companion of the `ℚ(√-21)` example
`finrank_candidateGenusField_over_sqrtNegTwentyOneSubfield`.

The prime-discriminant description follows D. A. Cox, *Primes of the Form x² + ny²*, and
F. Lemmermeyer's *Reciprocity Laws*.

## Main results

* `TauCeti.Multiquadratic.sqrtNegFiveSubfield`: the quadratic subfield generated by the product
  `i · √5`.
* `TauCeti.Multiquadratic.prodRootMem_univ_sq_minusFive`: that product squares to `-5`.
* `TauCeti.Multiquadratic.finrank_candidateGenusField_over_sqrtNegFiveSubfield`: the candidate
  genus field has degree two over this copy of `ℚ(√-5)`.
-/

public section

open IntermediateField

namespace TauCeti.Multiquadratic

/-- The two radicands `-1` and `5` associated to the prime discriminants `-4` and `5` in the
`ℚ(√-5)` genus-field example. -/
def minusFiveRadicand : Fin 2 → ℚ :=
  ![-1, 5]

/-- Chosen complex roots `i` and `√5` of the radicands in the `ℚ(√-5)` genus-field example. -/
noncomputable def minusFiveRoot : Fin 2 → ℂ :=
  ![Complex.I, ((Real.sqrt 5 : ℝ) : ℂ)]

@[simp] theorem minusFiveRadicand_zero : minusFiveRadicand 0 = -1 := rfl

@[simp] theorem minusFiveRadicand_one : minusFiveRadicand 1 = 5 := rfl

@[simp] theorem minusFiveRoot_zero : minusFiveRoot 0 = Complex.I := rfl

@[simp] theorem minusFiveRoot_one : minusFiveRoot 1 = ((Real.sqrt 5 : ℝ) : ℂ) := rfl

/-- The radicands for the `ℚ(√-5)` example agree with those associated to its two prime
discriminants `-4` and `5`. -/
theorem minusFiveRadicand_eq_primeDiscriminantRadicand (i : Fin 2) :
    minusFiveRadicand i =
      ((primeDiscriminantRadicand (negFourFivePrimeDiscriminants i) : ℤ) : ℚ) := by
  fin_cases i <;> simp [negFourFivePrimeDiscriminants, primeDiscriminantRadicand]

/-- Each chosen root for the `ℚ(√-5)` example squares to its corresponding radicand. -/
@[simp] theorem minusFiveRoot_sq (i : Fin 2) :
    minusFiveRoot i ^ 2 = algebraMap ℚ ℂ (minusFiveRadicand i) := by
  fin_cases i
  · simp [Complex.I_sq]
  · have h : (((Real.sqrt 5 : ℝ) : ℂ) ^ 2) = (5 : ℂ) := by
      rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 5)]
      norm_num
    simpa using h

/-- The radicands `-1` and `5` are square-class independent over `ℚ`. -/
theorem not_isSquare_prod_minusFiveRadicand (S : Finset (Fin 2)) (hS : S.Nonempty) :
    ¬ IsSquare (∏ i ∈ S, minusFiveRadicand i) := by
  have hD : ∀ i : Fin 2, IsPrimeDiscriminant (negFourFivePrimeDiscriminants i) := by
    intro i
    fin_cases i
    · simp [negFourFivePrimeDiscriminants]
    · have h5 : IsPrimeDiscriminant (5 : ℤ) := by
        simpa [oddPrimeDiscriminant_of_mod_four_eq_one (by norm_num : (5 : ℤ) % 4 = 1)]
          using isPrimeDiscriminant_oddPrimeDiscriminant (p := 5) (by decide) (by decide)
      simpa [negFourFivePrimeDiscriminants] using h5
  have hinj : Function.Injective negFourFivePrimeDiscriminants := by decide
  have heven :
      ¬ ((∃ i : Fin 2, negFourFivePrimeDiscriminants i = -4) ∧
        (∃ i : Fin 2, negFourFivePrimeDiscriminants i = 8) ∧
          (∃ i : Fin 2, negFourFivePrimeDiscriminants i = -8)) := by
    decide
  simp_rw [minusFiveRadicand_eq_primeDiscriminantRadicand]
  exact not_isSquare_prod_primeDiscriminantRadicands
    negFourFivePrimeDiscriminants hD hinj heven S hS

/-- The copy of `ℚ(√-5)` inside the candidate genus field `ℚ(i, √5)`, generated by the product of
its two chosen roots. -/
noncomputable def sqrtNegFiveSubfield :
    IntermediateField ℚ (adjoin ℚ (Set.range minusFiveRoot)) :=
  (quadraticSubfieldOfFinset minusFiveRoot_sq
    not_isSquare_prod_minusFiveRadicand
    ⟨Finset.univ, Finset.univ_nonempty⟩).1

/-- The named quadratic subfield is generated by the product of both chosen roots. -/
@[simp] theorem sqrtNegFiveSubfield_def :
    sqrtNegFiveSubfield =
      adjoin ℚ {prodRootMem (K := ℚ) minusFiveRoot (Finset.univ : Finset (Fin 2))} :=
  quadraticSubfieldOfFinset_val minusFiveRoot_sq
    not_isSquare_prod_minusFiveRadicand
    ⟨Finset.univ, Finset.univ_nonempty⟩

/-- The generator of `sqrtNegFiveSubfield` squares to `-5`. -/
@[simp] theorem prodRootMem_univ_sq_minusFive :
    (prodRootMem (K := ℚ) minusFiveRoot (Finset.univ : Finset (Fin 2))) ^ 2
      = algebraMap ℚ (adjoin ℚ (Set.range minusFiveRoot)) (-5) := by
  have hprod : ∏ i : Fin 2, minusFiveRadicand i = -5 := by
    rw [Fin.prod_univ_succ]
    norm_num [Fin.prod_univ_succ]
  apply Subtype.ext
  have h := prod_root_sq minusFiveRoot_sq (Finset.univ : Finset (Fin 2))
  rw [hprod] at h
  norm_num at h ⊢
  exact h

/-- The subfield generated by the product root of `-5` is quadratic over `ℚ`. -/
theorem finrank_sqrtNegFiveSubfield :
    Module.finrank ℚ sqrtNegFiveSubfield = 2 :=
  (quadraticSubfieldOfFinset minusFiveRoot_sq
    not_isSquare_prod_minusFiveRadicand
    ⟨Finset.univ, Finset.univ_nonempty⟩).2

/-- **The candidate genus field for `ℚ(√-5)` has relative degree two.**
The degree-four compositum `ℚ(i, √5)` has degree `2` over its quadratic subfield generated by the
product root, which squares to `-5`. -/
theorem finrank_candidateGenusField_over_sqrtNegFiveSubfield :
    Module.finrank sqrtNegFiveSubfield
      (adjoin ℚ (Set.range minusFiveRoot)) = 2 := by
  have h := finrank_top_over_intermediateField_of_finrank_eq_two
    minusFiveRoot_sq not_isSquare_prod_minusFiveRadicand
    sqrtNegFiveSubfield finrank_sqrtNegFiveSubfield
  norm_num [Nat.card_fin] at h ⊢
  exact h

end TauCeti.Multiquadratic
