module

public import TauCeti.CategoryTheory.Sites.FreeYoneda
public import TauCeti.CategoryTheory.Sites.SheafCohomology.Terminal
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.ExactSequences
public import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.HasExt
public import Mathlib.Topology.Sheaves.Abelian
public import Mathlib.Topology.Sheaves.Flasque
public import Mathlib.Topology.Sheaves.Skyscraper

/-!
# Flasque sheaves are acyclic

A sheaf of abelian groups on a topological space is flasque when all of its restriction maps are
surjective. This file proves that a flasque sheaf has no higher cohomology.

## Main declarations

* `TauCeti.Topology.isFlasque_of_injective`: an injective object in the category of abelian
  sheaves is flasque;
* `TauCeti.Topology.subsingleton_H'_succ_of_isFlasque`: a flasque sheaf has vanishing cohomology
  in every positive degree over every open subset;
* `TauCeti.Topology.subsingleton_H_succ_of_isFlasque`: the same statement for the cohomology of
  the whole space;
* `TauCeti.Topology.subsingleton_H'_succ_skyscraperSheaf` and
  `TauCeti.Topology.subsingleton_H_succ_skyscraperSheaf`: skyscraper sheaves are acyclic.

The proof is the classical dimension shift. Embedding a flasque sheaf `F` in an injective sheaf
`I` gives a short exact sequence `0 ⟶ F ⟶ I ⟶ Q ⟶ 0`, and the covariant long exact sequence of
`Ext` presents `Hⁿ⁺¹(U, F)` as a quotient of `Hⁿ(U, Q)`. In degree zero, the sections of `Q` over
`U` lift to sections of `I` because `F` is flasque, so the quotient vanishes; in higher degrees
`Q` is again flasque, because `I` is, and induction applies. That `I` is flasque is the point at
which `TauCeti/CategoryTheory/Sites/FreeYoneda.lean` enters: an inclusion of open subsets induces
a monomorphism of the free abelian sheaves they generate, and `Hom(-, I)` turns it into the
restriction map of `I`.

This advances `TauCetiRoadmap/JacobianChallenge/README.md`, Layer B, "coherent sheaves and
cohomology `Hⁱ(X, ℱ)`: acyclicity of affines, …, vanishing above dimension": it is the first
acyclicity theorem of the lane, and the acyclic skyscraper sheaves are the coefficients in which
the Riemann-Roch induction over the points of a divisor reads the additivity of
`TauCeti/AlgebraicGeometry/Cohomology/EulerCharacteristic.lean`.

No formalization is vendored: flasqueness, the surjectivity of sections out of a flasque
subsheaf, the stability of flasqueness under quotients and the flasqueness of skyscraper sheaves
are Mathlib's `Mathlib/Topology/Sheaves/Flasque.lean`, and the long exact sequence is Mathlib's
`CategoryTheory.Abelian.Ext.covariant_sequence_exact₁`.
-/

public section

open CategoryTheory Limits Opposite TopologicalSpace
open TauCeti.CategoryTheory (freeYonedaSheafFunctor freeYonedaSheafHomEquiv
  freeYonedaSheafHomEquiv_naturality_left freeYonedaSheafHomEquiv_naturality_right)

universe u

namespace TauCeti

namespace Topology

variable {X : TopCat.{u}}

noncomputable section

/-- An inclusion of open subsets induces a monomorphism of the free abelian sheaves they
generate: the hom-sets of the site are subsingletons, so the induced map of presheaves of sets is
injective, and both the free abelian group functor and sheafification preserve monomorphisms. -/
lemma mono_freeYonedaSheafFunctor_map {U V : Opens X} (i : U ⟶ V) :
    Mono ((freeYonedaSheafFunctor (Opens.grothendieckTopology X)).map i) := by
  have happ (W : (Opens X)ᵒᵖ) :
      Mono ((Functor.whiskerRight (yoneda.map i) AddCommGrpCat.free.{u}).app W) := by
    have hs : Subsingleton ((yoneda.obj U).obj W) := Preorder.subsingleton_hom _ _
    have : Mono ((yoneda.map i).app W) := by
      rw [CategoryTheory.mono_iff_injective]
      exact fun a b _ => hs.elim a b
    exact AddCommGrpCat.free.map_mono _
  have : Mono (Functor.whiskerRight (yoneda.map i) AddCommGrpCat.free.{u}) :=
    NatTrans.mono_of_mono_app _
  exact (presheafToSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).map_mono _

/-- An injective object in the category of sheaves of abelian groups is flasque.

Given `s : I(V)` and an inclusion `V ≤ U`, view `s` as a morphism `ℤ_V ⟶ I` out of the free
abelian sheaf generated by `V`; injectivity of `I` extends it along the monomorphism
`ℤ_V ⟶ ℤ_U`, and the extension is a section over `U` restricting to `s`. -/
lemma isFlasque_of_injective
    (F : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) [Injective F] :
    TopCat.Presheaf.IsFlasque F.obj where
  epi {U V} i := by
    rw [AddCommGrpCat.epi_iff_surjective]
    intro s
    have : Mono ((freeYonedaSheafFunctor (Opens.grothendieckTopology X)).map i.unop) :=
      mono_freeYonedaSheafFunctor_map _
    refine ⟨freeYonedaSheafHomEquiv _ U.unop F
      (Injective.factorThru ((freeYonedaSheafHomEquiv _ V.unop F).symm s)
        ((freeYonedaSheafFunctor (Opens.grothendieckTopology X)).map i.unop)), ?_⟩
    have h := freeYonedaSheafHomEquiv_naturality_left (Opens.grothendieckTopology X) i.unop F
      (Injective.factorThru ((freeYonedaSheafHomEquiv _ V.unop F).symm s)
        ((freeYonedaSheafFunctor (Opens.grothendieckTopology X)).map i.unop))
    rw [Injective.comp_factorThru, Equiv.apply_symm_apply] at h
    exact h.symm

/-- The dimension-shifting induction: a flasque sheaf has no cohomology in positive degrees over
any open subset. This is the `Ext`-formulation; see `subsingleton_H'_succ_of_isFlasque`. -/
private lemma subsingleton_ext_freeYonedaSheaf_succ (n : ℕ) :
    ∀ (F : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}),
      TopCat.Presheaf.IsFlasque F.obj → ∀ U : Opens X,
      Subsingleton
        (Abelian.Ext.{u} ((freeYonedaSheafFunctor (Opens.grothendieckTopology X)).obj U)
          F (n + 1)) := by
  induction n with
  | zero =>
    intro F hF U
    have := hF
    let S := ShortComplex.mk _ _ (cokernel.condition (Injective.ι F))
    have hS : S.ShortExact :=
      { exact := ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel S.f) }
    refine subsingleton_of_forall_eq 0 fun y => ?_
    obtain ⟨x₃, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS y
      (Abelian.Ext.eq_zero_of_injective _) rfl
    have hepi : Epi (S.g.hom.app (op U)) := TopCat.Sheaf.IsFlasque.epi_of_shortExact hS
    rw [AddCommGrpCat.epi_iff_surjective] at hepi
    obtain ⟨t, ht⟩ := hepi (freeYonedaSheafHomEquiv _ U S.X₃ (Abelian.Ext.homEquiv₀ x₃))
    have hx₃ : x₃ = (Abelian.Ext.mk₀ ((freeYonedaSheafHomEquiv _ U S.X₂).symm t)).comp
        (Abelian.Ext.mk₀ S.g) (add_zero 0) := by
      rw [Abelian.Ext.mk₀_comp_mk₀]
      refine (Abelian.Ext.mk₀_homEquiv₀_apply x₃).symm.trans (congrArg Abelian.Ext.mk₀ ?_)
      refine (freeYonedaSheafHomEquiv _ U S.X₃).injective ?_
      rw [freeYonedaSheafHomEquiv_naturality_right, Equiv.apply_symm_apply, ht]
    rw [hx₃, Abelian.Ext.comp_assoc_of_second_deg_zero, hS.comp_extClass,
      Abelian.Ext.comp_zero]
  | succ n ih =>
    intro F hF U
    have := hF
    let S := ShortComplex.mk _ _ (cokernel.condition (Injective.ι F))
    have hS : S.ShortExact :=
      { exact := ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel S.f) }
    have : TopCat.Presheaf.IsFlasque S.X₂.obj := isFlasque_of_injective _
    have : TopCat.Presheaf.IsFlasque S.X₃.obj :=
      TopCat.Sheaf.IsFlasque.of_shortExact_of_isFlasque₁₂ hS
    have := ih S.X₃ inferInstance U
    refine subsingleton_of_forall_eq 0 fun y => ?_
    obtain ⟨x₃, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS y
      (Abelian.Ext.eq_zero_of_injective _) rfl
    rw [Subsingleton.elim x₃ 0, Abelian.Ext.zero_comp]

/-- A flasque sheaf of abelian groups has vanishing cohomology in every positive degree over
every open subset. -/
theorem subsingleton_H'_succ_of_isFlasque
    (F : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    [TopCat.Presheaf.IsFlasque F.obj] (n : ℕ) (U : Opens X) :
    Subsingleton (_root_.CategoryTheory.Sheaf.H'.{u} F (n + 1) U) :=
  subsingleton_ext_freeYonedaSheaf_succ n F inferInstance U

/-- A flasque sheaf of abelian groups has vanishing cohomology in every positive degree. -/
theorem subsingleton_H_succ_of_isFlasque
    (F : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    [TopCat.Presheaf.IsFlasque F.obj] (n : ℕ) :
    Subsingleton (_root_.CategoryTheory.Sheaf.H.{u} F (n + 1)) := by
  have := subsingleton_H'_succ_of_isFlasque F n (⊤ : Opens X)
  exact Function.Injective.subsingleton
    (f := ConcreteCategory.hom
      (TauCeti.CategoryTheory.Sheaf.cohomologyPresheafObjIsoH (n + 1) isTerminalTop F).inv)
    ((ConcreteCategory.bijective_of_isIso _).injective)

/-- A skyscraper sheaf has vanishing cohomology in every positive degree over every open
subset. -/
theorem subsingleton_H'_succ_skyscraperSheaf (p₀ : X) (A : AddCommGrpCat.{u})
    [(U : Opens X) → Decidable (p₀ ∈ U)] (n : ℕ) (U : Opens X) :
    Subsingleton (_root_.CategoryTheory.Sheaf.H'.{u} (skyscraperSheaf p₀ A) (n + 1) U) := by
  have := isFlasque_skyscraperSheaf_of_hasZeroObject p₀ A
  exact subsingleton_H'_succ_of_isFlasque _ n U

/-- A skyscraper sheaf has vanishing cohomology in every positive degree. -/
theorem subsingleton_H_succ_skyscraperSheaf (p₀ : X) (A : AddCommGrpCat.{u})
    [(U : Opens X) → Decidable (p₀ ∈ U)] (n : ℕ) :
    Subsingleton (_root_.CategoryTheory.Sheaf.H.{u} (skyscraperSheaf p₀ A) (n + 1)) := by
  have := isFlasque_skyscraperSheaf_of_hasZeroObject p₀ A
  exact subsingleton_H_succ_of_isFlasque _ n

end

end Topology

end TauCeti
