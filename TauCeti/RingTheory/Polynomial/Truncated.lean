module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Nilpotent.Basic
public import TauCeti.RingTheory.LocalRing.Basic

/-!
# The truncated polynomial algebra `k[X]/(Xⁿ⁺¹)`

Mathlib builds `AdjoinRoot f` for any polynomial and, for a monic `f`, its power basis
`AdjoinRoot.powerBasis'`. It does not record what the quotient by a power of `X` looks like. This
file does: over a field `k`, the algebra `k[X]/(Xⁿ⁺¹)` is a **local** ring whose maximal ideal is
generated by the class of `X`, and it has dimension `n + 1`.

Locality is the useful form of the statement, because it is what pins the idempotents: through
`TauCeti.IsLocalRing.eq_zero_or_eq_one_of_isIdempotentElem` a truncated polynomial algebra has no
idempotent besides `0` and `1`. That is exactly the input to the indecomposability of a nilpotent
Jordan block, whose endomorphism algebra is `k[X]/(Xⁿ⁺¹)`.

## Main results

* `TauCeti.isNilpotent_root_X_pow`: the class of `X` is nilpotent in `k[X]/(Xⁿ⁺¹)`.
* `TauCeti.isNilpotent_of_lift_zero_X_pow`: an element of `k[X]/(Xⁿ⁺¹)` with vanishing constant
  term is nilpotent -- the kernel of the evaluation `k[X]/(Xⁿ⁺¹) → k` at `0` consists of
  nilpotents.
* `TauCeti.isLocalRing_adjoinRoot_X_pow`: `k[X]/(Xⁿ⁺¹)` is a local ring.
* `TauCeti.finrank_adjoinRoot_X_pow`: `k[X]/(Xⁿ)` has dimension `n` over `k`.

## Implementation notes

The evaluation `k[X]/(Xⁿ⁺¹) → k` reading off the constant term is `AdjoinRoot.lift` of the identity
of `k` at the root `0`, so `TauCeti.isNilpotent_of_lift_zero_X_pow` is stated against that map
rather than against a new name; `AdjoinRoot.lift_mk` computes it on a class.

Locality is proved from `IsLocalRing.of_isUnit_or_isUnit_one_sub_self`, splitting an element as its
constant term plus an element of the kernel: the constant term is a scalar, hence invertible unless
it vanishes, and adding a nilpotent to a unit leaves a unit
(`IsNilpotent.isUnit_add_left_of_commute`). Nontriviality, which that criterion needs, is
`AdjoinRoot.nontrivial` applied to the positive degree of `Xⁿ⁺¹`.

The dimension is stated for `Xⁿ` rather than for `Xⁿ⁺¹`, since the degenerate case `n = 0` -- the
zero ring, of dimension `0` -- is true and costs nothing; locality genuinely needs `n + 1`, the
zero ring not being local.
-/

public section

open Polynomial

namespace TauCeti

variable {k : Type*} [Field k]

/-- **The class of `X` is nilpotent in `k[X]/(Xⁿ⁺¹)`**: its `(n + 1)`-st power is the class of the
relator. -/
theorem isNilpotent_root_X_pow (n : ℕ) :
    IsNilpotent (AdjoinRoot.root ((X : k[X]) ^ (n + 1))) :=
  ⟨n + 1, by rw [← AdjoinRoot.mk_X, ← map_pow, AdjoinRoot.mk_self]⟩

/-- The evaluation `k[X]/(Xⁿ⁺¹) → k` at `0` is well defined: `Xⁿ⁺¹` vanishes at `0`. -/
theorem eval₂_id_zero_X_pow (n : ℕ) : ((X : k[X]) ^ (n + 1)).eval₂ (RingHom.id k) 0 = 0 := by
  simp

/-- **An element of `k[X]/(Xⁿ⁺¹)` with vanishing constant term is nilpotent.** Such an element is
the class of a polynomial divisible by `X`, hence a multiple of the nilpotent class of `X`. -/
theorem isNilpotent_of_lift_zero_X_pow {n : ℕ} {x : AdjoinRoot ((X : k[X]) ^ (n + 1))}
    (hx : AdjoinRoot.lift (RingHom.id k) (0 : k) (eval₂_id_zero_X_pow n) x = 0) :
    IsNilpotent x := by
  induction x using AdjoinRoot.induction_on with
  | ih p =>
    have hp : p.coeff 0 = 0 := by
      rw [Polynomial.coeff_zero_eq_eval_zero]
      simpa [AdjoinRoot.lift_mk, Polynomial.eval] using hx
    obtain ⟨q, rfl⟩ := Polynomial.X_dvd_iff.mpr hp
    rw [map_mul, AdjoinRoot.mk_X]
    exact (Commute.all _ _).isNilpotent_mul_right (isNilpotent_root_X_pow n)

/-- An element of `k[X]/(Xⁿ⁺¹)` with a nonzero constant term is a unit: it is the sum of the
nonzero scalar and a nilpotent. -/
theorem isUnit_of_lift_ne_zero_X_pow {n : ℕ} {x : AdjoinRoot ((X : k[X]) ^ (n + 1))}
    (hx : AdjoinRoot.lift (RingHom.id k) (0 : k) (eval₂_id_zero_X_pow n) x ≠ 0) : IsUnit x := by
  set c := AdjoinRoot.lift (RingHom.id k) (0 : k) (eval₂_id_zero_X_pow n) x with hc
  have hker : AdjoinRoot.lift (RingHom.id k) (0 : k) (eval₂_id_zero_X_pow n)
      (x - algebraMap k _ c) = 0 := by
    rw [map_sub, ← hc, AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of, RingHom.id_apply, sub_self]
  have hunit : IsUnit (algebraMap k (AdjoinRoot ((X : k[X]) ^ (n + 1))) c) :=
    (Ne.isUnit hx).map (algebraMap k _)
  have := (isNilpotent_of_lift_zero_X_pow hker).isUnit_add_left_of_commute hunit
    (Commute.all _ _)
  rwa [add_sub_cancel] at this

/-- **The truncated polynomial algebra `k[X]/(Xⁿ⁺¹)` is a local ring.** An element is a unit exactly
when its constant term is, since the elements of vanishing constant term are nilpotent; so of `x`
and `1 - x` at least one has a nonzero constant term. -/
instance isLocalRing_adjoinRoot_X_pow (n : ℕ) :
    IsLocalRing (AdjoinRoot ((X : k[X]) ^ (n + 1))) := by
  have : Nontrivial (AdjoinRoot ((X : k[X]) ^ (n + 1))) := by
    refine AdjoinRoot.nontrivial _ ?_
    rw [degree_X_pow]
    exact_mod_cast Nat.succ_ne_zero n
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun x ↦ ?_
  rcases eq_or_ne (AdjoinRoot.lift (RingHom.id k) (0 : k) (eval₂_id_zero_X_pow n) x) 0 with h | h
  · refine Or.inr (isUnit_of_lift_ne_zero_X_pow ?_)
    rw [map_sub, map_one, h, sub_zero]
    exact one_ne_zero
  · exact Or.inl (isUnit_of_lift_ne_zero_X_pow h)

/-- **The truncated polynomial algebra `k[X]/(Xⁿ)` has dimension `n`**: the classes of the powers of
`X` below `n` are a basis, Mathlib's `AdjoinRoot.powerBasis'` for the monic relator `Xⁿ`. -/
theorem finrank_adjoinRoot_X_pow (k : Type*) [Field k] (n : ℕ) :
    Module.finrank k (AdjoinRoot ((X : k[X]) ^ n)) = n := by
  rw [(AdjoinRoot.powerBasis' (monic_X_pow (R := k) n)).finrank]
  simp

end TauCeti
