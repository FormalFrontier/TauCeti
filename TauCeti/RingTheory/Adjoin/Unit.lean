module

public import Mathlib.RingTheory.Artinian.Algebra

/-!
# Algebra generated by an integral unit

This file records that over an Artinian commutative ring, the inverse of an integral unit belongs
to the algebra generated by that unit. The proof uses Mathlib's
`IsArtinianRing.isUnit_of_isIntegral_of_nonZeroDivisor` in the generated subalgebra.

## Main declarations

* `TauCeti.Units.coe_inv_mem_adjoin`: the inverse of an integral unit is contained in the algebra
  generated by that unit.
-/

public section

namespace TauCeti

universe u v

namespace Units

open nonZeroDivisors

variable {K : Type u} {A : Type v} [CommRing K] [IsArtinianRing K] [Ring A] [Algebra K A]

/-- The inverse of an integral unit over an Artinian commutative ring belongs to the algebra
generated by that unit. -/
theorem coe_inv_mem_adjoin (u : Aˣ) (hu : IsIntegral K (u : A)) :
    ((u⁻¹ : Aˣ) : A) ∈ Algebra.adjoin K {(u : A)} := by
  let B : Subalgebra K A := Algebra.adjoin K {(u : A)}
  let x : B := ⟨(u : A), Algebra.subset_adjoin (Set.mem_singleton _)⟩
  have hx_integral : IsIntegral K x :=
    (isIntegral_algHom_iff B.val Subtype.val_injective).mp hu
  have hinjective : Function.Injective B.subtype := Subtype.val_injective
  have hx_regular : x ∈ B⁰ :=
    comap_nonZeroDivisors_le_of_injective hinjective
      u.isUnit.mem_nonZeroDivisors
  have hx : IsUnit x :=
    IsArtinianRing.isUnit_of_isIntegral_of_nonZeroDivisor hx_integral hx_regular
  have hunit : hx.unit.map B.subtype = u := by
    apply Units.ext
    exact congrArg Subtype.val hx.unit_spec
  have hinv_units : (hx.unit⁻¹).map B.subtype = u⁻¹ := by
    rw [map_inv, hunit]
  have hinv : (((hx.unit⁻¹ : Bˣ) : B) : A) = ((u⁻¹ : Aˣ) : A) :=
    congrArg (fun z : Aˣ ↦ (z : A)) hinv_units
  rw [← hinv]
  exact ((hx.unit⁻¹ : Bˣ) : B).2

end Units

end TauCeti
