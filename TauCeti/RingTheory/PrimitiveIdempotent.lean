module

public import Mathlib.RingTheory.Ideal.Span
public import TauCeti.RingTheory.KrullSchmidt.Indecomposable

/-!
# Primitive idempotents

An idempotent `e` of a ring `A` is **primitive** when it is nonzero and cannot be split: there is
no way to write `e = e₁ + e₂` with `e₁` and `e₂` nonzero orthogonal idempotents. Primitive
idempotents are the atoms out of which a decomposition of `1` into orthogonal idempotents is
assembled, and the reason they matter is the theorem proved here: `e` is primitive exactly when
the left ideal `Ae` is an indecomposable module.

Splitting `e` is the same as finding an idempotent strictly between `0` and `e` in the corner ring
`eAe`, and that reformulation (`TauCeti.isPrimitiveIdempotent_iff_eq_zero_or_eq`) is what both the
module characterization and the applications consume: the idempotents `f` with `ef = fe = f` are
exactly the idempotents of `eAe`, and each of them splits `e` as `f + (e - f)`.

Mathlib has `IsIdempotentElem`, orthogonal families of idempotents
(`Mathlib/RingTheory/Idempotents.lean`) and the complete orthogonal decompositions of `1` they
generate, but no notion of a *primitive* idempotent and nothing connecting an idempotent to the
indecomposability of the left ideal it generates.

## Main definitions

* `TauCeti.IsPrimitiveIdempotent e`: `e` is a nonzero idempotent admitting no decomposition
  `e = e₁ + e₂` into nonzero orthogonal idempotents.

## Main results

* `TauCeti.isPrimitiveIdempotent_iff_eq_zero_or_eq`: primitivity read in the corner ring, as the
  statement that `0` and `e` are the only idempotents `f` with `ef = fe = f`.
* `TauCeti.isPrimitiveIdempotent_iff_isIndecomposableModule`: **an idempotent is primitive exactly
  when the left ideal it generates is an indecomposable module.** Both directions run along one
  dictionary: an idempotent of the corner ring acts on `Ae` by right multiplication, and every
  endomorphism of `Ae` is right multiplication by its value at `e`
  (`TauCeti.coe_apply_eq_mul_apply_generator`).
* `TauCeti.isPrimitiveIdempotent_iff_isLocalRing_end`: for a left ideal `Ae` of finite length,
  primitivity of `e` is the locality of `End (Ae)`; this is Fitting's lemma
  (`TauCeti.isIndecomposableModule_iff_isLocalRing_end`) read through the previous theorem.
* `TauCeti.isPrimitiveIdempotent_one_iff` and `TauCeti.isPrimitiveIdempotent_one`: `1` is primitive
  exactly when the ring has no idempotents besides `0` and `1`, which holds in a local ring.

## Implementation notes

The definition is the textbook one — no decomposition into two nonzero orthogonal idempotents —
rather than the corner-ring reformulation, which is derived. Keeping the two apart matters because
the derivation subtracts: the definition, the sufficient condition
`TauCeti.isPrimitiveIdempotent_of_eq_zero_or_eq` and the transport
`TauCeti.IsPrimitiveIdempotent.map` and the API for the left ideal `Ae` are stated over a semiring,
while the complement `e - f` that the reformulation needs, and everything after it, ask for a ring.

The left ideal generated by `e` is spelled `Ideal.span {e}` throughout. `Ideal` means *left* ideal
in Mathlib, which is the side the quiver-representation roadmap pins, its representations being
left modules. `TauCeti.mem_span_singleton_iff_mul_eq_self` says membership in `Ae` is exactly
`x * e = x`, which is the form every proof below uses; in particular `e` itself is a generator that
every element of `Ae` is a multiple of, on the nose rather than up to a sum.

## References

This implements the primitive-idempotent half of the finite-dimensional-algebra infrastructure of
Layer 3A in `TauCetiRoadmap/RepresentationTheory/QuiverRepresentations/README.md` ("a decomposition
of `1` into primitive orthogonal idempotents, the correspondence between primitive idempotents and
simple modules").

See I. Assem, D. Simson, A. Skowroński, *Elements of the Representation Theory of Associative
Algebras, Vol. 1*, Section I.4.
-/

public section

namespace TauCeti

universe u v

section Semiring

variable {A : Type u} [Semiring A] {e : A}

/-- An idempotent of a semiring is **primitive** when it is nonzero and is not the sum of two
nonzero orthogonal idempotents. -/
structure IsPrimitiveIdempotent (e : A) : Prop where
  /-- A primitive idempotent is an idempotent. -/
  isIdempotentElem : IsIdempotentElem e
  /-- A primitive idempotent is nonzero; without this `0` would be primitive in every ring. -/
  ne_zero : e ≠ 0
  /-- A primitive idempotent does not split: in every decomposition of it into two orthogonal
  idempotents one of the summands vanishes. -/
  eq_zero_or_eq_zero_of_add {e₁ e₂ : A} (h₁ : IsIdempotentElem e₁) (h₂ : IsIdempotentElem e₂)
    (h₁₂ : e₁ * e₂ = 0) (h₂₁ : e₂ * e₁ = 0) (hsum : e₁ + e₂ = e) : e₁ = 0 ∨ e₂ = 0

/-- A semiring carrying a primitive idempotent is nontrivial: that idempotent is nonzero. -/
theorem IsPrimitiveIdempotent.nontrivial (he : IsPrimitiveIdempotent e) : Nontrivial A :=
  ⟨e, 0, he.ne_zero⟩

/-- An idempotent whose corner ring contains no idempotent besides `0` and `e` is primitive: both
summands of a decomposition of `e` lie in that corner ring. -/
theorem isPrimitiveIdempotent_of_eq_zero_or_eq (he : IsIdempotentElem e) (h0 : e ≠ 0)
    (h : ∀ f : A, IsIdempotentElem f → e * f = f → f * e = f → f = 0 ∨ f = e) :
    IsPrimitiveIdempotent e where
  isIdempotentElem := he
  ne_zero := h0
  eq_zero_or_eq_zero_of_add {e₁ e₂} h₁ h₂ h₁₂ h₂₁ hsum := by
    have hee₁ : e * e₁ = e₁ := by rw [← hsum, add_mul, h₁.eq, h₂₁, add_zero]
    have he₁e : e₁ * e = e₁ := by rw [← hsum, mul_add, h₁.eq, h₁₂, add_zero]
    refine (h e₁ h₁ hee₁ he₁e).imp id fun he₁ ↦ ?_
    have h₂e : e₂ * e = e₂ := by rw [← hsum, mul_add, h₂₁, h₂.eq, zero_add]
    calc e₂ = e₂ * e := h₂e.symm
      _ = e₂ * e₁ := by rw [he₁]
      _ = 0 := h₂₁

/-- Primitivity transports along a semiring isomorphism: a decomposition of `σ e` pulls back along
`σ.symm` to a decomposition of `e`. -/
theorem IsPrimitiveIdempotent.map {B : Type v} [Semiring B] (σ : A ≃+* B)
    (he : IsPrimitiveIdempotent e) : IsPrimitiveIdempotent (σ e) where
  isIdempotentElem := he.isIdempotentElem.map σ
  ne_zero h := he.ne_zero (by simpa using congrArg σ.symm h)
  eq_zero_or_eq_zero_of_add {_ _} h₁ h₂ h₁₂ h₂₁ hsum :=
    (he.eq_zero_or_eq_zero_of_add (h₁.map σ.symm) (h₂.map σ.symm)
        (by simpa using congrArg σ.symm h₁₂) (by simpa using congrArg σ.symm h₂₁)
        (by simpa using congrArg σ.symm hsum)).imp
      (fun h ↦ by simpa using congrArg σ h) fun h ↦ by simpa using congrArg σ h

/-! ### The left ideal generated by an idempotent -/

/-- Membership in the left ideal generated by an idempotent: `x` lies in `Ae` exactly when `e` is a
right unit for `x`. -/
@[simp]
theorem mem_span_singleton_iff_mul_eq_self (he : IsIdempotentElem e) {x : A} :
    x ∈ (Ideal.span {e} : Ideal A) ↔ x * e = x := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ Ideal.mem_span_singleton'.2 ⟨x, hx⟩⟩
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hx
  rw [mul_assoc, he.eq]

/-- The generator of the left ideal it generates, as an element of that ideal. The body is not
exposed; consumers go through `TauCeti.coe_spanSingletonGenerator` and
`TauCeti.smul_spanSingletonGenerator`, never through the subtype. -/
def spanSingletonGenerator (e : A) : (Ideal.span {e} : Ideal A) :=
  ⟨e, Ideal.mem_span_singleton_self e⟩

/-- The generator of `Ae`, read in `A`, is `e`. -/
@[simp]
theorem coe_spanSingletonGenerator (e : A) :
    (spanSingletonGenerator e : A) = e := (rfl)

/-- Every element of `Ae` is the generator scaled by itself. -/
@[simp]
theorem smul_spanSingletonGenerator (he : IsIdempotentElem e)
    (x : (Ideal.span {e} : Ideal A)) : (x : A) • spanSingletonGenerator e = x :=
  Subtype.ext (by simpa using (mem_span_singleton_iff_mul_eq_self he).1 x.2)

/-- **An endomorphism of `Ae` is right multiplication by its value at the generator.** This is the
dictionary between the corner ring `eAe` and `End (Ae)`, and it is what makes primitivity of `e`
and indecomposability of `Ae` the same statement. -/
theorem coe_apply_eq_mul_apply_generator (he : IsIdempotentElem e)
    (f : Module.End A (Ideal.span {e} : Ideal A)) (x : (Ideal.span {e} : Ideal A)) :
    (f x : A) = (x : A) * (f (spanSingletonGenerator e) : A) := by
  conv_lhs => rw [← smul_spanSingletonGenerator he x]
  rw [map_smul]
  simp

end Semiring

section Ring

variable {A : Type u} [Ring A] {e : A}

/-- **Primitivity seen in the corner ring.** The only idempotents `f` with `ef = fe = f`, that is
the only idempotents of the corner ring `eAe`, are `0` and `e`: the complement `e - f` is an
idempotent orthogonal to `f`, and the two sum to `e`. -/
theorem IsPrimitiveIdempotent.eq_zero_or_eq (he : IsPrimitiveIdempotent e) {f : A}
    (hf : IsIdempotentElem f) (hef : e * f = f) (hfe : f * e = f) : f = 0 ∨ f = e := by
  have hsub : IsIdempotentElem (e - f) := hf.sub he.isIdempotentElem hfe hef
  have h₁₂ : f * (e - f) = 0 := by rw [mul_sub, hfe, hf.eq, sub_self]
  have h₂₁ : (e - f) * f = 0 := by rw [sub_mul, hef, hf.eq, sub_self]
  refine (he.eq_zero_or_eq_zero_of_add hf hsub h₁₂ h₂₁ (by abel)).imp id fun h ↦ ?_
  exact (sub_eq_zero.mp h).symm

/-- Primitivity of an idempotent, spelled entirely inside the corner ring `eAe`: it is nonzero and
the only idempotents `f` of `eAe` are `0` and `e`. -/
theorem isPrimitiveIdempotent_iff_eq_zero_or_eq :
    IsPrimitiveIdempotent e ↔ IsIdempotentElem e ∧ e ≠ 0 ∧
      ∀ f : A, IsIdempotentElem f → e * f = f → f * e = f → f = 0 ∨ f = e :=
  ⟨fun h ↦ ⟨h.isIdempotentElem, h.ne_zero, fun _ hf hef hfe ↦ h.eq_zero_or_eq hf hef hfe⟩,
    fun ⟨he, h0, h⟩ ↦ isPrimitiveIdempotent_of_eq_zero_or_eq he h0 h⟩

/-- **A primitive idempotent generates an indecomposable left ideal.** An idempotent endomorphism
`f` of `Ae` is right multiplication by `u = f e`, which is an idempotent of the corner ring `eAe`;
primitivity forces `u = 0` or `u = e`, that is, `f = 0` or `f = 1`. -/
theorem IsPrimitiveIdempotent.isIndecomposableModule (he : IsPrimitiveIdempotent e) :
    IsIndecomposableModule A (Ideal.span {e} : Ideal A) := by
  have hi := he.isIdempotentElem
  rw [isIndecomposableModule_iff_nontrivial_and_forall_isIdempotentElem]
  refine ⟨⟨spanSingletonGenerator e, 0, ?_⟩, fun f hf ↦ ?_⟩
  · rw [Ne, ← Submodule.coe_eq_zero, coe_spanSingletonGenerator]
    exact he.ne_zero
  set u : A := (f (spanSingletonGenerator e) : A) with hu
  have hue : u * e = u :=
    (mem_span_singleton_iff_mul_eq_self hi).1 (f (spanSingletonGenerator e)).2
  have heu : e * u = u := by
    simpa [hu] using (coe_apply_eq_mul_apply_generator hi f (spanSingletonGenerator e)).symm
  have huu : IsIdempotentElem u := by
    have happ : f (f (spanSingletonGenerator e)) = f (spanSingletonGenerator e) :=
      DFunLike.congr_fun hf.eq _
    have := coe_apply_eq_mul_apply_generator hi f (f (spanSingletonGenerator e))
    rw [happ] at this
    exact this.symm
  refine (he.eq_zero_or_eq huu heu hue).imp (fun h ↦ ?_) fun h ↦ ?_
  · refine LinearMap.ext fun x ↦ Subtype.ext ?_
    rw [coe_apply_eq_mul_apply_generator hi f x, ← hu, h, mul_zero]
    rfl
  · refine LinearMap.ext fun x ↦ Subtype.ext ?_
    rw [coe_apply_eq_mul_apply_generator hi f x, ← hu, h,
      (mem_span_singleton_iff_mul_eq_self hi).1 x.2]
    rfl

/-- **An idempotent generating an indecomposable left ideal is primitive.** An idempotent `f` of
the corner ring `eAe` gives the idempotent endomorphism `x ↦ x * f` of `Ae`, which by
indecomposability is `0` or `1`; evaluating at `e` gives `f = 0` or `f = e`. -/
theorem isPrimitiveIdempotent_of_isIndecomposableModule (he : IsIdempotentElem e)
    (h : IsIndecomposableModule A (Ideal.span {e} : Ideal A)) : IsPrimitiveIdempotent e := by
  rw [isIndecomposableModule_iff_nontrivial_and_forall_isIdempotentElem] at h
  obtain ⟨hnt, hidem⟩ := h
  have hne : e ≠ 0 := by
    rintro rfl
    rw [Ideal.span_singleton_eq_bot.2 rfl] at hnt
    exact absurd hnt (not_nontrivial _)
  refine isPrimitiveIdempotent_of_eq_zero_or_eq he hne fun f hf hef hfe ↦ ?_
  let φ : Module.End A (Ideal.span {e} : Ideal A) :=
    { toFun x := ⟨(x : A) * f, (mem_span_singleton_iff_mul_eq_self he).2 (by rw [mul_assoc, hfe])⟩
      map_add' x y := Subtype.ext (by simp [add_mul])
      map_smul' a x := Subtype.ext (by simp [mul_assoc]) }
  have hφapp : ∀ x : (Ideal.span {e} : Ideal A), (φ x : A) = (x : A) * f := fun x ↦ by simp [φ]
  have hφ : IsIdempotentElem φ := by
    refine LinearMap.ext fun x ↦ Subtype.ext ?_
    rw [Module.End.mul_apply, hφapp, hφapp, mul_assoc, hf.eq]
  have hgen : (φ (spanSingletonGenerator e) : A) = e * f := by
    rw [hφapp, coe_spanSingletonGenerator]
  refine (hidem φ hφ).imp (fun hz ↦ ?_) fun ho ↦ ?_
  · have h0 : e * f = 0 := by rw [← hgen, hz]; simp
    rwa [hef] at h0
  · have h1 : e * f = e := by rw [← hgen, ho]; simp
    rwa [hef] at h1

/-- **An idempotent is primitive exactly when the left ideal it generates is indecomposable.** -/
theorem isPrimitiveIdempotent_iff_isIndecomposableModule (he : IsIdempotentElem e) :
    IsPrimitiveIdempotent e ↔ IsIndecomposableModule A (Ideal.span {e} : Ideal A) :=
  ⟨fun h ↦ h.isIndecomposableModule, isPrimitiveIdempotent_of_isIndecomposableModule he⟩

/-- An idempotent generating a simple left ideal is primitive: a simple module is
indecomposable. -/
theorem isPrimitiveIdempotent_of_isSimpleModule (he : IsIdempotentElem e)
    [IsSimpleModule A (Ideal.span {e} : Ideal A)] : IsPrimitiveIdempotent e :=
  isPrimitiveIdempotent_of_isIndecomposableModule he IsSimpleModule.isIndecomposableModule

/-- **Primitivity as a local endomorphism ring.** For a left ideal of finite length, `e` is
primitive exactly when `End (Ae)` is local; this is Fitting's lemma read through
`TauCeti.isPrimitiveIdempotent_iff_isIndecomposableModule`. -/
theorem isPrimitiveIdempotent_iff_isLocalRing_end (he : IsIdempotentElem e)
    (hfin : IsFiniteLength A (Ideal.span {e} : Ideal A)) :
    IsPrimitiveIdempotent e ↔ IsLocalRing (Module.End A (Ideal.span {e} : Ideal A)) :=
  (isPrimitiveIdempotent_iff_isIndecomposableModule he).trans
    (isIndecomposableModule_iff_isLocalRing_end hfin)

/-! ### The unit -/

/-- `1` is primitive exactly when the ring has no idempotents besides `0` and `1`: the corner ring
of `1` is the whole ring. -/
theorem isPrimitiveIdempotent_one_iff [Nontrivial A] :
    IsPrimitiveIdempotent (1 : A) ↔ ∀ f : A, IsIdempotentElem f → f = 0 ∨ f = 1 :=
  ⟨fun h f hf ↦ h.eq_zero_or_eq hf (one_mul f) (mul_one f),
    fun h ↦ isPrimitiveIdempotent_of_eq_zero_or_eq .one one_ne_zero fun f hf _ _ ↦ h f hf⟩

/-- **`1` is primitive in a local ring.** An idempotent of a local ring is a unit or has a unit
complement, and in either case it is `1` or `0`. -/
theorem isPrimitiveIdempotent_one [IsLocalRing A] : IsPrimitiveIdempotent (1 : A) :=
  isPrimitiveIdempotent_one_iff.2 fun _ hf ↦
    IsLocalRing.eq_zero_or_eq_one_of_isIdempotentElem hf

end Ring

end TauCeti
