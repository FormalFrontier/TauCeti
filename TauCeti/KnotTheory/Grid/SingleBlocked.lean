module

public import TauCeti.KnotTheory.Grid.Unblocked

/-!
# The single-blocked grid map

The unblocked grid complex `GC⁻` has one polynomial variable `V_c` for each `O`-marking.  Blocking
the `O`-marking in a chosen column `i` means setting `V_i = 0`.  The resulting single-blocked
construction keeps the variables indexed by the other columns and counts exactly the empty
rectangles which cover neither an `X`-marking nor the blocked `O`-marking.  This specialization is
defined for every grid diagram and every commutative coefficient semiring.  For a knot grid over a
coefficient semiring of characteristic two, it is the simply blocked differential.  Outside
characteristic two it is only the unsigned candidate linear map: exactly as for the unblocked
differential it specializes, the unsigned rectangle count squares to zero only after a sign
assignment, and signs use additive inverses, so the sign-corrected construction needs a
commutative coefficient ring.  For a multi-component link, the corresponding simply blocked theory
instead requires blocking one `O`-marking on each component.

The coefficients form the polynomial semiring `R[V_c | c ≠ i]`, rather than one carrying a
redundant variable known to act by zero.  Mathlib's `MvPolynomial.killCompl` makes the relation to
`GC⁻` explicit, while `singleBlockedCoefficient_eq_sum` identifies the terms that remain after
specialization.

## Main definitions

* `Fin.SingleBlockedVariable`: the columns other than the blocked column.
* `TauCeti.SingleBlockedGridChain`: the free module underlying the one-variable specialization.
* `TauCeti.GridDiagram.singleBlockedRectangles`: the empty, `X`-avoiding rectangles which also
  avoid the chosen `O`-marking.
* `TauCeti.GridDiagram.singleBlockedDifferential`: the map obtained from `GC⁻` by
  specializing `V_i` to zero.

## References

The specialization and rectangle formula follow Ozsváth--Stipsicz--Szabó, *Grid Homology for
Knots and Links*, Chapter 4.6.
-/

public section

namespace TauCeti

open MvPolynomial

/-- The indices other than `i`.  For a grid diagram these index the polynomial variables that
remain after the `O`-marking in column `i` is blocked. -/
abbrev _root_.Fin.SingleBlockedVariable {n : ℕ} (i : Fin n) := {c : Fin n // c ≠ i}

/-- The chain module underlying the one-variable specialization, freely generated by grid states
over the polynomial semiring in the columns other than the blocked column. -/
abbrev SingleBlockedGridChain (R : Type*) [CommSemiring R] (n : ℕ) (i : Fin n) : Type _ :=
  GridChain (MvPolynomial i.SingleBlockedVariable R) n

/-- Coefficientwise specialization of an unblocked grid chain at `V_i = 0`.

This is semilinear over `MvPolynomial.killCompl`: specializing a polynomial multiple of a chain
specializes both the scalar and every coefficient. -/
noncomputable def singleBlockedSpecialization {n : ℕ} (R : Type*) [CommSemiring R] (i : Fin n) :
    GridChainMinus R n →ₛₗ[
      (MvPolynomial.killCompl (R := R) (f := Subtype.val)
        (Subtype.val_injective : Function.Injective
          (Subtype.val : i.SingleBlockedVariable → Fin n))).toRingHom]
      SingleBlockedGridChain R n i :=
  Finsupp.mapRange.linearMap
    (MvPolynomial.killCompl (R := R) (f := Subtype.val)
      (Subtype.val_injective : Function.Injective
        (Subtype.val : i.SingleBlockedVariable → Fin n))).toRingHom.toSemilinearMap

/-- Specializing a grid chain applies `MvPolynomial.killCompl` to each coefficient. -/
@[simp]
theorem singleBlockedSpecialization_apply {n : ℕ} (R : Type*) [CommSemiring R] (i : Fin n)
    (c : GridChainMinus R n) (x : GridState n) :
    singleBlockedSpecialization R i c x =
      MvPolynomial.killCompl (f := Subtype.val) Subtype.val_injective (c x) :=
  by
    rw [singleBlockedSpecialization, Finsupp.mapRange.linearMap_apply,
      Finsupp.mapRange_apply]
    exact congrFun (RingHom.coe_toSemilinearMap _) (c x)

/-- Specialization sends a single supported coefficient to the single supported specialized
coefficient. -/
@[simp]
theorem singleBlockedSpecialization_single {n : ℕ} (R : Type*) [CommSemiring R] (i : Fin n)
    (x : GridState n) (a : MvPolynomial (Fin n) R) :
    singleBlockedSpecialization R i (Finsupp.single x a) =
      Finsupp.single x
        (MvPolynomial.killCompl (f := Subtype.val) Subtype.val_injective a) := by
  classical
  rw [singleBlockedSpecialization, Finsupp.mapRange.linearMap_apply,
    Finsupp.mapRange_single, RingHom.coe_toSemilinearMap]
  congr 1

namespace GridDiagram

variable {n : ℕ} (G : GridDiagram n)
variable (R : Type*) [CommSemiring R]

/-- A rectangle covering the blocked `O`-marking has weight zero after specialization. -/
@[simp]
theorem killCompl_OMonomial_eq_zero_of_mem {i : Fin n} {r : GridRectangle n}
    (hi : i ∈ G.OColumns r) :
    MvPolynomial.killCompl (R := R) (f := Subtype.val)
      (Subtype.val_injective : Function.Injective
        (Subtype.val : i.SingleBlockedVariable → Fin n))
      (G.OMonomial R r) = 0 := by
  rw [G.OMonomial_eq_monomial R]
  apply MvPolynomial.killCompl_monomial_eq_zero_of_not_subset
  intro hsubset
  have hisupport : i ∈ (∑ c ∈ G.OColumns r, Finsupp.single c 1).support := by
    rw [Finsupp.mem_support_iff, Finsupp.finsetSum_apply, Finset.sum_eq_single i]
    · simp
    · intro c _ hci
      simp [hci]
    · exact fun h => (h hi).elim
  obtain ⟨c, hc⟩ := hsubset hisupport
  exact c.property hc

/-- A rectangle avoiding the blocked `O`-marking retains its monomial weight, with its exponent
vector restricted to the remaining variables. -/
@[simp]
theorem killCompl_OMonomial_eq_monomial_of_notMem {i : Fin n} {r : GridRectangle n}
    (hi : i ∉ G.OColumns r) :
    MvPolynomial.killCompl (R := R) (f := Subtype.val)
      (Subtype.val_injective : Function.Injective
          (Subtype.val : i.SingleBlockedVariable → Fin n)) (G.OMonomial R r) =
      MvPolynomial.monomial
        ((∑ c ∈ G.OColumns r, Finsupp.single c 1).comapDomain Subtype.val
          Subtype.val_injective.injOn) 1 := by
  rw [G.OMonomial_eq_monomial R]
  apply MvPolynomial.killCompl_monomial_eq_monomial_comapDomain_of_subset
  intro c hc
  have hcO : c ∈ G.OColumns r := by
    by_contra hcO
    apply (Finsupp.mem_support_iff.mp hc)
    rw [Finsupp.finsetSum_apply]
    apply Finset.sum_eq_zero
    intro d hd
    have hdc : d ≠ c := fun hdc => hcO (hdc ▸ hd)
    simp [hdc]
  exact ⟨⟨c, fun hci => hi (hci ▸ hcO)⟩, rfl⟩

/-- The rectangles counted after blocking column `i`: unblocked rectangles which do not cover
the `O`-marking in column `i`. -/
noncomputable def singleBlockedRectangles (i : Fin n) (x y : GridState n) :
    Finset (GridRectangleBetween x y) :=
  (G.unblockedRectangles x y).filter fun r => i ∉ G.OColumns r.toGridRectangle

/-- Membership in the single-blocked rectangle set is emptiness, `X`-avoidance, and avoidance of
the `O`-marking in the selected column. -/
@[simp]
theorem mem_singleBlockedRectangles (i : Fin n) {x y : GridState n}
    (r : GridRectangleBetween x y) :
    r ∈ G.singleBlockedRectangles i x y ↔
      r.IsEmpty ∧ Disjoint r.toGridRectangle.coveredSquares G.XSet ∧
        (i, G.O i) ∉ r.toGridRectangle.coveredSquares := by
  rw [singleBlockedRectangles, Finset.mem_filter, G.mem_unblockedRectangles,
    G.mem_OColumns]
  tauto

/-- Single-blocked rectangles are among those counted by the unblocked differential. -/
theorem singleBlockedRectangles_subset_unblockedRectangles (i : Fin n) (x y : GridState n) :
    G.singleBlockedRectangles i x y ⊆ G.unblockedRectangles x y :=
  Finset.filter_subset _ _

/-- There are no single-blocked rectangles from a grid state to itself. -/
@[simp]
theorem singleBlockedRectangles_self (i : Fin n) (x : GridState n) :
    G.singleBlockedRectangles i x x = ∅ := by
  simp [singleBlockedRectangles]

/-- The matrix coefficient of the single-blocked map, obtained by specializing the
corresponding coefficient of `GC⁻`. -/
noncomputable def singleBlockedCoefficient (i : Fin n) (x y : GridState n) :
    MvPolynomial i.SingleBlockedVariable R :=
  MvPolynomial.killCompl (f := Subtype.val) Subtype.val_injective
    (G.unblockedCoefficient R x y)

/-- The single-blocked coefficient is the finite sum over the contributing rectangles. Terms
covering the blocked marking disappear; the other terms survive under `MvPolynomial.killCompl`. -/
theorem singleBlockedCoefficient_eq_sum (i : Fin n) (x y : GridState n) :
    G.singleBlockedCoefficient R i x y =
      ∑ r ∈ G.singleBlockedRectangles i x y,
        MvPolynomial.killCompl (f := Subtype.val) Subtype.val_injective
          (G.OMonomial R r.toGridRectangle) := by
  classical
  rw [singleBlockedCoefficient, G.unblockedCoefficient_def R, map_sum]
  symm
  apply Finset.sum_subset (G.singleBlockedRectangles_subset_unblockedRectangles i x y)
  intro r hr hri
  have hi : i ∈ G.OColumns r.toGridRectangle := by
    by_contra hi
    exact hri (Finset.mem_filter.mpr ⟨hr, hi⟩)
  exact G.killCompl_OMonomial_eq_zero_of_mem R hi

/-- The single-blocked map has no diagonal matrix coefficient. -/
@[simp]
theorem singleBlockedCoefficient_self (i : Fin n) (x : GridState n) :
    G.singleBlockedCoefficient R i x x = 0 := by
  simp [singleBlockedCoefficient]

/-- The value of the single-blocked map on one grid-state generator. -/
noncomputable def singleBlockedDifferentialOnGenerator (i : Fin n) (x : GridState n) :
    SingleBlockedGridChain R n i :=
  Finsupp.equivFunOnFinite.symm (G.singleBlockedCoefficient R i x)

/-- The `y`-coefficient of the single-blocked map on the generator `x`. -/
@[simp]
theorem singleBlockedDifferentialOnGenerator_apply (i : Fin n) (x y : GridState n) :
    G.singleBlockedDifferentialOnGenerator R i x y = G.singleBlockedCoefficient R i x y := by
  exact congrFun (Finsupp.coe_equivFunOnFinite_symm (G.singleBlockedCoefficient R i x)) y

/-- The single-blocked map of a generator is supported on its column transpositions. -/
theorem singleBlockedDifferentialOnGenerator_support_subset (i : Fin n) (x : GridState n) :
    (G.singleBlockedDifferentialOnGenerator R i x).support ⊆ x.columnSwapNeighbors := by
  intro y hy
  rw [Finsupp.mem_support_iff, singleBlockedDifferentialOnGenerator_apply] at hy
  apply G.unblockedDifferentialOnGenerator_support_subset R x
  rw [Finsupp.mem_support_iff, G.unblockedDifferentialOnGenerator_apply R]
  intro hzero
  rw [singleBlockedCoefficient, hzero, map_zero] at hy
  exact hy rfl

/-- Specializing the unblocked differential of a generator gives its single-blocked row. -/
@[simp]
theorem singleBlockedSpecialization_unblockedDifferentialOnGenerator (i : Fin n)
    (x : GridState n) :
    singleBlockedSpecialization R i (G.unblockedDifferentialOnGenerator R x) =
      G.singleBlockedDifferentialOnGenerator R i x := by
  apply Finsupp.ext
  intro y
  rw [singleBlockedSpecialization_apply,
    G.singleBlockedDifferentialOnGenerator_apply R i x y,
    G.unblockedDifferentialOnGenerator_apply R x y]
  rw [singleBlockedCoefficient]

/-- The linear map obtained from the `GC⁻` differential by setting `V_i = 0`.  For a knot grid
over a coefficient semiring of characteristic two it is the simply blocked differential; outside
characteristic two it is only the unsigned candidate map, since sign correction uses additive
inverses and so needs a commutative coefficient ring.  A link with multiple components requires
one blocked marking on each component instead. -/
noncomputable def singleBlockedDifferential (i : Fin n) :
    SingleBlockedGridChain R n i →ₗ[MvPolynomial i.SingleBlockedVariable R]
      SingleBlockedGridChain R n i :=
  Finsupp.linearCombination (MvPolynomial i.SingleBlockedVariable R)
    (G.singleBlockedDifferentialOnGenerator R i)

/-- The single-blocked map sends a single generator to its rectangle-weight row. -/
@[simp]
theorem singleBlockedDifferential_single (i : Fin n) (x : GridState n) :
    G.singleBlockedDifferential R i (Finsupp.single x 1) =
      G.singleBlockedDifferentialOnGenerator R i x := by
  simp [singleBlockedDifferential]

/-- The single-blocked map is the finite sum of its generator rows over the support of
a chain. -/
theorem singleBlockedDifferential_apply (i : Fin n) (c : SingleBlockedGridChain R n i) :
    G.singleBlockedDifferential R i c =
      c.sum fun x a => a • G.singleBlockedDifferentialOnGenerator R i x := by
  rw [singleBlockedDifferential, Finsupp.linearCombination_apply]

/-- The coefficient formula for the single-blocked map on an arbitrary chain. -/
@[simp]
theorem singleBlockedDifferential_apply_apply (i : Fin n)
    (c : SingleBlockedGridChain R n i) (y : GridState n) :
    G.singleBlockedDifferential R i c y =
      c.sum fun x a => a * G.singleBlockedCoefficient R i x y := by
  rw [G.singleBlockedDifferential_apply R i c]
  simp [Finsupp.sum_apply]

private theorem singleBlockedSpecialization_unblockedDifferential_single (i : Fin n)
    (x : GridState n) (a : MvPolynomial (Fin n) R) :
    singleBlockedSpecialization R i
        (G.unblockedDifferential R (Finsupp.single x a)) =
      G.singleBlockedDifferential R i
        (singleBlockedSpecialization R i (Finsupp.single x a)) := by
  rw [singleBlockedSpecialization_single]
  nth_rewrite 1 [← Finsupp.smul_single_one x a]
  rw [map_smul, map_smulₛₗ,
    G.unblockedDifferential_single R x,
    G.singleBlockedSpecialization_unblockedDifferentialOnGenerator R i x,
    ← Finsupp.smul_single_one x
      (MvPolynomial.killCompl (f := Subtype.val) Subtype.val_injective a),
    map_smul, G.singleBlockedDifferential_single R i x]
  exact congrArg (fun b => b • G.singleBlockedDifferentialOnGenerator R i x)
    (congrFun
      (AlgHom.coe_toRingHom
        (MvPolynomial.killCompl (R := R) (f := Subtype.val) Subtype.val_injective)) a)

/-- Coefficientwise specialization intertwines the unblocked and single-blocked maps. -/
@[simp]
theorem singleBlockedSpecialization_unblockedDifferential (i : Fin n)
    (c : GridChainMinus R n) :
    singleBlockedSpecialization R i (G.unblockedDifferential R c) =
      G.singleBlockedDifferential R i (singleBlockedSpecialization R i c) := by
  induction c using Finsupp.induction with
  | zero =>
      rw [(G.unblockedDifferential R).map_zero,
        (singleBlockedSpecialization R i).map_zero,
        (G.singleBlockedDifferential R i).map_zero]
  | single_add x a c _ _ ih =>
      rw [(G.unblockedDifferential R).map_add, (singleBlockedSpecialization R i).map_add,
        (singleBlockedSpecialization R i).map_add,
        (G.singleBlockedDifferential R i).map_add, ih,
        G.singleBlockedSpecialization_unblockedDifferential_single R i x a]

end GridDiagram

end TauCeti
