module

public import Mathlib.MeasureTheory.Measure.FiniteMeasureExt
public import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Topology.ContinuousMap.StoneWeierstrass

/-!
# A finite measure on `ℝ≥0` is determined by its Laplace transform
-/

public section

noncomputable section

open MeasureTheory Set
open scoped NNReal

namespace TauCeti

/-- The decaying exponential `x ↦ exp (-t x)` as a bundled bounded continuous function. -/
private def expBCF (t : ℝ≥0) : ℝ≥0 →ᵇ ℝ where
  toFun := fun x => Real.exp (-((t : ℝ) * (x : ℝ)))
  continuous_toFun := Real.continuous_exp.comp ((continuous_const.mul continuous_subtype_val).neg)
  map_bounded' :=
    ⟨1, fun p q => by
      rw [Real.dist_eq]
      have hp0 : 0 < Real.exp (-((t : ℝ) * (p : ℝ))) := Real.exp_pos _
      have hp1 : Real.exp (-((t : ℝ) * (p : ℝ))) ≤ 1 := by
        rw [Real.exp_le_one_iff]
        exact neg_nonpos.mpr (mul_nonneg t.2 p.2)
      have hq0 : 0 < Real.exp (-((t : ℝ) * (q : ℝ))) := Real.exp_pos _
      have hq1 : Real.exp (-((t : ℝ) * (q : ℝ))) ≤ 1 := by
        rw [Real.exp_le_one_iff]
        exact neg_nonpos.mpr (mul_nonneg t.2 q.2)
      exact abs_sub_le_iff.mpr ⟨by linarith, by linarith⟩⟩

@[simp]
private theorem expBCF_apply (t x : ℝ≥0) : expBCF t x = Real.exp (-((t : ℝ) * (x : ℝ))) := rfl

/-- The exponentials are already closed under multiplication, with `expBCF 0 = 1`, so they form a
submonoid rather than merely generating one. -/
private def expMonoid : Submonoid (ℝ≥0 →ᵇ ℝ) where
  carrier := Set.range expBCF
  mul_mem' := by
    rintro _ _ ⟨s, rfl⟩ ⟨t, rfl⟩
    refine ⟨s + t, ?_⟩
    ext x
    simp only [expBCF_apply, BoundedContinuousFunction.mul_apply, NNReal.coe_add]
    rw [← Real.exp_add]
    ring_nf
  one_mem' := ⟨0, by ext x; simp⟩

private theorem mem_expMonoid_iff {g : ℝ≥0 →ᵇ ℝ} : g ∈ expMonoid ↔ ∃ t, expBCF t = g := Iff.rfl

/-- The star subalgebra generated by the decaying exponentials. -/
private def expAlgebra : StarSubalgebra ℝ (ℝ≥0 →ᵇ ℝ) where
  toSubalgebra := Algebra.adjoin ℝ (Set.range expBCF)
  star_mem' {a} ha := by
    have hstar : star a = a := by ext x; exact star_trivial _
    rwa [hstar]

private theorem expAlgebra_separatesPoints :
    (expAlgebra.map (toContinuousMapStarₐ ℝ)).SeparatesPoints := by
  intro x y hxy
  refine ⟨(expBCF 1 : ℝ≥0 → ℝ), ⟨expBCF 1, StarSubalgebra.mem_map.mpr
    ⟨expBCF 1, Algebra.subset_adjoin (Set.mem_range_self 1), rfl⟩, rfl⟩, ?_⟩
  simp only [expBCF_apply, NNReal.coe_one, one_mul]
  exact fun h => hxy (NNReal.coe_injective (by
    have := Real.exp_injective (by simpa using h)
    linarith))

/-- **A finite measure on `ℝ≥0` is determined by its Laplace transform.** -/
theorem Measure.ext_of_forall_integral_exp_neg_mul_eq {μ ν : Measure ℝ≥0}
    [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ t : ℝ, 0 ≤ t →
      ∫ x, Real.exp (-t * (x : ℝ)) ∂μ = ∫ x, Real.exp (-t * (x : ℝ)) ∂ν) :
    μ = ν := by
  refine ext_of_forall_mem_subalgebra_integral_eq_of_polish expAlgebra_separatesPoints ?_
  intro g hg
  have hmem : g ∈ Submodule.span ℝ (Submonoid.closure (Set.range expBCF)) :=
    Algebra.adjoin_eq_span (R := ℝ) (s := Set.range expBCF) ▸ hg
  clear hg
  rw [show Submonoid.closure (Set.range expBCF) = expMonoid from
    (Submonoid.closure_eq expMonoid).symm ▸ rfl] at hmem
  induction hmem using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨t, rfl⟩ := mem_expMonoid_iff.mp hf
    simpa only [expBCF_apply, neg_mul] using h t t.2
  | zero => simp
  | add a b _ _ ha hb =>
    simp only [BoundedContinuousFunction.add_apply]
    rw [integral_add (a.integrable μ) (b.integrable μ),
      integral_add (a.integrable ν) (b.integrable ν), ha, hb]
  | smul c a _ ha =>
    simp only [BoundedContinuousFunction.smul_apply, smul_eq_mul]
    rw [integral_const_mul, integral_const_mul, ha]

end TauCeti
