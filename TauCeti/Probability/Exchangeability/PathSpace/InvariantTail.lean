module

public import TauCeti.Probability.Exchangeability.PathSpace.Exchangeable.Sigma
public import TauCeti.Probability.Exchangeability.PathSpace.Shift
public import TauCeti.Probability.Process.Tail.Basic
public import Mathlib.MeasureTheory.MeasurableSpace.Invariants

/-!
# The shift-invariant σ-algebra sits strictly inside the path tail σ-algebra

For the one-sided shift on path space `ℕ → α`, an ambient-measurable event fixed by the shift is
fixed by every iterate of the shift, and therefore depends only on the coordinates from an
arbitrarily late time onward.  This file proves that comparison,

`MeasurableSpace.invariants (shift α) ≤ pathTail α`,

and shows that the inclusion is **strict**: for `Bool`-valued paths, the tail event "the value
`true` occurs at infinitely many even times" is not shift-invariant, because the shift exchanges
even and odd times.

The Layer 2 exchangeability roadmap warns against silently identifying the tail σ-algebra with the
shift-invariant σ-algebra for one-sided sequences; these two results are the exact form of that
comparison.  Combining with `pathTail_le_exchangeableSigma` from
`TauCeti.Probability.Exchangeability.PathSpace.Exchangeable.Sigma` gives the chain

`invariants (shift α) ≤ pathTail α ≤ exchangeableSigma α`,

with the first inclusion strict already over `Bool`.

The engine of the positive direction is `tailFamily_coord_eq_comap_shift_iterate`: the future path
σ-algebra from time `n` onward *is* the σ-algebra generated by the `n`-fold shift.  That identity
also gives the shift description `pathTail_eq_iInf_comap_shift_iterate` of the path tail
σ-algebra.

## Main results

* `tailFamily_coord_eq_comap_shift_iterate`
* `pathTail_eq_iInf_comap_shift_iterate`
* `invariants_shift_le_pathTail`
* `invariants_shift_le_exchangeableSigma`
* `not_pathTail_le_invariants_shift`
* `invariants_shift_lt_pathTail`
-/

public section

noncomputable section

open MeasureTheory

namespace TauCeti

namespace Probability

variable {α β : Type*} [MeasurableSpace α]

/-! ## Future σ-algebras as shift preimages -/

/-- The future path σ-algebra from time `n` onward is the σ-algebra generated by the `n`-fold
shift: an event depends only on the coordinates `n, n + 1, …` exactly when it is the preimage of an
ambient-measurable event under `(shift α)^[n]`. -/
theorem tailFamily_coord_eq_comap_shift_iterate (n : ℕ) :
    tailFamily (fun k (x : ℕ → α) => x k) n =
      MeasurableSpace.comap ((shift α)^[n]) inferInstance := by
  rw [tailFamily_eq_comap_shift, shift_iterate_eq_reindex n]
  simp only [Nat.add_comm]

/-- The path tail σ-algebra is the intersection of the σ-algebras generated by the iterated
shifts. -/
theorem pathTail_eq_iInf_comap_shift_iterate :
    pathTail α = ⨅ n : ℕ, MeasurableSpace.comap ((shift α)^[n]) inferInstance := by
  rw [pathTail_eq_tailProcess, tailProcess_eq_iInf_tailFamily]
  exact iInf_congr fun n => tailFamily_coord_eq_comap_shift_iterate n

/-- An ambient-measurable event fixed by the `n`-fold shift lies in the future path σ-algebra from
time `n` onward. -/
private theorem measurableSet_tailFamily_of_preimage_shift_iterate_eq {s : Set (ℕ → α)} {n : ℕ}
    (hs : MeasurableSet s) (hinv : (shift α)^[n] ⁻¹' s = s) :
    MeasurableSet[tailFamily (fun k (x : ℕ → α) => x k) n] s := by
  rw [tailFamily_coord_eq_comap_shift_iterate]
  exact ⟨s, hs, hinv⟩

/-! ## Shift-invariant events are tail events -/

/-- **A shift-invariant event is a tail event.**  A shift-invariant event is fixed by every iterate
of the one-sided shift, hence for each `n` it is the preimage under `(shift α)^[n]` of an
ambient-measurable event, so it depends only on the coordinates from time `n` onward. -/
theorem invariants_shift_le_pathTail :
    MeasurableSpace.invariants (shift α) ≤ pathTail α := by
  intro s hs
  rw [pathTail_eq_tailProcess, tailProcess_eq_iInf_tailFamily, MeasurableSpace.measurableSet_iInf]
  intro n
  have hn : MeasurableSet[MeasurableSpace.invariants ((shift α)^[n])] s :=
    MeasurableSpace.le_invariants_iterate (shift α) n s hs
  obtain ⟨hs_meas, hs_inv⟩ := MeasurableSpace.measurableSet_invariants.mp hn
  exact measurableSet_tailFamily_of_preimage_shift_iterate_eq hs_meas hs_inv

/-- An observable measurable for the shift-invariant σ-algebra is tail-measurable. -/
theorem measurable_pathTail_of_measurable_invariants_shift [MeasurableSpace β]
    {g : (ℕ → α) → β} (hg : Measurable[MeasurableSpace.invariants (shift α)] g) :
    Measurable[pathTail α] g :=
  hg.mono invariants_shift_le_pathTail le_rfl

/-- A shift-invariant event is an exchangeable event: it is a tail event, and tail events are fixed
by every finitely supported permutation of the time coordinate. -/
theorem invariants_shift_le_exchangeableSigma :
    MeasurableSpace.invariants (shift α) ≤ exchangeableSigma α :=
  invariants_shift_le_pathTail.trans pathTail_le_exchangeableSigma

/-! ## The inclusion is strict

The one-sided shift moves even times to odd times, so a tail event that refers to the even times
only need not be shift-invariant.  The witness below is the `Bool`-valued event "the value `true`
occurs at infinitely many even times". -/

/-- The path-space event that a `Bool`-valued path takes the value `true` at infinitely many even
times.  It is a tail event which the one-sided shift does not preserve. -/
private def trueFrequentlyAtEvenTimes : Set (ℕ → Bool) :=
  ⋂ N : ℕ, ⋃ n : ℕ, {x : ℕ → Bool | x (2 * (N + n)) = true}

/-- Membership in `trueFrequentlyAtEvenTimes` says that `true` occurs at arbitrarily late even
times. -/
private theorem mem_trueFrequentlyAtEvenTimes {x : ℕ → Bool} :
    x ∈ trueFrequentlyAtEvenTimes ↔ ∀ N, ∃ n, N ≤ n ∧ x (2 * n) = true := by
  simp only [trueFrequentlyAtEvenTimes, Set.mem_iInter, Set.mem_iUnion, Set.mem_setOf_eq]
  constructor
  · intro h N
    obtain ⟨n, hn⟩ := h N
    exact ⟨N + n, Nat.le_add_right N n, hn⟩
  · intro h N
    obtain ⟨n, hNn, hn⟩ := h N
    exact ⟨n - N, by rwa [Nat.add_sub_cancel' hNn]⟩

/-- `trueFrequentlyAtEvenTimes` can be written using only the even times beyond any prescribed
cutoff `r`; this is what makes it measurable for every future σ-algebra. -/
private theorem trueFrequentlyAtEvenTimes_eq_iInter_iUnion (r : ℕ) :
    trueFrequentlyAtEvenTimes =
      ⋂ N : ℕ, ⋃ n : ℕ, {x : ℕ → Bool | x (2 * (r + N + n)) = true} := by
  ext x
  simp only [mem_trueFrequentlyAtEvenTimes, Set.mem_iInter, Set.mem_iUnion, Set.mem_setOf_eq]
  constructor
  · intro h N
    obtain ⟨n, hn, hx⟩ := h (r + N)
    exact ⟨n - (r + N), by rwa [Nat.add_sub_cancel' hn]⟩
  · intro h N
    obtain ⟨n, hx⟩ := h N
    exact ⟨r + N + n, by omega, hx⟩

/-- `trueFrequentlyAtEvenTimes` belongs to every future path σ-algebra. -/
private theorem measurableSet_tailFamily_trueFrequentlyAtEvenTimes (r : ℕ) :
    MeasurableSet[tailFamily (fun k (x : ℕ → Bool) => x k) r] trueFrequentlyAtEvenTimes := by
  rw [trueFrequentlyAtEvenTimes_eq_iInter_iUnion r]
  refine MeasurableSet.iInter fun N => MeasurableSet.iUnion fun n => ?_
  have hset : {x : ℕ → Bool | x (2 * (r + N + n)) = true} =
      (fun x : ℕ → Bool => x (2 * (r + N + n))) ⁻¹' {true} := rfl
  rw [hset]
  exact measurable_tailFamily_of_le (X := fun k (x : ℕ → Bool) => x k)
    (by omega) (measurableSet_singleton true)

/-- `trueFrequentlyAtEvenTimes` is a tail event. -/
private theorem measurableSet_pathTail_trueFrequentlyAtEvenTimes :
    MeasurableSet[pathTail Bool] trueFrequentlyAtEvenTimes := by
  rw [pathTail_eq_tailProcess, tailProcess_eq_iInf_tailFamily, MeasurableSpace.measurableSet_iInf]
  exact measurableSet_tailFamily_trueFrequentlyAtEvenTimes

/-- The one-sided shift does not preserve `trueFrequentlyAtEvenTimes`: the alternating path lies
in the event, while its shift, which is `true` exactly at the odd times, does not. -/
private theorem preimage_shift_trueFrequentlyAtEvenTimes_ne :
    shift Bool ⁻¹' trueFrequentlyAtEvenTimes ≠ trueFrequentlyAtEvenTimes := by
  intro h
  set x : ℕ → Bool := fun k => decide (k % 2 = 0) with hx
  have hmem : x ∈ trueFrequentlyAtEvenTimes := by
    rw [mem_trueFrequentlyAtEvenTimes]
    refine fun N => ⟨N, le_rfl, ?_⟩
    simp [hx, Nat.mul_mod_right]
  have hshift : shift Bool x ∉ trueFrequentlyAtEvenTimes := by
    intro hmem_shift
    obtain ⟨n, -, hn⟩ := mem_trueFrequentlyAtEvenTimes.mp hmem_shift 0
    have hodd : (2 * n + 1) % 2 = 1 := by omega
    simp [hx, shift_apply, hodd] at hn
  have hpre : x ∈ shift Bool ⁻¹' trueFrequentlyAtEvenTimes := by rw [h]; exact hmem
  exact hshift hpre

/-- **The path tail σ-algebra is not contained in the shift-invariant σ-algebra**: for `Bool`-valued
paths, the tail event "the value `true` occurs at infinitely many even times" is not fixed by the
one-sided shift, which carries the even times onto the odd ones. -/
theorem not_pathTail_le_invariants_shift :
    ¬ pathTail Bool ≤ MeasurableSpace.invariants (shift Bool) := fun h =>
  preimage_shift_trueFrequentlyAtEvenTimes_ne
    (MeasurableSpace.measurableSet_invariants.mp
      (h _ measurableSet_pathTail_trueFrequentlyAtEvenTimes)).2

/-- For `Bool`-valued paths the inclusion `invariants_shift_le_pathTail` is strict: the
shift-invariant σ-algebra is a proper sub-σ-algebra of the path tail σ-algebra. -/
theorem invariants_shift_lt_pathTail :
    MeasurableSpace.invariants (shift Bool) < pathTail Bool :=
  lt_of_le_not_ge invariants_shift_le_pathTail not_pathTail_le_invariants_shift

/-- For `Bool`-valued paths the shift-invariant σ-algebra is a proper sub-σ-algebra of the
exchangeable σ-algebra. -/
theorem invariants_shift_lt_exchangeableSigma :
    MeasurableSpace.invariants (shift Bool) < exchangeableSigma Bool :=
  invariants_shift_lt_pathTail.trans_le pathTail_le_exchangeableSigma

end Probability

end TauCeti
