module

public import Mathlib.Probability.Independence.Basic

/-!
# Independence from disjoint blocks of an independent family

Mathlib's `ProbabilityTheory.iIndepFun.indepFun_finset` splits an independent family along two
disjoint **finite** index sets. The statement is true for arbitrary index sets, and that is what a
random object built from a countably infinite block of independent noise needs: the two objects are
independent as soon as the coordinates they read are disjoint, however many of them there are.

`TauCeti.Probability.blockSigma` names the σ-algebra a block of coordinates generates, and
`TauCeti.Probability.indepFun_of_measurable_blockSigma` is the resulting independence criterion. The
proof is Mathlib's `ProbabilityTheory.indep_iSup_of_disjoint` together with the monotonicity of
independence in both σ-algebras.

## Main declarations

* `TauCeti.Probability.blockSigma` — the σ-algebra generated by a set of members of a family of
  random variables;
* `TauCeti.Probability.measurable_blockSigma_of_mem` — a member of the block is measurable for it;
* `TauCeti.Probability.indepFun_of_measurable_blockSigma` — two random elements measurable for the
  σ-algebras of disjoint blocks of an independent family are independent.
-/

public section

open MeasureTheory

namespace TauCeti

namespace Probability

variable {Ω ι : Type*} [MeasurableSpace Ω] {β : ι → Type*} [∀ i, MeasurableSpace (β i)]

/-- The σ-algebra generated by the members `Z i` of a family with `i` in a block `S` of indices. -/
@[implicit_reducible]
def blockSigma (Z : ∀ i, Ω → β i) (S : Set ι) : MeasurableSpace Ω :=
  ⨆ i ∈ S, MeasurableSpace.comap (Z i) inferInstance

omit [MeasurableSpace Ω] in
/-- A member of a block is measurable for the σ-algebra that block generates. -/
theorem measurable_blockSigma_of_mem {Z : ∀ i, Ω → β i} {S : Set ι} {i : ι} (hi : i ∈ S) :
    Measurable[blockSigma Z S] (Z i) :=
  Measurable.of_comap_le
    (le_iSup₂ (f := fun i (_ : i ∈ S) => MeasurableSpace.comap (Z i) inferInstance) i hi)

/-- The σ-algebra of a block of an independent family sits inside the ambient σ-algebra. -/
theorem blockSigma_le {Z : ∀ i, Ω → β i} (S : Set ι)
    (hZ : ∀ i ∈ S, Measurable (Z i)) :
    blockSigma Z S ≤ (inferInstance : MeasurableSpace Ω) :=
  iSup₂_le fun i hi => (hZ i hi).comap_le

/-- **Disjoint blocks of an independent family are independent.** Two random elements, each
measurable for the σ-algebra generated by its own block of an independent family, are independent
as soon as the two blocks are disjoint. Unlike
`ProbabilityTheory.iIndepFun.indepFun_finset`, the blocks may be infinite. -/
theorem indepFun_of_measurable_blockSigma {μ : Measure Ω} {Z : ∀ i, Ω → β i}
    (hZ : ProbabilityTheory.iIndepFun Z μ) {S T : Set ι}
    (hZ_meas : ∀ i ∈ S ∪ T, Measurable (Z i)) (hST : Disjoint S T)
    {γ δ : Type*} [MeasurableSpace γ] [MeasurableSpace δ] {U : Ω → γ} {V : Ω → δ}
    (hU : Measurable[blockSigma Z S] U) (hV : Measurable[blockSigma Z T] V) :
    ProbabilityTheory.IndepFun U V μ := by
  classical
  let m : ι → MeasurableSpace Ω := fun i =>
    if i ∈ S ∪ T then MeasurableSpace.comap (Z i) inferInstance else ⊥
  have hm_le : ∀ i, m i ≤ (inferInstance : MeasurableSpace Ω) := by
    intro i
    simp only [m]
    split_ifs with hi
    · exact (hZ_meas i hi).comap_le
    · exact bot_le
  have hm_indep : ProbabilityTheory.iIndep m μ :=
    ProbabilityTheory.iIndep_of_iIndep_of_le hZ.iIndep fun i => by
      simp only [m]
      split_ifs <;> simp
  have hm_block (A : Set ι) (hA : A ⊆ S ∪ T) : (⨆ i ∈ A, m i) = blockSigma Z A := by
    apply le_antisymm
    · rw [blockSigma]
      refine iSup₂_le fun i hi => ?_
      have hmi : m i = MeasurableSpace.comap (Z i) inferInstance := by
        simp only [m, ite_eq_left (hA hi)]
      rw [hmi]
      exact le_iSup_of_le i (le_iSup_of_le hi le_rfl)
    · rw [blockSigma]
      refine iSup₂_le fun i hi => ?_
      have hmi : m i = MeasurableSpace.comap (Z i) inferInstance := by
        simp only [m, ite_eq_left (hA hi)]
      rw [← hmi]
      exact le_iSup_of_le i (le_iSup_of_le hi le_rfl)
  have hblocks := ProbabilityTheory.indep_iSup_of_disjoint hm_le hm_indep hST
  rw [hm_block S Set.subset_union_left, hm_block T Set.subset_union_right] at hblocks
  exact ProbabilityTheory.indep_of_indep_of_le
    hblocks hU.comap_le hV.comap_le

end Probability

end TauCeti
