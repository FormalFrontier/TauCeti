/-!
# The class number of a function field with a finite constant field

Let `F / k` be an algebraic function field. Riemann's theorem produces, from a divisor `B` and an
`n` with `n · deg B ≥ g`, an **effective** representative of degree `n · deg B` in the class of
`D + n·B` for every degree-zero divisor `D`
(`TauCeti.Divisor.exists_isEffective_linearlyEquivalent_add_nsmul`): so the class of a degree-zero
divisor is the class of `A - n·B` with `A` effective of one fixed degree.  Taking `B` to be a
place makes `deg B` positive, so such an `n` exists.

When the constant field `k` is **finite** there are only finitely many effective divisors of a
given degree — the places of bounded degree are finite in number
(`TauCeti.Place.finite_setOf_degree_le`) and an effective divisor of degree at most `n` is
supported on places of degree at most `n` with coefficients in `[0, n]`. Combining the two gives
the finiteness of the degree-zero divisor class group `Cl⁰(F) = ker (deg : Cl(F) → ℤ)`, whose
cardinality is the **class number** `h_F`.

This is Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., Lemma 5.1.1 and
Proposition 5.1.3, the zeta-free half of his Section V.1: no zeta function, no functional
equation, and no exactness hypothesis on the constant field.

⚠ `TauCeti.Divisor.classNumber` is **not** Mathlib's `FunctionField.classNumber`
(`Mathlib/NumberTheory/ClassNumber/FunctionField.lean`), which is
`#ClassGroup (FunctionField.ringOfIntegers Fq F)`: the class number of the *finite chart* of one
chosen model, defined only for a chosen embedding of `Fq(X)` and under separability of
`F / Fq(X)`.  The two differ by the places at infinity of that model — `Cl⁰(F)` surjects onto
`ClassGroup R_x`, with kernel generated by the classes of the places over `∞` — and the
comparison is the affine class-group bridge, which is not proved here.

## Main definitions

* `TauCeti.Divisor.classNumber`: `h_F = #Cl⁰(F)`, the cardinality of the degree-zero divisor
  class group.

## Main results

* `TauCeti.Divisor.finite_setOf_isEffective_degree_le`: over a finite constant field there are
  finitely many effective divisors of bounded degree (Lemma 5.1.1).
* `TauCeti.Divisor.exists_isEffective_linearlyEquivalent_add_nsmul`: the effective representative
  of fixed degree in a degree-zero class, from Riemann's theorem.
* `TauCeti.Divisor.finite_ker_degreeClass`: **`Cl⁰(F)` is finite** (Proposition 5.1.3), with
  `TauCeti.Divisor.classNumber_pos` recording that the class number is then positive.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Section V.1.
-/

public section

namespace TauCeti

open AlgebraicGeometry

universe u v

variable {k : Type u} {F : Type v} [Field k] [Field F] [Algebra k F]

namespace Divisor

/-! ### Counting effective divisors -/

/-- **Over a finite constant field there are only finitely many effective divisors of degree at
most `n`** (Stichtenoth, Lemma 5.1.1): such a divisor is supported on the finitely many places of
degree at most `n`, and its coefficients lie in `[0, n]`. -/
theorem finite_setOf_isEffective_degree_le (hF : IsFunctionField k F) [Finite k] (n : ℕ) :
    {D : Divisor k F | WeilDivisor.IsEffective D ∧ degree D ≤ (n : ℤ)}.Finite := by
  set E : Set (Divisor k F) := {D | WeilDivisor.IsEffective D ∧ degree D ≤ (n : ℤ)}
  set S : Set (Place k F) := {P | P.degree ≤ n}
  have : Finite S := (Place.finite_setOf_degree_le hF n).to_subtype
  have : Finite (Set.Icc (0 : ℤ) n) := (Set.finite_Icc _ _).to_subtype
  have hle : ∀ D ∈ E, (0 : Divisor k F) ≤ D := fun _ hD ↦
    WeilDivisor.isEffective_iff_zero_le.mp hD.1
  have hmem : ∀ D ∈ E, ∀ P : Place k F, (D : Divisor k F).coeff P ∈ Set.Icc (0 : ℤ) n :=
    fun D hD P ↦ ⟨WeilDivisor.coeff_le_coeff (hle D hD) P,
      (coeff_le_degree hF (hle D hD) P).trans hD.2⟩
  have hzero : ∀ D ∈ E, ∀ P : Place k F, P ∉ S → (D : Divisor k F).coeff P = 0 := by
    intro D hD P hP
    by_contra hne
    exact hP (mod_cast (degree_le_degree_of_coeff_ne_zero (hle D hD) hne).trans hD.2)
  have : Finite E := by
    refine Finite.of_injective
      (fun D : E ↦ fun P : S ↦ (⟨(D : Divisor k F).coeff P, hmem D D.2 P⟩ : Set.Icc (0 : ℤ) n)) ?_
    intro D₁ D₂ h
    refine Subtype.ext (WeilDivisor.ext fun P ↦ ?_)
    by_cases hP : P ∈ S
    · exact congrArg Subtype.val (congrFun h ⟨P, hP⟩)
    · rw [hzero _ D₁.2 P hP, hzero _ D₂.2 P hP]
  exact Set.toFinite E

/-! ### The effective representative of a degree-zero class -/

/-- **Every degree-zero divisor class contains a divisor of the form `A - n·B`, with `A` effective
of degree `n · deg B`** — for any divisor `B` and any `n` with `n · deg B` at least the genus
(Stichtenoth, the representative step in the proof of Proposition 5.1.3). Riemann's theorem makes
`L(D + n·B)` nonzero, and a nonzero function in it moves `D + n·B` to an effective divisor of the
same degree. -/
theorem exists_isEffective_linearlyEquivalent_add_nsmul (hF : IsFunctionField k F)
    {B D : Divisor k F} {n : ℕ} (hn : (genus k F : ℤ) ≤ n * degree B) (hD : degree D = 0) :
    ∃ A : Divisor k F, WeilDivisor.IsEffective A ∧ degree A = n * degree B ∧
      (Place.orderSystem hF).LinearlyEquivalent A (D + n • B) := by
  have hnB : degree (n • B) = n * degree B := by rw [map_nsmul, nsmul_eq_mul]
  have hdeg : degree (D + n • B) = n * degree B := by rw [degree_add, hD, zero_add, hnB]
  have hdim : 1 ≤ (Divisor.dim (D + n • B) : ℤ) := by
    have hR := Divisor.degree_add_one_sub_genus_le_dim hF (D + n • B)
    rw [hdeg] at hR
    omega
  obtain ⟨z, hz, hz0⟩ : ∃ z : F, z ∈ riemannRochSpace (D + n • B) ∧ z ≠ 0 :=
    Submodule.exists_mem_ne_zero_of_ne_bot
      ((Divisor.one_le_dim_iff_riemannRochSpace_ne_bot hF _).mp (mod_cast hdim))
  refine ⟨principal hF (Units.mk0 z hz0) + (D + n • B), ?_, ?_, ?_⟩
  · refine (WeilDivisor.isEffective_iff _).mpr fun P ↦ ?_
    have hord := (mem_riemannRochSpace_iff_neg_le_ord hz0).mp hz P
    rw [WeilDivisor.coeff_add, coeff_principal, Units.val_mk0]
    omega
  · rw [degree_add, degree_principal hF, zero_add, hdeg]
  · refine ((Place.orderSystem hF).linearlyEquivalent_iff).mpr ?_
    rw [add_sub_cancel_right]
    exact (mem_principalSubgroup_iff hF).mpr ⟨Units.mk0 z hz0, rfl⟩

/-! ### The class number -/

/-- **The degree-zero divisor class group `Cl⁰(F)` of an algebraic function field with a finite
constant field is finite** (Stichtenoth, Proposition 5.1.3): every degree-zero class is the class
of `A - n·B` for a fixed divisor `B` and an effective `A` of one fixed degree, and there are only
finitely many such `A`. -/
theorem finite_ker_degreeClass (hF : IsFunctionField k F) [Finite k] :
    Finite (Divisor.degreeClass hF).ker := by
  obtain ⟨P⟩ := Place.nonempty hF
  set B : Divisor k F := WeilDivisor.ofPoint P with hBdef
  have hBpos : 1 ≤ degree B := by
    rw [hBdef, degree_ofPoint]
    exact_mod_cast P.one_le_degree_of_isFunctionField hF
  set n : ℕ := genus k F
  have hgen : (genus k F : ℤ) ≤ n * degree B := by nlinarith [Int.natCast_nonneg (genus k F)]
  set m : ℕ := (n * degree B).toNat
  have hmcast : (m : ℤ) = n * degree B := Int.toNat_of_nonneg (by positivity)
  set T : Set (Divisor k F) := {D | WeilDivisor.IsEffective D ∧ degree D = (m : ℤ)}
  have : Finite T :=
    ((finite_setOf_isEffective_degree_le hF m).subset fun _ hD ↦ ⟨hD.1, hD.2.le⟩).to_subtype
  have hnB : degree (n • B) = n * degree B := by rw [map_nsmul, nsmul_eq_mul]
  have hker : ∀ A : T, (Place.orderSystem hF).divisorClass ((A : Divisor k F) - n • B) ∈
      (Divisor.degreeClass hF).ker := by
    intro A
    rw [AddMonoidHom.mem_ker, degreeClass_divisorClass, degree_sub, hnB, A.2.2, hmcast, sub_self]
  refine Finite.of_surjective (fun A : T ↦ (⟨_, hker A⟩ : (Divisor.degreeClass hF).ker)) ?_
  rintro ⟨c, hc⟩
  obtain ⟨D, rfl⟩ := (Place.orderSystem hF).divisorClass_surjective c
  rw [AddMonoidHom.mem_ker, degreeClass_divisorClass] at hc
  obtain ⟨A, hA0, hAdeg, hAeq⟩ := exists_isEffective_linearlyEquivalent_add_nsmul hF hgen hc
  refine ⟨⟨A, hA0, by rw [hAdeg, hmcast]⟩, Subtype.ext ?_⟩
  have hclass : (Place.orderSystem hF).divisorClass A =
      (Place.orderSystem hF).divisorClass (D + n • B) :=
    ((Place.orderSystem hF).divisorClass_eq_iff).mpr hAeq
  -- Unfold the value of the surjection at the chosen preimage before rewriting.
  dsimp only
  rw [map_sub, hclass, map_add, add_sub_cancel_right]

/-- The **class number** `h_F = #Cl⁰(F)` of an algebraic function field: the cardinality of its
degree-zero divisor class group.  Over a finite constant field this is a positive integer
(`TauCeti.Divisor.classNumber_pos`); in general `Nat.card` returns the junk value `0` for an
infinite group. -/
noncomputable def classNumber (hF : IsFunctionField k F) : ℕ :=
  Nat.card (Divisor.degreeClass hF).ker

/-- The class number, unfolded. -/
theorem classNumber_def (hF : IsFunctionField k F) :
    classNumber hF = Nat.card (Divisor.degreeClass hF).ker := (rfl)

/-- Over a finite constant field the class number is positive. -/
theorem classNumber_pos (hF : IsFunctionField k F) [Finite k] : 0 < classNumber hF :=
  have := finite_ker_degreeClass hF
  Nat.card_pos

end Divisor

end TauCeti
