module

public import TauCeti.AlgebraicGeometry.WeilDivisor.Degree.Order
public import TauCeti.FieldTheory.FunctionField.Place.Degree

/-!
# Divisors of an algebraic function field

A divisor of `F / k` is a finite integer combination of its normalized places.  The underlying
free abelian group, its coefficientwise order, effectivity, and its positive/negative part
decomposition are supplied by `TauCeti.AlgebraicGeometry.WeilDivisor`; this file specializes that
API rather than constructing a second formal-divisor theory.

The degree of a function-field divisor is the weighted degree

`\sum_P D(P) [F_P : k]`.

The residue degrees are finite and positive when `F / k` is an algebraic function field.  Thus
degree is nonnegative on effective divisors, and is positive on every nonzero effective divisor.
The weights cannot be omitted over a general constant field: this file identifies the weighted
degree with the unweighted coefficient sum only when every place is rational, in particular over
an algebraically closed constant field.

This is the divisor carrier and degree portion of Stichtenoth, *Algebraic Function Fields and
Codes*, 2nd ed., Definition 1.4.1.  Principal divisors and the product formula follow after the
finiteness of zeros and poles.
-/

public section

namespace TauCeti

open AlgebraicGeometry

variable (k F : Type*) [Field k] [Field F] [Algebra k F]

/-- A divisor of `F / k` is a finite formal integer combination of its normalized places. -/
abbrev Divisor :=
  WeilDivisor (Place k F)

namespace Divisor

variable {k F}

/-- The degree of a function-field divisor, weighted by the degrees of its residue fields. -/
noncomputable def degree : Divisor k F →+ ℤ :=
  WeilDivisor.weightedDegree fun P => P.degree

/-- The degree is the finite sum of each coefficient times the corresponding residue degree. -/
lemma degree_apply (D : Divisor k F) :
    degree D = D.sum fun P n => n * P.degree := by
  simpa only [degree] using
    WeilDivisor.weightedDegree_apply (fun P : Place k F => (P.degree : ℤ)) D

/-- The support-indexed form of the degree sum. -/
lemma degree_eq_sum_support (D : Divisor k F) :
    degree D = ∑ P ∈ D.support, D P * P.degree := by
  rw [degree_apply, Finsupp.sum]

@[simp]
lemma degree_zero : degree (0 : Divisor k F) = 0 :=
  map_zero degree

@[simp]
lemma degree_add (D E : Divisor k F) : degree (D + E) = degree D + degree E :=
  map_add degree D E

@[simp]
lemma degree_neg (D : Divisor k F) : degree (-D) = -degree D :=
  map_neg degree D

@[simp]
lemma degree_sub (D E : Divisor k F) : degree (D - E) = degree D - degree E :=
  map_sub degree D E

@[simp]
lemma degree_zsmul (n : ℤ) (D : Divisor k F) : degree (n • D) = n * degree D := by
  simpa only [smul_eq_mul] using map_zsmul degree n D

/-- A place viewed as a prime divisor has degree equal to its residue degree. -/
@[simp]
lemma degree_ofPoint (P : Place k F) : degree (WeilDivisor.ofPoint P) = P.degree := by
  simpa only [degree] using
    WeilDivisor.weightedDegree_ofPoint (fun Q : Place k F => (Q.degree : ℤ)) P

/-- The degree of a divisor supported at one place. -/
@[simp]
lemma degree_single (P : Place k F) (n : ℤ) :
    degree (Finsupp.single P n) = n * P.degree := by
  rw [WeilDivisor.single_eq_zsmul_ofPoint, degree_zsmul, degree_ofPoint]

/-- The image of the degree map is the subgroup of `ℤ` generated by all residue degrees. -/
lemma degree_range :
    (degree : Divisor k F →+ ℤ).range =
      AddSubgroup.closure (Set.range fun P : Place k F => (P.degree : ℤ)) := by
  simpa only [degree] using
    WeilDivisor.weightedDegree_range (fun P : Place k F => (P.degree : ℤ))

/-- A rational place makes the divisor degree map surjective. -/
lemma degree_surjective_of_degree_eq_one (P : Place k F) (hP : P.degree = 1) :
    Function.Surjective (degree : Divisor k F →+ ℤ) := by
  intro n
  refine ⟨n • WeilDivisor.ofPoint P, ?_⟩
  simp [hP]

/-- A rational place makes the image of the divisor degree map all of `ℤ`. -/
lemma degree_range_eq_top_of_degree_eq_one (P : Place k F) (hP : P.degree = 1) :
    (degree : Divisor k F →+ ℤ).range = ⊤ :=
  AddMonoidHom.range_eq_top.mpr
    (degree_surjective_of_degree_eq_one (k := k) (F := F) P hP)

/-- The degree of an effective divisor is nonnegative.  This does not need a function-field
hypothesis, since `finrank` is always a natural number even before its finiteness is known. -/
lemma degree_nonneg {D : Divisor k F} (hD : 0 ≤ D) : 0 ≤ degree D := by
  have hD' : WeilDivisor.IsEffective D := WeilDivisor.isEffective_iff_zero_le.mpr hD
  simpa only [degree] using
    hD'.weightedDegree_nonneg fun P : Place k F => Int.natCast_nonneg P.degree

/-- Residue-degree weighting is monotone for the coefficientwise order on divisors. -/
lemma degree_le_of_le {D E : Divisor k F} (hDE : D ≤ E) : degree D ≤ degree E := by
  simpa only [degree] using WeilDivisor.weightedDegree_le_of_le
    (fun P : Place k F => Int.natCast_nonneg P.degree) hDE

/-- Bundled monotonicity of the function-field divisor degree. -/
lemma monotone_degree : Monotone (degree : Divisor k F → ℤ) :=
  fun _ _ => degree_le_of_le (k := k) (F := F)

private lemma degree_pos_of_isFunctionField (hF : IsFunctionField k F) (P : Place k F) :
    0 < (P.degree : ℤ) := by
  exact_mod_cast P.one_le_degree_of_isFunctionField hF

/-- A nonzero effective divisor of a function field has positive degree. -/
lemma degree_pos (hF : IsFunctionField k F) {D : Divisor k F} (hD : 0 ≤ D) (hD0 : D ≠ 0) :
    0 < degree D := by
  have hD' : WeilDivisor.IsEffective D := WeilDivisor.isEffective_iff_zero_le.mpr hD
  simpa only [degree] using
    hD'.weightedDegree_pos_of_pos (degree_pos_of_isFunctionField hF) hD0

/-- An effective divisor of a function field has degree zero exactly when it is zero. -/
lemma degree_eq_zero_iff (hF : IsFunctionField k F) {D : Divisor k F} (hD : 0 ≤ D) :
    degree D = 0 ↔ D = 0 := by
  have hD' : WeilDivisor.IsEffective D := WeilDivisor.isEffective_iff_zero_le.mpr hD
  simpa only [degree] using
    hD'.weightedDegree_eq_zero_iff_of_pos (degree_pos_of_isFunctionField hF)

/-- Equality of degrees under a coefficientwise inequality forces equality of divisors. -/
lemma eq_of_le_of_degree_eq (hF : IsFunctionField k F) {D E : Divisor k F} (hDE : D ≤ E)
    (hdeg : degree D = degree E) : D = E := by
  apply WeilDivisor.eq_of_le_of_weightedDegree_eq_of_pos
    (degree_pos_of_isFunctionField hF) hDE
  simpa only [degree] using hdeg

/-- Degree is strictly monotone on divisors of an algebraic function field. -/
lemma strictMono_degree (hF : IsFunctionField k F) :
    StrictMono (degree : Divisor k F → ℤ) := by
  simpa only [degree] using
    WeilDivisor.strictMono_weightedDegree (degree_pos_of_isFunctionField hF)

/-- **Degrees grow without bound along a single place**: since every place of an algebraic
function field has degree at least one, adding enough copies of a fixed place `P` to `D` carries
the degree past any prescribed bound `c`.  This is how a divisor is made to satisfy a
large-degree hypothesis while its coefficients away from `P` are left untouched. -/
lemma exists_le_degree_add_nsmul_ofPoint (hF : IsFunctionField k F) (D : Divisor k F)
    (P : Place k F) (c : ℤ) : ∃ n : ℕ, c ≤ degree (D + n • WeilDivisor.ofPoint P) := by
  refine ⟨(c - degree D).toNat, ?_⟩
  have hP : (1 : ℤ) ≤ P.degree := by
    have := degree_pos_of_isFunctionField hF P
    omega
  have hmul : ((c - degree D).toNat : ℤ) ≤ ((c - degree D).toNat : ℤ) * P.degree :=
    le_mul_of_one_le_right (Int.natCast_nonneg _) hP
  rw [degree_add, map_nsmul, degree_ofPoint, nsmul_eq_mul]
  omega

/-- Degree splits over the positive and negative parts of a divisor. -/
lemma degree_posPart_sub_degree_negPart (D : Divisor k F) :
    degree D⁺ - degree D⁻ = degree D := by
  simpa only [degree] using WeilDivisor.weightedDegree_posPart_sub_weightedDegree_negPart
    (fun P : Place k F => (P.degree : ℤ)) D

/-- Degree satisfies inclusion-exclusion for the coefficientwise infimum and supremum. -/
lemma degree_inf_add_degree_sup (D E : Divisor k F) :
    degree (D ⊓ E) + degree (D ⊔ E) = degree D + degree E := by
  simpa only [degree] using WeilDivisor.weightedDegree_inf_add_weightedDegree_sup
    (fun P : Place k F => (P.degree : ℤ)) D E

/-- If every place is rational, weighted degree is the ordinary sum of coefficients. -/
lemma degree_eq_weilDivisorDegree (h : ∀ P : Place k F, P.degree = 1) :
    (degree : Divisor k F →+ ℤ) =
      (WeilDivisor.degree : WeilDivisor (Place k F) →+ ℤ) := by
  apply DFunLike.ext _ _
  intro D
  rw [degree_eq_sum_support, WeilDivisor.degree_apply]
  apply Finset.sum_congr rfl
  intro P _
  simp [h P]

/-- Over an algebraically closed constant field, divisor degree is the ordinary coefficient
sum. -/
lemma degree_eq_weilDivisorDegree_of_isAlgClosed [IsAlgClosed k] (hF : IsFunctionField k F) :
    (degree : Divisor k F →+ ℤ) =
      (WeilDivisor.degree : WeilDivisor (Place k F) →+ ℤ) :=
  degree_eq_weilDivisorDegree (k := k) (F := F) fun P =>
    P.degree_eq_one_of_isAlgClosed_of_isFunctionField hF

/-- Over an algebraically closed constant field, the degree is the sum of the coefficients. -/
lemma degree_apply_of_isAlgClosed [IsAlgClosed k] (hF : IsFunctionField k F) (D : Divisor k F) :
    degree D = ∑ P ∈ D.support, D P := by
  rw [degree_eq_weilDivisorDegree_of_isAlgClosed (k := k) (F := F) hF,
    WeilDivisor.degree_apply]

end Divisor

end TauCeti
