module

public import Mathlib.FieldTheory.FinTrdeg
public import Mathlib.NumberTheory.FunctionField

/-!
# Algebraic function fields of one variable

This file defines an algebraic function field intrinsically: no rational parameter is chosen.
It proves that every transcendental element is a valid parameter, compares the intrinsic notion
with Mathlib's chosen-parameter `FunctionField`, and characterizes it by finite generation and
transcendence degree one.

The definition and the independence-of-parameter result follow Stichtenoth, *Algebraic Function
Fields and Codes*, second edition, Definition 1.1.1 and Remark 1.1.2.

The proof of independence of the parameter adapts Mathlib's
`FunctionField.finiteDimensional_of_adjoin_transcendental` to the intrinsic predicate defined
here. No code from external formalizations is used.
-/

public section

noncomputable section

namespace TauCeti

open IntermediateField

universe u v

variable (k : Type u) (F : Type v) [Field k] [Field F] [Algebra k F]

/-- A field `F` is an algebraic function field of one variable over `k` if it is finite over
`k(x)` for some element `x` transcendental over `k`.

Unlike Mathlib's `FunctionField`, this proposition does not depend on a chosen embedding of the
rational function field. It is intentionally an explicit proposition rather than a typeclass. -/
def IsFunctionField : Prop :=
  ∃ x : F, Transcendental k x ∧ FiniteDimensional k⟮x⟯ F

/-- The defining characterization of an algebraic function field. -/
theorem isFunctionField_iff :
    IsFunctionField k F ↔ ∃ x : F, Transcendental k x ∧ FiniteDimensional k⟮x⟯ F :=
  Iff.rfl

variable {k F}

namespace IsFunctionField

/-- An algebraic function field contains an element transcendental over its constant field. -/
theorem exists_transcendental (hF : IsFunctionField k F) : ∃ x : F, Transcendental k x :=
  hF.imp fun _ hx ↦ hx.1

/-- Every transcendental element of an algebraic function field is a rational parameter: the
field is finite over the intermediate field it generates. -/
theorem finiteDimensional_adjoin (hF : IsFunctionField k F) {y : F}
    (hy : Transcendental k y) : FiniteDimensional k⟮y⟯ F := by
  obtain ⟨x, hx, hfinite⟩ := hF
  let Fyx := restrictScalars k k⟮y⟯⟮x⟯
  let Fxy := restrictScalars k k⟮x⟯⟮y⟯
  let : Algebra k⟮y⟯ Fyx := k⟮y⟯⟮x⟯.algebra
  let : Module k⟮y⟯ Fyx := Algebra.toModule
  let : SMul k⟮y⟯ Fyx := Algebra.toSMul
  let : Algebra k⟮x⟯ Fxy := k⟮x⟯⟮y⟯.algebra
  let : Module k⟮x⟯ Fxy := Algebra.toModule
  let : SMul k⟮x⟯ Fxy := Algebra.toSMul
  let : FiniteDimensional k⟮x⟯ F := hfinite
  have : Algebra.IsAlgebraic k⟮x⟯ F := Algebra.IsAlgebraic.of_finite k⟮x⟯ F
  have hx_over_y : IsAlgebraic k⟮y⟯ x :=
    isAlgebraic_adjoin_iff.mpr (.adjoin_singleton hx hy
      (isAlgebraic_adjoin_iff.mp (Algebra.IsAlgebraic.isAlgebraic y)))
  have : FiniteDimensional k⟮y⟯ Fyx :=
    adjoin.finiteDimensional (isAlgebraic_iff_isIntegral.mp hx_over_y)
  have : FiniteDimensional Fyx F := by
    unfold Fyx
    rw [adjoin_simple_comm]
    have : IsScalarTower k⟮x⟯ Fxy F := isScalarTower_mid' k⟮x⟯⟮y⟯
    exact FiniteDimensional.right k⟮x⟯ Fxy F
  have : IsScalarTower k⟮y⟯ Fyx F := isScalarTower_mid' k⟮y⟯⟮x⟯
  exact FiniteDimensional.trans k⟮y⟯ Fyx F

/-- An algebraic function field is finitely generated as a field extension. -/
theorem essFiniteType (hF : IsFunctionField k F) : Algebra.EssFiniteType k F := by
  obtain ⟨x, -, hfinite⟩ := hF
  let : FiniteDimensional k⟮x⟯ F := hfinite
  let : Algebra.EssFiniteType k k⟮x⟯ :=
    IntermediateField.essFiniteType_iff.mpr
      (IntermediateField.fg_adjoin_of_finite (Set.finite_singleton x))
  exact Algebra.EssFiniteType.comp k k⟮x⟯ F

/-- The simple field generated by a transcendental element has transcendence degree one. -/
theorem trdeg_adjoin_eq_one_of_transcendental {x : F} (hx : Transcendental k x) :
    Algebra.trdeg k k⟮x⟯ = 1 := by
  have hrat_alg : Algebra.IsAlgebraic (Polynomial k) (RatFunc k) :=
    ⟨fun z ↦ (IsFractionRing.isAlgebraic_iff
      (Polynomial k) (RatFunc k) (RatFunc k)).mpr
        (Algebra.IsAlgebraic.isAlgebraic z)⟩
  have hrat : Algebra.trdeg k (RatFunc k) = 1 := by
    rw [← trdeg_add_eq k (Polynomial k) (A := RatFunc k),
      trdeg_eq_zero_iff.mpr hrat_alg, add_zero]
    exact Polynomial.trdeg_of_isDomain
  apply Cardinal.lift_injective
  rw [← (RatFunc.algEquivOfTranscendental x hx).lift_trdeg_eq, hrat]
  simp

/-- An algebraic function field has transcendence degree one. -/
theorem trdeg_eq_one (hF : IsFunctionField k F) : Algebra.trdeg k F = 1 := by
  obtain ⟨x, hx, hfinite⟩ := hF
  let : FiniteDimensional k⟮x⟯ F := hfinite
  rw [← trdeg_add_eq k k⟮x⟯ (A := F),
    trdeg_eq_zero_iff.mpr (inferInstance : Algebra.IsAlgebraic k⟮x⟯ F), add_zero,
    trdeg_adjoin_eq_one_of_transcendental hx]

end IsFunctionField

/-- The rational function field is an algebraic function field over its coefficient field. -/
theorem IsFunctionField.ratFunc (k : Type u) [Field k] : IsFunctionField k (RatFunc k) := by
  refine ⟨RatFunc.X, RatFunc.transcendental_X, ?_⟩
  rw [RatFunc.adjoin_X]
  exact Module.Finite.top_left (RatFunc k) (RatFunc k)

/-- With a chosen embedding of the rational function field, the intrinsic predicate agrees with
Mathlib's `FunctionField`. -/
theorem isFunctionField_iff_functionField [Algebra (RatFunc k) F]
    [IsScalarTower k (RatFunc k) F] : IsFunctionField k F ↔ FunctionField k F := by
  let y : F := algebraMap (RatFunc k) F RatFunc.X
  have hy : Transcendental k y :=
    (transcendental_algebraMap_iff (R := k)
      (FaithfulSMul.algebraMap_injective (RatFunc k) F)).mpr RatFunc.transcendental_X
  constructor
  · intro hF
    let : FiniteDimensional k⟮y⟯ F := hF.finiteDimensional_adjoin hy
    let e := RatFunc.algEquivOfTranscendental y hy
    have hpoly :
        (algebraMap (RatFunc k) F).comp (algebraMap (Polynomial k) (RatFunc k)) =
          (Polynomial.aeval y).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro c
        simp only [RingHom.coe_comp, Function.comp_apply, RatFunc.algebraMap_C,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C]
        rw [← RatFunc.algebraMap_eq_C]
        exact (IsScalarTower.algebraMap_apply k (RatFunc k) F c).symm
      · simp [y]
    have he (r : RatFunc k) : algebraMap (RatFunc k) F r = (e r : F) := by
      rw [RatFunc.algEquivOfTranscendental_apply]
      conv_lhs => rw [← RatFunc.num_div_denom r]
      rw [map_div₀]
      exact congrArg₂ (· / ·) (RingHom.congr_fun hpoly r.num) (RingHom.congr_fun hpoly r.denom)
    let b := Module.finBasis k⟮y⟯ F
    refine (b.mapCoeffs e.symm ?_).finiteDimensional_of_finite
    intro c z
    rw [Algebra.smul_def, Algebra.smul_def, he]
    congr 1
    exact congrArg (fun t : k⟮y⟯ ↦ (t : F)) (e.apply_symm_apply c)
  · intro hF
    let : FunctionField k F := hF
    exact ⟨y, hy, FunctionField.FiniteDimensional.adjoin_algebraMap_X⟩

/-- For a finitely generated field extension, being an algebraic function field is equivalent to
having transcendence degree one. -/
theorem isFunctionField_iff_trdeg_eq_one [Algebra.EssFiniteType k F] :
    IsFunctionField k F ↔ Algebra.trdeg k F = 1 := by
  refine ⟨IsFunctionField.trdeg_eq_one, fun htr ↦ ?_⟩
  let : Algebra.Transcendental k F := trdeg_ne_zero_iff.mp (htr ▸ one_ne_zero)
  obtain ⟨x, hx⟩ := Algebra.Transcendental.transcendental (R := k) (A := F)
  have htower := trdeg_add_eq k k⟮x⟯ (A := F)
  rw [IsFunctionField.trdeg_adjoin_eq_one_of_transcendental hx, htr] at htower
  have hzero : Algebra.trdeg k⟮x⟯ F = 0 := by
    rcases Cardinal.add_eq_left_iff.mp htower with h | h
    · exfalso
      have : Cardinal.aleph0 ≤ (1 : Cardinal) := (le_max_left _ _).trans h
      exact Cardinal.one_lt_aleph0.2 this
    · exact h
  let : Algebra.EssFiniteType k⟮x⟯ F := Algebra.EssFiniteType.of_comp k k⟮x⟯ F
  let : Algebra.IsAlgebraic k⟮x⟯ F := trdeg_eq_zero_iff.mp hzero
  exact ⟨x, hx, Algebra.finite_of_essFiniteType_of_isAlgebraic⟩

/-- A finite extension of an algebraic function field is an algebraic function field over the
same constant field. No separability hypothesis is needed. -/
theorem IsFunctionField.finite_extension {E : Type*} [Field E] [Algebra k E] [Algebra F E]
    [IsScalarTower k F E] [FiniteDimensional F E] (hF : IsFunctionField k F) :
    IsFunctionField k E := by
  let : Algebra.EssFiniteType k F := hF.essFiniteType
  let : Algebra.EssFiniteType k E := Algebra.EssFiniteType.comp k F E
  rw [isFunctionField_iff_trdeg_eq_one]
  apply Cardinal.lift_injective
  rw [← lift_trdeg_add_eq k F E,
    trdeg_eq_zero_iff.mpr (inferInstance : Algebra.IsAlgebraic F E), Cardinal.lift_zero,
    add_zero, hF.trdeg_eq_one, Cardinal.lift_one]
  simp

end TauCeti
