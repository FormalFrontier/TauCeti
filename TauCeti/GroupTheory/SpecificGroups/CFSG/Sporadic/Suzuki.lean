/-- The generator count recorded for `Suz`. -/
@[simp]
theorem suzPresentation_expectedGeneratorCount :
    suzPresentation.expectedGeneratorCount = 7 := by
  rfl

/-- The relator count recorded for `Suz`. -/
@[simp]
theorem suzPresentation_expectedRelatorCount : suzPresentation.expectedRelatorCount = 34 := by
  rfl

/-- The relator expressions transcribed for `Suz`, with all thirty-four words visible to consumers
of the sealed presentation definition. -/
@[simp]
theorem suzPresentation_transcribed :
    suzPresentation.transcribed =
      let a : Relator (Fin suzPresentation.generatorNames.length) :=
        .gen ⟨0, by simp [suzPresentation]⟩
      let b : Relator (Fin suzPresentation.generatorNames.length) :=
        .gen ⟨1, by simp [suzPresentation]⟩
      let c : Relator (Fin suzPresentation.generatorNames.length) :=
        .gen ⟨2, by simp [suzPresentation]⟩
      let d : Relator (Fin suzPresentation.generatorNames.length) :=
        .gen ⟨3, by simp [suzPresentation]⟩
      let e : Relator (Fin suzPresentation.generatorNames.length) :=
        .gen ⟨4, by simp [suzPresentation]⟩
      let f : Relator (Fin suzPresentation.generatorNames.length) :=
        .gen ⟨5, by simp [suzPresentation]⟩
      let g : Relator (Fin suzPresentation.generatorNames.length) :=
        .gen ⟨6, by simp [suzPresentation]⟩
      [ .pow a 2,
        .pow b 2,
        .pow c 2,
        .pow d 2,
        .pow e 2,
        .pow f 2,
        .pow g 2,
        .pow (a ⬝ b) 5,
        .pow (b ⬝ c) 3,
        .pow (c ⬝ d) 8,
        .pow (d ⬝ e) 3,
        .pow (b ⬝ f) 3,
        .pow (f ⬝ g) 4,
        .pow (g ⬝ b) 3,
        .pow (a ⬝ c) 2,
        .pow (a ⬝ d) 2,
        .pow (a ⬝ e) 2,
        .pow (a ⬝ f) 2,
        .pow (a ⬝ g) 2,
        .pow (b ⬝ d) 2,
        .pow (b ⬝ e) 2,
        .pow (c ⬝ e) 2,
        .pow (c ⬝ f) 2,
        .pow (c ⬝ g) 2,
        .pow (d ⬝ f) 2,
        .pow (d ⬝ g) 2,
        .pow (e ⬝ f) 2,
        .pow (e ⬝ g) 2,
        .inv a ⬝ .pow (c ⬝ d) 4,
        .inv a ⬝ .pow (f ⬝ g) 2,
        .pow (a ⬝ b ⬝ c ⬝ f) 5,
        .pow (b ⬝ f ⬝ g) 5,
        .pow (.pow (b ⬝ c ⬝ d ⬝ c ⬝ d) 5 ⬝ e) 3,
        .pow (a ⬝ b ⬝ c ⬝ g) 5 ] := by
  simp [suzPresentation, suzCoxeterRelators, suzAdditionalRelators]

/-- The generator and relator counts recorded for `Suz` agree with the transcribed data. -/
theorem suzPresentation_matchesMetadata : suzPresentation.matchesMetadata := by
  decide

/-! ### The compiled letters and the counts read off them -/

/-- **The compiled relator words of `Suz`, spelled out letter by letter.** A letter `(i, true)` is
the generator of index `i` and `(i, false)` is its inverse, so index `0` reads `a` and index `6`
reads `g`.

This is the form in which the transcription is compared with the source one letter at a time, and
it is the check the two counts of `TauCeti.Sporadic.suzPresentation_matchesMetadata` cannot make:
a relator exchanged for another of the same shape, or an omitted-edge pair written twice while
another is dropped, leaves both counts unchanged. Read off this list, the twenty-one pair relations
among the twenty-eight words decoded from the two Coxeter paths carry each unordered pair of the
seven generators exactly once: the seven pairs named by the paths with the exponents
`5, 3, 8, 3, 3, 4, 3` in that order, and the remaining fourteen with exponent two.

The per-relator lengths and the total below are read off these letters. The cyclic-reduction check
instead recompiles the bounded words from `TauCeti.Sporadic.suzPresentation_transcribed`, since
forgetting the generator bounds forgets the type that predicate is stated on. -/
