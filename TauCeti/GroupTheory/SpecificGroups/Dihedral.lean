module

public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# The dihedral groups: an enumeration, and a recognition criterion

`DihedralGroup n` is finite, but `Fintype` alone does not hand back a list of its elements, since
`Finset.toList` is noncomputable. This file writes that list down, and evaluates
`DihedralGroup.exponent` — which computes the exponent of `DihedralGroup n` as `lcm n 2` — at the
two orders the worked examples of the Burnside--Dixon--Schneider character-table algorithm are run
on.

It then proves the converse-facing statement, which Mathlib does not have: a group generated by two
involutions *is* a dihedral group, of order twice the order of their product. Every rank-two
reflection group is presented to us in that shape, and this is what identifies it.

## Main definitions

* `TauCeti.dihedralElements`: a computable enumeration of `DihedralGroup n`.

## Main results

* `TauCeti.mem_dihedralElements`: that enumeration exhausts the group.
* `TauCeti.exponent_dihedralGroup_three`: `DihedralGroup 3`, of order `6`, has exponent `6`.
* `TauCeti.exponent_dihedralGroup_four`: `DihedralGroup 4`, of order `8`, has exponent `4`.
* `TauCeti.nonempty_dihedralGroup_mulEquiv`: **a group generated by two involutions other than the
  identity is the dihedral group of order twice the order of their product.**
-/

public section

namespace TauCeti

/-- The rotations `r 0, …, r (n-1)` of `DihedralGroup n`, each followed by the corresponding
reflection. For `n ≠ 0` this lists all `2 * n` elements of the group, which is
`TauCeti.mem_dihedralElements`. The body is exposed because a kernel computation over the group —
such as the class data of `TauCeti.dihedralClassData` — has to reduce it. -/
@[expose] def dihedralElements (n : ℕ) : List (DihedralGroup n) :=
  (List.range n).flatMap fun i : ℕ => [DihedralGroup.r (i : ZMod n), DihedralGroup.sr (i : ZMod n)]

/-- The enumeration `TauCeti.dihedralElements` exhausts the dihedral group. -/
theorem mem_dihedralElements {n : ℕ} [NeZero n] (g : DihedralGroup n) : g ∈ dihedralElements n := by
  have hmem : ∀ i : ZMod n, i.val ∈ List.range n := fun i => List.mem_range.mpr (ZMod.val_lt i)
  cases g with
  | r i =>
    refine List.mem_flatMap.mpr ⟨i.val, hmem i, ?_⟩
    rw [ZMod.natCast_rightInverse i]
    simp
  | sr i =>
    refine List.mem_flatMap.mpr ⟨i.val, hmem i, ?_⟩
    rw [ZMod.natCast_rightInverse i]
    simp

/-- The dihedral group of order `6`, the symmetric group on three letters, has exponent `6`. -/
@[simp]
theorem exponent_dihedralGroup_three : Monoid.exponent (DihedralGroup 3) = 6 := by
  rw [DihedralGroup.exponent]
  decide

/-- The dihedral group of order `8` has exponent `4`. -/
@[simp]
theorem exponent_dihedralGroup_four : Monoid.exponent (DihedralGroup 4) = 4 := by
  rw [DihedralGroup.exponent]
  decide

/-! ## Recognizing a dihedral group

A group generated by two involutions `s` and `t` is dihedral: its rotation subgroup is generated by
`c = s * t`, and its reflections are the elements `s * c ^ k`. Turning that into an isomorphism
means indexing the powers of `c` by `ZMod n`, where `n` is the order of `c`; that indexing is
`TauCeti.rotation`, and `TauCeti.dihedralHom` is the resulting homomorphism.

The work is in injectivity. On the rotations it is the definition of the order of `c`. On the
reflections it is the observation that `s * c ^ k = 1` puts `s` inside the *abelian* subgroup
generated by `c`, so that `s` both inverts and centralizes `c`; then `c` is its own inverse, and the
parity of `k` makes `s` or `t` the identity. Both hypotheses `s ≠ 1` and `t ≠ 1` are therefore
needed: for `s = 1` the group is generated by the single involution `t` while `orderOf (s * t) = 2`,
so it is not the dihedral group of order `4`. -/

section Recognition

variable {G : Type*} [Group G] {n : ℕ} {c s t : G}

/-- The power `c ^ i` of a group element `c` of order `n`, indexed by `ZMod n` through the
representative `ZMod.val i`. This is the rotation part of the isomorphism of
`TauCeti.nonempty_dihedralGroup_mulEquiv`. -/
private def rotation (c : G) (i : ZMod n) : G := c ^ i.val

private lemma intCast_val [NeZero n] (i : ZMod n) : (((i.val : ℕ) : ℤ) : ZMod n) = i := by
  rw [Int.cast_natCast, ZMod.natCast_rightInverse i]

/-- Every integer power of `c` is a rotation, namely the one indexed by its residue. -/
private lemma rotation_intCast [NeZero n] (hc : orderOf c = n) (k : ℤ) :
    rotation c (k : ZMod n) = c ^ k := by
  change c ^ ((k : ZMod n)).val = c ^ k
  rw [← zpow_natCast, zpow_eq_zpow_iff_modEq, hc, ← ZMod.intCast_eq_intCast_iff, intCast_val]

/-- A rotation is the integer power named by any integer representative of its index. -/
private lemma rotation_eq_zpow [NeZero n] (hc : orderOf c = n) {i : ZMod n} {k : ℤ}
    (h : (k : ZMod n) = i) : rotation c i = c ^ k := by
  subst h
  exact rotation_intCast hc k

private lemma rotation_val [NeZero n] (hc : orderOf c = n) (i : ZMod n) :
    rotation c i = c ^ ((i.val : ℕ) : ℤ) :=
  rotation_eq_zpow hc (intCast_val i)

private lemma rotation_zero (c : G) : rotation c (0 : ZMod n) = 1 := by
  change c ^ (0 : ZMod n).val = 1
  simp

private lemma rotation_one [NeZero n] (hc : orderOf c = n) : rotation c (1 : ZMod n) = c := by
  rw [rotation_eq_zpow hc (k := 1) Int.cast_one, zpow_one]

private lemma rotation_add [NeZero n] (hc : orderOf c = n) (i j : ZMod n) :
    rotation c (i + j) = rotation c i * rotation c j := by
  rw [rotation_eq_zpow hc (k := ((i.val : ℕ) : ℤ) + ((j.val : ℕ) : ℤ))
      (by rw [Int.cast_add, intCast_val, intCast_val]),
    rotation_val hc i, rotation_val hc j, zpow_add]

private lemma rotation_neg [NeZero n] (hc : orderOf c = n) (i : ZMod n) :
    rotation c (-i) = (rotation c i)⁻¹ := by
  rw [rotation_eq_zpow hc (k := -((i.val : ℕ) : ℤ)) (by rw [Int.cast_neg, intCast_val]),
    rotation_val hc i, zpow_neg]

/-- Either of the two involutions inverts their product by conjugation. -/
private lemma conj_mul_eq_inv (hs : s * s = 1) (ht : t * t = 1) :
    s * (s * t) * s⁻¹ = (s * t)⁻¹ := by
  rw [mul_inv_rev, inv_eq_of_mul_eq_one_right ht, inv_eq_of_mul_eq_one_right hs, ← mul_assoc, hs,
    one_mul]

/-- Moving one of the two involutions across a rotation inverts the rotation. -/
private lemma rotation_mul_eq [NeZero n] (hs : s * s = 1) (ht : t * t = 1)
    (hn : orderOf (s * t) = n) (i : ZMod n) :
    rotation (s * t) i * s = s * rotation (s * t) (-i) := by
  have hsi : s⁻¹ = s := inv_eq_of_mul_eq_one_right hs
  have hkey : s * (s * t) ^ ((i.val : ℕ) : ℤ) * s⁻¹ = ((s * t) ^ ((i.val : ℕ) : ℤ))⁻¹ := by
    rw [← conj_zpow, conj_mul_eq_inv hs ht, inv_zpow]
  rw [rotation_neg hn, rotation_val hn i, ← hkey, hsi, ← mul_assoc, ← mul_assoc, hs, one_mul]

/-- The homomorphism out of the dihedral group determined by two involutions whose product has
order `n`: a rotation `r i` goes to `(s * t) ^ i`, and a reflection `sr i` to `s * (s * t) ^ i`. -/
private def dihedralHom [NeZero n] (hs : s * s = 1) (ht : t * t = 1) (hn : orderOf (s * t) = n) :
    DihedralGroup n →* G where
  toFun x := match x with
    | .r i => rotation (s * t) i
    | .sr i => s * rotation (s * t) i
  map_one' := rotation_zero (s * t)
  map_mul' := by
    rintro (i | i) (j | j)
    · rw [DihedralGroup.r_mul_r]
      exact rotation_add hn i j
    · rw [DihedralGroup.r_mul_sr]
      change s * rotation (s * t) (j - i) = rotation (s * t) i * (s * rotation (s * t) j)
      rw [← mul_assoc, rotation_mul_eq hs ht hn, mul_assoc, ← rotation_add hn, neg_add_eq_sub]
    · rw [DihedralGroup.sr_mul_r]
      change s * rotation (s * t) (i + j) = s * rotation (s * t) i * rotation (s * t) j
      rw [rotation_add hn, mul_assoc]
    · rw [DihedralGroup.sr_mul_sr]
      change rotation (s * t) (j - i) = s * rotation (s * t) i * (s * rotation (s * t) j)
      rw [← mul_assoc, mul_assoc s, rotation_mul_eq hs ht hn, ← mul_assoc, hs, one_mul,
        ← rotation_add hn, neg_add_eq_sub]

/-- **A group generated by two involutions is dihedral.** If the involutions `s` and `t` generate
`G` and neither is the identity, then `G` is the dihedral group of order `2 * n`, where `n` is the
order of `s * t`: the rotation `r i` is the power `(s * t) ^ i`, and the reflection `sr i` is
`s * (s * t) ^ i`.

Mathlib has the dihedral groups but no criterion recognizing one, so this is proved here. It is
what identifies the Weyl group of a rank-two root system in
`TauCeti.nonempty_dihedralGroup_mulEquiv_weylGroup`. -/
theorem nonempty_dihedralGroup_mulEquiv [NeZero n] (hs : s * s = 1) (ht : t * t = 1) (hs1 : s ≠ 1)
    (ht1 : t ≠ 1) (hn : orderOf (s * t) = n)
    (hgen : Subgroup.closure ({s, t} : Set G) = ⊤) :
    Nonempty (DihedralGroup n ≃* G) := by
  refine ⟨MulEquiv.ofBijective (dihedralHom hs ht hn) ⟨?_, ?_⟩⟩
  · rw [injective_iff_map_eq_one]
    rintro (i | i) hi
    · -- A rotation in the kernel has index divisible by the order of `s * t`, hence index zero.
      have hval : (s * t) ^ i.val = 1 := hi
      have hdvd : orderOf (s * t) ∣ i.val := orderOf_dvd_of_pow_eq_one hval
      rw [hn] at hdvd
      have hzero : i.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt i)
      rw [show i = 0 by rw [← ZMod.natCast_rightInverse i, hzero, Nat.cast_zero],
        DihedralGroup.r_zero]
    · -- A reflection in the kernel would put `s` in the centralizer of `s * t`.
      exfalso
      have hmul : s * (s * t) ^ ((i.val : ℕ) : ℤ) = 1 := by
        rw [zpow_natCast]
        exact hi
      have hzpow : s = (s * t) ^ (-((i.val : ℕ) : ℤ)) := by
        rw [zpow_neg, eq_inv_iff_mul_eq_one]
        exact hmul
      have hcomm : Commute s (s * t) := by
        have hz : Commute ((s * t) ^ (-((i.val : ℕ) : ℤ))) (s * t) :=
          (Commute.refl (s * t)).zpow_left _
        rwa [← hzpow] at hz
      have hinv : (s * t)⁻¹ = s * t := by
        rw [← conj_mul_eq_inv hs ht, hcomm.eq, mul_assoc, mul_inv_cancel, mul_one]
      have hsq : (s * t) ^ (2 : ℤ) = 1 := by
        rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) by norm_num, zpow_natCast, pow_two]
        nth_rewrite 1 [← hinv]
        exact inv_mul_cancel _
      rcases Int.even_or_odd (-((i.val : ℕ) : ℤ)) with ⟨m, hm⟩ | ⟨m, hm⟩
      · exact hs1 (by rw [hzpow, hm, ← two_mul, zpow_mul, hsq, one_zpow])
      · refine ht1 (mul_left_cancel (a := s) ?_)
        rw [mul_one]
        nth_rewrite 2 [hzpow]
        rw [hm, zpow_add, zpow_mul, hsq, one_zpow, one_mul, zpow_one]
  · -- Surjectivity: the range is a subgroup containing both generators.
    rw [← MonoidHom.range_eq_top, eq_top_iff, ← hgen, Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with h | h
    · refine ⟨DihedralGroup.sr 0, ?_⟩
      change s * rotation (s * t) (0 : ZMod n) = x
      rw [rotation_zero, mul_one, h]
    · refine ⟨DihedralGroup.sr 1, ?_⟩
      change s * rotation (s * t) (1 : ZMod n) = x
      rw [rotation_one hn, ← mul_assoc, hs, one_mul, h]

end Recognition

end TauCeti
