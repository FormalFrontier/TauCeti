module

public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Tactic.Group
import Mathlib.Data.Nat.Dist

/-!
# Normalizers and commutators tested on generating sets

Subgroups presented by generators are controlled by inspecting generators only. Conjugation and
commutation are not preserved by products, so the first two results below carry an auxiliary
normalizing hypothesis. The last result uses a commutator relation to propagate membership along
an ordered finite index set.

Mathlib has `Subgroup.le_normalizer_closure_iff`, which tests the *conjugated* subgroup on
generators but still quantifies over the whole conjugating subgroup, and `Subgroup.commutator_le`,
which quantifies over both subgroups. Neither reduces a comparison to generators on both sides.

## Main results

* `TauCeti.closure_le_normalizer_closure`: a subgroup generated by `X` normalizes a subgroup
  generated by `Y` as soon as the generators of `X` conjugate those of `Y` into it, in both
  directions.
* `TauCeti.commutator_closure_closure_le`: the commutator of two subgroups presented by generators
  lies in a subgroup normalized by both, as soon as the commutators of the generators do.
* `TauCeti.commutatorElement_mul_mul_eq_mul_of_commute`: the commutator of two paired products
  splits into the product of their same-position commutators when the required cross terms commute.
* `Subgroup.mem_of_adjacent_of_commutator`: a structure-constant-one family indexed by ordered
  pairs of `Fin m` is generated by its adjacent members.

## References

* R. W. Carter, *Simple Groups of Lie Type*, §5.3.
-/

public section

namespace TauCeti

open Subgroup
open scoped commutatorElement

variable {G : Type*} [Group G] {X Y : Set G} {N : Subgroup G}

/-- The commutator of two paired products splits into the product of the same-position
commutators when the cross terms and the resulting commutators commute as required. -/
theorem commutatorElement_mul_mul_eq_mul_of_commute {a b c d : G}
    (hbc : Commute b c) (had : Commute a d)
    (hcbd : Commute c ⁅b, d⁆) (habd : Commute a ⁅b, d⁆)
    (hcomm : Commute ⁅a, c⁆ ⁅b, d⁆) :
    ⁅a * b, c * d⁆ = ⁅a, c⁆ * ⁅b, d⁆ := by
  have hcbd_conj : c * ⁅b, d⁆ * c⁻¹ = ⁅b, d⁆ := by
    rw [hcbd.eq]
    group
  have habd_conj : a * ⁅b, d⁆ * a⁻¹ = ⁅b, d⁆ := by
    rw [habd.eq]
    group
  rw [commutatorElement_mul_left_eq_conj_mul,
    commutatorElement_mul_right_eq_mul_conj, hbc.commutator_eq,
    commutatorElement_mul_right_eq_mul_conj, had.commutator_eq]
  simp only [one_mul, mul_one, hcbd_conj, habd_conj, mul_inv_cancel_right]
  exact hcomm.eq.symm

/-- Conjugating the subgroup generated by `Y` by an element that conjugates the generators of `Y`
into that subgroup lands back inside it. -/
private theorem map_conj_closure_le {g : G} (h : ∀ y ∈ Y, g * y * g⁻¹ ∈ closure Y) :
    (closure Y).map (MulAut.conj g) ≤ closure Y := by
  rw [MonoidHom.map_closure, MonoidHom.coe_coe, closure_le]
  rintro - ⟨y, hy, rfl⟩
  exact h y hy

/-- A subgroup generated by `X` normalizes a subgroup generated by `Y` as soon as every generator
of `X` conjugates every generator of `Y` into the latter, in both directions.

Both directions are genuinely needed: for an infinitely generated subgroup, a single inclusion
`g (closure Y) g⁻¹ ≤ closure Y` does not place `g` in the normalizer. When `X` is closed under
inverses the second hypothesis is the first one read at `x⁻¹`. -/
theorem closure_le_normalizer_closure
    (h : ∀ x ∈ X, ∀ y ∈ Y, x * y * x⁻¹ ∈ closure Y)
    (hinv : ∀ x ∈ X, ∀ y ∈ Y, x⁻¹ * y * x ∈ closure Y) :
    closure X ≤ normalizer (closure Y : Set G) := by
  rw [closure_le]
  intro x hx
  have hle := map_conj_closure_le (h x hx)
  have hle' : (closure Y).map (MulAut.conj x⁻¹) ≤ closure Y :=
    map_conj_closure_le fun y hy => by simpa using hinv x hx y hy
  rw [SetLike.mem_coe, mem_normalizer_iff_map_conj_eq]
  refine le_antisymm hle fun y hy => ⟨x⁻¹ * y * x, ?_, ?_⟩
  · simpa using hle' ⟨y, hy, rfl⟩
  · rw [MonoidHom.coe_coe, MulAut.conj_apply]
    group

/-- Commutators of generators control the commutator subgroup, provided the target subgroup is
normalized by both factors.

The normalizing hypotheses are what makes the induction go through: expanding `⁅x, y₁ y₂⁆` and
`⁅x₁ x₂, y⁆` produces conjugates of commutators by elements of `closure Y` and of `closure X`
respectively. -/
theorem commutator_closure_closure_le
    (hX : closure X ≤ normalizer (N : Set G)) (hY : closure Y ≤ normalizer (N : Set G))
    (h : ∀ x ∈ X, ∀ y ∈ Y, ⁅x, y⁆ ∈ N) :
    ⁅closure X, closure Y⁆ ≤ N := by
  -- Conjugation by an element of either subgroup preserves `N`.
  have hconjX : ∀ x ∈ closure X, ∀ n ∈ N, x * n * x⁻¹ ∈ N :=
    fun x hx n hn => ((mem_normalizer_iff (H := N)).mp (hX hx) n).mp hn
  have hconjY : ∀ y ∈ closure Y, ∀ n ∈ N, y * n * y⁻¹ ∈ N :=
    fun y hy n hn => ((mem_normalizer_iff (H := N)).mp (hY hy) n).mp hn
  -- Fix a generator of `X` and induct over the second factor.
  have hgen : ∀ x ∈ X, ∀ y ∈ closure Y, ⁅x, y⁆ ∈ N := by
    intro x hx y hy
    induction hy using closure_induction with
    | mem y hy => exact h x hx y hy
    | one => simp
    | mul a b ha _ hxa hxb =>
      have hsplit : ⁅x, a⁆ * a * ⁅x, b⁆ * a⁻¹ = ⁅x, a⁆ * (a * ⁅x, b⁆ * a⁻¹) := by group
      rw [commutatorElement_mul_right_eq_mul_conj, hsplit]
      exact mul_mem hxa (hconjY a ha _ hxb)
    | inv a ha hxa =>
      rw [commutatorElement_inv_right]
      simpa using hconjY a⁻¹ (inv_mem ha) _ (commutatorElement_inv x a ▸ inv_mem hxa)
  -- Now induct over the first factor.
  rw [Subgroup.commutator_le]
  intro p hp q hq
  induction hp using closure_induction with
  | mem x hx => exact hgen x hx q hq
  | one => simp
  | mul a b ha _ hxa hxb =>
    rw [commutatorElement_mul_left_eq_conj_mul]
    exact mul_mem (hconjX a ha _ hxb) hxa
  | inv a ha hxa =>
    rw [commutatorElement_inv_left]
    simpa using hconjX a⁻¹ (inv_mem ha) _ (commutatorElement_inv a q ▸ inv_mem hxa)

end TauCeti

/-! ## Pair-indexed families generated by adjacent members -/

namespace Subgroup

open scoped commutatorElement

variable {G : Type*} [Group G] {P : Type*} [One P]

/-- Suppose elements `xᵢⱼ(a)` indexed by distinct pairs in `Fin m` satisfy the relation

```text
⁅xᵢⱼ(a), xⱼₖ(1)⁆ = xᵢₖ(a).
```

If a subgroup contains `xᵢⱼ(a)` whenever `i` and `j` are adjacent, in both orientations, then it
contains every `xᵢⱼ(a)`. -/
theorem mem_of_adjacent_of_commutator (H : Subgroup G)
    (x : ∀ {i j : Fin m}, i ≠ j → P → G)
    (hcomm : ∀ {i j k : Fin m} (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a : P),
      ⁅x hij a, x hjk 1⁆ = x hik a)
    (hadjacent : ∀ {i j : Fin m} (hij : i ≠ j) (a : P),
      i.val + 1 = j.val ∨ j.val + 1 = i.val → x hij a ∈ H)
    {i j : Fin m} (hij : i ≠ j) (a : P) : x hij a ∈ H := by
  let Q : ℕ → Prop := fun d =>
    ∀ (i j : Fin m) (hij : i ≠ j), Nat.dist i.val j.val = d → ∀ a : P, x hij a ∈ H
  suffices ∀ d, Q d by
    exact this (Nat.dist i.val j.val) i j hij rfl a
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
      intro i j hij hdist a
      by_cases hforward : i.val + 1 = j.val
      · exact hadjacent hij a (Or.inl hforward)
      by_cases hbackward : j.val + 1 = i.val
      · exact hadjacent hij a (Or.inr hbackward)
      have hval : i.val ≠ j.val := Fin.val_ne_of_ne hij
      let k : Fin m := if h : i.val < j.val then
        ⟨i.val + 1, by omega⟩ else ⟨i.val - 1, by omega⟩
      have hik : i ≠ k := by
        dsimp only [k]
        split_ifs with h <;> simp only [Fin.ext_iff, ne_eq] <;> omega
      have hkj : k ≠ j := by
        dsimp only [k]
        split_ifs with h <;> simp only [Fin.ext_iff, ne_eq] <;> omega
      have hdist_ik : Nat.dist i.val k.val < Nat.dist i.val j.val := by
        dsimp only [k]
        split_ifs with h <;> simp only [Nat.dist] <;> omega
      have hdist_kj : Nat.dist k.val j.val < Nat.dist i.val j.val := by
        dsimp only [k]
        split_ifs with h <;> simp only [Nat.dist] <;> omega
      rw [hdist] at hdist_ik hdist_kj
      have hik_mem := ih (Nat.dist i.val k.val) hdist_ik i k hik rfl a
      have hkj_mem := ih (Nat.dist k.val j.val) hdist_kj k j hkj rfl 1
      rw [← hcomm hik hkj hij a, commutatorElement_def]
      exact H.mul_mem (H.mul_mem (H.mul_mem hik_mem hkj_mem) (H.inv_mem hik_mem))
        (H.inv_mem hkj_mem)

end Subgroup
